@page "/usuarios/nuevo"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Gerente")]
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject UsuarioService UsuarioService
@inject SucursalService SucursalService
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject BlazorFrontEnd.Auth.TokenStorageService TokenStorage
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Registrar Nuevo Usuario</PageTitle>

<div class="glass-card" style="max-width: 600px; margin: auto; margin-top: 30px;">
    <div class="d-flex align-items-center mb-4">
        <button class="btn btn-link" style="color: var(--text-secondary); padding: 0; margin-right: 15px;" @onclick="GoBack">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 24px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
        </button>
        <h3 class="m-0" style="font-weight: 700;">Alta de Operador</h3>
    </div>

    @if (isLoading)
    {
        <p class="text-secondary text-center">Cargando permisos y roles...</p>
    }
    else
    {
        <EditForm Model="model" OnValidSubmit="HandleSave">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label>Nombre Completo (*)</label>
                <InputText @bind-Value="model.NombreCompleto" class="form-control bg-dark text-light border-secondary" placeholder="Ej: Dr. Juan Pérez" />
                <ValidationMessage For="@(() => model.NombreCompleto)" class="text-danger" />
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label>Nombre de Usuario (Alias) (*)</label>
                    <InputText @bind-Value="model.NombreUsuario" class="form-control bg-dark text-light border-secondary" placeholder="Ej: jperez" />
                    <ValidationMessage For="@(() => model.NombreUsuario)" class="text-danger" />
                </div>
                <div class="col-md-6">
                    <label>Rol Interno (*)</label>
                    <InputSelect @bind-Value="model.RolId" class="form-select bg-dark text-light border-secondary">
                        <option value="0">Seleccione un cargo...</option>
                        @foreach(var r in roles)
                        {
                            <option value="@r.Id">@r.Nombre</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => model.RolId)" class="text-danger" />
                </div>
            </div>

            <div class="mb-3">
                <label>Sucursal Asignada</label>
                @if (IsGerente && currentUserSucursalId.HasValue)
                {
                    var sucursalNombre = sucursales.FirstOrDefault(s => s.Id == currentUserSucursalId.Value)?.Nombre ?? $"Sucursal #{currentUserSucursalId}";
                    <input type="text" class="form-control bg-dark text-light border-secondary" value="@sucursalNombre" disabled />
                    <small class="text-secondary mb-2 d-block">Como Gerente, los usuarios creados se asignan automáticamente a tu sucursal.</small>
                }
                else
                {
                    <select class="form-select bg-dark text-light border-secondary" @bind="SelectedSucursalId">
                        <option value="">Global / Sin sucursal (Administrador)</option>
                        @foreach(var s in sucursales)
                        {
                            <option value="@s.Id">@s.Nombre</option>
                        }
                    </select>
                    <small class="text-secondary mb-2 d-block">Los administradores pueden no tener sucursal asignada (acceso global). Los demás cargos requieren sucursal.</small>
                }
            </div>

            <div class="mb-3">
                <label>Correo Electrónico (*)</label>
                <InputText @bind-Value="model.Email" class="form-control bg-dark text-light border-secondary" type="email" placeholder="jperez@veterinaria.com" />
                <ValidationMessage For="@(() => model.Email)" class="text-danger" />
            </div>

            <div class="mb-4">
                <label>Contraseña Provisoria (*)</label>
                <div class="input-group">
                    <InputText @bind-Value="model.Password" class="form-control bg-dark text-light border-secondary" type="@passwordType" style="border-right: none !important; border-radius: var(--radius-sm) 0 0 var(--radius-sm) !important;" />
                    <button type="button" @onclick="TogglePasswordVisibility" style="background: #212529; border: 1px solid #6c757d; border-left: none; color: #f8f9fa; border-radius: 0 var(--radius-sm) var(--radius-sm) 0 !important; display: flex; align-items: center; justify-content: center; padding: 0 15px; cursor: pointer;">
                        <i class="@passwordIconClass" style="font-size: 1.1rem; color: #f8f9fa !important;"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => model.Password)" class="text-danger" />
                <small class="text-secondary">Debe contener al menos 6 caracteres.</small>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger p-2">@errorMessage</div>
            }

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button type="button" class="btn btn-outline-secondary text-light" @onclick="GoBack">Cancelar</button>
                <button type="submit" class="btn-primary-glass" disabled="@isSaving">
                    @if(isSaving) { <span>Creando Cuenta...</span> } else { <span>Conceder Acceso</span> }
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    private RegisterRequest model = new();
    private List<RolDto> roles = new();
    private List<SucursalDto> sucursales = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string errorMessage = string.Empty;
    private string passwordType = "password";
    private string passwordIconClass = "bi bi-eye-slash";

    private string currentUserRole = "Usuario";
    private int? currentUserSucursalId = null;
    private bool IsGerente => currentUserRole.Equals("Gerente", StringComparison.OrdinalIgnoreCase);

    private void TogglePasswordVisibility()
    {
        if (passwordType == "password")
        {
            passwordType = "text";
            passwordIconClass = "bi bi-eye";
        }
        else
        {
            passwordType = "password";
            passwordIconClass = "bi bi-eye-slash";
        }
    }

    private string SelectedSucursalId
    {
        get => model.SucursalId?.ToString() ?? "";
        set => model.SucursalId = string.IsNullOrEmpty(value) ? null : int.Parse(value);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SyncTokenAsync();
            isLoading = true;
            StateHasChanged();

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            currentUserRole = user.FindFirst(ClaimTypes.Role)?.Value ?? user.FindFirst("role")?.Value ?? "Usuario";
            var sucClaim = user.FindFirst("sucursalId")?.Value;
            currentUserSucursalId = int.TryParse(sucClaim, out var sId) ? sId : null;

            var r = await UsuarioService.GetRolesAsync();
            if (r != null)
            {
                if (IsGerente)
                {
                    roles = r.Where(x => x.Nombre.Equals("Veterinario", StringComparison.OrdinalIgnoreCase) ||
                                         x.Nombre.Equals("Recepcionista", StringComparison.OrdinalIgnoreCase)).ToList();
                }
                else
                {
                    roles = r;
                }
            }

            var s = await SucursalService.GetAllAsync(soloActivos: true);
            if (s != null) sucursales = s;

            if (IsGerente && currentUserSucursalId.HasValue)
            {
                model.SucursalId = currentUserSucursalId.Value;
            }

            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SyncTokenAsync()
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrWhiteSpace(token))
                TokenStorage.SetToken(token);
        }
        catch { }
    }

    private async Task HandleSave()
    {
        if (model.RolId == 0)
        {
            errorMessage = "Debe asignar un Rol válido al usuario para continuar.";
            return;
        }

        var selectedRol = roles.FirstOrDefault(r => r.Id == model.RolId);
        if (selectedRol != null && selectedRol.Nombre.ToUpper() != "ADMIN" && !model.SucursalId.HasValue)
        {
            errorMessage = "Debe asignar una sucursal para cargos que no sean Administrador.";
            return;
        }

        isSaving = true;
        errorMessage = "";

        try
        {
            var res = await UsuarioService.RegisterUserAsync(model);
            if (res)
            {
                Navigation.NavigateTo("/usuarios");
            }
            else
            {
                errorMessage = "Hubo un error al registrar el usuario. El alias o email podrían estar ya en uso o no cuenta con los permisos necesarios.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Excepción interna comunicándose con el servidor.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/usuarios");
}
