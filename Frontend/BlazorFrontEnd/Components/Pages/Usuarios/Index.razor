@page "/usuarios"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Gerente")]
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject UsuarioService UsuarioService
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject BlazorFrontEnd.Auth.TokenStorageService TokenStorage
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Gestión de Usuarios y Accesos</PageTitle>

<div class="d-flex justify-content-between align-items-center" style="margin-bottom: var(--sp-lg);">
    <div>
        <h2 style="font-weight: 700; margin: 0;">Usuarios</h2>
        <p class="text-secondary" style="margin: 0;">Gestión de accesos, roles y auditoría del sistema</p>
    </div>
    <a href="/usuarios/nuevo" class="btn-primary-glass" style="text-decoration: none; display: flex; align-items: center; gap: 8px;">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 20px;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
        </svg>
        Registrar Usuario
    </a>
</div>

<!-- Tabs -->
<div style="display: flex; gap: 0; margin-bottom: var(--sp-lg);">
    <button class="@(activeTab == "usuarios" ? "btn-primary-glass" : "btn btn-sm btn-outline-secondary")"
            style="border-radius: 8px 0 0 8px; padding: 8px 20px; font-size: 0.85rem; @(activeTab == "usuarios" ? "" : "border-color: var(--border-glass); color: var(--text-secondary);")"
            @onclick='() => activeTab = "usuarios"'>
        👥 Usuarios del Sistema
    </button>
    <button class="@(activeTab == "auditoria" ? "btn-primary-glass" : "btn btn-sm btn-outline-secondary")"
            style="border-radius: 0 8px 8px 0; padding: 8px 20px; font-size: 0.85rem; @(activeTab == "auditoria" ? "" : "border-color: var(--border-glass); color: var(--text-secondary);")"
            @onclick="ActivarTabAuditoria">
        📋 Log de Auditoría
    </button>
</div>

@if (activeTab == "usuarios")
{
    <!-- ══════════════════════════════════════════════════════ -->
    <!-- TAB: USUARIOS                                        -->
    <!-- ══════════════════════════════════════════════════════ -->
    <div class="glass-card">
        <!-- Filtros de usuarios -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 pb-2" style="border-bottom: 1px solid var(--border-glass);">
            <div class="d-flex align-items-center gap-2">
                <span class="text-secondary" style="font-size: 0.82rem; font-weight: 600;">Estado:</span>
                <button class="btn btn-sm @(filtroEstadoUsuario == "activos" ? "btn-primary" : "btn-outline-secondary")"
                        style="border-radius: 6px; font-size: 0.78rem; padding: 3px 10px;"
                        @onclick='() => SetFiltroEstado("activos")'>
                    Activos
                </button>
                <button class="btn btn-sm @(filtroEstadoUsuario == "inactivos" ? "btn-primary" : "btn-outline-secondary")"
                        style="border-radius: 6px; font-size: 0.78rem; padding: 3px 10px;"
                        @onclick='() => SetFiltroEstado("inactivos")'>
                    Revocados / Inactivos
                </button>
                <button class="btn btn-sm @(filtroEstadoUsuario == "todos" ? "btn-primary" : "btn-outline-secondary")"
                        style="border-radius: 6px; font-size: 0.78rem; padding: 3px 10px;"
                        @onclick='() => SetFiltroEstado("todos")'>
                    Todos
                </button>
            </div>
            <div style="min-width: 200px;">
                <input type="text" class="form-control form-control-sm" placeholder="Buscar por alias, nombre o email..."
                       @bind="busquedaTexto" @bind:event="oninput"
                       style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); color: white; font-size: 0.82rem;" />
            </div>
        </div>

        @if (isLoading)
        {
            <p class="text-secondary">Cargando cuentas del personal...</p>
        }
        else if (FilteredUsers == null || !FilteredUsers.Any())
        {
            <p class="text-secondary">No se encontraron usuarios con el filtro seleccionado.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover" style="background: transparent;">
                    <thead>
                        <tr style="border-bottom: 2px solid var(--border-glass);">
                            <th>Usuario / Email</th>
                            <th>Nombre Completo</th>
                            <th>Rol Asignado</th>
                            <th>Sucursal</th>
                            <th>Estado</th>
                            <th>Último Acceso</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in FilteredUsers)
                        {
                            var rolColor = user.RolNombre.ToUpper() == "ADMIN" ? "badge bg-danger" : 
                                           user.RolNombre.ToUpper() == "GERENTE" ? "badge bg-primary" :
                                           user.RolNombre.ToUpper() == "VETERINARIO" ? "badge bg-success" : "badge bg-info";

                            <tr style="border-bottom: 1px solid var(--border-glass); opacity: @(user.Activo ? "1" : "0.65");">
                                <td>
                                    <strong>@user.NombreUsuario</strong>
                                    <br/><small class="text-secondary">@user.Email</small>
                                </td>
                                <td>@user.NombreCompleto</td>
                                <td>
                                    <span class="@rolColor">@user.RolNombre</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.SucursalNombre))
                                    {
                                        <span class="badge bg-secondary">@user.SucursalNombre</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary" style="font-size: 0.85rem;">Global</span>
                                    }
                                </td>
                                <td>
                                    @if (user.Activo)
                                    {
                                        <span class="badge bg-success" style="font-size: 0.72rem; font-weight: 500;">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger" style="font-size: 0.72rem; font-weight: 500;">Revocado</span>
                                    }
                                </td>
                                <td class="text-secondary">
                                    @if(user.UltimoLogin.HasValue) {
                                        <span>@user.UltimoLogin.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                    } else { 
                                        <span>Nunca</span> 
                                    }
                                </td>
                                <td class="text-end">
                                    @if (CanManageUser(user))
                                    {
                                        @if (user.Activo)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" style="font-size: 0.78rem;" @onclick="() => ConfirmarDelete(user)">Revocar Acceso</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-success" style="font-size: 0.78rem;" @onclick="() => RestaurarUser(user)">Restaurar Acceso</button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-secondary" style="font-size: 0.8rem;">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
else
{
    <!-- ══════════════════════════════════════════════════════ -->
    <!-- TAB: LOG DE AUDITORÍA                                -->
    <!-- ══════════════════════════════════════════════════════ -->
    <div class="glass-card">
        <div style="margin-bottom: 16px;">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h4 style="margin: 0;">Registro de Actividad del Sistema</h4>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm @(modoSimplificado ? "btn-info" : "btn-outline-secondary")"
                            style="font-size: 0.78rem; border-radius: 6px; padding: 4px 10px;"
                            @onclick="ToggleModoSimplificado">
                        @(modoSimplificado ? "👁️ Vista Simplificada (Activa)" : "⚙️ Vista Técnica (Activa)")
                    </button>
                </div>
            </div>

            <!-- Filtros -->
            <div class="d-flex flex-wrap align-items-end gap-3">
                <div style="min-width: 140px;">
                    <label class="text-secondary" style="font-size: 0.78rem; display: block; margin-bottom: 4px;">Desde</label>
                    <input type="date" @bind="filtroDesde" @bind:after="ApplyAuditFilters" class="form-control form-control-sm"
                           style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); color: white;" />
                </div>
                <div style="min-width: 140px;">
                    <label class="text-secondary" style="font-size: 0.78rem; display: block; margin-bottom: 4px;">Hasta</label>
                    <input type="date" @bind="filtroHasta" @bind:after="ApplyAuditFilters" class="form-control form-control-sm"
                           style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); color: white;" />
                </div>
                <div style="min-width: 140px;">
                    <label class="text-secondary" style="font-size: 0.78rem; display: block; margin-bottom: 4px;">Usuario</label>
                    <select @bind="filtroUsuario" @bind:after="ApplyAuditFilters" class="form-select form-select-sm"
                            style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); color: white;">
                        <option value="">Todos</option>
                        @foreach (var u in usuariosUnicos)
                        {
                            <option value="@u">@u</option>
                        }
                    </select>
                </div>
                <div style="min-width: 120px;">
                    <label class="text-secondary" style="font-size: 0.78rem; display: block; margin-bottom: 4px;">Acción</label>
                    <select @bind="filtroAccion" @bind:after="ApplyAuditFilters" class="form-select form-select-sm"
                            style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); color: white;">
                        <option value="">Todas</option>
                        <option value="POST">POST (Crear)</option>
                        <option value="PUT">PUT (Editar)</option>
                        <option value="DELETE">DELETE (Eliminar)</option>
                    </select>
                </div>
                <div style="min-width: 140px;">
                    <label class="text-secondary" style="font-size: 0.78rem; display: block; margin-bottom: 4px;">Entidad</label>
                    <select @bind="filtroEntidad" @bind:after="ApplyAuditFilters" class="form-select form-select-sm"
                            style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); color: white;">
                        <option value="">Todas</option>
                        @foreach (var e in entidadesUnicas)
                        {
                            <option value="@e">@e</option>
                        }
                    </select>
                </div>
                @if (HasActiveFilters())
                {
                    <button class="btn btn-sm btn-outline-secondary" style="height: 31px; border-color: var(--border-glass); color: var(--text-secondary);" @onclick="ClearAuditFilters">
                        Limpiar filtros
                    </button>
                }
            </div>
        </div>

        @if (isLoadingAudit)
        {
            <p class="text-secondary">Cargando registros de auditoría...</p>
        }
        else if (filteredAuditLogs == null || !filteredAuditLogs.Any())
        {
            <p class="text-secondary">No se encontraron registros con los filtros aplicados.</p>
        }
        else
        {
            <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                <table class="table table-dark table-hover" style="background: transparent; font-size: 0.82rem;">
                    <thead>
                        <tr style="border-bottom: 2px solid var(--border-glass); position: sticky; top: 0; background: var(--bg-card, rgba(17,24,39,0.95)); z-index: 1;">
                            <th style="width: 145px;">Fecha</th>
                            <th style="width: 120px;">Usuario</th>
                            <th style="width: 75px;">Acción</th>
                            <th style="width: 130px;">Entidad</th>
                            <th>Descripción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in filteredAuditLogs)
                        {
                            <tr style="border-bottom: 1px solid var(--border-glass);">
                                <td>@log.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <strong>@(log.NombreUsuario ?? "Anónimo")</strong>
                                </td>
                                <td>
                                    <span style="@GetAccionStyle(log.Accion); font-size: 0.75rem; padding: 2px 8px; border-radius: 6px;">@log.Accion</span>
                                </td>
                                <td>@log.Entidad</td>
                                <td>
                                    @if (modoSimplificado)
                                    {
                                        var friendly = GetFriendlyDescription(log);
                                        <span style="@friendly.Style">@friendly.Text</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary" style="max-width: 400px; display: inline-block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            @(log.Descripcion ?? "—")
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-2 text-secondary" style="font-size: 0.78rem;">
                Mostrando @filteredAuditLogs.Count de @allAuditLogs?.Count registros totales
            </div>
        }
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
        @errorMessage
    </div>
}

@code {
    private List<UsuarioDto>? usuarios = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string activeTab = "usuarios";
    private string filtroEstadoUsuario = "activos";
    private string busquedaTexto = string.Empty;

    private string currentUserRole = "Usuario";
    private int? currentUserSucursalId = null;
    private bool IsAdmin => currentUserRole.Equals("Admin", StringComparison.OrdinalIgnoreCase);
    private bool IsGerente => currentUserRole.Equals("Gerente", StringComparison.OrdinalIgnoreCase);

    // Audit log
    private List<AuditLogDto>? allAuditLogs;
    private List<AuditLogDto>? filteredAuditLogs;
    private bool isLoadingAudit;
    private bool auditLoaded;
    private bool modoSimplificado = false;

    // Audit filters
    private DateTime? filtroDesde;
    private DateTime? filtroHasta;
    private string filtroUsuario = string.Empty;
    private string filtroAccion = string.Empty;
    private string filtroEntidad = string.Empty;

    // Computed unique values for dropdowns
    private List<string> usuariosUnicos = new();
    private List<string> entidadesUnicas = new();

    private IEnumerable<UsuarioDto> FilteredUsers
    {
        get
        {
            if (usuarios == null) return Enumerable.Empty<UsuarioDto>();

            var q = usuarios.AsEnumerable();

            if (filtroEstadoUsuario == "activos")
                q = q.Where(u => u.Activo);
            else if (filtroEstadoUsuario == "inactivos")
                q = q.Where(u => !u.Activo);

            if (!string.IsNullOrWhiteSpace(busquedaTexto))
            {
                var t = busquedaTexto.Trim().ToLower();
                q = q.Where(u => (u.NombreUsuario != null && u.NombreUsuario.ToLower().Contains(t)) ||
                                 (u.NombreCompleto != null && u.NombreCompleto.ToLower().Contains(t)) ||
                                 (u.Email != null && u.Email.ToLower().Contains(t)) ||
                                 (u.RolNombre != null && u.RolNombre.ToLower().Contains(t)));
            }

            return q;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SyncTokenAsync();

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            currentUserRole = user.FindFirst(ClaimTypes.Role)?.Value ?? user.FindFirst("role")?.Value ?? "Usuario";
            var sucClaim = user.FindFirst("sucursalId")?.Value;
            currentUserSucursalId = int.TryParse(sucClaim, out var sId) ? sId : null;

            // Gerente default to simplified mode for friendly human readability
            if (IsGerente)
            {
                modoSimplificado = true;
            }

            await LoadDataAsync();
            StateHasChanged();
        }
    }

    private async Task SyncTokenAsync()
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrWhiteSpace(token))
                TokenStorage.SetToken(token);
        }
        catch { }
    }

    private void SetFiltroEstado(string estado)
    {
        filtroEstadoUsuario = estado;
    }

    private void ToggleModoSimplificado()
    {
        modoSimplificado = !modoSimplificado;
    }

    private bool CanManageUser(UsuarioDto target)
    {
        if (target.NombreUsuario.Equals("admin", StringComparison.OrdinalIgnoreCase))
            return false;

        if (IsAdmin)
            return true;

        if (IsGerente)
        {
            var r = target.RolNombre ?? "";
            var isManageableRole = r.Equals("Veterinario", StringComparison.OrdinalIgnoreCase) ||
                                  r.Equals("Recepcionista", StringComparison.OrdinalIgnoreCase);

            if (!isManageableRole) return false;

            if (currentUserSucursalId.HasValue && target.SucursalId.HasValue && target.SucursalId != currentUserSucursalId)
                return false;

            return true;
        }

        return false;
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            usuarios = await UsuarioService.GetAllUsersAsync(incluirInactivos: true);
        }
        catch (Exception)
        {
            errorMessage = "No se pudieron cargar los usuarios. Verifica tus permisos de acceso.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ActivarTabAuditoria()
    {
        activeTab = "auditoria";
        if (!auditLoaded)
        {
            await LoadAuditLogs();
        }
    }

    private async Task LoadAuditLogs()
    {
        isLoadingAudit = true;
        try
        {
            allAuditLogs = await UsuarioService.GetAllAuditLogsAsync(200);

            // Build unique values for filter dropdowns
            if (allAuditLogs != null)
            {
                usuariosUnicos = allAuditLogs
                    .Where(l => !string.IsNullOrEmpty(l.NombreUsuario) && l.NombreUsuario != "Anónimo")
                    .Select(l => l.NombreUsuario!)
                    .Distinct()
                    .OrderBy(u => u)
                    .ToList();

                entidadesUnicas = allAuditLogs
                    .Where(l => !string.IsNullOrEmpty(l.Entidad))
                    .Select(l => l.Entidad)
                    .Distinct()
                    .OrderBy(e => e)
                    .ToList();
            }

            ApplyAuditFilters();
            auditLoaded = true;
        }
        catch
        {
            errorMessage = "Error al cargar los registros de auditoría.";
        }
        finally
        {
            isLoadingAudit = false;
        }
    }

    private void ApplyAuditFilters()
    {
        if (allAuditLogs == null)
        {
            filteredAuditLogs = null;
            return;
        }

        IEnumerable<AuditLogDto> items = allAuditLogs;

        if (filtroDesde.HasValue)
            items = items.Where(l => l.Fecha.Date >= filtroDesde.Value.Date);
        if (filtroHasta.HasValue)
            items = items.Where(l => l.Fecha.Date <= filtroHasta.Value.Date);

        if (!string.IsNullOrEmpty(filtroUsuario))
            items = items.Where(l => l.NombreUsuario == filtroUsuario);

        if (!string.IsNullOrEmpty(filtroAccion))
            items = items.Where(l => l.Accion == filtroAccion);

        if (!string.IsNullOrEmpty(filtroEntidad))
            items = items.Where(l => l.Entidad == filtroEntidad);

        filteredAuditLogs = items.OrderByDescending(l => l.Fecha).ToList();
    }

    private bool HasActiveFilters() =>
        filtroDesde.HasValue || filtroHasta.HasValue ||
        !string.IsNullOrEmpty(filtroUsuario) || !string.IsNullOrEmpty(filtroAccion) ||
        !string.IsNullOrEmpty(filtroEntidad);

    private void ClearAuditFilters()
    {
        filtroDesde = null;
        filtroHasta = null;
        filtroUsuario = string.Empty;
        filtroAccion = string.Empty;
        filtroEntidad = string.Empty;
        ApplyAuditFilters();
    }

    private async Task ConfirmarDelete(UsuarioDto user)
    {
        if (user.NombreUsuario.Equals("admin", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "No se puede eliminar la cuenta de Super-Administrador del sistema.";
            return;
        }

        var res = await UsuarioService.DeleteUserAsync(user.Id);
        if (res)
        {
            await LoadDataAsync();
        }
        else
        {
            errorMessage = "Hubo un error al intentar revocar el acceso del usuario.";
        }
    }

    private async Task RestaurarUser(UsuarioDto user)
    {
        var res = await UsuarioService.RestoreUserAsync(user.Id);
        if (res)
        {
            await LoadDataAsync();
        }
        else
        {
            errorMessage = "Hubo un error al intentar restaurar el acceso del usuario.";
        }
    }

    private string GetAccionStyle(string accion) => accion?.ToUpper() switch
    {
        "POST" => "background: rgba(34,197,94,0.15); color: #22c55e; font-weight: 600;",
        "PUT" => "background: rgba(245,158,11,0.15); color: #f59e0b; font-weight: 600;",
        "DELETE" => "background: rgba(239,68,68,0.15); color: var(--accent-danger); font-weight: 600;",
        _ => "color: var(--text-secondary);"
    };

    // ═══════════════════════════════════════════
    // Traducción de audit logs a lenguaje natural (Modo Simplificado)
    // ═══════════════════════════════════════════

    private record FriendlyLog(string Text, string Style);

    private static readonly Dictionary<string, string> EntityNames = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Paciente"] = "paciente",
        ["Propietario"] = "propietario",
        ["Turno"] = "turno",
        ["Tratamiento"] = "tratamiento",
        ["RegistroVacunacion"] = "registro de vacunación",
        ["Venta"] = "venta",
        ["Producto"] = "producto",
        ["Especie"] = "especie",
        ["Raza"] = "raza",
        ["Categoria"] = "categoría",
        ["Marca"] = "marca",
        ["Proveedor"] = "proveedor",
        ["Deposito"] = "depósito",
        ["Servicio"] = "servicio",
        ["Veterinario"] = "veterinario",
        ["HistorialClinico"] = "historial clínico",
        ["Configuracion"] = "configuración",
        ["Notificacion"] = "notificación",
        ["auth"] = "sesión / usuario",
        ["Usuario"] = "usuario",
        ["Audit"] = "auditoría",
        ["Paginacion"] = "consulta",
    };

    private FriendlyLog GetFriendlyDescription(AuditLogDto log)
    {
        var desc = log.Descripcion ?? "";
        var entity = log.Entidad ?? "";
        var action = log.Accion?.ToUpper() ?? "";

        var entityFriendly = EntityNames.GetValueOrDefault(entity, entity.ToLower());
        var subAction = ExtractSubAction(desc);

        string text;
        string style;

        if (action == "POST")
        {
            style = "color: #22c55e;";
            text = subAction switch
            {
                "login" => "Inició sesión en el sistema",
                "register" => "Registró un nuevo usuario",
                "seed" => "Ejecutó la carga inicial de datos",
                "entrada" => $"Registró una entrada de stock de {entityFriendly}",
                "salida" => $"Registró una salida de stock de {entityFriendly}",
                "facturar" => $"Facturó una {entityFriendly}",
                "generar" => "Generó notificaciones automáticas",
                "completo" => "Ejecutó la carga completa de datos",
                _ => $"Registró un/a {entityFriendly}"
            };
        }
        else if (action == "PUT")
        {
            style = "color: #f59e0b;";
            text = subAction switch
            {
                "restaurar" => $"Restauró el acceso a un/a {entityFriendly}",
                "completar" => $"Marcó un {entityFriendly} como completado",
                "cancelar" => $"Canceló un {entityFriendly}",
                "reprogramar" => $"Reprogramó un {entityFriendly}",
                "confirmar" => $"Confirmó un {entityFriendly}",
                "encurso" => $"Marcó un {entityFriendly} como en curso",
                "finalizar" => $"Finalizó un {entityFriendly}",
                "ausente" => $"Marcó ausente en un {entityFriendly}",
                "anular" => $"Anuló una {entityFriendly}",
                "leer" => "Leyó una notificación",
                "cambiarPassword" => "Cambió su contraseña",
                "cambiarPropietario" => $"Cambió el propietario de un {entityFriendly}",
                "perfil" => "Actualizó su perfil",
                "foto" => "Actualizó su foto de perfil",
                "veterinario" => "Actualizó datos de veterinario",
                _ => $"Modificó un/a {entityFriendly}"
            };
        }
        else if (action == "DELETE")
        {
            style = "color: var(--accent-danger);";
            text = subAction switch
            {
                "limpiar" => "Limpió la caché del sistema",
                "reset" => "Reinició métricas de rendimiento",
                _ => $"Revocó/Eliminó un/a {entityFriendly}"
            };
        }
        else
        {
            style = "color: var(--text-secondary);";
            text = desc;
        }

        return new FriendlyLog(text, style);
    }

    private static string ExtractSubAction(string descripcion)
    {
        if (string.IsNullOrEmpty(descripcion)) return "";

        var parts = descripcion.Split(' ', 2);
        var path = parts.Length > 1 ? parts[1] : parts[0];
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (segments.Length >= 5)
        {
            var last = segments[^1];
            if (!Guid.TryParse(last, out _) && !last.All(c => char.IsDigit(c)))
                return last;
        }
        if (segments.Length >= 4)
        {
            var last = segments[^1];
            if (!Guid.TryParse(last, out _) && !last.All(c => char.IsDigit(c)))
                return last;
        }

        return "";
    }
}
