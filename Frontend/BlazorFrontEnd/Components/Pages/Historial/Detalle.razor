    private string GetEdadPaciente(DateTime? fechaNacimiento)
    {
        if (!fechaNacimiento.HasValue) return "Desconocida";
        var nacimiento = fechaNacimiento.Value.Date;
        var hoy = DateTime.Today;

        if (nacimiento > hoy) return "0 días";

        int años = hoy.Year - nacimiento.Year;
        int meses = hoy.Month - nacimiento.Month;
        int dias = hoy.Day - nacimiento.Day;

        if (dias < 0)
        {
            meses--;
            var prevMonth = hoy.AddMonths(-1);
            dias += DateTime.DaysInMonth(prevMonth.Year, prevMonth.Month);
        }

        if (meses < 0)
        {
            años--;
            meses += 12;
        }

        if (años > 0)
        {
            if (meses > 0)
                return $"{años} {(años == 1 ? "año" : "años")} y {meses} {(meses == 1 ? "mes" : "meses")}";
            return $"{años} {(años == 1 ? "año" : "años")}";
        }
        else if (meses > 0)
        {
            if (dias > 0)
                return $"{meses} {(meses == 1 ? "mes" : "meses")} y {dias} {(dias == 1 ? "día" : "días")}";
            return $"{meses} {(meses == 1 ? "mes" : "meses")}";
        }
        else
        {
            return $"{dias} {(dias == 1 ? "día" : "días")}";
        }
    }

    private bool IsImageFile(string? nombre, string? contentType)
    {
        if (!string.IsNullOrEmpty(contentType) && contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            return true;
        if (string.IsNullOrEmpty(nombre)) return false;
        var ext = System.IO.Path.GetExtension(nombre).ToLowerInvariant();
        return ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif" || ext == ".webp" || ext == ".bmp";
    }

