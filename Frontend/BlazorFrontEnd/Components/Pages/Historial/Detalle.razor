    private bool isSendingVaccineTwilio = false;
    private string? vaccineTwilioMsg = null;
    private bool vaccineTwilioSuccess = false;

    private async Task SendVaccineReminderTwilio()
    {
        if (propietario == null || string.IsNullOrWhiteSpace(propietario.Telefono) || paciente == null) return;
        isSendingVaccineTwilio = true;
        vaccineTwilioMsg = null;
        try
        {
            var msg = $"Hola {propietario.Nombre}, te contactamos de Veterinaria Ñandubay. Queríamos recordarte que {paciente.Nombre} tiene una vacuna pendiente de aplicación. Por favor, coordiná un turno a la brevedad.";
            var res = await WhatsAppService.SendWhatsAppAsync(propietario.Telefono, msg);
            vaccineTwilioSuccess = res.Success;
            vaccineTwilioMsg = res.Success 
                ? "✅ Recordatorio enviado exitosamente vía Twilio WhatsApp." 
                : $"❌ {res.Message}";
        }
        catch (Exception ex)
        {
            vaccineTwilioSuccess = false;
            vaccineTwilioMsg = $"❌ Error: {ex.Message}";
        }
        finally
        {
            isSendingVaccineTwilio = false;
        }
    }

    private string FormatWhatsApp(string telefono)
    {
        if (string.IsNullOrEmpty(telefono)) return string.Empty;
        var clean = new string(telefono.Where(char.IsDigit).ToArray());
        return clean;
    }

    private async Task UploadModalConsultaFiles(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(10))
        {
            try
            {
                var maxAllowedSize = 5 * 1024 * 1024;
                using var stream = file.OpenReadStream(maxAllowedSize);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                
                modalConsultaFilesList.Add(new Adjunto
                {
                    Nombre = file.Name,
