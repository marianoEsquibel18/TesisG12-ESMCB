                    <ValidationMessage For="@(() => tratamientoModel.Diagnostico)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Descripción (*)</label>
                    <InputTextArea @bind-Value="tratamientoModel.Descripcion" class="form-control bg-dark text-light border-secondary" rows="2" placeholder="Ej: Limpieza ótica + aplicación tópica..." />
                    <ValidationMessage For="@(() => tratamientoModel.Descripcion)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Medicación Recetada</label>
                    <InputTextArea @bind-Value="tratamientoModel.Medicacion" class="form-control bg-dark text-light border-secondary" rows="3" placeholder="Ej: Amoxicilina 500mg cada 12hs por 7 días..." />
                    <ValidationMessage For="@(() => tratamientoModel.Medicacion)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Observaciones</label>
                    <InputTextArea @bind-Value="tratamientoModel.Observaciones" class="form-control bg-dark text-light border-secondary" rows="2" />
                    <ValidationMessage For="@(() => tratamientoModel.Observaciones)" class="text-danger" />
                </div>

                <!-- Archivos Adjuntos (Clip Icon + File Selection + List) -->
                <div class="mb-3">
                    <label class="d-flex align-items-center gap-2" style="color: var(--text-secondary); font-size: 0.875rem;">
                        <span>Archivos Adjuntos (Imágenes, Videos, PDFs)</span>
                        <label for="modal-tratamiento-attachments" class="btn btn-sm btn-outline-info d-inline-flex align-items-center gap-1 py-1 px-2 m-0" style="cursor: pointer; font-size: 0.78rem; border-color: var(--border-glass); background: rgba(0, 163, 108, 0.05); color: var(--accent-primary);">
                            <i class="bi bi-paperclip"></i> Adjuntar
                        </label>
                        <InputFile id="modal-tratamiento-attachments" OnChange="UploadModalTratamientoFiles" multiple style="display: none;" />
                    </label>
                    
                    @if (modalTratamientoFilesList != null && modalTratamientoFilesList.Any())
                    {
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            @foreach (var file in modalTratamientoFilesList)
                            {
                                <div class="d-flex align-items-center gap-2 p-1 px-2 rounded" style="background: rgba(0, 163, 108, 0.1); border: 1px solid var(--accent-primary); font-size: 0.8rem;">
                                    <span class="text-truncate" style="max-width: 150px; color: var(--text-primary);" title="@file.Nombre">@file.Nombre</span>
                                    <button type="button" class="btn p-0 text-primary border-0" style="box-shadow: none;" @onclick="() => PreviewFile(file)" title="Ver/Descargar">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button type="button" class="btn p-0 text-danger border-0" style="box-shadow: none;" @onclick="() => RemoveModalTratamientoFile(file)" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="mb-3 form-check" style="margin-top: 20px;">
                    <InputCheckbox @bind-Value="tratamientoModel.Finalizado" class="form-check-input bg-dark border-secondary" id="chkFinalizado" />
                    <label class="form-check-label text-light" for="chkFinalizado">Marcar como Finalizado / Alta médica</label>
                </div>

                @if (!string.IsNullOrEmpty(tratamientoErrorMessage))
                {
                    <div class="alert alert-danger p-2 mt-2" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">@tratamientoErrorMessage</div>
                }

                <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                    <button type="button" class="btn btn-outline-secondary text-light" @onclick="CloseTratamientoModal">Cancelar</button>
                    <button type="submit" class="btn-primary-glass" disabled="@isSavingTratamiento">
                        @if(isSavingTratamiento) { <span>Guardando...</span> } else { <span>Guardar</span> }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public string PacienteId { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "tab")]
    public string? QueryTab { get; set; }

    private bool isLoading = true;
    private PacienteDto? paciente;
    private PropietarioDto? propietario;
    private string activeTab = "consultas"; // consultas | vacunas | tratamientos

    private List<HistorialClinicoDto> consultas = new();
    private List<RegistroVacunacionDto> vacunas = new();
    private List<TratamientoDto> tratamientos = new();

    private HashSet<string> expandedConsultas = new();

    private List<VeterinarioDto> vets = new();
    private List<VacunaDto> catalogoVacunas = new();
    private List<ProductoDto> productosVacunas = new();
    private string selectedProductoId = "";
    private int? selectedDepositoId;
    private ProductoDto? selectedProducto => productosVacunas.FirstOrDefault(p => p.Id == selectedProductoId);

    // Consulta Modal States
    private bool showConsultaModal;
    private HistorialClinicoDto consultaModel = new();
    private bool isSavingConsulta;
    private string consultaErrorMessage = string.Empty;

    // Vacuna Modal States
    private bool showVacunaModal;
    private RegistroVacunacionDto vacunaModel = new();
    private bool isSavingVacuna;
    private string vacunaErrorMessage = string.Empty;

    // Tratamiento Modal States
    private bool showTratamientoModal;
    private TratamientoDto tratamientoModel = new();
    private bool isSavingTratamiento;
    private string tratamientoErrorMessage = string.Empty;

    private List<Adjunto> modalConsultaFilesList = new();
    private List<Adjunto> modalTratamientoFilesList = new();

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(QueryTab))
        {
            activeTab = QueryTab;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        
        // Cargar paciente
        paciente = await PacienteService.GetByIdAsync(PacienteId);
        
        if (paciente != null)
        {
            // Cargar toda la historia en paralelo por performance
            var clTask = HistorialService.GetByPacienteIdAsync(PacienteId);
            var vcTask = VacunacionService.GetByPacienteIdAsync(PacienteId);
            var trTask = TratamientoService.GetByPacienteIdAsync(PacienteId);
            var prTask = PropietarioService.GetByIdAsync(paciente.PropietarioId);
            var vtTask = PersonalService.GetVeterinariosActivosAsync();
            var vaTask = VacunacionService.GetCatalogoVacunasAsync();
            var prodTask = ProductoService.GetAllAsync(1, 1000);

            await Task.WhenAll(clTask, vcTask, trTask, prTask, vtTask, vaTask, prodTask);

            consultas = clTask.Result ?? new();
            vacunas = vcTask.Result ?? new();
            tratamientos = trTask.Result ?? new();
            propietario = prTask.Result;
            vets = vtTask.Result ?? new();
            
            var vacs = vaTask.Result;
            if (vacs != null)
            {
                catalogoVacunas = vacs.Where(v => v.Activo).ToList();
            }

            if (prodTask.Result?.Items != null)
            {
                productosVacunas = prodTask.Result.Items
                    .Where(p => p.Activo && (
                        (!string.IsNullOrEmpty(p.CategoriaNombre) && p.CategoriaNombre.Contains("Vacuna", StringComparison.OrdinalIgnoreCase)) ||
                        p.Nombre.Contains("Vacuna", StringComparison.OrdinalIgnoreCase)
                    ))
                    .ToList();
            }
        }

        isLoading = false;
    }

    private void SetTab(string tab) => activeTab = tab;
    private void GoBack() => Navigation.NavigateTo("/historial-clinico");

    private void ToggleConsulta(string id)
    {
        if (expandedConsultas.Contains(id))
            expandedConsultas.Remove(id);
        else
            expandedConsultas.Add(id);
    }

    // Modal Consultation Handlers
    private void NuevaConsulta()
    {
        consultaModel = new HistorialClinicoDto
        {
            PacienteId = PacienteId,
            PacienteNombre = paciente?.Nombre ?? string.Empty,
            Fecha = DateTime.Today
        };
        modalConsultaFilesList = new List<Adjunto>();
        consultaErrorMessage = string.Empty;
        isSavingConsulta = false;
        showConsultaModal = true;
    }

    private async Task EditarConsulta(string consultaId)
    {
        consultaErrorMessage = string.Empty;
        isSavingConsulta = false;
        showConsultaModal = true;
        try
        {
            var existing = await HistorialService.GetByIdAsync(consultaId);
            if (existing != null)
            {
                consultaModel = new HistorialClinicoDto
                {
                    Id = existing.Id,
                    PacienteId = existing.PacienteId,
                    PacienteNombre = existing.PacienteNombre,
                    Fecha = existing.Fecha,
                    Motivo = existing.Motivo,
                    Sintomas = existing.Sintomas,
                    Diagnostico = existing.Diagnostico,
                    Indicaciones = existing.Indicaciones,
                    Veterinario = existing.Veterinario,
                    Peso = existing.Peso,
                    Temperatura = existing.Temperatura,
                    Observaciones = existing.Observaciones
                };
                try
                {
                    modalConsultaFilesList = string.IsNullOrEmpty(existing.ArchivosAdjuntos)
                        ? new List<Adjunto>()
                        : System.Text.Json.JsonSerializer.Deserialize<List<Adjunto>>(existing.ArchivosAdjuntos) ?? new List<Adjunto>();
                }
                catch
                {
                    modalConsultaFilesList = new List<Adjunto>();
                }
            }
            else
            {
                consultaErrorMessage = "No se encontró la consulta a editar.";
            }
        }
        catch (Exception ex)
        {
            consultaErrorMessage = $"Error de conexión: {ex.Message}";
        }
    }

    private void CloseConsultaModal()
    {
        showConsultaModal = false;
    }

    private async Task HandleSaveConsulta()
    {
        if (consultaModel.Fecha == null)
        {
            consultaErrorMessage = "La fecha es obligatoria";
            return;
        }
        if (consultaModel.Fecha.Value.Date > DateTime.Today)
        {
            consultaErrorMessage = "Las consultas ya deben haber sido realizadas (no puede ser fecha futura)";
            return;
        }
        if (string.IsNullOrWhiteSpace(consultaModel.Veterinario))
        {
            consultaErrorMessage = "Seleccionar un veterinario es obligatorio";
            return;
        }
        if (consultaModel.Peso == null)
        {
            consultaErrorMessage = "Ingresar el peso de la mascota es obligatorio";
            return;
        }
        if (consultaModel.Peso < 0)
        {
            consultaErrorMessage = "No se puede ingresar un peso negativo";
            return;
        }
        if (string.IsNullOrWhiteSpace(consultaModel.Motivo))
        {
            consultaErrorMessage = "El motivo de consulta es obligatorio";
            return;
        }
        if (string.IsNullOrWhiteSpace(consultaModel.Sintomas))
        {
            consultaErrorMessage = "Los síntomas reportados son obligatorios";
            return;
        }
        if (string.IsNullOrWhiteSpace(consultaModel.Diagnostico))
        {
            consultaErrorMessage = "El diagnóstico es obligatorio";
            return;
        }
        if (string.IsNullOrWhiteSpace(consultaModel.Indicaciones))
        {
            consultaErrorMessage = "Las indicaciones al propietario son obligatorias";
            return;
        }

        isSavingConsulta = true;
        consultaErrorMessage = string.Empty;
        try
        {
            consultaModel.ArchivosAdjuntos = System.Text.Json.JsonSerializer.Serialize(modalConsultaFilesList);
            bool success;
            if (string.IsNullOrEmpty(consultaModel.Id))
            {
                success = await HistorialService.CreateAsync(consultaModel);
            }
            else
            {
                success = await HistorialService.UpdateAsync(consultaModel.Id, consultaModel);
            }

            if (success)
            {
                showConsultaModal = false;
                consultas = await HistorialService.GetByPacienteIdAsync(PacienteId) ?? new();
                StateHasChanged();
            }
            else
            {
                consultaErrorMessage = "Error al intentar guardar la consulta.";
            }
        }
        catch (Exception ex)
        {
            consultaErrorMessage = $"Ocurrió una excepción: {ex.Message}";
        }
        finally
        {
            isSavingConsulta = false;
        }
    }

    // Modal Vaccination Handlers
    private void NuevaVacuna()
    {
        vacunaModel = new RegistroVacunacionDto
        {
            PacienteId = PacienteId,
            PacienteNombre = paciente?.Nombre ?? string.Empty,
            FechaAplicacion = DateTime.Today
        };
        selectedProductoId = "";
        selectedDepositoId = null;
        vacunaErrorMessage = string.Empty;
        isSavingVacuna = false;
        showVacunaModal = true;
    }

    private void OnVacunaProductoSelected()
    {
        if (selectedProducto != null)
        {
            if (selectedProducto.StocksDepositos != null && selectedProducto.StocksDepositos.Count(s => s.StockActual > 0) == 1)
            {
                selectedDepositoId = selectedProducto.StocksDepositos.First(s => s.StockActual > 0).DepositoId;
            }
            else
            {
                selectedDepositoId = null;
            }
        }
    }

    private async Task EditarVacuna(string registroId)
    {
        vacunaErrorMessage = string.Empty;
        isSavingVacuna = false;
        showVacunaModal = true;
        try
        {
            var existing = await VacunacionService.GetByIdAsync(registroId);
            if (existing != null)
            {
                vacunaModel = new RegistroVacunacionDto
                {
                    Id = existing.Id,
                    PacienteId = existing.PacienteId,
                    PacienteNombre = existing.PacienteNombre,
                    VacunaId = existing.VacunaId,
                    ProductoId = existing.ProductoId,
                    DepositoId = existing.DepositoId,
                    VacunaNombre = existing.VacunaNombre,
                    FechaAplicacion = existing.FechaAplicacion,
                    FechaProximaDosis = existing.FechaProximaDosis,
                    Veterinario = existing.Veterinario,
                    NroLote = existing.NroLote,
                    Observaciones = existing.Observaciones
                };
                selectedProductoId = existing.ProductoId ?? "";
                selectedDepositoId = existing.DepositoId;
            }
            else
            {
                vacunaErrorMessage = "No se encontró el registro de vacunación a editar.";
            }
        }
        catch (Exception ex)
        {
            vacunaErrorMessage = $"Error de conexión: {ex.Message}";
        }
    }

    private void CloseVacunaModal()
    {
        showVacunaModal = false;
    }

    private async Task HandleSaveVacuna()
    {
        if (string.IsNullOrWhiteSpace(selectedProductoId) && vacunaModel.VacunaId == 0)
        {
            vacunaErrorMessage = "Debe seleccionar una vacuna del inventario.";
            return;
        }
        if (string.IsNullOrWhiteSpace(vacunaModel.Veterinario))
        {
            vacunaErrorMessage = "Debe seleccionar un veterinario.";
            return;
        }

        var selectedProd = productosVacunas.FirstOrDefault(p => p.Id == selectedProductoId);
        if (selectedProd != null && string.IsNullOrEmpty(vacunaModel.Id) && selectedProd.StockActual <= 0)
        {
            vacunaErrorMessage = $"No hay stock disponible para la vacuna '{selectedProd.Nombre}'.";
            return;
        }

        vacunaModel.ProductoId = selectedProductoId;
        vacunaModel.DepositoId = selectedDepositoId;
        if (selectedProd != null)
        {
            vacunaModel.VacunaNombre = selectedProd.Nombre;
        }

        isSavingVacuna = true;
        vacunaErrorMessage = string.Empty;
        try
        {
            bool success;
            if (string.IsNullOrEmpty(vacunaModel.Id))
            {
                success = await VacunacionService.CreateAsync(vacunaModel);
            }
            else
            {
                success = await VacunacionService.UpdateAsync(vacunaModel.Id, vacunaModel);
            }

            if (success)
            {
                showVacunaModal = false;
                vacunas = await VacunacionService.GetByPacienteIdAsync(PacienteId) ?? new();
                
                // Actualizar stock local de productos de vacunas
                var prodTask = await ProductoService.GetAllAsync(1, 1000);
                if (prodTask?.Items != null)
                {
                    productosVacunas = prodTask.Items
                        .Where(p => p.Activo && (
                            (!string.IsNullOrEmpty(p.CategoriaNombre) && p.CategoriaNombre.Contains("Vacuna", StringComparison.OrdinalIgnoreCase)) ||
                            p.Nombre.Contains("Vacuna", StringComparison.OrdinalIgnoreCase)
                        ))
                        .ToList();
                }
                
                StateHasChanged();
            }
            else
            {
                vacunaErrorMessage = "Error al intentar guardar el registro de vacunación. Verifique el stock disponible.";
            }
        }
        catch (Exception ex)
        {
            vacunaErrorMessage = $"Ocurrió una excepción: {ex.Message}";
        }
        finally
        {
            isSavingVacuna = false;
        }
    }

    // Modal Treatment Handlers
    private void NuevoTratamiento()
    {
        tratamientoModel = new TratamientoDto
        {
            PacienteId = PacienteId,
            PacienteNombre = paciente?.Nombre ?? string.Empty,
            Fecha = DateTime.Today
        };
        modalTratamientoFilesList = new List<Adjunto>();
        tratamientoErrorMessage = string.Empty;
        isSavingTratamiento = false;
        showTratamientoModal = true;
    }

    private async Task EditarTratamiento(string tratamientoId)
    {
        tratamientoErrorMessage = string.Empty;
        isSavingTratamiento = false;
        showTratamientoModal = true;
        try
        {
            var existing = await TratamientoService.GetByIdAsync(tratamientoId);
            if (existing != null)
            {
                tratamientoModel = new TratamientoDto
                {
                    Id = existing.Id,
                    PacienteId = existing.PacienteId,
                    PacienteNombre = existing.PacienteNombre,
                    Fecha = existing.Fecha,
                    Diagnostico = existing.Diagnostico,
                    Descripcion = existing.Descripcion,
                    Medicacion = existing.Medicacion,
                    Veterinario = existing.Veterinario,
                    Observaciones = existing.Observaciones,
                    Finalizado = existing.Finalizado
                };
                try
                {
                    modalTratamientoFilesList = string.IsNullOrEmpty(existing.ArchivosAdjuntos)
                        ? new List<Adjunto>()
                        : System.Text.Json.JsonSerializer.Deserialize<List<Adjunto>>(existing.ArchivosAdjuntos) ?? new List<Adjunto>();
                }
                catch
                {
                    modalTratamientoFilesList = new List<Adjunto>();
                }
            }
            else
            {
                tratamientoErrorMessage = "No se encontró el tratamiento a editar.";
            }
        }
        catch (Exception ex)
        {
            tratamientoErrorMessage = $"Error de conexión: {ex.Message}";
        }
    }

    private void CloseTratamientoModal()
    {
        showTratamientoModal = false;
    }

    private async Task HandleSaveTratamiento()
    {
        if (string.IsNullOrEmpty(tratamientoModel.Diagnostico))
        {
            tratamientoErrorMessage = "El campo Diagnóstico es requerido.";
            return;
        }
        if (string.IsNullOrEmpty(tratamientoModel.Descripcion))
        {
            tratamientoErrorMessage = "El campo Descripción es requerido.";
            return;
        }
        if (string.IsNullOrEmpty(tratamientoModel.Veterinario))
        {
            tratamientoErrorMessage = "Debe seleccionar un veterinario.";
            return;
        }

        isSavingTratamiento = true;
        tratamientoErrorMessage = string.Empty;
        try
        {
            tratamientoModel.ArchivosAdjuntos = System.Text.Json.JsonSerializer.Serialize(modalTratamientoFilesList);
            bool success;
            if (string.IsNullOrEmpty(tratamientoModel.Id))
            {
                success = await TratamientoService.CreateAsync(tratamientoModel);
            }
            else
            {
                success = await TratamientoService.UpdateAsync(tratamientoModel.Id, tratamientoModel);
            }

            if (success)
            {
                showTratamientoModal = false;
                tratamientos = await TratamientoService.GetByPacienteIdAsync(PacienteId) ?? new();
                StateHasChanged();
            }
            else
            {
                tratamientoErrorMessage = "Error al intentar guardar el tratamiento.";
            }
        }
        catch (Exception ex)
        {
            tratamientoErrorMessage = $"Ocurrió una excepción: {ex.Message}";
        }
        finally
        {
            isSavingTratamiento = false;
        }
    }

    private async Task FinalizarTratamiento(string tratamientoId)
    {
        if (await TratamientoService.FinalizarAsync(tratamientoId))
        {
            // Recargar tratamientos para reflejar el cambio
            tratamientos = await TratamientoService.GetByPacienteIdAsync(PacienteId) ?? new();
            StateHasChanged();
        }
    }

    private string FormatWhatsApp(string telefono)
    {
        if (string.IsNullOrEmpty(telefono)) return string.Empty;
        var clean = new string(telefono.Where(char.IsDigit).ToArray());
        return clean;
    }

    private async Task UploadModalConsultaFiles(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(10))
        {
            try
            {
                var maxAllowedSize = 5 * 1024 * 1024;
                using var stream = file.OpenReadStream(maxAllowedSize);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                
                modalConsultaFilesList.Add(new Adjunto
                {
                    Nombre = file.Name,
                    Base64 = base64,
                    ContentType = file.ContentType
                });
            }
            catch (Exception ex)
            {
                consultaErrorMessage = $"Error al cargar archivo {file.Name}: {ex.Message}";
            }
        }
    }

    private void RemoveModalConsultaFile(Adjunto file)
    {
        modalConsultaFilesList.Remove(file);
    }

