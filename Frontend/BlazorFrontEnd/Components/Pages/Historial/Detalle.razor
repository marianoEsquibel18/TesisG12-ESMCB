@page "/historial-clinico/paciente/{PacienteId}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Veterinario")]
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@inject PacienteService PacienteService
@inject HistorialClinicoService HistorialService
@inject VacunacionService VacunacionService
@inject TratamientoService TratamientoService
@inject PersonalService PersonalService
@inject NavigationManager Navigation
@inject PropietarioService PropietarioService
@inject ProductoService ProductoService
@inject WhatsAppService WhatsAppService
@inject IJSRuntime JS

<PageTitle>Historia Clínica: @(paciente?.Nombre ?? "Cargando...")</PageTitle>

@if (isLoading)
{
    <p class="text-secondary">Cargando ficha médica...</p>
}
else if (paciente == null)
{
    <p class="text-secondary">Paciente no encontrado.</p>
}
else
{
    <div class="d-flex align-items-center" style="margin-bottom: var(--sp-lg); gap: 15px;">
        <button class="btn btn-link" style="color: var(--text-secondary); padding: 0;" @onclick="GoBack">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 24px; height: 24px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
        </button>
        @if (!string.IsNullOrEmpty(paciente.FotoUrl))
        {
            <img src="@paciente.FotoUrl" style="width: 60px; height: 60px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent-primary);" />
        }
        else
        {
            <div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(255,255,255,0.08); border: 2px solid var(--border-glass); display: flex; align-items: center; justify-content: center;">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" style="width: 28px; height: 28px; color: var(--accent-primary);">
                    <path d="M8.5 3a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Zm7 0a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM4.5 7.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Zm15 0a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM12 9.5c-3.5 0-6 2.5-6 5.5 0 2.5 2 4.5 4.5 4.5.8 0 1.2-.5 1.5-.5s.7.5 1.5.5c2.5 0 4.5-2 4.5-4.5 0-3-2.5-5.5-6-5.5Z"/>
                </svg>
            </div>
        }
        <div>
            <h2 style="font-weight: 700; margin: 0;">Historia Clínica</h2>
            <p class="text-secondary" style="margin: 0;">Paciente: <strong class="text-primary">@paciente.Nombre</strong> (@paciente.EspecieNombre / @paciente.RazaNombre)</p>
        </div>
    </div>

    @* Card Información del Paciente *@
    <div class="glass-card mb-3 p-3" style="border: 1px solid var(--border-glass); background: rgba(255,255,255,0.02); border-radius: 8px;">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom" style="border-color: var(--border-glass) !important;">
            <div class="d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 20px; height: 20px; color: var(--accent-primary);">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                </svg>
                <h5 class="m-0" style="font-weight: 700; color: var(--text-primary);">Información del Paciente</h5>
                @if (paciente != null && paciente.ContadorInasistencias > 0)
                {
                    <span class="badge bg-danger" style="font-size: 0.8rem; padding: 4px 8px;" title="Inasistencias a turnos registradas">
                        ⚠️ @paciente.ContadorInasistencias @(paciente.ContadorInasistencias == 1 ? "ausencia" : "ausencias")
                    </span>
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-info d-flex align-items-center gap-2" style="border-color: var(--border-glass); color: var(--accent-primary); font-weight: 600; padding: 6px 14px; border-radius: 6px;" @onclick="NavigateToEditPaciente">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 16px; height: 16px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                    </svg>
                    Ver/Editar paciente
                </button>
                <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-2" style="background-color: var(--accent-primary); border: 1px solid var(--accent-primary); color: #ffffff; font-weight: 600; padding: 6px 14px; border-radius: 6px;" @onclick="ImprimirHistoriaClinica">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 16px; height: 16px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.656h10.5Z" />
                    </svg>
                    Imprimir Historia Clínica
                </button>
            </div>
        </div>

        <div class="row align-items-center">
            <div class="col-6 col-md-2 border-end" style="border-color: var(--border-color) !important;">
                <span class="text-secondary small d-block" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 600; margin-bottom: 2px;">Especie</span>
                <strong style="font-size: 1rem; color: var(--text-primary);">@(string.IsNullOrEmpty(paciente?.EspecieNombre) ? "—" : paciente.EspecieNombre)</strong>
            </div>
            <div class="col-6 col-md-3 border-end" style="border-color: var(--border-color) !important; padding-left: 20px;">
                <span class="text-secondary small d-block" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 600; margin-bottom: 2px;">Raza</span>
                <strong style="font-size: 1rem; color: var(--text-primary);">@(string.IsNullOrEmpty(paciente?.RazaNombre) ? "—" : paciente.RazaNombre)</strong>
            </div>
            <div class="col-6 col-md-2 border-end" style="border-color: var(--border-color) !important; padding-left: 20px;">
                <span class="text-secondary small d-block" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 600; margin-bottom: 2px;">Género</span>
                <strong style="font-size: 1rem; color: var(--text-primary);">@(paciente?.Sexo == "M" ? "Macho" : paciente?.Sexo == "H" ? "Hembra" : "Desconocido")</strong>
            </div>
            <div class="col-6 col-md-3 border-end" style="border-color: var(--border-color) !important; padding-left: 20px;">
                <span class="text-secondary small d-block" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 600; margin-bottom: 2px;">Edad</span>
                <strong style="font-size: 1rem; color: var(--accent-primary);">@(paciente != null ? GetEdadPaciente(paciente.FechaNacimiento) : "—")</strong>
                @if (paciente?.FechaNacimiento.HasValue == true)
                {
                    <span class="text-secondary d-block" style="font-size: 0.8rem;">Nac: @paciente.FechaNacimiento.Value.ToString("dd/MM/yyyy")</span>
                }
            </div>
            <div class="col-12 col-md-2" style="padding-left: 20px;">
                <span class="text-secondary small d-block" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 600; margin-bottom: 2px;">Peso</span>
                @{
                    var ultimaConsultaConPeso = consultas?.Where(c => c.Peso.HasValue && c.Peso > 0).OrderByDescending(c => c.Fecha).FirstOrDefault();
                }
                @if (ultimaConsultaConPeso != null && ultimaConsultaConPeso.Peso.HasValue)
                {
                    <strong style="font-size: 1.05rem; color: var(--accent-primary);">@ultimaConsultaConPeso.Peso.Value.ToString("0.##") kg</strong>
                    <span class="text-secondary d-block" style="font-size: 0.75rem;">Última consulta: @(ultimaConsultaConPeso.Fecha?.ToString("dd/MM/yyyy") ?? "—")</span>
                }
                else
                {
                    <span class="text-secondary" style="font-size: 0.95rem;">Sin registrar</span>
                }
            </div>
        </div>
    </div>

    @if (propietario != null)
    {
        <div class="glass-card mb-3 p-3" style="border: 1px solid var(--border-glass); background: rgba(255,255,255,0.02); border-radius: 8px;">
            <div class="row align-items-center">
                <div class="col-md-3 border-end" style="border-color: var(--border-glass) !important;">
                    <span class="text-secondary small d-block" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 600; margin-bottom: 2px;">Dueño / Propietario</span>
                    <strong style="font-size: 1.1rem; color: var(--accent-primary); display: flex; align-items: center; gap: 6px;">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 16px; height: 16px; color: var(--accent-primary);">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                        </svg>
                        @propietario.NombreCompleto
                    </strong>
                    <span class="text-secondary d-block" style="font-size: 0.85rem;">DNI: @propietario.DNI</span>
                </div>
                <div class="col-md-3 border-end" style="border-color: var(--border-glass) !important; padding-left: 20px;">
                    <span class="text-secondary small d-block" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 600; margin-bottom: 2px;">Contacto</span>
                    <strong style="color: var(--text-primary); font-size: 1rem; display: flex; align-items: center; gap: 6px;">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 16px; height: 16px; color: var(--accent-primary);">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                        </svg>
                        @propietario.Telefono
                    </strong>
                    <span class="text-secondary d-block" style="font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@propietario.Email</span>
                </div>
                <div class="col-md-3 border-end" style="border-color: var(--border-glass) !important; padding-left: 20px;">
                    <span class="text-secondary small d-block" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 600; margin-bottom: 2px;">Dirección</span>
                    <span class="text-light" style="font-size: 0.9rem; font-weight: 500; display: flex; align-items: center; gap: 6px;">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 16px; height: 16px; color: var(--accent-primary);">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                        </svg>
                        @(string.IsNullOrEmpty(propietario.Direccion) ? "Sin dirección" : propietario.Direccion)
                    </span>
                </div>
                <div class="col-md-3 d-flex flex-column align-items-md-end justify-content-center mt-2 mt-md-0 gap-1" style="padding-left: 20px;">
                    @if (!string.IsNullOrEmpty(vaccineTwilioMsg))
                    {
                        <div class="alert @(vaccineTwilioSuccess ? "alert-success" : "alert-danger") p-1 small mb-1 text-center w-100" style="font-size: 0.75rem;">
                            @vaccineTwilioMsg
                        </div>
                    }
                    <div class="d-flex gap-2 flex-wrap justify-content-end">
                        <button type="button" @onclick="SendVaccineReminderTwilio" disabled="@isSendingVaccineTwilio" class="btn btn-success btn-sm d-flex align-items-center gap-1" style="background-color: #25D366; border: none; font-weight: 600; padding: 6px 12px; border-radius: 8px;" title="Enviar recordatorio automático vía Twilio">
                            @if (isSendingVaccineTwilio)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>Enviando...</span>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-send-fill" viewBox="0 0 16 16">
                                    <path d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855H.766l-.452.18a.5.5 0 0 0-.082.887l.41.26.001.002 4.995 3.178 3.178 4.995.002.002.26.41a.5.5 0 0 0 .886-.083zm-1.833 1.89L6.637 10.07l-.215-.136L3.255 7.91l10.876-5.334z"/>
                                </svg>
                                <span>Twilio Auto</span>
                            }
                        </button>
                        <a href="https://wa.me/@FormatWhatsApp(propietario?.Telefono ?? "")?text=@Uri.EscapeDataString($"Hola {propietario?.Nombre ?? ""}, te contactamos de la Veterinaria. Queríamos recordarte que {paciente?.Nombre ?? "su mascota"} tiene una vacuna pendiente de aplicación. Por favor, coordiná un turno a la brevedad.")" 
                           target="_blank" class="btn btn-outline-success btn-sm d-flex align-items-center gap-1" style="color: #4ade80; border-color: rgba(74,222,128,0.3); font-weight: 600; padding: 6px 12px; border-radius: 8px;" title="Abrir en WhatsApp Web / wa.me">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-whatsapp" viewBox="0 0 16 16">
                              <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.949h.004c4.368 0 7.926-3.562 7.928-7.929a7.89 7.89 0 0 0-2.33-5.69m-5.61 10.744h-.01a6.5 6.5 0 0 1-3.3-1.02l-.242-.144-2.454.644.656-2.387-.156-.25a6.5 6.5 0 0 1-1.007-3.5C.029 4.348 3.52 1.052 7.99 1.052a6.5 6.5 0 0 1 4.59 1.93 6.5 6.5 0 0 1 1.922 4.6c-.004 4.475-3.498 7.969-7.965 7.969m3.636-4.708c-.18-.089-1.08-.534-1.25-.597-.17-.061-.29-.092-.41.09-.12.18-.46.597-.56.711-.1.115-.2.13-.38.041-1.81-.9-3.236-2.225-4.088-3.727-.12-.206-.013-.319.09-.422.09-.09.18-.21.28-.31.09-.1.12-.17.18-.29.06-.12.03-.22-.01-.31-.04-.09-.41-1.005-.56-1.373-.15-.356-.3-.3-.41-.3-.1-.005-.22-.005-.34-.005-.12 0-.32.045-.49.23-.17.19-.66.645-.66 1.57s.68 1.835.77 1.962c.09.13 1.34 2.044 3.25 2.87.45.2 1.01.32 1.37.43.46.15.88.13 1.21.08.37-.06 1.08-.44 1.23-.863.15-.42.15-.78.1-.863-.05-.08-.18-.12-.36-.21"/>
                            </svg>
                            <span>WhatsApp Web</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- TABS -->
    <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist" style="border-bottom: 2px solid var(--border-glass); padding-bottom: 10px;">
      <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "consultas" ? "active btn-primary-glass" : "text-light")" @onclick='() => SetTab("consultas")' style="border-radius: 8px;">Consultas Médicas</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "vacunas" ? "active btn-primary-glass" : "text-light")" @onclick='() => SetTab("vacunas")' style="border-radius: 8px; margin-left:10px;">Plan de Vacunación</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "tratamientos" ? "active btn-primary-glass" : "text-light")" @onclick='() => SetTab("tratamientos")' style="border-radius: 8px; margin-left:10px;">Tratamientos Activos</button>
      </li>
    </ul>

    <!-- TAB CONTENT -->
    <div class="tab-content" id="pills-tabContent">
        
        <!-- CONSULTAS -->
        @if(activeTab == "consultas")
        {
            <div class="glass-card mt-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="m-0">Últimas Consultas</h5>
                    <button class="btn btn-sm btn-outline-success" @onclick="NuevaConsulta">
                        + Nueva Consulta
                    </button>
                </div>
                
                @if(consultas == null || !consultas.Any())
                {
                    <p class="text-secondary">No hay registros de consultas en la historia clínica.</p>
                }
                else
                {
                    <div class="accordion" id="accConsultas">
                        @foreach(var c in consultas.OrderByDescending(x => x.Fecha))
                        {
                            <div class="accordion-item" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-glass); margin-bottom: 5px;">
                                <h2 class="accordion-header">
                                  <button class="accordion-button @(expandedConsultas.Contains(c.Id) ? "" : "collapsed") text-light" type="button" @onclick="() => ToggleConsulta(c.Id)" style="background: transparent; box-shadow: none;">
                                    <strong>@(c.Fecha?.ToString("dd/MM/yyyy") ?? "")</strong>: @c.Motivo (Vet: @c.Veterinario)
                                  </button>
                                </h2>
                                <div class="accordion-collapse collapse @(expandedConsultas.Contains(c.Id) ? "show" : "")">
                                  <div class="accordion-body text-secondary">
                                    <p><strong>Síntomas:</strong> @c.Sintomas</p>
                                    <p><strong>Diagnóstico:</strong> <span class="text-light">@c.Diagnostico</span></p>
                                    <p><strong>Indicaciones:</strong> @c.Indicaciones</p>
                                                  @{
                                        List<Adjunto>? files = null;
                                        try {
                                            if (!string.IsNullOrEmpty(c.ArchivosAdjuntos))
                                                files = System.Text.Json.JsonSerializer.Deserialize<List<Adjunto>>(c.ArchivosAdjuntos);
                                        } catch {}
                                    }
                                    @if (files != null && files.Any())
                                    {
                                        <div class="mt-2 border-top pt-2" style="border-color: rgba(255,255,255,0.05) !important;">
                                            <strong class="text-secondary small d-block mb-1">Archivos y fotos adjuntas:</strong>
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var file in files)
                                                {
                                                    var isImg = IsImageFile(file.Nombre, file.ContentType);
                                                    if (isImg && !string.IsNullOrEmpty(file.Base64))
                                                    {
                                                        <div class="d-flex flex-column align-items-center gap-1 p-1 rounded" style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); cursor: pointer;" @onclick="() => PreviewFile(file)" title="Click para ver en grande">
                                                            <img src="data:@(string.IsNullOrEmpty(file.ContentType) ? "image/jpeg" : file.ContentType);base64,@file.Base64" 
                                                                 style="width: 55px; height: 55px; object-fit: cover; border-radius: 4px; border: 1px solid var(--accent-primary);" />
                                                            <span class="text-truncate text-secondary" style="max-width: 60px; font-size: 0.7rem;">@file.Nombre</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-info py-1 px-2 d-inline-flex align-items-center gap-1" style="font-size: 0.75rem; border-color: var(--border-glass);" @onclick="() => PreviewFile(file)">
                                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 14px; height: 14px;">
                                                                <path stroke-linecap="round" stroke-linejoin="round" d="m18.375 12.739-7.693 7.693a4.5 4.5 0 0 1-6.364-6.364l10.94-10.94A3 3 0 1 1 19.5 7.372L8.552 18.32m.009-.01-.01.01m5.699-9.941-7.81 7.81a1.5 1.5 0 0 0 2.112 2.13" />
                                                            </svg>
                                                            @file.Nombre
                                                        </button>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }

                                    <p style="font-size: 0.85em; margin-top:10px;">Peso: @c.Peso kg | Temp: @(c.Temperatura.HasValue ? $"{c.Temperatura.Value} °C" : "—")</p>
                                    <div class="d-flex justify-content-end mt-2">
                                        <button class="btn btn-sm btn-outline-info" @onclick="() => EditarConsulta(c.Id)">
                                            Editar Consulta
                                        </button>
                                    </div>
                                  </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <!-- VACUNAS -->
        @if(activeTab == "vacunas")
        {
            <div class="glass-card mt-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="m-0">Libreta Sanitaria (Vacunas)</h5>
                    <button class="btn btn-sm btn-outline-success" @onclick="NuevaVacuna">
                        + Registrar Vacuna
                    </button>
                </div>
                
                @if(vacunas == null || !vacunas.Any())
                {
                    <p class="text-secondary">El paciente no registra vacunas aplicadas.</p>
                }
                else
                {
                    <table class="table table-dark table-hover" style="background: transparent;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--border-glass);">
                                <th>Fecha Aplic.</th>
                                <th>Vacuna</th>
                                <th>Próxima Dosis</th>
                                <th>Lote</th>
                                <th>Veterinario</th>
                                <th>Observaciones</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in vacunas.OrderByDescending(x => x.FechaAplicacion))
                            {
                                <tr style="border-bottom: 1px solid var(--border-glass);">
                                    <td>@v.FechaAplicacion.ToString("dd/MM/yyyy")</td>
                                    <td><strong>@v.VacunaNombre</strong></td>
                                    <td>
                                        @if (v.FechaProximaDosis.HasValue)
                                        {
                                            var isOverdue = v.FechaProximaDosis.Value.Date < DateTime.Today;
                                            <span class="@(isOverdue ? "text-danger fw-bold" : "text-info")" style="font-size: 0.85rem;">
                                                @v.FechaProximaDosis.Value.ToString("dd/MM/yyyy")
                                                @if (isOverdue)
                                                {
                                                    <span class="badge bg-danger ms-1" style="font-size: 0.65rem;">Vencida</span>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">-</span>
                                        }
                                    </td>
                                    <td class="text-secondary" style="font-size:0.85rem;">@(string.IsNullOrEmpty(v.NroLote) ? "-" : v.NroLote)</td>
                                    <td style="font-size:0.85rem;">@v.Veterinario</td>
                                    <td class="text-secondary" style="font-size:0.85rem;">@(string.IsNullOrEmpty(v.Observaciones) ? "-" : v.Observaciones)</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-info" @onclick="() => EditarVacuna(v.Id)" title="Editar registro de vacuna">
                                            Editar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }

        <!-- TRATAMIENTOS -->
        @if(activeTab == "tratamientos")
        {
            <div class="glass-card mt-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="m-0">Tratamientos Médicos</h5>
                    <button class="btn btn-sm btn-outline-success" @onclick="NuevoTratamiento">
                        + Iniciar Tratamiento
                    </button>
                </div>
                
                @if(tratamientos == null || !tratamientos.Any())
                {
                    <p class="text-secondary">No hay tratamientos activos o finalizados.</p>
                }
                else
                {
                    <table class="table table-dark table-hover" style="background: transparent;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--border-glass);">
                                <th>Fecha</th>
                                <th>Diagnóstico</th>
                                <th>Descripción</th>
                                <th>Medicación</th>
                                <th>Veterinario</th>
                                <th class="text-center">Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var t in tratamientos.OrderBy(x=>x.Finalizado).ThenByDescending(x=>x.Fecha))
                            {
                                <tr style="border-bottom: 1px solid var(--border-glass);">
                                    <td>@t.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td><strong class="text-light">@t.Diagnostico</strong></td>
                                    <td class="text-secondary" style="max-width: 250px;">
                                        <div>@t.Descripcion</div>
                                        @{
                                            List<Adjunto>? tFiles = null;
                                            try {
                                                if (!string.IsNullOrEmpty(t.ArchivosAdjuntos))
                                                    tFiles = System.Text.Json.JsonSerializer.Deserialize<List<Adjunto>>(t.ArchivosAdjuntos);
                                            } catch {}
                                        }
                                        @if (tFiles != null && tFiles.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                @foreach (var file in tFiles)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-info py-0 px-1 d-inline-flex align-items-center gap-1" style="font-size: 0.7rem; border-color: var(--border-glass); padding: 1px 4px;" @onclick="() => PreviewFile(file)" title="@file.Nombre">
                                                        <i class="bi bi-paperclip"></i> <span class="text-truncate" style="max-width: 80px;">@file.Nombre</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="text-secondary" style="max-width: 250px;">@t.Medicacion</td>
                                    <td class="text-secondary">@t.Veterinario</td>
                                    <td class="text-center">
                                        @if(t.Finalizado)
                                        {
                                            <span class="badge bg-secondary">Finalizado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">En curso</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-info" style="margin-right: 5px;" @onclick="() => EditarTratamiento(t.Id)" title="Editar tratamiento">
                                            Editar
                                        </button>
                                        @if(!t.Finalizado)
                                        {
                                            <button class="btn btn-sm btn-outline-success" @onclick="() => FinalizarTratamiento(t.Id)" title="Marcar como finalizado">
                                                Finalizar
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }

    </div>

    @* ═══════ SECCIÓN IMPRIMIBLE: HISTORIA CLÍNICA COMPLETA ═══════ *@
    <div id="historia-clinica-print-area">
        <!-- Encabezado Membrete -->
        <div class="historia-print-header">
            <div class="historia-print-logo-box">
                <img src="/images/logoNandubay.jpg" alt="Logo Veterinaria Ñandubay" class="historia-print-logo" />
                <div>
                    <h1 class="historia-print-title">Veterinaria Ñandubay</h1>
                    <p class="historia-print-subtitle">Atención Médica Veterinaria Integral</p>
                </div>
            </div>
            <div class="historia-print-meta">
                <div class="historia-print-badge">HISTORIA CLÍNICA VETERINARIA</div>
                <div class="historia-print-date"><strong>Fecha de Emisión:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm") hs</div>
                <div class="historia-print-date"><strong>ID Ficha Paciente:</strong> @(paciente?.Id ?? "—")</div>
            </div>
        </div>

        <!-- 1. Información del Paciente -->
        <div class="historia-print-section">
            <div class="historia-print-section-header">1. Información del Paciente</div>
            <table class="historia-print-info-table">
                <tr>
                    <td style="width: 25%;"><strong>Nombre:</strong></td>
                    <td style="width: 25%; font-weight: bold; color: #00A36C;">@(paciente?.Nombre ?? "—")</td>
                    <td style="width: 25%;"><strong>Especie:</strong></td>
                    <td style="width: 25%;">@(string.IsNullOrEmpty(paciente?.EspecieNombre) ? "—" : paciente.EspecieNombre)</td>
                </tr>
                <tr>
                    <td><strong>Raza:</strong></td>
                    <td>@(string.IsNullOrEmpty(paciente?.RazaNombre) ? "—" : paciente.RazaNombre)</td>
                    <td><strong>Género / Sexo:</strong></td>
                    <td>@(paciente?.Sexo == "M" ? "Macho" : paciente?.Sexo == "H" ? "Hembra" : "Desconocido")</td>
                </tr>
                <tr>
                    <td><strong>Fecha de Nacimiento:</strong></td>
                    <td>@(paciente?.FechaNacimiento.HasValue == true ? paciente.FechaNacimiento.Value.ToString("dd/MM/yyyy") : "No registrada")</td>
                    <td><strong>Edad actual:</strong></td>
                    <td>@(paciente != null ? GetEdadPaciente(paciente.FechaNacimiento) : "—")</td>
                </tr>
                <tr>
                    <td><strong>Último Peso Registrado:</strong></td>
                    <td colspan="3">
                        @{
                            var ultPesoPrint = consultas?.Where(c => c.Peso.HasValue && c.Peso > 0).OrderByDescending(c => c.Fecha).FirstOrDefault();
                        }
                        @(ultPesoPrint != null && ultPesoPrint.Peso.HasValue ? $"{ultPesoPrint.Peso.Value.ToString("0.##")} kg (Registrado el {ultPesoPrint.Fecha?.ToString("dd/MM/yyyy")})" : "Sin registros de peso")
                    </td>
                </tr>
                @if (!string.IsNullOrEmpty(paciente?.Observaciones))
                {
                    <tr>
                        <td><strong>Observaciones / Alergias:</strong></td>
                        <td colspan="3">@paciente.Observaciones</td>
                    </tr>
                }
            </table>
        </div>

        <!-- 2. Información del Dueño / Propietario -->
        <div class="historia-print-section">
            <div class="historia-print-section-header">2. Datos del Propietario / Dueño</div>
            @if (propietario != null)
            {
                <table class="historia-print-info-table">
                    <tr>
                        <td style="width: 25%;"><strong>Nombre Completo:</strong></td>
                        <td style="width: 25%; font-weight: bold;">@propietario.NombreCompleto</td>
                        <td style="width: 25%;"><strong>DNI / Documento:</strong></td>
                        <td style="width: 25%;">@propietario.DNI</td>
                    </tr>
                    <tr>
                        <td><strong>Teléfono de Contacto:</strong></td>
                        <td>@propietario.Telefono</td>
                        <td><strong>Correo Electrónico:</strong></td>
                        <td>@(string.IsNullOrEmpty(propietario.Email) ? "—" : propietario.Email)</td>
                    </tr>
                    <tr>
                        <td><strong>Dirección:</strong></td>
                        <td colspan="3">@(string.IsNullOrEmpty(propietario.Direccion) ? "Sin dirección registrada" : propietario.Direccion)</td>
                    </tr>
                </table>
            }
            else
            {
                <p class="historia-print-empty">No se encontró información del propietario registrado.</p>
            }
        </div>

        <!-- 3. Consultas Médicas -->
        <div class="historia-print-section">
            <div class="historia-print-section-header">3. Consultas Médicas (@(consultas?.Count ?? 0))</div>
            @if (consultas == null || !consultas.Any())
            {
                <p class="historia-print-empty">No se registran consultas médicas previas en el historial.</p>
            }
            else
            {
                @foreach (var c in consultas.OrderByDescending(x => x.Fecha))
                {
                    <div class="historia-print-consult-card">
                        <div class="historia-print-consult-header">
                            <div>
                                <strong>Fecha:</strong> @(c.Fecha?.ToString("dd/MM/yyyy") ?? "—")
                                <span style="margin-left: 15px;"><strong>Motivo:</strong> @c.Motivo</span>
                            </div>
                            <div>
                                <strong>Veterinario:</strong> @c.Veterinario
                            </div>
                        </div>
                        <div class="historia-print-consult-body">
                            <div class="historia-print-row">
                                <div class="historia-print-col">
                                    <strong>Peso:</strong> @(c.Peso.HasValue ? $"{c.Peso.Value.ToString("0.##")} kg" : "—")
                                </div>
                                <div class="historia-print-col">
                                    <strong>Temperatura:</strong> @(c.Temperatura.HasValue ? $"{c.Temperatura.Value} °C" : "—")
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(c.Sintomas))
                            {
                                <div class="historia-print-field">
                                    <strong>Síntomas reportados:</strong> @c.Sintomas
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(c.Diagnostico))
                            {
                                <div class="historia-print-field">
                                    <strong>Diagnóstico:</strong> @c.Diagnostico
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(c.Indicaciones))
                            {
                                <div class="historia-print-field">
                                    <strong>Indicaciones / Tratamiento:</strong> @c.Indicaciones
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(c.Observaciones))
                            {
                                <div class="historia-print-field">
                                    <strong>Observaciones:</strong> @c.Observaciones
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <!-- 4. Libreta Sanitaria / Plan de Vacunación -->
        <div class="historia-print-section">
            <div class="historia-print-section-header">4. Libreta Sanitaria y Plan de Vacunación (@(vacunas?.Count ?? 0))</div>
            @if (vacunas == null || !vacunas.Any())
            {
                <p class="historia-print-empty">El paciente no registra vacunas aplicadas.</p>
            }
            else
            {
                <table class="historia-print-table">
                    <thead>
                        <tr>
                            <th style="width: 15%;">Fecha Aplicación</th>
                            <th style="width: 25%;">Vacuna</th>
                            <th style="width: 15%;">Próxima Dosis</th>
                            <th style="width: 12%;">N° Lote</th>
                            <th style="width: 18%;">Veterinario</th>
                            <th style="width: 15%;">Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in vacunas.OrderByDescending(x => x.FechaAplicacion))
                        {
                            <tr>
                                <td>@v.FechaAplicacion.ToString("dd/MM/yyyy")</td>
                                <td><strong>@v.VacunaNombre</strong></td>
                                <td>@(v.FechaProximaDosis.HasValue ? v.FechaProximaDosis.Value.ToString("dd/MM/yyyy") : "—")</td>
                                <td>@(string.IsNullOrEmpty(v.NroLote) ? "—" : v.NroLote)</td>
                                <td>@v.Veterinario</td>
                                <td>@(string.IsNullOrEmpty(v.Observaciones) ? "—" : v.Observaciones)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- 5. Tratamientos Médicos -->
        <div class="historia-print-section">
            <div class="historia-print-section-header">5. Tratamientos Médicos (@(tratamientos?.Count ?? 0))</div>
            @if (tratamientos == null || !tratamientos.Any())
            {
                <p class="historia-print-empty">No se registran tratamientos médicos para este paciente.</p>
            }
            else
            {
                <table class="historia-print-table">
                    <thead>
                        <tr>
                            <th style="width: 12%;">Fecha</th>
                            <th style="width: 20%;">Diagnóstico</th>
                            <th style="width: 23%;">Descripción</th>
                            <th style="width: 20%;">Medicación</th>
                            <th style="width: 15%;">Veterinario</th>
                            <th style="width: 10%; text-align: center;">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in tratamientos.OrderBy(x => x.Finalizado).ThenByDescending(x => x.Fecha))
                        {
                            <tr>
                                <td>@t.Fecha.ToString("dd/MM/yyyy")</td>
                                <td><strong>@t.Diagnostico</strong></td>
                                <td>@t.Descripcion</td>
                                <td>@(string.IsNullOrEmpty(t.Medicacion) ? "—" : t.Medicacion)</td>
                                <td>@t.Veterinario</td>
                                <td style="text-align: center;">
                                    @(t.Finalizado ? "Finalizado" : "En curso")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Pie y Firmas -->
        <div class="historia-print-footer">
            <div class="historia-print-signatures">
                <div class="historia-print-sig-box">
                    <div class="historia-print-sig-line"></div>
                    <p>Firma y Sello Médico Veterinario</p>
                </div>
                <div class="historia-print-sig-box">
                    <div class="historia-print-sig-line"></div>
                    <p>Firma Propietario / Responsable</p>
                </div>
            </div>
            <div class="historia-print-legal">
                <p>Veterinaria Ñandubay - Documento generado automáticamente por el Sistema de Gestión Clínica.</p>
            </div>
        </div>
    </div>
}

@* ═══════ MODAL: Consulta ═══════ *@
@if (showConsultaModal)
{
    <div class="modal-overlay modal-overlay-z1" @onclick="CloseConsultaModal" @onclick:stopPropagation="false">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>@(string.IsNullOrEmpty(consultaModel.Id) ? "Nueva Consulta" : "Editar Consulta")</h3>
                <button class="modal-close-btn" @onclick="CloseConsultaModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <EditForm Model="consultaModel" OnValidSubmit="HandleSaveConsulta" FormName="modalConsultaForm">
                <DataAnnotationsValidator />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Fecha (*)</label>
                        <InputDate @bind-Value="consultaModel.Fecha" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => consultaModel.Fecha)" class="text-danger" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Veterinario Tratante (*)</label>
                        <InputSelect @bind-Value="consultaModel.Veterinario" class="form-select bg-dark text-light border-secondary">
                            <option value="">Seleccione...</option>
                            @foreach (var v in vets)
                            {
                                <option value="@v.NombreCompleto">@v.NombreCompleto</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => consultaModel.Veterinario)" class="text-danger" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Peso (kg) (*)</label>
                        <InputNumber @bind-Value="consultaModel.Peso" class="form-control bg-dark text-light border-secondary" TValue="decimal?" />
                        <ValidationMessage For="@(() => consultaModel.Peso)" class="text-danger" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Temp (°C)</label>
                        <InputNumber @bind-Value="consultaModel.Temperatura" class="form-control bg-dark text-light border-secondary" TValue="decimal?" />
                        <ValidationMessage For="@(() => consultaModel.Temperatura)" class="text-danger" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Motivo de Consulta (*)</label>
                    <InputText @bind-Value="consultaModel.Motivo" class="form-control bg-dark text-light border-secondary" />
                    <ValidationMessage For="@(() => consultaModel.Motivo)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Síntomas reportados (*)</label>
                    <InputTextArea @bind-Value="consultaModel.Sintomas" class="form-control bg-dark text-light border-secondary" rows="2" />
                    <ValidationMessage For="@(() => consultaModel.Sintomas)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Diagnóstico (*)</label>
                    <InputTextArea @bind-Value="consultaModel.Diagnostico" class="form-control bg-dark text-light border-secondary" rows="2" />
                    <ValidationMessage For="@(() => consultaModel.Diagnostico)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Indicaciones (*)</label>
                    <InputTextArea @bind-Value="consultaModel.Indicaciones" class="form-control bg-dark text-light border-secondary" rows="3" />
                    <ValidationMessage For="@(() => consultaModel.Indicaciones)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Observaciones adicionales</label>
                    <InputTextArea @bind-Value="consultaModel.Observaciones" class="form-control bg-dark text-light border-secondary" rows="2" />
                    <ValidationMessage For="@(() => consultaModel.Observaciones)" class="text-danger" />
                </div>

                <!-- Archivos Adjuntos (Preview de fotos y documentos) -->
                <div class="mb-3">
                    <label class="d-flex align-items-center gap-2" style="color: var(--text-secondary); font-size: 0.875rem;">
                        <span>Archivos Adjuntos (Imágenes, Documentos, PDFs)</span>
                        <label for="modal-consulta-attachments" class="btn btn-sm btn-outline-info d-inline-flex align-items-center gap-1 py-1 px-2 m-0" style="cursor: pointer; font-size: 0.78rem; border-color: var(--border-glass); background: rgba(0, 163, 108, 0.05); color: var(--accent-primary);">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 14px; height: 14px;">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m18.375 12.739-7.693 7.693a4.5 4.5 0 0 1-6.364-6.364l10.94-10.94A3 3 0 1 1 19.5 7.372L8.552 18.32m.009-.01-.01.01m5.699-9.941-7.81 7.81a1.5 1.5 0 0 0 2.112 2.13" />
                            </svg>
                            Adjuntar
                        </label>
                        <InputFile id="modal-consulta-attachments" OnChange="UploadModalConsultaFiles" multiple style="display: none;" />
                    </label>
                    
                    @if (modalConsultaFilesList != null && modalConsultaFilesList.Any())
                    {
                        <div class="row g-2 mt-2">
                            @foreach (var file in modalConsultaFilesList)
                            {
                                var isImg = IsImageFile(file.Nombre, file.ContentType);
                                <div class="col-sm-6">
                                    <div class="d-flex align-items-center p-2 rounded position-relative" style="background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border-glass); gap: 10px;">
                                        @if (isImg && !string.IsNullOrEmpty(file.Base64))
                                        {
                                            <img src="data:@(string.IsNullOrEmpty(file.ContentType) ? "image/jpeg" : file.ContentType);base64,@file.Base64" 
                                                 style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid var(--accent-primary); cursor: pointer; flex-shrink: 0;" 
                                                 @onclick="() => PreviewFile(file)" 
                                                 title="Click para ampliar" />
                                        }
                                        else
                                        {
                                            <div style="width: 50px; height: 50px; border-radius: 6px; background: rgba(0, 163, 108, 0.1); border: 1px solid var(--border-glass); display: flex; align-items: center; justify-content: center; flex-shrink: 0; cursor: pointer;"
                                                 @onclick="() => PreviewFile(file)" title="Click para abrir">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 24px; height: 24px; color: var(--accent-primary);">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                                                </svg>
                                            </div>
                                        }
                                        <div style="flex: 1; min-width: 0;">
                                            <span class="d-block text-truncate text-light" style="font-size: 0.8rem; font-weight: 500;" title="@file.Nombre">@file.Nombre</span>
                                            <div class="d-flex align-items-center gap-2 mt-1">
                                                <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" style="color: var(--accent-primary); font-size: 0.75rem;" @onclick="() => PreviewFile(file)">
                                                    Ver
                                                </button>
                                                <span class="text-secondary" style="font-size: 0.75rem;">|</span>
                                                <button type="button" class="btn btn-sm btn-link p-0 text-danger text-decoration-none" style="font-size: 0.75rem;" @onclick="() => RemoveModalConsultaFile(file)">
                                                    Quitar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(consultaErrorMessage))
                {
                    <div class="alert alert-danger p-2 mt-2" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">@consultaErrorMessage</div>
                }

                <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                    <button type="button" class="btn btn-outline-secondary text-light" @onclick="CloseConsultaModal">Cancelar</button>
                    <button type="submit" class="btn-primary-glass" disabled="@isSavingConsulta">
                        @if(isSavingConsulta) { <span>Guardando...</span> } else { <span>Guardar</span> }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* ═══════ MODAL: Vacunación ═══════ *@
@if (showVacunaModal)
{
    <div class="modal-overlay modal-overlay-z1" @onclick="CloseVacunaModal" @onclick:stopPropagation="false">
        <div class="modal-panel modal-panel-sm" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>@(string.IsNullOrEmpty(vacunaModel.Id) ? "Nueva Vacunación" : "Editar Vacunación")</h3>
                <button class="modal-close-btn" @onclick="CloseVacunaModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <EditForm Model="vacunaModel" OnValidSubmit="HandleSaveVacuna" FormName="modalVacunaForm">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Vacuna del Inventario (*)</label>
                    <select @bind="selectedProductoId" @bind:after="OnVacunaProductoSelected" class="form-select bg-dark text-light border-secondary">
                        <option value="">-- Seleccione Vacuna --</option>
                        @foreach (var prod in productosVacunas)
                        {
                            <option value="@prod.Id">
                                @prod.Nombre @(string.IsNullOrEmpty(prod.MarcaNombre) ? "" : $"({prod.MarcaNombre})") - Stock: @prod.StockActual
                            </option>
                        }
                    </select>
                </div>

                @if (selectedProducto != null && selectedProducto.StocksDepositos != null && selectedProducto.StocksDepositos.Count(s => s.StockActual > 0) > 1)
                {
                    <div class="mb-3">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Depósito de Origen (*)</label>
                        <select @bind="selectedDepositoId" class="form-select bg-dark text-light border-secondary">
                            <option value="">-- Seleccionar Depósito --</option>
                            @foreach (var sd in selectedProducto.StocksDepositos.Where(s => s.StockActual > 0))
                            {
                                <option value="@sd.DepositoId">@sd.DepositoNombre (Disponible: @sd.StockActual)</option>
                            }
                        </select>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Veterinario (*)</label>
                    <InputSelect @bind-Value="vacunaModel.Veterinario" class="form-select bg-dark text-light border-secondary">
                        <option value="">Seleccione Médico...</option>
                        @foreach (var v in vets)
                        {
                            <option value="@v.NombreCompleto">@v.NombreCompleto</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => vacunaModel.Veterinario)" class="text-danger" />
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Fecha Aplicación (*)</label>
                        <InputDate @bind-Value="vacunaModel.FechaAplicacion" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => vacunaModel.FechaAplicacion)" class="text-danger" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Próxima Dosis</label>
                        <InputDate @bind-Value="vacunaModel.FechaProximaDosis" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => vacunaModel.FechaProximaDosis)" class="text-danger" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Número de Lote / Etiqueta</label>
                    <InputText @bind-Value="vacunaModel.NroLote" class="form-control bg-dark text-light border-secondary" placeholder="Lote de la ampolla" />
                    <ValidationMessage For="@(() => vacunaModel.NroLote)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Observaciones</label>
                    <InputTextArea @bind-Value="vacunaModel.Observaciones" class="form-control bg-dark text-light border-secondary" rows="3" />
                    <ValidationMessage For="@(() => vacunaModel.Observaciones)" class="text-danger" />
                </div>

                @if (!string.IsNullOrEmpty(vacunaErrorMessage))
                {
                    <div class="alert alert-danger p-2 mt-2" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">@vacunaErrorMessage</div>
                }

                <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                    <button type="button" class="btn btn-outline-secondary text-light" @onclick="CloseVacunaModal">Cancelar</button>
                    <button type="submit" class="btn-primary-glass" disabled="@isSavingVacuna">
                        @if(isSavingVacuna) { <span>Guardando...</span> } else { <span>Guardar</span> }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* ═══════ MODAL: Tratamiento ═══════ *@
@if (showTratamientoModal)
{
    <div class="modal-overlay modal-overlay-z1" @onclick="CloseTratamientoModal" @onclick:stopPropagation="false">
