@page "/historial-clinico/nueva-vacuna/{PacienteId}"
@page "/historial-clinico/editar-vacuna/{PacienteId}/{RegistroId}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Veterinario")]
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@inject VacunacionService VacunacionService
@inject PacienteService PacienteService
@inject PersonalService PersonalService
@inject ProductoService ProductoService
@inject NavigationManager Navigation

<PageTitle>@(isEdit ? "Editar Vacuna" : "Registrar Vacuna") - Historial Clínico</PageTitle>

<div class="glass-card" style="max-width: 800px; margin: auto; margin-top:20px;">
    <h4>@(isEdit ? "Editar Aplicación de Vacuna" : "Aplicación de Vacuna") (@pacienteNombre)</h4>
    <hr class="border-secondary" />

    <EditForm Model="model" OnValidSubmit="HandleSave">
        <DataAnnotationsValidator />
        
        <div class="row mb-3">
            <div class="col-md-6">
                <label>Vacuna del Inventario (*)</label>
                <select @bind="selectedProductoId" @bind:after="OnVacunaProductoSelected" class="form-select bg-dark text-light border-secondary">
                    <option value="">-- Seleccione Vacuna --</option>
                    @foreach (var prod in productosVacunas)
                    {
                        <option value="@prod.Id">
                            @prod.Nombre @(string.IsNullOrEmpty(prod.MarcaNombre) ? "" : $"({prod.MarcaNombre})") - Stock: @prod.StockActual
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label>Veterinario (*)</label>
                <InputSelect @bind-Value="model.Veterinario" class="form-select bg-dark text-light border-secondary">
                    <option value="">Seleccione Médico...</option>
                    @foreach (var v in vets)
                    {
                        <option value="@v.NombreCompleto">@v.NombreCompleto</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => model.Veterinario)" class="text-danger" />
            </div>
        </div>

        @if (selectedProducto != null && selectedProducto.StocksDepositos != null && selectedProducto.StocksDepositos.Count(s => s.StockActual > 0) > 1)
        {
            <div class="mb-3">
                <label>Depósito de Origen (*)</label>
                <select @bind="selectedDepositoId" class="form-select bg-dark text-light border-secondary">
                    <option value="">-- Seleccionar Depósito --</option>
                    @foreach (var sd in selectedProducto.StocksDepositos.Where(s => s.StockActual > 0))
                    {
                        <option value="@sd.DepositoId">@sd.DepositoNombre (Disponible: @sd.StockActual)</option>
                    }
                </select>
            </div>
        }

        <div class="row mb-3">
            <div class="col-md-6">
                <label>Fecha Aplicación (*)</label>
                <InputDate @bind-Value="model.FechaAplicacion" class="form-control bg-dark text-light border-secondary" />
                <ValidationMessage For="@(() => model.FechaAplicacion)" class="text-danger" />
            </div>
            <div class="col-md-6">
                <label>Próxima Dosis</label>
                <InputDate @bind-Value="model.FechaProximaDosis" class="form-control bg-dark text-light border-secondary" />
                <ValidationMessage For="@(() => model.FechaProximaDosis)" class="text-danger" />
            </div>
        </div>

        <div class="mb-3">
            <label>Número de Lote / Etiqueta</label>
            <InputText @bind-Value="model.NroLote" class="form-control bg-dark text-light border-secondary" placeholder="Lote de la ampolla" />
            <ValidationMessage For="@(() => model.NroLote)" class="text-danger" />
        </div>

        <div class="mb-3">
            <label>Observaciones (Reacciones, recomendaciones)</label>
            <InputTextArea @bind-Value="model.Observaciones" class="form-control bg-dark text-light border-secondary" rows="3" />
            <ValidationMessage For="@(() => model.Observaciones)" class="text-danger" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger p-2 mt-2">@errorMessage</div>
        }

        <div class="d-flex justify-content-end mt-4 gap-2">
            <button type="button" class="btn btn-outline-secondary text-light" @onclick="GoBack">Cancelar</button>
            <button type="submit" class="btn-primary-glass" disabled="@isSaving">@(isEdit ? "Guardar Cambios" : "Registrar Vacunación")</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public string PacienteId { get; set; } = string.Empty;

    [Parameter]
    public string? RegistroId { get; set; }

    private bool isEdit => !string.IsNullOrEmpty(RegistroId);

    private RegistroVacunacionDto model = new() { FechaAplicacion = DateTime.Today };
    private string pacienteNombre = "Cargando...";
    private bool isSaving;
    private string errorMessage = string.Empty;

    private List<ProductoDto> productosVacunas = new();
    private string selectedProductoId = "";
    private int? selectedDepositoId;
    private ProductoDto? selectedProducto => productosVacunas.FirstOrDefault(p => p.Id == selectedProductoId);

    private List<VeterinarioDto> vets = new();

    protected override async Task OnInitializedAsync()
    {
        model.PacienteId = PacienteId;
        var p = await PacienteService.GetByIdAsync(PacienteId);
        if(p != null) {
            pacienteNombre = p.Nombre;
            model.PacienteNombre = p.Nombre;
        }

        var prodTask = ProductoService.GetAllAsync(1, 1000);
        var vResTask = PersonalService.GetVeterinariosActivosAsync();

        await Task.WhenAll(prodTask, vResTask);

        if (prodTask.Result?.Items != null)
        {
            productosVacunas = prodTask.Result.Items
                .Where(pr => pr.Activo && (
                    (!string.IsNullOrEmpty(pr.CategoriaNombre) && pr.CategoriaNombre.Contains("Vacuna", StringComparison.OrdinalIgnoreCase)) ||
                    pr.Nombre.Contains("Vacuna", StringComparison.OrdinalIgnoreCase)
                ))
                .ToList();
        }

        if(vResTask.Result != null) vets = vResTask.Result;

        if (isEdit)
        {
            var existing = await VacunacionService.GetByIdAsync(RegistroId!);
            if (existing != null)
            {
                model = existing;
                selectedProductoId = existing.ProductoId ?? "";
                selectedDepositoId = existing.DepositoId;
            }
            else
            {
                errorMessage = "No se encontró el registro de vacunación a editar.";
            }
        }
    }

    private void OnVacunaProductoSelected()
    {
        if (selectedProducto != null)
        {
            if (selectedProducto.StocksDepositos != null && selectedProducto.StocksDepositos.Count(s => s.StockActual > 0) == 1)
            {
                selectedDepositoId = selectedProducto.StocksDepositos.First(s => s.StockActual > 0).DepositoId;
            }
            else
            {
                selectedDepositoId = null;
            }
        }
    }

    private async Task HandleSave()
    {
        if (string.IsNullOrWhiteSpace(selectedProductoId) && model.VacunaId == 0)
        {
            errorMessage = "Debe seleccionar una vacuna del inventario.";
            return;
        }
        if (string.IsNullOrWhiteSpace(model.Veterinario))
        {
            errorMessage = "Debe seleccionar un veterinario.";
            return;
        }

        var selectedProd = productosVacunas.FirstOrDefault(p => p.Id == selectedProductoId);
        if (selectedProd != null && !isEdit && selectedProd.StockActual <= 0)
        {
            errorMessage = $"No hay stock disponible para la vacuna '{selectedProd.Nombre}'.";
            return;
        }

        model.ProductoId = selectedProductoId;
        model.DepositoId = selectedDepositoId;
        if (selectedProd != null)
        {
            model.VacunaNombre = selectedProd.Nombre;
        }

        isSaving = true;
        errorMessage = string.Empty;

        try
        {
            bool success;
            if (isEdit)
            {
                success = await VacunacionService.UpdateAsync(RegistroId!, model);
            }
            else
            {
                success = await VacunacionService.CreateAsync(model);
            }

            if (success)
            {
                GoBack();
            }
            else
            {
                errorMessage = isEdit ? "Error al intentar actualizar la vacuna." : "No se pudo guardar el registro de vacunación. Verifique el stock disponible.";
                isSaving = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió una excepción: {ex.Message}";
            isSaving = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo($"/historial-clinico/paciente/{PacienteId}");
}
