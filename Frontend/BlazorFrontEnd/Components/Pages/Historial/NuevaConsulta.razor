@page "/historial-clinico/nueva-consulta/{PacienteId}"
@page "/historial-clinico/editar-consulta/{PacienteId}/{ConsultaId}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Veterinario")]
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@inject HistorialClinicoService HistorialService
@inject PacienteService PacienteService
@inject PersonalService PersonalService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(isEdit ? "Editar Consulta" : "Registrar Consulta") - Historial Clínico</PageTitle>

<div class="glass-card" style="max-width: 800px; margin: auto; margin-top:20px;">
    <h4>@(isEdit ? "Editar Consulta" : "Nueva Consulta") (@pacienteNombre)</h4>
    <hr class="border-secondary" />

    @if (editContext != null)
    {
        <EditForm EditContext="editContext" OnSubmit="HandleSave">
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <label>Fecha (*)</label>
                    <InputDate @bind-Value="model.Fecha" class="form-control bg-dark text-light border-secondary" />
                    <ValidationMessage For="@(() => model.Fecha)" class="text-danger" />
                </div>
                <div class="col-md-6">
                    <label>Veterinario Tratante (*)</label>
                    <InputSelect @bind-Value="model.Veterinario" class="form-select bg-dark text-light border-secondary">
                        <option value="">Seleccione...</option>
                        @foreach (var v in vets)
                        {
                            <option value="@v.NombreCompleto">@v.NombreCompleto</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => model.Veterinario)" class="text-danger" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label>Peso (kg) (*)</label>
                    <InputNumber @bind-Value="model.Peso" class="form-control bg-dark text-light border-secondary" TValue="decimal?" />
                    <ValidationMessage For="@(() => model.Peso)" class="text-danger" />
                </div>
                <div class="col-md-6">
                    <label>Temp (°C)</label>
                    <InputNumber @bind-Value="model.Temperatura" class="form-control bg-dark text-light border-secondary" TValue="decimal?" />
                    <ValidationMessage For="@(() => model.Temperatura)" class="text-danger" />
                </div>
            </div>

            <div class="mb-3">
                <label>Motivo de Consulta (*)</label>
                <InputText @bind-Value="model.Motivo" class="form-control bg-dark text-light border-secondary" />
                <ValidationMessage For="@(() => model.Motivo)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label>Síntomas reportados (*)</label>
                <InputTextArea @bind-Value="model.Sintomas" class="form-control bg-dark text-light border-secondary" rows="2" />
                <ValidationMessage For="@(() => model.Sintomas)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label>Diagnóstico (Presuntivo o Definitivo) (*)</label>
                <InputTextArea @bind-Value="model.Diagnostico" class="form-control bg-dark text-light border-secondary" rows="2" />
                <ValidationMessage For="@(() => model.Diagnostico)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label>Indicaciones al Propietario (*)</label>
                <InputTextArea @bind-Value="model.Indicaciones" class="form-control bg-dark text-light border-secondary" rows="3" />
                <ValidationMessage For="@(() => model.Indicaciones)" class="text-danger" />
            </div>

            <!-- Archivos Adjuntos (Preview de fotos y documentos) -->
            <div class="mb-3">
                    <label class="d-flex align-items-center gap-2" style="color: var(--text-secondary); font-size: 0.875rem;">
                        <span>Archivos Adjuntos (Imágenes, Documentos, PDFs)</span>
                        <label for="consulta-attachments" class="btn btn-sm btn-outline-info d-inline-flex align-items-center gap-1 py-1 px-2 m-0" style="cursor: pointer; font-size: 0.78rem; border-color: var(--border-glass); background: rgba(0, 163, 108, 0.05); color: var(--accent-primary);">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 14px; height: 14px;">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m18.375 12.739-7.693 7.693a4.5 4.5 0 0 1-6.364-6.364l10.94-10.94A3 3 0 1 1 19.5 7.372L8.552 18.32m.009-.01-.01.01m5.699-9.941-7.81 7.81a1.5 1.5 0 0 0 2.112 2.13" />
                            </svg>
                            Adjuntar
                        </label>
                        <InputFile id="consulta-attachments" OnChange="UploadConsultaFiles" multiple style="display: none;" />
                    </label>
                    
                    @if (consultaFilesList != null && consultaFilesList.Any())
                    {
                        <div class="row g-2 mt-2">
                            @foreach (var file in consultaFilesList)
                            {
                                var isImg = IsImageFile(file.Nombre, file.ContentType);
                                <div class="col-sm-6 col-md-4">
                                    <div class="d-flex align-items-center p-2 rounded position-relative" style="background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border-glass); gap: 10px;">
                                        @if (isImg && !string.IsNullOrEmpty(file.Base64))
                                        {
                                            <img src="data:@(string.IsNullOrEmpty(file.ContentType) ? "image/jpeg" : file.ContentType);base64,@file.Base64" 
                                                 style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid var(--accent-primary); cursor: pointer; flex-shrink: 0;" 
                                                 @onclick="() => PreviewFile(file)" 
                                                 title="Click para ampliar" />
                                        }
                                        else
                                        {
                                            <div style="width: 50px; height: 50px; border-radius: 6px; background: rgba(0, 163, 108, 0.1); border: 1px solid var(--border-glass); display: flex; align-items: center; justify-content: center; flex-shrink: 0; cursor: pointer;"
                                                 @onclick="() => PreviewFile(file)" title="Click para abrir">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 24px; height: 24px; color: var(--accent-primary);">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                                                </svg>
                                            </div>
                                        }
                                        <div style="flex: 1; min-width: 0;">
                                            <span class="d-block text-truncate text-light" style="font-size: 0.8rem; font-weight: 500;" title="@file.Nombre">@file.Nombre</span>
                                            <div class="d-flex align-items-center gap-2 mt-1">
                                                <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" style="color: var(--accent-primary); font-size: 0.75rem;" @onclick="() => PreviewFile(file)">
                                                    Ver
                                                </button>
                                                <span class="text-secondary" style="font-size: 0.75rem;">|</span>
                                                <button type="button" class="btn btn-sm btn-link p-0 text-danger text-decoration-none" style="font-size: 0.75rem;" @onclick="() => RemoveConsultaFile(file)">
                                                    Quitar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger p-2 mt-2">@errorMessage</div>
            }

            <div class="d-flex justify-content-end mt-4 gap-2">
                <button type="button" class="btn btn-outline-secondary text-light" @onclick="GoBack">Cancelar</button>
                <button type="submit" class="btn-primary-glass" disabled="@isSaving">@(isEdit ? "Guardar Cambios" : "Guardar Consulta")</button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public string PacienteId { get; set; } = string.Empty;

    [Parameter]
    public string? ConsultaId { get; set; }

    private bool isEdit => !string.IsNullOrEmpty(ConsultaId);

    private HistorialClinicoDto model = new() { Fecha = DateTime.Today };
    private string pacienteNombre = "Cargando...";
    private bool isSaving;
    private string errorMessage = string.Empty;
    private List<VeterinarioDto> vets = new();
    private List<Adjunto> consultaFilesList = new();

    private EditContext? editContext;
    private ValidationMessageStore? messageStore;

    protected override async Task OnInitializedAsync()
    {
        model.PacienteId = PacienteId;
        
        var p = await PacienteService.GetByIdAsync(PacienteId);
        if(p != null) {
            pacienteNombre = p.Nombre;
            model.PacienteNombre = p.Nombre;
        }

        var vRes = await PersonalService.GetVeterinariosActivosAsync();
        if(vRes != null) vets = vRes;

        if (isEdit)
        {
            var existing = await HistorialService.GetByIdAsync(ConsultaId!);
            if (existing != null)
            {
                model = existing;
                try
                {
                    consultaFilesList = string.IsNullOrEmpty(model.ArchivosAdjuntos)
                        ? new List<Adjunto>()
                        : System.Text.Json.JsonSerializer.Deserialize<List<Adjunto>>(model.ArchivosAdjuntos) ?? new List<Adjunto>();
                }
                catch
                {
                    consultaFilesList = new List<Adjunto>();
                }
            }
            else
            {
                errorMessage = "No se encontró la consulta a editar.";
            }
        }

        editContext = new EditContext(model);
        messageStore = new ValidationMessageStore(editContext);
        editContext.OnFieldChanged += HandleFieldChanged;
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        messageStore?.Clear(e.FieldIdentifier);
    }

    private async Task HandleSave()
    {
        isSaving = true;
        errorMessage = string.Empty;
        messageStore?.Clear();
        bool hasErrors = false;

        model.ArchivosAdjuntos = System.Text.Json.JsonSerializer.Serialize(consultaFilesList);

        if (model.Fecha == null)
        {
            messageStore?.Add(() => model.Fecha!, "La fecha es obligatoria");
            hasErrors = true;
        }
        else if (model.Fecha.Value.Date > DateTime.Today)
        {
            messageStore?.Add(() => model.Fecha!, "Las consultas ya deben haber sido realizadas");
            hasErrors = true;
        }

        if (string.IsNullOrWhiteSpace(model.Veterinario))
        {
            messageStore?.Add(() => model.Veterinario, "Seleccionar un veterinario es obligatorio");
            hasErrors = true;
        }

        if (model.Peso == null)
        {
            messageStore?.Add(() => model.Peso!, "Ingresar el peso de la mascota es obligatorio");
            hasErrors = true;
        }
        else if (model.Peso < 0)
        {
            messageStore?.Add(() => model.Peso!, "No se puede ingresar un peso negativo");
            hasErrors = true;
        }

        if (model.Temperatura.HasValue && (model.Temperatura.Value < 1 || model.Temperatura.Value > 50))
        {
            messageStore?.Add(() => model.Temperatura!, "La temperatura debe estar entre 1 y 50 °C");
            hasErrors = true;
        }

        if (string.IsNullOrWhiteSpace(model.Motivo))
        {
            messageStore?.Add(() => model.Motivo, "El motivo de consulta es obligatorio");
            hasErrors = true;
        }

        if (string.IsNullOrWhiteSpace(model.Sintomas))
        {
            messageStore?.Add(() => model.Sintomas, "Los síntomas reportados son obligatorios");
            hasErrors = true;
        }

        if (string.IsNullOrWhiteSpace(model.Diagnostico))
        {
            messageStore?.Add(() => model.Diagnostico, "El diagnóstico es obligatorio");
            hasErrors = true;
        }

        if (string.IsNullOrWhiteSpace(model.Indicaciones))
        {
            messageStore?.Add(() => model.Indicaciones, "Las indicaciones al propietario son obligatorias");
            hasErrors = true;
        }

        editContext?.NotifyValidationStateChanged();

        if (hasErrors)
        {
            isSaving = false;
            return;
        }

        try
        {
            bool success;
            if (isEdit)
            {
                success = await HistorialService.UpdateAsync(ConsultaId!, model);
            }
            else
            {
                success = await HistorialService.CreateAsync(model);
            }

            if (success)
            {
                GoBack();
            }
            else
            {
                errorMessage = isEdit ? "Error al intentar actualizar la consulta." : "Error al intentar guardar la consulta.";
                isSaving = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió una excepción: {ex.Message}";
            isSaving = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo($"/historial-clinico/paciente/{PacienteId}");

    private async Task UploadConsultaFiles(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(10))
        {
            try
            {
                var maxAllowedSize = 5 * 1024 * 1024;
                using var stream = file.OpenReadStream(maxAllowedSize);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                
                consultaFilesList.Add(new Adjunto
                {
                    Nombre = file.Name,
                    Base64 = base64,
                    ContentType = file.ContentType
                });
            }
            catch (Exception ex)
            {
                errorMessage = $"Error al cargar archivo {file.Name}: {ex.Message}";
            }
        }
    }

    private void RemoveConsultaFile(Adjunto file)
    {
        consultaFilesList.Remove(file);
    }

    private async Task PreviewFile(Adjunto file)
    {
        try
        {
            await JS.InvokeVoidAsync("openBase64File", file.Base64, file.Nombre, file.ContentType);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al abrir archivo: {ex.Message}");
        }
    }

    private bool IsImageFile(string? nombre, string? contentType)
    {
        if (!string.IsNullOrEmpty(contentType) && contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            return true;
        if (string.IsNullOrEmpty(nombre)) return false;
        var ext = System.IO.Path.GetExtension(nombre).ToLowerInvariant();
        return ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif" || ext == ".webp" || ext == ".bmp";
    }

    public void Dispose()
    {
        if (editContext != null)
        {
            editContext.OnFieldChanged -= HandleFieldChanged;
        }
    }
}
