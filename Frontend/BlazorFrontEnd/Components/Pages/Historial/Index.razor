@page "/historial-clinico"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Veterinario")]
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@inject PacienteService PacienteService
@inject NavigationManager Navigation

<PageTitle>Historia Clínica</PageTitle>

<div class="d-flex justify-content-between align-items-center" style="margin-bottom: var(--sp-lg);">
    <div>
        <h2 style="font-weight: 700; margin: 0;">Historia Clínica</h2>
        <p class="text-secondary" style="margin: 0;">Seleccione un paciente para ver su historia clínica completa</p>
    </div>
</div>

<div class="glass-card">
    <div class="d-flex justify-content-between align-items-center" style="margin-bottom: var(--sp-md);">
        <h4 style="margin: 0;">Seleccionar Paciente</h4>
        <input type="text" value="@searchTerm" @oninput="OnSearchInput" class="form-control" placeholder="Buscar mascota por nombre..." style="width: 350px; background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); color: white;" />
    </div>

    @if (isLoading)
    {
        <p class="text-secondary">Cargando directorio de pacientes...</p>
    }
    else if (pacientesResponse?.Items == null || !pacientesResponse.Items.Any())
    {
        <p class="text-secondary">No se encontraron mascotas que coincidan con la búsqueda.</p>
    }
    else
    {
        <div class="row" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--sp-md);">
            @foreach (var p in pacientesResponse.Items)
            {
                <div class="glass-card" style="padding: 15px; cursor: pointer; transition: transform 0.2s;" @onclick="() => VerHistorial(p.Id)" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <strong style="font-size: 1.1rem; color: var(--accent-primary);">@p.Nombre</strong>
                            <div class="text-secondary" style="font-size: 0.85rem;">@p.EspecieNombre | @p.PropietarioNombre</div>
                        </div>
                        <div style="width: 40px; height: 40px; background: rgba(255,255,255,0.08); border-radius: 50%; display:flex; align-items:center; justify-content:center; border: 1px solid var(--border-glass);">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" style="width: 20px; height: 20px; color: var(--accent-primary);">
                                <path d="M8.5 3a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Zm7 0a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM4.5 7.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Zm15 0a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM12 9.5c-3.5 0-6 2.5-6 5.5 0 2.5 2 4.5 4.5 4.5.8 0 1.2-.5 1.5-.5s.7.5 1.5.5c2.5 0 4.5-2 4.5-4.5 0-3-2.5-5.5-6-5.5Z"/>
                            </svg>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <div class="d-flex justify-content-between align-items-center mt-4">
            <span class="text-secondary">Página @pacientesResponse.PageIndex de @pacientesResponse.TotalPages</span>
            <div>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(!pacientesResponse.HasPreviousPage)" @onclick="PreviousPage">Anterior</button>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(!pacientesResponse.HasNextPage)" @onclick="NextPage">Siguiente</button>
            </div>
        </div>
    }
</div>

@code {
    private PaginatedList<PacienteDto>? pacientesResponse;
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private CancellationTokenSource? _debounceToken;
    private int currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        StateHasChanged();
        pacientesResponse = await PacienteService.GetAllAsync(currentPage, 12, searchTerm);
        isLoading = false;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;

        // Debounce: cancel previous pending search
        _debounceToken?.Cancel();
        _debounceToken = new CancellationTokenSource();
        var token = _debounceToken.Token;

        try
        {
            await Task.Delay(400, token);
            if (!token.IsCancellationRequested)
            {
                await LoadDataAsync();
            }
        }
        catch (TaskCanceledException) { /* debounce cancelled, expected */ }
    }

    private void VerHistorial(string id)
    {
        Navigation.NavigateTo($"/historial-clinico/paciente/{id}");
    }

    private async Task PreviousPage() { if (pacientesResponse?.HasPreviousPage == true) { currentPage--; await LoadDataAsync(); } }
    private async Task NextPage() { if (pacientesResponse?.HasNextPage == true) { currentPage++; await LoadDataAsync(); } }
}

