@page "/ventas/pos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Veterinario,Recepcionista")]
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@inject VentaService VentaService
@inject PacienteService PacienteService 
@inject PropietarioService PropietarioService
@inject ProductoService ProductoService
@inject CatalogoServiciosService ServiciosService
@inject MetodoPagoService PagoService
@inject CatalogoInventarioService CatalogoService
@inject NavigationManager Navigation

<PageTitle>Punto de Venta (POS)</PageTitle>

<div class="row">
    <!-- Panel Izquierdo: Buscador y Catálogo -->
    <div class="col-md-7">
        <div class="d-flex align-items-center mb-3">
            <button class="btn btn-outline-secondary me-3" @onclick="GoBack">
                 ← Volver a Comercio
            </button>
            <h3 class="m-0" style="font-weight: 700;">Registrar Venta</h3>
        </div>

        <div class="glass-card mb-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="m-0">@(EsCobroTurno ? "Buscador de Productos y Servicios" : "Buscador de productos")</h5>
                @if (EsCobroTurno)
                {
                    <span class="badge bg-success d-inline-flex align-items-center gap-1" style="font-size: 0.75rem; padding: 5px 9px;">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 14px; height: 14px;">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5V6.75a4.5 4.5 0 1 1 9 0v3.75M3.75 21.75h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H3.75A2.25 2.25 0 0 0 1.5 13.5v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                        </svg>
                        Servicios Desbloqueados (Cobro de Turno)
                    </span>
                }
            </div>

            @if (EsCobroTurno)
            {
                <div class="btn-group mb-3 w-100" role="group" aria-label="Filtro Tipo Item">
                    <button type="button" class="btn btn-sm @(tipoFiltro == "TODOS" ? "btn-primary text-white" : "btn-outline-secondary")" @onclick='() => CambiarFiltroTipo("TODOS")' style="font-size: 0.8rem; font-weight: 600;">
                        Todos
                    </button>
                    <button type="button" class="btn btn-sm @(tipoFiltro == "PRODUCTOS" ? "btn-primary text-white" : "btn-outline-secondary")" @onclick='() => CambiarFiltroTipo("PRODUCTOS")' style="font-size: 0.8rem; font-weight: 600;">
                        Solo Productos
                    </button>
                    <button type="button" class="btn btn-sm @(tipoFiltro == "SERVICIOS" ? "btn-success text-white" : "btn-outline-secondary")" @onclick='() => CambiarFiltroTipo("SERVICIOS")' style="font-size: 0.8rem; font-weight: 600;">
                        Solo Servicios (@(allActiveServicios.Count))
                    </button>
                </div>
            }

            <div class="input-group">
                <span class="input-group-text bg-transparent border-secondary text-secondary" style="border-color: var(--border-glass) !important;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 16px; height: 16px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                    </svg>
                </span>
                <input type="text" class="form-control" placeholder="@(EsCobroTurno ? "Escanear Código de Barras o buscar producto / servicio..." : "Escanear Código de Barras o buscar producto...")" @bind-value="searchTerm" @bind-value:event="oninput" @onkeyup="OnSearch" />
                <button class="btn btn-outline-info" type="button" @onclick="BuscarProductosYServicios">Buscar</button>
            </div>

            @if(isSearching)
            {
               <div class="mt-2 text-secondary small">Cargando resultados...</div> 
            }
            else if ((searchResponse?.Items != null && searchResponse.Items.Any()) || (matchingServicios != null && matchingServicios.Any()))
            {
                <div class="list-group mt-3" style="max-height: 480px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px;">
                    <!-- Servicios Encontrados (Solo habilitado en cobro de turno) -->
                    @if (EsCobroTurno && matchingServicios != null)
                    {
                        @foreach(var serv in matchingServicios)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center"
                                 style="border-left: 5px solid #10b981 !important; border-color: var(--border-glass) !important; background: rgba(16, 185, 129, 0.06);">
                                <div style="flex: 1; margin-right: 12px;">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-success" style="font-size: 0.7rem; letter-spacing: 0.5px;">SERVICIO</span>
                                        <strong style="font-size: 0.95rem;">@serv.Nombre</strong>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(serv.Descripcion))
                                    {
                                        <small class="text-secondary d-block">@serv.Descripcion</small>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(serv.ProductosUtilizados))
                                    {
                                        <small class="text-info" style="font-size: 0.72rem;">
                                            Insumos vinculados: @serv.ProductosUtilizados
                                        </small>
                                    }
                                </div>
                                <div class="text-end d-flex flex-column align-items-end gap-1">
                                    <span class="d-block text-success fw-bold" style="font-size: 1.05rem;">$@serv.Precio.ToString("N2")</span>
                                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => AgregarServicioAlCarrito(serv)" style="font-size: 0.8rem; padding: 3px 10px;">
                                        + Añadir al carrito
                                    </button>
                                </div>
                            </div>
                        }
                    }

                    <!-- Productos Encontrados -->
                    @if (searchResponse?.Items != null)
                    {
                        @foreach(var prod in searchResponse.Items)
                        {
                            var agotado = prod.StockActual <= 0;
                            <div class="list-group-item d-flex justify-content-between align-items-center"
                                 style="border-left: 5px solid #3b82f6 !important; border-color: var(--border-glass) !important; background: rgba(59, 130, 246, 0.05); @(agotado ? "opacity: 0.6;" : "")">
                                <div style="flex: 1; margin-right: 12px;">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-primary" style="font-size: 0.7rem; letter-spacing: 0.5px;">PRODUCTO</span>
                                        <strong style="font-size: 0.95rem;">@prod.Nombre</strong>
                                    </div>
                                    <small class="text-secondary">Cod: @prod.CodigoBarras - Stock Total: @prod.StockActual</small>
                                    @if (prod.StocksDepositos != null && prod.StocksDepositos.Any())
                                    {
                                        <br/>
                                        <small class="text-secondary" style="font-size: 0.72rem;">
                                            @string.Join(" | ", prod.StocksDepositos.Select(sd => $"{sd.DepositoNombre}: {sd.StockActual}"))
                                        </small>
                                    }
                                </div>
                                <div class="text-end d-flex flex-column align-items-end gap-1">
                                    <span class="d-block" style="color: #60a5fa; font-weight: bold; font-size: 1.05rem;">$@prod.PrecioVenta.ToString("N2")</span>
                                    @if(agotado)
                                    {
                                        <span class="badge bg-danger">Agotado</span>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AgregarAlCarrito(prod)" style="font-size: 0.8rem; padding: 3px 10px;">
                                            + Añadir al carrito
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(searchTerm) && !isSearching)
            {
                <div class="mt-3 text-secondary small text-center p-3">
                    No se encontraron @(EsCobroTurno ? "productos ni servicios" : "productos") con el término "<strong>@searchTerm</strong>".
                </div>
            }
            else if (EsCobroTurno && tipoFiltro == "SERVICIOS" && (matchingServicios == null || !matchingServicios.Any()))
            {
                <div class="mt-3 text-secondary small text-center p-3">
                    No hay servicios disponibles.
                </div>
            }
        </div>
    </div>

    <!-- Panel Derecho: Ticket / Carrito -->
    <div class="col-md-5">
        <div class="glass-card" style="height: 100%; display: flex; flex-direction: column;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="m-0">Carrito Actual</h4>
                @if (carrito.Any())
                {
                    <button class="btn btn-sm btn-outline-danger" @onclick="VaciarCarrito">Vaciar</button>
                }
            </div>

            <!-- Alerta informativa si se agregaron insumos por servicio -->
            @if (!string.IsNullOrEmpty(serviceAlertMessage))
            {
                <div class="alert alert-warning alert-dismissible fade show p-2 mb-2" role="alert" style="font-size: 0.82rem; background: rgba(245, 158, 11, 0.15); border: 1px solid #f59e0b; color: #fde68a;">
                    <div class="d-flex align-items-start gap-2">
                        <span style="font-size: 1rem;">⚠️</span>
                        <div style="flex: 1;">@serviceAlertMessage</div>
                        <button type="button" class="btn-close" style="font-size: 0.65rem; padding: 6px;" @onclick="() => serviceAlertMessage = string.Empty"></button>
                    </div>
                </div>
            }

            <!-- Listado de items -->
            <div class="flex-grow-1 border border-secondary rounded p-2 mb-3" style="overflow-y: auto; background: rgba(0,0,0,0.2); min-height: 250px;">
                @if(!carrito.Any())
                {
                    <div class="text-center text-secondary mt-5">
                        <p>El carrito está vacío.</p>
                        <small>Busque o escanee productos/servicios para agregarlos al carrito.</small>
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush" style="display: flex; flex-direction: column; gap: 6px;">
                    @foreach(var item in carrito)
                    {
                        var isService = item.EsServicio || string.IsNullOrEmpty(item.ProductoId);
                        var prodInfo = !isService && !string.IsNullOrEmpty(item.ProductoId) ? productosEnCarrito.GetValueOrDefault(item.ProductoId) : null;
                        
                        <li class="list-group-item bg-transparent px-2 py-2 rounded"
                            style="border-left: 4px solid @(isService ? "#10b981" : "#3b82f6") !important; border: 1px solid var(--border-glass); background: rgba(255,255,255,0.03);">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="badge @(isService ? "bg-success" : "bg-primary") me-1" style="font-size: 0.65rem;">
                                        @(isService ? "Servicio" : "Producto")
                                    </span>
                                    <strong style="font-size: 0.9rem;">@item.Descripcion</strong>
                                </div>
                                <button class="btn btn-link text-danger p-0" title="Eliminar del carrito" @onclick="() => RemoverDelCarrito(item)">✕</button>
                            </div>

                            @* Selector de depósito solo para productos físicos *@
                            @if (!isService && prodInfo?.StocksDepositos != null && prodInfo.StocksDepositos.Any())
                            {
                                <div class="mt-1">
                                    <select value="@(item.DepositoId ?? 0)" @onchange="(e) => OnDepositoChanged(item, e)" class="form-select form-select-sm bg-dark text-light border-secondary" style="font-size: 0.78rem; padding: 2px 8px; height: auto;">
                                        <option value="0">— Seleccionar depósito —</option>
                                        @foreach (var sd in prodInfo.StocksDepositos.Where(s => s.StockActual > 0))
                                        {
                                            <option value="@sd.DepositoId">@sd.DepositoNombre (disp: @sd.StockActual)</option>
                                        }
                                    </select>
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <div class="d-flex align-items-center">
                                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="() => DisminuirCantidad(item)">-</button>
                                    <span class="mx-2 fw-bold" style="font-size: 0.9rem;">@item.Cantidad</span>
                                    <button class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="() => AumentarCantidad(item)">+</button>
                                </div>
                                <div>
                                    <span class="text-secondary small me-2">$@item.PrecioUnitario.ToString("N2") c/u</span>
                                    <strong style="color: @(isService ? "#10b981" : "var(--accent-primary)"); font-size: 0.95rem;">
                                        $@((item.Cantidad * item.PrecioUnitario).ToString("N2"))
                                    </strong>
                                </div>
                            </div>
                        </li>
                    }
                    </ul>
                }
            </div>

            <!-- Total y Cobro -->
            <div class="mt-auto">
                <div class="d-flex justify-content-between mb-3 text-primary">
                    <h5 class="m-0 text-dark">TOTAL:</h5>
                    <h3 class="m-0" style="color: var(--accent-primary); font-weight: 900;">$@TotalCarrito.ToString("N2")</h3>
                </div>

                @if (propietarios != null && propietarios.Any())
                {
                    <div class="mb-2">
                        <label class="text-secondary small">Cliente / Propietario</label>
                        <select @bind="ventaRequest.PropietarioId" class="form-select form-select-sm bg-dark text-light border-secondary">
                            <option value="">Consumidor Final / Sin Asignar</option>
                            @foreach(var p in propietarios)
                            {
                                <option value="@p.Id">@p.NombreCompleto - DNI: @p.DNI</option>
                            }
                        </select>
                    </div>
                }

                <div class="mb-3">
                    <label class="text-secondary small">Método de Pago (*)</label>
                    <select @bind="ventaRequest.MetodoPagoId" class="form-select form-select-lg">
                        <option value="0">Cobrar con...</option>
                        @foreach(var m in metodosPago)
                        {
                            <option value="@m.Id">@m.Nombre</option>
                        }
                    </select>
                </div>

                @if(!string.IsNullOrEmpty(msgError))
                {
                    <div class="alert alert-danger p-2 small m-0 mb-3">@msgError</div>
                }

                <button class="btn-primary-glass w-100 btn-lg" disabled="@procesando" @onclick="ProcesarVenta">
                    @if(procesando) { <span>Procesando...</span> } else { <span>Registrar venta</span> }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public int? ServicioId { get; set; }

    [SupplyParameterFromQuery]
    public string? PacienteId { get; set; }

    [SupplyParameterFromQuery]
    public string? PropietarioId { get; set; }

    [SupplyParameterFromQuery]
    public string? TurnoId { get; set; }

    private bool EsCobroTurno => !string.IsNullOrEmpty(TurnoId) || (ServicioId.HasValue && ServicioId.Value > 0);

    private string searchTerm = "";
    private string tipoFiltro = "TODOS"; // "TODOS", "PRODUCTOS", "SERVICIOS"
    private System.Timers.Timer? debounceTimer;
    private bool isSearching;
    private PaginatedList<ProductoDto>? searchResponse;
    private List<ServicioDto> matchingServicios = new();
    private List<ServicioDto> allActiveServicios = new();
    private List<ProductoDto> allInventoryProducts = new();
    private List<PropietarioDto> propietarios = new();

    private List<CreateDetalleVentaRequest> carrito = new();
    private Dictionary<string, ProductoDto> productosEnCarrito = new();
    private CreateVentaRequest ventaRequest = new() { MetodoPagoId = 0 };
    
    // Auxiliares combo boxes
    private List<MetodoPagoDto> metodosPago = new();
    private List<DepositoDto> depositos = new();

    private bool procesando;
    private string msgError = "";
    private string serviceAlertMessage = "";

    private decimal TotalCarrito => carrito.Sum(x => x.Cantidad * x.PrecioUnitario);
    private bool PuedeCobrar => carrito.Any() && ventaRequest.MetodoPagoId > 0 && !procesando
        && carrito.All(c => DepositoValido(c));

    protected override async Task OnInitializedAsync()
    {
        var pagosTask = PagoService.GetAllActivosAsync();
        var depTask = CatalogoService.GetDepositosAsync();
        var servTask = ServiciosService.GetServiciosActivosAsync();
        var prodTask = ProductoService.GetAllAsync(1, 1000);
        var propTask = PropietarioService.GetAllActivosAsync();
        
        await Task.WhenAll(pagosTask, depTask, servTask, prodTask, propTask);

        if(pagosTask.Result != null) metodosPago = pagosTask.Result;
        if(depTask.Result != null) depositos = depTask.Result;
        if(servTask.Result != null) allActiveServicios = servTask.Result;
        if(prodTask.Result?.Items != null) allInventoryProducts = prodTask.Result.Items;
        if(propTask.Result != null) propietarios = propTask.Result;

        // Si se redirige desde un turno completado, precargar servicio y datos
        if (ServicioId.HasValue && ServicioId.Value > 0)
        {
            var servicio = allActiveServicios.FirstOrDefault(s => s.Id == ServicioId.Value);
            if (servicio != null)
            {
                AgregarServicioAlCarrito(servicio);
                serviceAlertMessage = $"¡Cobro precargado desde Turno! Servicio \"{servicio.Nombre}\" añadido al carrito. Seleccione el método de pago para registrar la venta.";
            }
        }

        if (!string.IsNullOrEmpty(PropietarioId))
        {
            ventaRequest.PropietarioId = PropietarioId;
        }
        else if (!string.IsNullOrEmpty(PacienteId))
        {
            try
            {
                var pac = await PacienteService.GetByIdAsync(PacienteId);
                if (pac != null && !string.IsNullOrEmpty(pac.PropietarioId))
                {
                    ventaRequest.PropietarioId = pac.PropietarioId;
                }
            }
            catch {}
        }
    }

    /// <summary>
    /// Returns true if the item is a service or either has no depot stocks (old product) or has a depot selected
    /// </summary>
    private bool DepositoValido(CreateDetalleVentaRequest item)
    {
        if (item.EsServicio || string.IsNullOrEmpty(item.ProductoId))
            return true; // Los servicios no requieren depósito

        var prod = productosEnCarrito.GetValueOrDefault(item.ProductoId);
        if (prod?.StocksDepositos == null || !prod.StocksDepositos.Any())
            return true; // No depot-based stock, allow global
        return item.DepositoId.HasValue && item.DepositoId.Value > 0;
    }

    private void OnSearch()
    {
        if (debounceTimer != null) debounceTimer.Dispose();
        debounceTimer = new System.Timers.Timer(400);
        debounceTimer.Elapsed += async (s, e) =>
        {
            await InvokeAsync(BuscarProductosYServicios);
            await InvokeAsync(StateHasChanged);
        };
        debounceTimer.AutoReset = false;
        debounceTimer.Start();
    }

    private async Task BuscarProductosYServicios()
    {
        isSearching = true;
        StateHasChanged();
        try
        {
            // 1. Buscar productos si no está filtrado exclusivamente por servicios
            if (tipoFiltro != "SERVICIOS")
            {
                if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    searchResponse = await ProductoService.GetAllAsync(1, 20, searchTerm);
                }
                else
                {
                    searchResponse = null;
                }
            }
            else
            {
                searchResponse = null;
            }

            // 2. Buscar servicios SOLO cuando proviene de un turno completado (EsCobroTurno)
            if (EsCobroTurno && tipoFiltro != "PRODUCTOS")
            {
                if (string.IsNullOrWhiteSpace(searchTerm))
                {
                    matchingServicios = tipoFiltro == "SERVICIOS"
                        ? allActiveServicios.Where(s => s.Activo).ToList()
                        : new List<ServicioDto>();
                }
                else
                {
                    matchingServicios = allActiveServicios
                        .Where(s => s.Activo && (
                            s.Nombre.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || 
                            (!string.IsNullOrEmpty(s.Descripcion) && s.Descripcion.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                        )).ToList();
                }
            }
            else
            {
                matchingServicios.Clear();
            }
        }
        finally
        {
            isSearching = false;
        }
    }

    private async Task CambiarFiltroTipo(string nuevoTipo)
    {
        tipoFiltro = nuevoTipo;
        await BuscarProductosYServicios();
    }

    private void AgregarAlCarrito(ProductoDto p)
    {
        var existente = carrito.FirstOrDefault(x => !x.EsServicio && x.ProductoId == p.Id);
        if(existente != null)
        {
            // Check stock limit
            var maxStock = GetMaxStock(p, existente.DepositoId);
            if(existente.Cantidad < maxStock) existente.Cantidad++;
        }
        else
        {
            // Auto-select depot if product only has one depot with stock
            int? autoDepositoId = null;
            if (p.StocksDepositos != null && p.StocksDepositos.Count(sd => sd.StockActual > 0) == 1)
            {
                autoDepositoId = p.StocksDepositos.First(sd => sd.StockActual > 0).DepositoId;
            }

            carrito.Add(new CreateDetalleVentaRequest {
                ProductoId = p.Id, Descripcion = p.Nombre, 
                PrecioUnitario = p.PrecioVenta, Cantidad = 1,
                DepositoId = autoDepositoId,
                EsServicio = false
            });
            productosEnCarrito[p.Id] = p;
        }
    }

    private void AgregarServicioAlCarrito(ServicioDto s)
    {
        // 1. Agregar el servicio al carrito
        var existenteServicio = carrito.FirstOrDefault(x => x.EsServicio && x.Descripcion == s.Nombre);
        if (existenteServicio != null)
        {
            existenteServicio.Cantidad++;
        }
        else
        {
            carrito.Add(new CreateDetalleVentaRequest
            {
                ProductoId = null,
                Descripcion = s.Nombre,
                PrecioUnitario = s.Precio,
                Cantidad = 1,
                DepositoId = null,
                EsServicio = true
            });
        }

        // 2. Si el servicio tiene productos utilizados, agregarlos al carrito
        if (!string.IsNullOrWhiteSpace(s.ProductosUtilizados))
        {
            var productNames = s.ProductosUtilizados
                .Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            var productosAgregados = new List<string>();

            foreach (var pName in productNames)
            {
                // Buscar producto en el inventario por coincidencia exacta o contenida
                var prod = allInventoryProducts.FirstOrDefault(p =>
                    p.Nombre.Equals(pName, StringComparison.OrdinalIgnoreCase)) ??
                    allInventoryProducts.FirstOrDefault(p =>
                    p.Nombre.Contains(pName, StringComparison.OrdinalIgnoreCase));

                if (prod != null)
                {
                    AgregarAlCarrito(prod);
                    productosAgregados.Add(prod.Nombre);
                }
            }

            if (productosAgregados.Any())
            {
                serviceAlertMessage = $"El servicio \"{s.Nombre}\" incluye insumos vinculados ({string.Join(", ", productosAgregados)}). Se han agregado automáticamente al carrito para descontar su stock. Por favor revise los ítems, depósitos y precios antes de cobrar.";
            }
        }
    }

    private void OnDepositoChanged(CreateDetalleVentaRequest item, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var depId) && depId > 0)
        {
            item.DepositoId = depId;
            // Reset quantity to 1 if current quantity exceeds depot stock
            if (!string.IsNullOrEmpty(item.ProductoId))
            {
                var prod = productosEnCarrito.GetValueOrDefault(item.ProductoId);
                if (prod != null)
                {
                    var sdStock = prod.StocksDepositos?.FirstOrDefault(sd => sd.DepositoId == depId)?.StockActual ?? 0;
                    if (item.Cantidad > sdStock && sdStock > 0) item.Cantidad = sdStock;
                }
            }
        }
        else
        {
            item.DepositoId = null;
        }
    }

    private int GetMaxStock(ProductoDto p, int? depositoId)
    {
        if (depositoId.HasValue && depositoId.Value > 0 && p.StocksDepositos != null)
        {
            return p.StocksDepositos.FirstOrDefault(sd => sd.DepositoId == depositoId.Value)?.StockActual ?? p.StockActual;
        }
        return p.StockActual;
    }

    private void RemoverDelCarrito(CreateDetalleVentaRequest item)
    {
        carrito.Remove(item);
        if (!string.IsNullOrEmpty(item.ProductoId) && !carrito.Any(c => c.ProductoId == item.ProductoId))
            productosEnCarrito.Remove(item.ProductoId);
    }

    private void VaciarCarrito() { carrito.Clear(); productosEnCarrito.Clear(); serviceAlertMessage = string.Empty; }

    private void AumentarCantidad(CreateDetalleVentaRequest item)
    {
        if (item.EsServicio || string.IsNullOrEmpty(item.ProductoId))
        {
            item.Cantidad++;
            return;
        }

        var prod = productosEnCarrito.GetValueOrDefault(item.ProductoId);
        if (prod != null)
        {
            var max = GetMaxStock(prod, item.DepositoId);
            if (item.Cantidad < max) item.Cantidad++;
        }
        else
        {
            item.Cantidad++;
        }
    }

    private void DisminuirCantidad(CreateDetalleVentaRequest item) { 
        if(item.Cantidad > 1) item.Cantidad--; 
        else RemoverDelCarrito(item);
    }

    private async Task ProcesarVenta()
    {
        msgError = "";
        
        // 1. Validar que haya al menos un producto o servicio en la lista
        if (!carrito.Any())
        {
            msgError = "Debe ingresar al menos un producto o servicio al carrito.";
            return;
        }

        // 2. Validar que todos los productos físicos tengan depósito seleccionado si corresponde
        foreach (var item in carrito)
        {
            if (!DepositoValido(item))
            {
                msgError = $"Debe seleccionar de qué depósito está retirando el producto '{item.Descripcion}'";
                return;
            }
        }

        // 3. Validar que se haya seleccionado un método de pago
        if (ventaRequest.MetodoPagoId <= 0)
        {
            msgError = "Debe seleccionar un método de pago.";
            return;
        }

        procesando = true;
        
        // Asignar los items del carrito final a la request
        ventaRequest.Detalles = carrito;

        try
        {
            var ventaIdStr = await VentaService.CreateVentaAsync(ventaRequest);
            
            if(!string.IsNullOrEmpty(ventaIdStr))
            {
                Navigation.NavigateTo("/ventas"); 
            }
            else
            {
                msgError = "La caja reportó un error. Verifique niveles de stock y método de pago.";
            }
        }
        catch(Exception)
        {
            msgError = "Falla de red procesando la venta.";
        }
        finally
        {
            procesando = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/ventas");
}
