@page "/inventario/proveedores"
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@inject CatalogoInventarioService CatalogoService
@inject NavigationManager Navigation

<PageTitle>Proveedores</PageTitle>

<div class="d-flex justify-content-between align-items-center" style="margin-bottom: var(--sp-lg);">
    <div class="d-flex align-items-center">
        <button class="btn btn-link" style="color: var(--text-secondary); padding: 0; margin-right: 15px;" @onclick="GoBack">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 24px; height: 24px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
        </button>
        <div>
            <h2 style="font-weight: 700; margin: 0;">Proveedores</h2>
            <p class="text-secondary" style="margin: 0;">Directorio de agentes comerciales de suministro</p>
        </div>
    </div>
    <button class="btn-primary-glass" @onclick="OpenProveedorModalForCreate" style="display: flex; align-items: center; gap: 8px;">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 20px;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Nuevo Proveedor
    </button>
</div>

<div class="glass-card">
    @if (isLoading)
    {
        <p class="text-secondary">Cargando proveedores...</p>
    }
    else if (Items == null || !Items.Any())
    {
        <p class="text-secondary">No hay proveedores registrados. Comienza agregando uno.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover" style="background: transparent;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--border-glass);">
                        <th>ID</th>
                        <th>Razón Social</th>
                        <th>CUIT</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        <th>Activo</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Items)
                    {
                        <tr style="border-bottom: 1px solid var(--border-glass);">
                            <td><span class="text-secondary">#@i.Id</span></td>
                            <td><strong>@i.RazonSocial</strong></td>
                            <td>@i.Cuit</td>
                            <td>@i.Telefono</td>
                            <td><a href="mailto:@i.Email" target="_blank" onclick="window.open(this.href, '_blank'); return false;" class="text-light">@i.Email</a></td>
                            <td>
                                @if(i.Activo) { <span class="badge bg-success">Sí</span> }
                                else { <span class="badge bg-danger">No</span> }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-info" style="border-color: var(--border-glass); color: var(--text-primary);" @onclick="() => OpenProveedorModalForEdit(i.Id)">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" style="margin-left: 5px;" @onclick="() => ConfirmDelete(i.Id)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
        @errorMessage
    </div>
}


@* ── Modal de Proveedor (Nuevo/Editar) ── *@
@if (showProveedorModal)
{
    <div class="modal-overlay modal-overlay-z1" @onclick="CloseProveedorModal" @onclick:stopPropagation="false">
        <div class="modal-panel" style="max-width: 800px;" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>@(string.IsNullOrEmpty(proveedorModel.Id) ? "Nuevo Proveedor" : "Editar Proveedor")</h3>
                <button class="modal-close-btn" @onclick="CloseProveedorModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <EditForm Model="proveedorModel" OnValidSubmit="HandleSaveProveedor" FormName="modalProveedorForm">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-md-7 mb-3">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Razón Social (*)</label>
                        <InputText @bind-Value="proveedorModel.RazonSocial" class="form-control bg-dark text-light border-secondary" placeholder="Ej. Droguería del Sur S.A." />
                        <ValidationMessage For="@(() => proveedorModel.RazonSocial)" class="text-danger" />
                    </div>
                    <div class="col-md-5 mb-3">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">CUIT (*)</label>
                        <InputText @bind-Value="proveedorModel.Cuit" class="form-control bg-dark text-light border-secondary" placeholder="XX-XXXXXXXX-X" />
                        <ValidationMessage For="@(() => proveedorModel.Cuit)" class="text-danger" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Teléfono / Celular</label>
                        <InputText @bind-Value="proveedorModel.Telefono" class="form-control bg-dark text-light border-secondary" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Email de Contacto</label>
                        <InputText @bind-Value="proveedorModel.Email" type="email" class="form-control bg-dark text-light border-secondary" placeholder="ventas@proveedor.com" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Dirección Física</label>
                    <InputText @bind-Value="proveedorModel.Direccion" class="form-control bg-dark text-light border-secondary" placeholder="Calle, Número, Ciudad, Provincia" />
                </div>

                <div class="form-check form-switch mb-3">
                    <InputCheckbox @bind-Value="proveedorModel.Activo" class="form-check-input" id="modalProveedorActivoSw" />
                    <label class="form-check-label" for="modalProveedorActivoSw" style="color: var(--text-secondary);">Proveedor Activo (Habilitado para compras)</label>
                </div>

                @if (!string.IsNullOrEmpty(proveedorErrorMessage))
                {
                    <div class="alert alert-danger p-2 mt-2" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">@proveedorErrorMessage</div>
                }

                <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                    <button type="button" class="btn btn-outline-secondary text-light" @onclick="CloseProveedorModal">Cancelar</button>
                    <button type="submit" class="btn-primary-glass" disabled="@isSavingProveedor">
                        @if(isSavingProveedor) { <span>Guardando...</span> } else { <span>Guardar</span> }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (showSimilarProveedoresConfirm)
{
    <div class="modal-overlay modal-overlay-z3" style="background: rgba(0,0,0,0.85);">
        <div class="modal-panel modal-panel-sm" style="border: 1px solid var(--accent-primary);">
            <div class="modal-header-row">
                <h3>¿Quisiste decir?</h3>
            </div>
            <div style="margin-top: 15px; margin-bottom: 25px;">
                <p class="text-light">Se encontraron los siguientes proveedores similares cargados en el sistema:</p>
                <ul style="color: var(--accent-primary); font-size: 1.1rem; font-weight: bold; margin-bottom: 20px;">
                    @foreach (var p in similarProveedoresList)
                    {
                        <li>@p</li>
                    }
                </ul>
                <p class="text-secondary" style="font-size: 0.9rem;">¿Deseas continuar y guardar de todos modos?</p>
            </div>
            <div class="d-flex justify-content-end" style="gap: 10px;">
                <button type="button" class="btn btn-outline-secondary text-light" @onclick="CancelProveedorSimilarity">Cancelar</button>
                <button type="button" class="btn btn-primary" style="background: var(--accent-primary); border: none;" @onclick="BypassProveedorSimilarity">Continuar y guardar</button>
            </div>
        </div>
    </div>
}

@code {
    private List<ProveedorDto>? Items;
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    private bool showProveedorModal;
    private ProveedorDto proveedorModel = new() { Activo = true };
    private bool isSavingProveedor;
    private string proveedorErrorMessage = string.Empty;

    // ── Similarity Checks ──
    private bool showSimilarProveedoresConfirm;
    private List<string> similarProveedoresList = new();
    private bool bypassProveedorSimilarity;


    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            Items = await CatalogoService.GetProveedoresAsync();
        }
        catch (Exception)
        {
            errorMessage = "Error de conexión al cargar los proveedores.";
        }
        finally
        {
            isLoading = false;
        }
    }

    // ── Proveedor Modal Handlers ──
    private void OpenProveedorModalForCreate()
    {
        proveedorModel = new ProveedorDto { Activo = true };
        proveedorErrorMessage = string.Empty;
        isSavingProveedor = false;
        showProveedorModal = true;
    }

    private async Task OpenProveedorModalForEdit(string id)
    {
        proveedorErrorMessage = string.Empty;
        isSavingProveedor = false;
        showProveedorModal = true;
        try
        {
            var p = await CatalogoService.GetProveedorByIdAsync(id);
            if (p != null)
            {
                proveedorModel = p;
            }
            else
            {
                proveedorErrorMessage = "No se encontró el elemento solicitado.";
            }
        }
        catch (Exception)
        {
            proveedorErrorMessage = "Error al intentar obtener la información del proveedor.";
        }
    }

    private void CloseProveedorModal()
    {
        showProveedorModal = false;
    }

    private async Task HandleSaveProveedor()
    {
        if (string.IsNullOrWhiteSpace(proveedorModel.RazonSocial))
        {
            proveedorErrorMessage = "La Razón Social es requerida.";
            return;
        }
        if (string.IsNullOrWhiteSpace(proveedorModel.Cuit))
        {
            proveedorErrorMessage = "El CUIT es requerido.";
            return;
        }

        isSavingProveedor = true;
        proveedorErrorMessage = string.Empty;
        try
        {
            if (!bypassProveedorSimilarity && Items != null)
            {
                similarProveedoresList = Items
                    .Where(p => p.Id != proveedorModel.Id && BlazorFrontEnd.Helpers.SimilarityHelper.AreSimilar(proveedorModel.RazonSocial, p.RazonSocial))
                    .Select(p => p.RazonSocial)
                    .ToList();

                if (similarProveedoresList.Any())
                {
                    showSimilarProveedoresConfirm = true;
                    isSavingProveedor = false;
                    return;
                }
            }

            bypassProveedorSimilarity = false;
            showSimilarProveedoresConfirm = false;

            bool success;
            if (string.IsNullOrEmpty(proveedorModel.Id))
            {
                success = await CatalogoService.CreateProveedorAsync(proveedorModel);
            }
            else
            {
                success = await CatalogoService.UpdateProveedorAsync(proveedorModel.Id, proveedorModel);
            }

            if (success)
            {
                showProveedorModal = false;
                await LoadDataAsync();
            }
            else
            {
                proveedorErrorMessage = "Error al guardar el proveedor. Valide el formato del CUIT.";
            }
        }
        catch (Exception ex)
        {
            proveedorErrorMessage = $"Ocurrió una excepción: {ex.Message}";
        }
        finally
        {
            isSavingProveedor = false;
        }
    }

    private void CancelProveedorSimilarity()
    {
        showSimilarProveedoresConfirm = false;
        bypassProveedorSimilarity = false;
    }

    private async Task BypassProveedorSimilarity()
    {
        showSimilarProveedoresConfirm = false;
        bypassProveedorSimilarity = true;
        await HandleSaveProveedor();
    }


    private void GoBack() => Navigation.NavigateTo("/inventario");

    private async Task ConfirmDelete(string id)
    {
        bool confirmed = true;
        if (confirmed)
        {
            var result = await CatalogoService.DeleteProveedorAsync(id);
            if (result) await LoadDataAsync();
            else errorMessage = "No se pudo eliminar el elemento. Podría tener dependencias.";
        }
    }
}
