@page "/inventario/depositos"
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@inject CatalogoInventarioService CatalogoService
@inject NavigationManager Navigation
@inject SucursalService SucursalService

<PageTitle>Depósitos</PageTitle>

<div class="d-flex justify-content-between align-items-center" style="margin-bottom: var(--sp-lg);">
    <div class="d-flex align-items-center">
        <button class="btn btn-link" style="color: var(--text-secondary); padding: 0; margin-right: 15px;" @onclick="GoBack">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 24px; height: 24px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
        </button>
        <div>
            <h2 style="font-weight: 700; margin: 0;">Depósitos de Stock</h2>
            <p class="text-secondary" style="margin: 0;">Ubicaciones físicas de almacenamiento de inventario</p>
        </div>
    </div>
    <button class="btn-primary-glass" @onclick="OpenDepositoModalForCreate" style="display: flex; align-items: center; gap: 8px;">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 20px;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Nuevo Depósito
    </button>
</div>

<div class="glass-card">
    @if (isLoading)
    {
        <p class="text-secondary">Cargando depósitos...</p>
    }
    else if (Items == null || !Items.Any())
    {
        <p class="text-secondary">No hay depósitos registrados. Comienza agregando uno.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover" style="background: transparent;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--border-glass);">
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Ubicación</th>
                        <th>Sucursal</th>
                        <th>Activo</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Items)
                    {
                        <tr style="border-bottom: 1px solid var(--border-glass);">
                            <td><span class="text-secondary">#@i.Id</span></td>
                            <td><strong>@i.Nombre</strong></td>
                            <td class="text-truncate" style="max-width: 300px;">@i.Ubicacion</td>
                            <td>@(string.IsNullOrEmpty(i.SucursalNombre) ? "Sin Sucursal" : i.SucursalNombre)</td>
                            <td>
                                @if(i.Activo) { <span class="badge bg-success">Sí</span> }
                                else { <span class="badge bg-danger">No</span> }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-info" style="border-color: var(--border-glass); color: var(--text-primary);" @onclick="() => OpenDepositoModalForEdit(i.Id)">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" style="margin-left: 5px;" @onclick="() => ConfirmDelete(i.Id)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
        @errorMessage
    </div>
}


@* ── Modal de Depósito (Nuevo/Editar) ── *@
@if (showDepositoModal)
{
    <div class="modal-overlay modal-overlay-z1" @onclick="CloseDepositoModal" @onclick:stopPropagation="false">
        <div class="modal-panel" style="max-width: 600px;" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>@(depositoModel.Id == 0 ? "Nuevo Depósito" : "Editar Depósito")</h3>
                <button class="modal-close-btn" @onclick="CloseDepositoModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <EditForm Model="depositoModel" OnValidSubmit="HandleSaveDeposito" FormName="modalDepositoForm">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Nombre del Depósito (*)</label>
                    <InputText @bind-Value="depositoModel.Nombre" class="form-control bg-dark text-light border-secondary" placeholder="Ej. Depósito Central, Vitrina Secundaria" />
                    <ValidationMessage For="@(() => depositoModel.Nombre)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Ubicación / Nro de Estante</label>
                    <InputText @bind-Value="depositoModel.Ubicacion" class="form-control bg-dark text-light border-secondary" placeholder="Ej. Pasillo A, Estante 3" />
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Sucursal (*)</label>
                    <InputSelect @bind-Value="depositoModel.SucursalId" class="form-select bg-dark text-light border-secondary">
                        <option value="">-- Seleccionar Sucursal --</option>
                        @foreach (var s in sucursales)
                        {
                            <option value="@s.Id">@s.Nombre</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => depositoModel.SucursalId)" class="text-danger" />
                </div>

                <div class="form-check form-switch mb-3">
                    <InputCheckbox @bind-Value="depositoModel.Activo" class="form-check-input" id="modalDepositoActivoSw" />
                    <label class="form-check-label" for="modalDepositoActivoSw" style="color: var(--text-secondary);">Depósito Operativo</label>
                </div>

                @if (!string.IsNullOrEmpty(depositoErrorMessage))
                {
                    <div class="alert alert-danger p-2 mt-2" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">@depositoErrorMessage</div>
                }

                <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                    <button type="button" class="btn btn-outline-secondary text-light" @onclick="CloseDepositoModal">Cancelar</button>
                    <button type="submit" class="btn-primary-glass" disabled="@isSavingDeposito">
                        @if(isSavingDeposito) { <span>Guardando...</span> } else { <span>Guardar</span> }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (showSimilarDepositosConfirm)
{
    <div class="modal-overlay modal-overlay-z3" style="background: rgba(0,0,0,0.85);">
        <div class="modal-panel modal-panel-sm" style="border: 1px solid var(--accent-primary);">
            <div class="modal-header-row">
                <h3>¿Quisiste decir?</h3>
            </div>
            <div style="margin-top: 15px; margin-bottom: 25px;">
                <p class="text-light">Se encontraron los siguientes depósitos similares cargados en el sistema:</p>
                <ul style="color: var(--accent-primary); font-size: 1.1rem; font-weight: bold; margin-bottom: 20px;">
                    @foreach (var d in similarDepositosList)
                    {
                        <li>@d</li>
                    }
                </ul>
                <p class="text-secondary" style="font-size: 0.9rem;">¿Deseas continuar y guardar de todos modos?</p>
            </div>
            <div class="d-flex justify-content-end" style="gap: 10px;">
                <button type="button" class="btn btn-outline-secondary text-light" @onclick="CancelDepositoSimilarity">Cancelar</button>
                <button type="button" class="btn btn-primary" style="background: var(--accent-primary); border: none;" @onclick="BypassDepositoSimilarity">Continuar y guardar</button>
            </div>
        </div>
    </div>
}

@code {
    private List<DepositoDto>? Items;
    private List<SucursalDto> sucursales = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    private bool showDepositoModal;
    private DepositoDto depositoModel = new() { Activo = true };
    private bool isSavingDeposito;
    private string depositoErrorMessage = string.Empty;

    // ── Similarity Checks ──
    private bool showSimilarDepositosConfirm;
    private List<string> similarDepositosList = new();
    private bool bypassDepositoSimilarity;


    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            Items = await CatalogoService.GetDepositosAsync();
            var sucs = await SucursalService.GetAllAsync(true);
            if (sucs != null) sucursales = sucs;
        }
        catch (Exception)
        {
            errorMessage = "Error de conexión al cargar los depósitos.";
        }
        finally
        {
            isLoading = false;
        }
    }

    // ── Deposito Modal Handlers ──
    private void OpenDepositoModalForCreate()
    {
        depositoModel = new DepositoDto { Activo = true };
        depositoErrorMessage = string.Empty;
        isSavingDeposito = false;
        showDepositoModal = true;
    }

    private async Task OpenDepositoModalForEdit(int id)
    {
        depositoErrorMessage = string.Empty;
        isSavingDeposito = false;
        showDepositoModal = true;
        try
        {
            var d = await CatalogoService.GetDepositoByIdAsync(id);
            if (d != null)
            {
                depositoModel = d;
            }
            else
            {
                depositoErrorMessage = "No se encontró el elemento solicitado.";
            }
        }
        catch (Exception)
        {
            depositoErrorMessage = "Error al intentar obtener la información del depósito.";
        }
    }

    private void CloseDepositoModal()
    {
        showDepositoModal = false;
    }

    private async Task HandleSaveDeposito()
    {
        if (string.IsNullOrWhiteSpace(depositoModel.Nombre))
        {
            depositoErrorMessage = "El nombre es requerido.";
            return;
        }

        if (!depositoModel.SucursalId.HasValue || depositoModel.SucursalId.Value <= 0)
        {
            depositoErrorMessage = "Debe seleccionar una sucursal.";
            return;
        }

        isSavingDeposito = true;
        depositoErrorMessage = string.Empty;
        try
        {
            if (!bypassDepositoSimilarity && Items != null)
            {
                similarDepositosList = Items
                    .Where(d => d.Id != depositoModel.Id && BlazorFrontEnd.Helpers.SimilarityHelper.AreSimilar(depositoModel.Nombre, d.Nombre))
                    .Select(d => d.Nombre)
                    .ToList();

                if (similarDepositosList.Any())
                {
                    showSimilarDepositosConfirm = true;
                    isSavingDeposito = false;
                    return;
                }
            }

            bypassDepositoSimilarity = false;
            showSimilarDepositosConfirm = false;

            bool success;
            if (depositoModel.Id == 0)
            {
                success = await CatalogoService.CreateDepositoAsync(depositoModel);
            }
            else
            {
                success = await CatalogoService.UpdateDepositoAsync(depositoModel.Id, depositoModel);
            }

            if (success)
            {
                showDepositoModal = false;
                await LoadDataAsync();
            }
            else
            {
                depositoErrorMessage = "Error al guardar el depósito.";
            }
        }
        catch (Exception ex)
        {
            depositoErrorMessage = $"Ocurrió una excepción: {ex.Message}";
        }
        finally
        {
            isSavingDeposito = false;
        }
    }

    private void CancelDepositoSimilarity()
    {
        showSimilarDepositosConfirm = false;
        bypassDepositoSimilarity = false;
    }

    private async Task BypassDepositoSimilarity()
    {
        showSimilarDepositosConfirm = false;
        bypassDepositoSimilarity = true;
        await HandleSaveDeposito();
    }


    private void GoBack() => Navigation.NavigateTo("/inventario");

    private async Task ConfirmDelete(int id)
    {
        bool confirmed = true;
        if (confirmed)
        {
            var result = await CatalogoService.DeleteDepositoAsync(id);
            if (result) await LoadDataAsync();
            else errorMessage = "No se pudo eliminar el depósito. Podría contener productos en stock.";
        }
    }
}
