@page "/inventario/marcas"
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@inject CatalogoInventarioService CatalogoService
@inject NavigationManager Navigation

<PageTitle>Marcas</PageTitle>

<div class="d-flex justify-content-between align-items-center" style="margin-bottom: var(--sp-lg);">
    <div class="d-flex align-items-center">
        <button class="btn btn-link" style="color: var(--text-secondary); padding: 0; margin-right: 15px;" @onclick="GoBack">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 24px; height: 24px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
        </button>
        <div>
            <h2 style="font-weight: 700; margin: 0;">Marcas Comerciales</h2>
            <p class="text-secondary" style="margin: 0;">Gestión de fabricantes y sellos del inventario</p>
        </div>
    </div>
    <AuthorizeView Roles="Admin,Gerente,Recepcionista">
        <Authorized>
            <button class="btn-primary-glass" @onclick="OpenMarcaModalForCreate" style="display: flex; align-items: center; gap: 8px;">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 20px;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Nueva Marca
            </button>
        </Authorized>
    </AuthorizeView>
</div>

<div class="glass-card">
    @if (isLoading)
    {
        <p class="text-secondary">Cargando marcas...</p>
    }
    else if (Items == null || !Items.Any())
    {
        <p class="text-secondary">No hay marcas registradas. Comienza agregando una.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover" style="background: transparent;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--border-glass);">
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Activo</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Items)
                    {
                        <tr style="border-bottom: 1px solid var(--border-glass);">
                            <td><span class="text-secondary">#@i.Id</span></td>
                            <td><strong>@i.Nombre</strong></td>
                            <td class="text-truncate" style="max-width: 300px;">@i.Descripcion</td>
                            <td>
                                @if(i.Activo) { <span class="badge bg-success">Sí</span> }
                                else { <span class="badge bg-danger">No</span> }
                            </td>
                            <td class="text-end">
                                <AuthorizeView Roles="Admin,Gerente,Recepcionista">
                                    <Authorized>
                                        <button class="btn btn-sm btn-outline-info" style="border-color: var(--border-glass); color: var(--text-primary);" @onclick="() => OpenMarcaModalForEdit(i.Id)">Editar</button>
                                        <button class="btn btn-sm btn-outline-danger" style="margin-left: 5px;" @onclick="() => ConfirmDelete(i.Id)">Eliminar</button>
                                    </Authorized>
                                    <NotAuthorized>
                                        <span class="badge bg-secondary">Solo Lectura</span>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
        @errorMessage
    </div>
}


@* ── Modal de Marca (Nueva/Editar) ── *@
@if (showMarcaModal)
{
    <div class="modal-overlay modal-overlay-z1" @onclick="CloseMarcaModal" @onclick:stopPropagation="false">
        <div class="modal-panel" style="max-width: 600px;" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>@(marcaModel.Id == 0 ? "Nueva Marca" : "Editar Marca")</h3>
                <button class="modal-close-btn" @onclick="CloseMarcaModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <EditForm Model="marcaModel" OnValidSubmit="HandleSaveMarca" FormName="modalMarcaForm">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Nombre de la Marca (*)</label>
                    <InputText @bind-Value="marcaModel.Nombre" class="form-control bg-dark text-light border-secondary" placeholder="Ej. Royal Canin, ProPlan" />
                    <ValidationMessage For="@(() => marcaModel.Nombre)" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Descripción Opcional</label>
                    <InputTextArea @bind-Value="marcaModel.Descripcion" class="form-control bg-dark text-light border-secondary" rows="3" />
                </div>

                <div class="form-check form-switch mb-3">
                    <InputCheckbox @bind-Value="marcaModel.Activo" class="form-check-input" id="modalMarcaActivoSw" />
                    <label class="form-check-label" for="modalMarcaActivoSw" style="color: var(--text-secondary);">Marca Activa (Visible)</label>
                </div>

                @if (!string.IsNullOrEmpty(marcaErrorMessage))
                {
                    <div class="alert alert-danger p-2 mt-2" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">@marcaErrorMessage</div>
                }

                <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                    <button type="button" class="btn btn-outline-secondary text-light" @onclick="CloseMarcaModal">Cancelar</button>
                    <button type="submit" class="btn-primary-glass" disabled="@isSavingMarca">
                        @if(isSavingMarca) { <span>Guardando...</span> } else { <span>Guardar</span> }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (showSimilarMarcasConfirm)
{
    <div class="modal-overlay modal-overlay-z3" style="background: rgba(0,0,0,0.85);">
        <div class="modal-panel modal-panel-sm" style="border: 1px solid var(--accent-primary);">
            <div class="modal-header-row">
                <h3>¿Quisiste decir?</h3>
            </div>
            <div style="margin-top: 15px; margin-bottom: 25px;">
                <p class="text-light">Se encontraron las siguientes marcas similares cargadas en el sistema:</p>
                <ul style="color: var(--accent-primary); font-size: 1.1rem; font-weight: bold; margin-bottom: 20px;">
                    @foreach (var m in similarMarcasList)
                    {
                        <li>@m</li>
                    }
                </ul>
                <p class="text-secondary" style="font-size: 0.9rem;">¿Deseas continuar y guardar de todos modos?</p>
            </div>
            <div class="d-flex justify-content-end" style="gap: 10px;">
                <button type="button" class="btn btn-outline-secondary text-light" @onclick="CancelMarcaSimilarity">Cancelar</button>
                <button type="button" class="btn btn-primary" style="background: var(--accent-primary); border: none;" @onclick="BypassMarcaSimilarity">Continuar y guardar</button>
            </div>
        </div>
    </div>
}

@* ── Modal de Confirmación de Eliminación ── *@
@if (showDeleteModal)
{
    <div class="modal-overlay modal-overlay-z1" @onclick="CloseDeleteModal" @onclick:stopPropagation="false">
        <div class="modal-panel modal-panel-sm" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>Confirmar Eliminación</h3>
                <button class="modal-close-btn" @onclick="CloseDeleteModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div style="margin-top: 15px; margin-bottom: 25px;">
                <p>¿Está seguro de que desea eliminar la marca <strong>@marcaToDelete?.Nombre</strong>?</p>
                <small class="text-secondary">Esta acción dará de baja la marca.</small>
            </div>

            <div class="d-flex justify-content-end" style="gap: 10px;">
                <button type="button" class="btn btn-outline-secondary text-light" @onclick="CloseDeleteModal">Cancelar</button>
                <button type="button" class="btn btn-danger" style="background: var(--accent-danger); border: none;" @onclick="ExecuteDelete">Eliminar</button>
            </div>
        </div>
    </div>
}

@code {
    private List<MarcaDto>? Items;
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    private bool showMarcaModal;
    private MarcaDto marcaModel = new() { Activo = true };
    private bool isSavingMarca;
    private string marcaErrorMessage = string.Empty;

    // ── Delete Modal State ──
    private bool showDeleteModal;
    private MarcaDto? marcaToDelete;

    // ── Similarity Checks ──
    private bool showSimilarMarcasConfirm;
    private List<string> similarMarcasList = new();
    private bool bypassMarcaSimilarity;


    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            Items = await CatalogoService.GetMarcasAsync(soloActivas: false);
        }
        catch (Exception)
        {
            errorMessage = "Error de conexión al cargar las marcas.";
        }
        finally
        {
            isLoading = false;
        }
    }

    // ── Marca Modal Handlers ──
    private void OpenMarcaModalForCreate()
    {
        marcaModel = new MarcaDto { Activo = true };
        marcaErrorMessage = string.Empty;
        isSavingMarca = false;
        showMarcaModal = true;
    }

    private async Task OpenMarcaModalForEdit(int id)
    {
        marcaErrorMessage = string.Empty;
        isSavingMarca = false;
        showMarcaModal = true;
        try
        {
            var m = await CatalogoService.GetMarcaByIdAsync(id);
            if (m != null)
            {
                marcaModel = m;
            }
            else
            {
                marcaErrorMessage = "No se encontró el elemento solicitado.";
            }
        }
        catch (Exception)
        {
            marcaErrorMessage = "Error al intentar obtener la marca.";
        }
    }

    private void CloseMarcaModal()
    {
        showMarcaModal = false;
    }

    private async Task HandleSaveMarca()
    {
        if (string.IsNullOrWhiteSpace(marcaModel.Nombre))
        {
            marcaErrorMessage = "El nombre es requerido.";
            return;
        }

        isSavingMarca = true;
        marcaErrorMessage = string.Empty;
        try
        {
            if (!bypassMarcaSimilarity && Items != null)
            {
                similarMarcasList = Items
                    .Where(m => m.Id != marcaModel.Id && BlazorFrontEnd.Helpers.SimilarityHelper.AreSimilar(marcaModel.Nombre, m.Nombre))
                    .Select(m => m.Nombre)
                    .ToList();

                if (similarMarcasList.Any())
                {
                    showSimilarMarcasConfirm = true;
                    isSavingMarca = false;
                    return;
                }
            }

            bypassMarcaSimilarity = false;
            showSimilarMarcasConfirm = false;

            bool success;
            if (marcaModel.Id == 0)
            {
                success = await CatalogoService.CreateMarcaAsync(marcaModel);
            }
            else
            {
                success = await CatalogoService.UpdateMarcaAsync(marcaModel.Id, marcaModel);
            }

            if (success)
            {
                showMarcaModal = false;
                await LoadDataAsync();
            }
            else
            {
                marcaErrorMessage = "Error al guardar la marca.";
            }
        }
        catch (Exception ex)
        {
            marcaErrorMessage = $"Ocurrió una excepción: {ex.Message}";
        }
        finally
        {
            isSavingMarca = false;
        }
    }

    private void CancelMarcaSimilarity()
    {
        showSimilarMarcasConfirm = false;
        bypassMarcaSimilarity = false;
    }

    private async Task BypassMarcaSimilarity()
    {
        showSimilarMarcasConfirm = false;
        bypassMarcaSimilarity = true;
        await HandleSaveMarca();
    }


    private void GoBack() => Navigation.NavigateTo("/inventario");

    private void ConfirmDelete(int id)
    {
        marcaToDelete = Items?.FirstOrDefault(m => m.Id == id);
        if (marcaToDelete != null)
        {
            showDeleteModal = true;
        }
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        marcaToDelete = null;
    }

    private async Task ExecuteDelete()
    {
        if (marcaToDelete != null)
        {
            var result = await CatalogoService.DeleteMarcaAsync(marcaToDelete.Id);
            showDeleteModal = false;
            marcaToDelete = null;
            if (result) await LoadDataAsync();
            else errorMessage = "No se pudo eliminar el elemento. Podría estar en uso por un Producto.";
        }
    }
}
