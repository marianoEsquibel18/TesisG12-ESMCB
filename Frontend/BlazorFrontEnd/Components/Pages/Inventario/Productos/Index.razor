@page "/inventario/productos"
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@inject ProductoService ProductoService
@inject CatalogoInventarioService CatalogoService
@inject NavigationManager Navigation

<PageTitle>Productos - Inventario</PageTitle>

<div class="d-flex justify-content-between align-items-center" style="margin-bottom: var(--sp-lg);">
    <div class="d-flex align-items-center">
        <button class="btn btn-link" style="color: var(--text-secondary); padding: 0; margin-right: 15px;" @onclick="GoBack">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 24px; height: 24px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
        </button>
        <div>
            <h2 style="font-weight: 700; margin: 0;">Gestión de Productos</h2>
            <p class="text-secondary" style="margin: 0;">Inventario general con control de stock</p>
        </div>
    </div>
    <AuthorizeView Roles="Admin,Gerente,Recepcionista">
        <Authorized>
            <button class="btn-primary-glass" @onclick="OpenProductModalForCreate" style="display: flex; align-items: center; gap: 8px;">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 20px;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Nuevo Producto
            </button>
        </Authorized>
    </AuthorizeView>
</div>

<div class="glass-card">
    <div class="d-flex justify-content-between align-items-center" style="margin-bottom: var(--sp-sm);">
        <h4 style="margin: 0;">Lista de Productos</h4>
        <input type="text" @bind-value="searchTerm" @bind-value:after="OnSearchChanged" class="form-control" placeholder="Buscar por nombre o código..." style="width: 300px; background: rgba(255,255,255,0.05); border: 1px solid var(--border-glass); color: white;" />
    </div>

    @* ── Barra de Filtros ── *@
    <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center; margin-bottom: var(--sp-md); padding: 10px 14px; background: rgba(255,255,255,0.03); border: 1px solid var(--border-glass); border-radius: 8px;">
        <div style="display: flex; align-items: center; gap: 6px;">
            <label style="color: var(--text-secondary); font-size: 0.8rem; white-space: nowrap;">Categoría:</label>
            <select @bind="filterCategoria" @bind:after="ApplyFilters" class="form-select form-select-sm bg-dark text-light border-secondary" style="width: 160px; font-size: 0.85rem;">
                <option value="0">Todas</option>
                @foreach (var c in categorias)
                {
                    <option value="@c.Id">@c.Nombre</option>
                }
            </select>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
            <label style="color: var(--text-secondary); font-size: 0.8rem; white-space: nowrap;">Marca:</label>
            <select @bind="filterMarca" @bind:after="ApplyFilters" class="form-select form-select-sm bg-dark text-light border-secondary" style="width: 160px; font-size: 0.85rem;">
                <option value="0">Todas</option>
                @foreach (var m in marcas)
                {
                    <option value="@m.Id">@m.Nombre</option>
                }
            </select>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
            <label style="color: var(--text-secondary); font-size: 0.8rem; white-space: nowrap;">Depósito:</label>
            <select @bind="filterDeposito" @bind:after="ApplyFilters" class="form-select form-select-sm bg-dark text-light border-secondary" style="width: 160px; font-size: 0.85rem;">
                <option value="0">Todos</option>
                @foreach (var d in depositos)
                {
                    <option value="@d.Id">@d.Nombre</option>
                }
            </select>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
            <label style="color: var(--text-secondary); font-size: 0.8rem; white-space: nowrap;">Estado:</label>
            <select @bind="filterEstado" @bind:after="ApplyFilters" class="form-select form-select-sm bg-dark text-light border-secondary" style="width: 130px; font-size: 0.85rem;">
                <option value="todos">Todos</option>
                <option value="activo">Activos</option>
                <option value="inactivo">Inactivos</option>
            </select>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
            <label class="form-check-label" style="color: var(--text-secondary); font-size: 0.8rem; cursor: pointer; white-space: nowrap;" for="chkStockBajo">
                <input type="checkbox" id="chkStockBajo" @bind="filterStockBajo" @bind:after="ApplyFilters" class="form-check-input" style="margin-right: 4px;" />
                Solo Stock Bajo
            </label>
        </div>
        @if (HasActiveFilters)
        {
            <button class="btn btn-sm btn-outline-secondary text-light" style="font-size: 0.8rem; padding: 2px 10px;" @onclick="ClearFilters">✕ Limpiar</button>
        }
    </div>

    @if (isLoading)
    {
        <p class="text-secondary">Cargando productos...</p>
    }
    else if (filteredItems == null || !filteredItems.Any())
    {
        <p class="text-secondary">No se encontraron productos con los filtros aplicados.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover" style="background: transparent;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--border-glass);">
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Marca</th>
                        <th style="text-align: right;">P. Compra</th>
                        <th style="text-align: right;">P. Venta</th>
                        <th style="text-align: center;">Stock Actual</th>
                        @if (filterDeposito > 0)
                        {
                            <th style="text-align: center;">Stock Depósito</th>
                        }
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in filteredItems!)
                    {
                        var stockDeposito = filterDeposito > 0
                            ? p.StocksDepositos?.FirstOrDefault(sd => sd.DepositoId == filterDeposito)
                            : null;
                        <tr style="border-bottom: 1px solid var(--border-glass);">
                            <td>
                                <strong>@p.Nombre</strong>
                                @if(!string.IsNullOrEmpty(p.CodigoBarras))
                                {
                                    <br/><small class="text-secondary">@p.CodigoBarras</small>
                                }
                            </td>
                            <td>@p.CategoriaNombre</td>
                            <td>@p.MarcaNombre</td>
                            <td style="text-align: right;">$@p.PrecioCompra.ToString("N2")</td>
                            <td style="text-align: right;">$@p.PrecioVenta.ToString("N2")</td>
                            <td style="text-align: center;">
                                @if(p.StockBajo)
                                {
                                    <span style="background: rgba(239,68,68,0.3); color: #ff6b6b; padding: 2px 10px; border-radius: 12px; font-size: 0.85rem; font-weight: 600;">
                                        @p.StockActual / @p.StockMinimo
                                    </span>
                                }
                                else
                                {
                                    <span style="background: rgba(34,197,94,0.2); color: #4ade80; padding: 2px 10px; border-radius: 12px; font-size: 0.85rem;">
                                        @p.StockActual
                                    </span>
                                }
                            </td>
                            @if (filterDeposito > 0)
                            {
                                <td style="text-align: center;">
                                    @if (stockDeposito != null)
                                    {
                                        @if(stockDeposito.StockBajo)
                                        {
                                            <span style="background: rgba(239,68,68,0.3); color: #ff6b6b; padding: 2px 10px; border-radius: 12px; font-size: 0.85rem; font-weight: 600;">
                                                @stockDeposito.StockActual
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="background: rgba(59,130,246,0.2); color: #60a5fa; padding: 2px 10px; border-radius: 12px; font-size: 0.85rem;">
                                                @stockDeposito.StockActual
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-secondary" style="font-size: 0.8rem;">—</span>
                                    }
                                </td>
                            }
                            <td>
                                @if(p.Activo) { <span style="color: var(--accent-primary);">Activo</span> }
                                else { <span style="color: var(--accent-danger);">Inactivo</span> }
                            </td>
                            <td class="text-end" style="white-space: nowrap;">
                                <AuthorizeView Roles="Admin,Gerente,Recepcionista">
                                    <Authorized>
                                        <button class="btn btn-sm btn-outline-info" style="border-color: var(--border-glass); color: var(--text-primary);" @onclick="() => OpenProductModalForEdit(p.Id)">Editar</button>
                                        <button class="btn btn-sm btn-outline-success" style="margin-left: 4px;" @onclick="() => ShowStockModal(p)">Stock</button>
                                        <button class="btn btn-sm btn-outline-danger" style="margin-left: 4px;" @onclick="() => ConfirmDelete(p.Id)">Eliminar</button>
                                    </Authorized>
                                    <NotAuthorized>
                                        <span class="badge bg-secondary">Solo Lectura</span>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-secondary">Pagina @(productosResponse?.PageIndex ?? 1) de @(productosResponse?.TotalPages ?? 1) (@(productosResponse?.TotalCount ?? 0) registros)</span>
            <div>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(productosResponse == null || !productosResponse.HasPreviousPage)" @onclick="PreviousPage">Anterior</button>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(productosResponse == null || !productosResponse.HasNextPage)" @onclick="NextPage">Siguiente</button>
            </div>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
        @errorMessage
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success mt-3" style="background: rgba(34, 197, 94, 0.2); border: 1px solid #4ade80; color: white;">
        @successMessage
    </div>
}

@* ── Modal de Movimiento de Stock ── *@
@if (showStockModal && selectedProducto != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="CloseStockModal">
        <div class="glass-card" style="width: 480px; max-width: 95vw;" @onclick:stopPropagation>
            <h4 style="margin-bottom: var(--sp-md);">Movimiento de Stock — @selectedProducto.Nombre</h4>
            <p class="text-secondary">Stock total: <strong style="color: white;">@selectedProducto.StockActual</strong></p>

            @* Selector de depósito *@
            <div style="margin-bottom: var(--sp-sm);">
                <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Depósito (*)</label>
                <select @bind="stockDepositoId" class="form-select bg-dark text-light border-secondary" @bind:after="OnStockDepositoChanged">
                    <option value="0">— Seleccionar depósito —</option>
                    @foreach (var d in depositos)
                    {
                        <option value="@d.Id">@d.Nombre</option>
                    }
                </select>
                @if (stockDepositoId > 0)
                {
                    var sdInfo = selectedProducto.StocksDepositos?.FirstOrDefault(sd => sd.DepositoId == stockDepositoId);
                    <small class="text-secondary" style="font-size: 0.78rem;">
                        Stock en este depósito: <strong style="color: white;">@(sdInfo?.StockActual ?? 0)</strong>
                    </small>
                }
            </div>

            <div style="margin-bottom: var(--sp-sm);">
                <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Tipo de Movimiento</label>
                <select @bind="stockTipo" class="form-select bg-dark text-light border-secondary">
                    <option value="entrada">Entrada (Ingreso)</option>
                    <option value="salida">Salida (Egreso)</option>
                </select>
            </div>

            <div style="margin-bottom: var(--sp-sm);">
                <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Cantidad (*)</label>
                <input type="number" @bind="stockCantidad" class="form-control bg-dark text-light border-secondary" min="1" />
            </div>

            <div style="margin-bottom: var(--sp-sm);">
                <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Motivo</label>
                <input type="text" @bind="stockMotivo" class="form-control bg-dark text-light border-secondary" placeholder="Ej: Compra a proveedor, Venta, Rotura..." />
            </div>

            @if (!string.IsNullOrEmpty(stockError))
            {
                <div class="alert alert-danger mt-2" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white; font-size: 0.9rem;">
                    @stockError
                </div>
            }

            <div class="d-flex justify-content-end mt-3" style="gap: 10px;">
                <button class="btn btn-outline-secondary text-light" @onclick="CloseStockModal">Cancelar</button>
                <button class="btn-primary-glass" disabled="@isSavingStock" @onclick="HandleStockMovement">
                    @if(isSavingStock) { <span>Procesando...</span> } else { <span>Confirmar</span> }
                </button>
            </div>
        </div>
    </div>
}

@* ── Modal de Producto (Nuevo/Editar) ── *@
@if (showProductModal)
{
    <div class="modal-overlay modal-overlay-z1" @onclick="CloseProductModal" @onclick:stopPropagation="false">
        <div class="modal-panel" style="max-width: 800px;" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>@(string.IsNullOrEmpty(productModel.Id) ? "Nuevo Producto" : "Editar Producto")</h3>
                <button class="modal-close-btn" @onclick="CloseProductModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <EditForm Model="productModel" OnValidSubmit="HandleSaveProduct" FormName="modalProductoForm">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-md-8 mb-3">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Nombre del Producto (*)</label>
                        <InputText @bind-Value="productModel.Nombre" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => productModel.Nombre)" class="text-danger" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Código de Barras (*)</label>
                        <InputText @bind-Value="productModel.CodigoBarras" class="form-control bg-dark text-light border-secondary" placeholder="Ej: 7790001234" />
                        <ValidationMessage For="@(() => productModel.CodigoBarras)" class="text-danger" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Categoría (*)</label>
                        <InputSelect @bind-Value="productModel.CategoriaId" class="form-select bg-dark text-light border-secondary">
                            <option value="0">-- Seleccione Categoría --</option>
                            @foreach (var c in categorias)
                            {
                                <option value="@c.Id">@c.Nombre</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => productModel.CategoriaId)" class="text-danger" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Marca</label>
                        <InputSelect @bind-Value="productModel.MarcaId" class="form-select bg-dark text-light border-secondary">
                            <option value="">-- Sin Marca --</option>
                            @foreach (var m in marcas)
                            {
                                <option value="@m.Id">@m.Nombre</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Proveedor</label>
                        <InputSelect @bind-Value="productModel.ProveedorId" class="form-select bg-dark text-light border-secondary">
                            <option value="">-- Sin Proveedor --</option>
                            @foreach (var p in proveedores)
                            {
                                <option value="@p.Id">@p.RazonSocial</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Depósito</label>
                        <InputSelect @bind-Value="productModel.DepositoId" class="form-select bg-dark text-light border-secondary">
                            <option value="">-- Sin Depósito --</option>
                            @foreach (var d in depositos)
                            {
                                <option value="@d.Id">@d.Nombre</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Precio de Compra (*)</label>
                        <InputNumber @bind-Value="productModel.PrecioCompra" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => productModel.PrecioCompra)" class="text-danger" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Precio de Venta (*)</label>
                        <InputNumber @bind-Value="productModel.PrecioVenta" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => productModel.PrecioVenta)" class="text-danger" />
                    </div>
                </div>

                @if (string.IsNullOrEmpty(productModel.Id))
                {
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Stock Inicial</label>
                            <InputNumber @bind-Value="productModel.StockActual" class="form-control bg-dark text-light border-secondary" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Stock Mínimo (alerta)</label>
                            <InputNumber @bind-Value="productModel.StockMinimo" class="form-control bg-dark text-light border-secondary" />
                        </div>
                    </div>
                }
                else
                {
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Stock Mínimo (alerta)</label>
                            <InputNumber @bind-Value="productModel.StockMinimo" class="form-control bg-dark text-light border-secondary" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Stock Actual</label>
                            <p class="form-control bg-dark text-light border-secondary" style="line-height: 2.2; margin: 0;">@productModel.StockActual <small class="text-secondary">(use el botón "Stock" de la grilla para modificar)</small></p>
                        </div>
                    </div>
                }

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-check" style="margin-top: 10px;">
                            <InputCheckbox @bind-Value="productModel.Activo" class="form-check-input bg-dark border-secondary" id="chkProductActivo" />
                            <label class="form-check-label text-light" for="chkProductActivo">Producto Activo</label>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Descripción</label>
                    <InputTextArea @bind-Value="productModel.Descripcion" class="form-control bg-dark text-light border-secondary" rows="2" />
                </div>

                @if (!string.IsNullOrEmpty(productErrorMessage))
                {
                    <div class="alert alert-danger p-2 mt-2" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">@productErrorMessage</div>
                }

                <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                    <button type="button" class="btn btn-outline-secondary text-light" @onclick="CloseProductModal">Cancelar</button>
                    <button type="submit" class="btn-primary-glass" disabled="@isSavingProduct">
                        @if(isSavingProduct) { <span>Guardando...</span> } else { <span>Guardar</span> }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (showSimilarProductsConfirm)
{
    <div class="modal-overlay modal-overlay-z3" style="background: rgba(0,0,0,0.85);">
        <div class="modal-panel modal-panel-sm" style="border: 1px solid var(--accent-primary);">
            <div class="modal-header-row">
                <h3>¿Quisiste decir?</h3>
            </div>
            <div style="margin-top: 15px; margin-bottom: 25px;">
                <p class="text-light">Se encontraron los siguientes productos similares cargados en el sistema:</p>
                <ul style="color: var(--accent-primary); font-size: 1.1rem; font-weight: bold; margin-bottom: 20px;">
                    @foreach (var p in similarProductsList)
                    {
                        <li>@p</li>
                    }
                </ul>
                <p class="text-secondary" style="font-size: 0.9rem;">¿Deseas continuar y guardar de todos modos?</p>
            </div>
            <div class="d-flex justify-content-end" style="gap: 10px;">
                <button type="button" class="btn btn-outline-secondary text-light" @onclick="CancelProductSimilarity">Cancelar</button>
                <button type="button" class="btn btn-primary" style="background: var(--accent-primary); border: none;" @onclick="BypassProductSimilarity">Continuar y guardar</button>
            </div>
        </div>
    </div>
}

@* ── Modal de Confirmación de Eliminación ── *@
@if (showDeleteModal)
{
    <div class="modal-overlay modal-overlay-z1" @onclick="CloseDeleteModal" @onclick:stopPropagation="false">
        <div class="modal-panel modal-panel-sm" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>Confirmar Eliminación</h3>
                <button class="modal-close-btn" @onclick="CloseDeleteModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div style="margin-top: 15px; margin-bottom: 25px;">
                <p>¿Está seguro de que desea eliminar el producto <strong>@productoToDelete?.Nombre</strong>?</p>
                <small class="text-secondary">Esta acción dará de baja el producto en el catálogo de inventario.</small>
            </div>

            <div class="d-flex justify-content-end" style="gap: 10px;">
                <button type="button" class="btn btn-outline-secondary text-light" @onclick="CloseDeleteModal">Cancelar</button>
                <button type="button" class="btn btn-danger" style="background: var(--accent-danger); border: none;" @onclick="ExecuteDelete">Eliminar</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "productoId")]
    public string? QueryProductoId { get; set; }

    private PaginatedList<ProductoDto>? productosResponse;
    private List<ProductoDto>? filteredItems;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private int currentPage = 1;
    private int pageSize = 15;
    private string searchTerm = string.Empty;

    // Filtros
    private int filterCategoria;
    private int filterMarca;
    private int filterDeposito;
    private string filterEstado = "todos";
    private bool filterStockBajo;
    private List<CategoriaDto> categorias = new();
    private List<MarcaDto> marcas = new();
    private List<DepositoDto> depositos = new();
    private bool HasActiveFilters => filterCategoria > 0 || filterMarca > 0 || filterDeposito > 0 || filterEstado != "todos" || filterStockBajo;

    // Stock modal
    private bool showStockModal;
    private ProductoDto? selectedProducto;
    private string stockTipo = "entrada";
    private int stockCantidad = 1;
    private string stockMotivo = string.Empty;
    private string stockError = string.Empty;
    private bool isSavingStock;
    private int stockDepositoId;

    // Product Modal States
    private bool showProductModal;
    private ProductoDto productModel = new() { Activo = true };
    private bool isSavingProduct;
    private string productErrorMessage = string.Empty;
    private List<ProveedorDto> proveedores = new();

    // ── Similarity Checks ──
    private List<ProductoDto> todosLosProductos = new();
    private bool showSimilarProductsConfirm;
    private List<string> similarProductsList = new();
    private bool bypassProductSimilarity;

    protected override async Task OnInitializedAsync()
    {
        // Cargar catálogos para filtros en paralelo con los datos
        var catTask = CatalogoService.GetCategoriasAsync();
        var marTask = CatalogoService.GetMarcasAsync();
        var depTask = CatalogoService.GetDepositosAsync();
        var proTask = CatalogoService.GetProveedoresAsync();
        var loadTask = LoadDataAsync();
        await Task.WhenAll(catTask, marTask, depTask, proTask, loadTask);
        categorias = catTask.Result ?? new();
        marcas = marTask.Result ?? new();
        depositos = depTask.Result ?? new();
        proveedores = proTask.Result ?? new();

        var prodRes = await ProductoService.GetAllAsync(1, 1000);
        if (prodRes?.Items != null)
        {
            todosLosProductos = prodRes.Items;
        }
    }


    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(QueryProductoId))
        {
            try
            {
                var prod = await ProductoService.GetByIdAsync(QueryProductoId);
                if (prod != null)
                {
                    searchTerm = prod.Nombre;
                    currentPage = 1;
                    await LoadDataAsync();
                }
            }
            catch (Exception)
            {
            }
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            productosResponse = await ProductoService.GetAllAsync(currentPage, pageSize, searchTerm);
            ApplyFiltersInternal();
        }
        catch (Exception)
        {
            errorMessage = "Error de conexión al cargar productos.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFiltersInternal()
    {
        if (productosResponse?.Items == null) { filteredItems = null; return; }

        IEnumerable<ProductoDto> items = productosResponse.Items;

        if (filterCategoria > 0)
            items = items.Where(p => p.CategoriaId == filterCategoria);
        if (filterMarca > 0)
            items = items.Where(p => p.MarcaId == filterMarca);
        if (filterDeposito > 0)
            items = items.Where(p => p.StocksDepositos != null && p.StocksDepositos.Any(sd => sd.DepositoId == filterDeposito));
        if (filterEstado == "activo")
            items = items.Where(p => p.Activo);
        else if (filterEstado == "inactivo")
            items = items.Where(p => !p.Activo);
        if (filterStockBajo)
            items = items.Where(p => p.StockBajo);

        filteredItems = items.ToList();
    }

    private void ApplyFilters() => ApplyFiltersInternal();

    private async Task ClearFilters()
    {
        filterCategoria = 0;
        filterMarca = 0;
        filterDeposito = 0;
        filterEstado = "todos";
        filterStockBajo = false;
        searchTerm = string.Empty;
        if (!string.IsNullOrEmpty(QueryProductoId))
        {
            QueryProductoId = null;
            Navigation.NavigateTo("/inventario/productos");
        }
        else
        {
            await LoadDataAsync();
        }
    }

    private async Task OnSearchChanged()
    {
        currentPage = 1;
        await LoadDataAsync();
    }

    private async Task PreviousPage()
    {
        if (productosResponse?.HasPreviousPage == true)
        {
            currentPage--;
            await LoadDataAsync();
        }
    }

    private async Task NextPage()
    {
        if (productosResponse?.HasNextPage == true)
        {
            currentPage++;
            await LoadDataAsync();
        }
    }

    // Delete confirmation modal state
    private bool showDeleteModal;
    private ProductoDto? productoToDelete;

    private void ConfirmDelete(string id)
    {
        productoToDelete = filteredItems?.FirstOrDefault(p => p.Id == id) ?? productosResponse?.Items?.FirstOrDefault(p => p.Id == id);
        if (productoToDelete != null)
        {
            showDeleteModal = true;
        }
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        productoToDelete = null;
    }

    private async Task ExecuteDelete()
    {
        if (productoToDelete != null)
        {
            var result = await ProductoService.DeleteAsync(productoToDelete.Id);
            showDeleteModal = false;
            productoToDelete = null;
            if (result)
            {
                await LoadDataAsync();
                var prodRes = await ProductoService.GetAllAsync(1, 1000);
                if (prodRes?.Items != null) todosLosProductos = prodRes.Items;
            }
            else
            {
                errorMessage = "No se pudo eliminar el producto.";
            }
        }
    }

    // ── Stock Modal ──
    private void ShowStockModal(ProductoDto p)
    {
        selectedProducto = p;
        stockTipo = "entrada";
        stockCantidad = 1;
        stockMotivo = string.Empty;
        stockError = string.Empty;
        // Pre-seleccionar el depósito si hay filtro activo
        stockDepositoId = filterDeposito > 0 ? filterDeposito : 0;
        showStockModal = true;
    }

    private void CloseStockModal()
    {
        showStockModal = false;
        selectedProducto = null;
    }

    private void OnStockDepositoChanged()
    {
        // Just trigger re-render to show stock info for selected deposit
    }

    private async Task HandleStockMovement()
    {
        if (selectedProducto == null) return;
        if (stockCantidad <= 0) { stockError = "La cantidad debe ser mayor a 0."; return; }
        if (stockDepositoId <= 0) { stockError = "Debe seleccionar un depósito."; return; }

        isSavingStock = true;
        stockError = string.Empty;

        var req = new MovimientoStockRequest
        {
            Cantidad = stockCantidad,
            Motivo = stockMotivo,
            DepositoId = stockDepositoId
        };
        bool ok;

        if (stockTipo == "entrada")
            ok = await ProductoService.EntradaStockAsync(selectedProducto.Id, req);
        else
            ok = await ProductoService.SalidaStockAsync(selectedProducto.Id, req);

        isSavingStock = false;

        if (ok)
        {
            var depNombre = depositos.FirstOrDefault(d => d.Id == stockDepositoId)?.Nombre ?? "depósito";
            successMessage = $"Movimiento de stock ({stockTipo}) en {depNombre} registrado correctamente.";
            CloseStockModal();
            await LoadDataAsync();
            // Auto-clear success after render
            _ = Task.Delay(4000).ContinueWith(_ => { successMessage = string.Empty; InvokeAsync(StateHasChanged); });
        }
        else
        {
            stockError = stockTipo == "salida"
                ? "Stock insuficiente en este depósito o error al procesar la salida."
                : "Error al procesar la entrada de stock.";
        }
    }

    // ── Product Modal Handlers ──
    private async Task OpenProductModalForCreate()
    {
        productModel = new ProductoDto { Activo = true };
        productErrorMessage = string.Empty;
        isSavingProduct = false;
        showProductModal = true;

        try
        {
            var catTask = CatalogoService.GetCategoriasAsync(soloActivas: true);
            var marTask = CatalogoService.GetMarcasAsync(soloActivas: true);
            var depTask = CatalogoService.GetDepositosAsync(soloActivos: true);
            var proTask = CatalogoService.GetProveedoresAsync(soloActivos: true);
            await Task.WhenAll(catTask, marTask, depTask, proTask);
            categorias = catTask.Result ?? new();
            marcas = marTask.Result ?? new();
            depositos = depTask.Result ?? new();
            proveedores = proTask.Result ?? new();
        }
        catch { }
    }

    private async Task OpenProductModalForEdit(string id)
    {
        productErrorMessage = string.Empty;
        isSavingProduct = false;
        showProductModal = true;
        try
        {
            var pTask = ProductoService.GetByIdAsync(id);
            var catTask = CatalogoService.GetCategoriasAsync(soloActivas: true);
            var marTask = CatalogoService.GetMarcasAsync(soloActivas: true);
            var depTask = CatalogoService.GetDepositosAsync(soloActivos: true);
            var proTask = CatalogoService.GetProveedoresAsync(soloActivos: true);
            await Task.WhenAll(pTask, catTask, marTask, depTask, proTask);

            categorias = catTask.Result ?? new();
            marcas = marTask.Result ?? new();
            depositos = depTask.Result ?? new();
            proveedores = proTask.Result ?? new();

            var p = pTask.Result;
            if (p != null)
            {
                if (p.CategoriaId > 0 && !categorias.Any(c => c.Id == p.CategoriaId))
                {
                    categorias.Add(new CategoriaDto { Id = p.CategoriaId, Nombre = !string.IsNullOrEmpty(p.CategoriaNombre) ? p.CategoriaNombre : $"Categoría #{p.CategoriaId} (Inactiva)", Activo = false });
                }
                if (p.MarcaId.HasValue && p.MarcaId.Value > 0 && !marcas.Any(m => m.Id == p.MarcaId.Value))
                {
                    marcas.Add(new MarcaDto { Id = p.MarcaId.Value, Nombre = !string.IsNullOrEmpty(p.MarcaNombre) ? p.MarcaNombre : $"Marca #{p.MarcaId.Value} (Inactiva)", Activo = false });
                }
                productModel = p;
            }
            else
            {
                productErrorMessage = "No se encontró el producto solicitado.";
            }
        }
        catch (Exception)
        {
            productErrorMessage = "Error al intentar obtener el producto.";
        }
    }

    private void CloseProductModal()
    {
        showProductModal = false;
    }

    private async Task HandleSaveProduct()
    {
        if (string.IsNullOrWhiteSpace(productModel.Nombre))
        {
            productErrorMessage = "El nombre del producto es requerido.";
            return;
        }
        if (string.IsNullOrWhiteSpace(productModel.CodigoBarras))
        {
            productErrorMessage = "El código de barras es requerido.";
            return;
        }
        if (productModel.CategoriaId == 0)
        {
            productErrorMessage = "Debe asignar una categoría.";
            return;
        }
        if (productModel.PrecioVenta < productModel.PrecioCompra)
        {
            productErrorMessage = "El precio de venta no puede ser menor al precio de compra.";
            return;
        }

        isSavingProduct = true;
        productErrorMessage = string.Empty;
        try
        {
            if (!bypassProductSimilarity && todosLosProductos != null)
            {
                similarProductsList = todosLosProductos
                    .Where(p => p.Id != productModel.Id && BlazorFrontEnd.Helpers.SimilarityHelper.AreSimilar(productModel.Nombre, p.Nombre))
                    .Select(p => p.Nombre)
                    .ToList();

                if (similarProductsList.Any())
                {
                    showSimilarProductsConfirm = true;
                    isSavingProduct = false;
                    return;
                }
            }

            bypassProductSimilarity = false;
            showSimilarProductsConfirm = false;

            (bool Success, string? ErrorMessage) result;
            if (string.IsNullOrEmpty(productModel.Id))
            {
                result = await ProductoService.CreateWithResultAsync(productModel);
            }
            else
            {
                result = await ProductoService.UpdateWithResultAsync(productModel.Id, productModel);
            }

            if (result.Success)
            {
                showProductModal = false;
                await LoadDataAsync();
                var prodRes = await ProductoService.GetAllAsync(1, 1000);
                if (prodRes?.Items != null)
                {
                    todosLosProductos = prodRes.Items;
                }
            }
            else
            {
                productErrorMessage = !string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? result.ErrorMessage.Trim('\"', '[', ']')
                    : "Error al guardar el producto. Revise que los campos sean correctos.";
            }
        }
        catch (Exception ex)
        {
            productErrorMessage = $"Ocurrió una excepción: {ex.Message}";
        }
        finally
        {
            isSavingProduct = false;
        }
    }

    private void CancelProductSimilarity()
    {
        showSimilarProductsConfirm = false;
        bypassProductSimilarity = false;
    }

    private async Task BypassProductSimilarity()
    {
        showSimilarProductsConfirm = false;
        bypassProductSimilarity = true;
        await HandleSaveProduct();
    }

    private void GoBack() => Navigation.NavigateTo("/inventario");
}
