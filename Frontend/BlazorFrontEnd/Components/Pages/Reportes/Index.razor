    private bool isValuacionStockOpen = true;
    private bool isListadoStockOpen = true;

    private string stockSortBy = "VALORTOTAL"; // "NOMBRE", "CANTIDAD", "VALORTOTAL", "PRECIOUNITARIO"
    private bool isStockSortAsc = false;
    private string stockFiltroTexto = "";
    private string stockFiltroEstado = "TODOS"; // "TODOS", "BAJO", "MEDIO", "OPTIMO"

    private void ToggleAllStockSubreportes()
    {
        bool target = !(isValuacionStockOpen && isListadoStockOpen);
        isValuacionStockOpen = target;
        isListadoStockOpen = target;
    }

    private void ToggleStockSort(string column)
    {
        if (stockSortBy == column)
        {
            isStockSortAsc = !isStockSortAsc;
        }
        else
        {
            stockSortBy = column;
            isStockSortAsc = (column == "NOMBRE");
        }
    }

    private (string BadgeClass, string TextClass, string Label, string Icon, string EstadoKey) GetStockStatus(int stockActual, int stockMinimo)
    {
        if (stockActual <= stockMinimo)
        {
            return ("bg-danger text-white", "text-danger", stockActual == 0 ? "Sin Stock" : "Bajo Stock", "", "BAJO");
        }
        else if (stockMinimo > 0 ? (stockActual <= stockMinimo * 1.5) : (stockActual <= 3))
        {
            return ("bg-warning text-dark", "text-warning", "Stock Medio", "", "MEDIO");
        }
        else
        {
            return ("bg-success text-white", "text-success", "Stock Óptimo", "", "OPTIMO");
        }
    }

    private List<ProductoStockItemDto> GetListaStockFiltradaYOrdenada()
    {
        if (reporteStock == null || reporteStock.ListaTodosProductos == null) return new();

        var query = reporteStock.ListaTodosProductos.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(stockFiltroTexto))
        {
            var f = stockFiltroTexto.Trim();
            query = query.Where(p => 
                p.Nombre.Contains(f, StringComparison.OrdinalIgnoreCase) ||
                p.CategoriaNombre.Contains(f, StringComparison.OrdinalIgnoreCase) ||
                p.CodigoBarras.Contains(f, StringComparison.OrdinalIgnoreCase));
        }

        if (stockFiltroEstado != "TODOS")
        {
            query = query.Where(p => GetStockStatus(p.StockActual, p.StockMinimo).EstadoKey == stockFiltroEstado);
        }

        query = stockSortBy switch
        {
            "NOMBRE" => isStockSortAsc ? query.OrderBy(p => p.Nombre) : query.OrderByDescending(p => p.Nombre),
            "CANTIDAD" => isStockSortAsc ? query.OrderBy(p => p.StockActual) : query.OrderByDescending(p => p.StockActual),
            "PRECIOUNITARIO" => isStockSortAsc ? query.OrderBy(p => p.PrecioUnitario) : query.OrderByDescending(p => p.PrecioUnitario),
            "VALORTOTAL" => isStockSortAsc ? query.OrderBy(p => p.ValorTotal) : query.OrderByDescending(p => p.ValorTotal),
            _ => query.OrderByDescending(p => p.ValorTotal)
        };

        return query.ToList();
    }

