    private static readonly string[] EspeciePalette = new[]
    {
        "#0284c7", "#8b5cf6", "#10b981", "#f59e0b", "#ec4899", 
        "#06b6d4", "#6366f1", "#f97316", "#14b8a6", "#84cc16"
    };

    private List<EspeciePieSlice> GetEspeciesPieSlices()
    {
        var result = new List<EspeciePieSlice>();
        if (reporteClinico == null || reporteClinico.PacientesPorEspecie == null || !reporteClinico.PacientesPorEspecie.Any())
            return result;

        var ordenados = reporteClinico.PacientesPorEspecie.OrderByDescending(e => e.Cantidad).ToList();
        int total = ordenados.Sum(e => e.Cantidad);
        if (total <= 0) return result;

        double currentAngle = -90.0;
        double cx = 175.0, cy = 175.0;
        double R = 130.0, r = 70.0;

        for (int i = 0; i < ordenados.Count; i++)
        {
            var item = ordenados[i];
            double angle = (double)item.Cantidad / total * 360.0;
            if (angle > 359.999) angle = 359.999;
            double startAngle = currentAngle;
            double endAngle = currentAngle + angle;
            double midAngle = startAngle + angle / 2.0;
            currentAngle += angle;

            double startRad = startAngle * Math.PI / 180.0;
            double endRad = endAngle * Math.PI / 180.0;

            double x1 = cx + R * Math.Cos(startRad);
            double y1 = cy + R * Math.Sin(startRad);
            double x2 = cx + R * Math.Cos(endRad);
            double y2 = cy + R * Math.Sin(endRad);

            double x3 = cx + r * Math.Cos(endRad);
            double y3 = cy + r * Math.Sin(endRad);
            double x4 = cx + r * Math.Cos(startRad);
            double y4 = cy + r * Math.Sin(startRad);

            int largeArc = (angle > 180.0) ? 1 : 0;

            var ci = System.Globalization.CultureInfo.InvariantCulture;
            string path = string.Format(ci,
                "M {0:F2} {1:F2} A {2:F2} {2:F2} 0 {3} 1 {4:F2} {5:F2} L {6:F2} {7:F2} A {8:F2} {8:F2} 0 {3} 0 {9:F2} {10:F2} Z",
                x1, y1, R, largeArc, x2, y2, x3, y3, r, x4, y4);

            string color = EspeciePalette[i % EspeciePalette.Length];
            decimal pct = ((decimal)item.Cantidad / total) * 100m;

            result.Add(new EspeciePieSlice
            {
                EspecieId = item.EspecieId,
                EspecieNombre = item.EspecieNombre,
                Cantidad = item.Cantidad,
                Porcentaje = pct,
                Color = color,
                SvgPath = path,
                MidAngle = midAngle
            });
        }
        return result;
    }

    private string GetEspecieIcon(string nombre)
    {
        var n = (nombre ?? "").ToLowerInvariant();
        if (n.Contains("can") || n.Contains("perr") || n.Contains("dog")) return "🐕";
        if (n.Contains("fel") || n.Contains("gat") || n.Contains("cat")) return "🐈";
        if (n.Contains("av") || n.Contains("paj") || n.Contains("bird") || n.Contains("loro")) return "🦜";
        if (n.Contains("con") || n.Contains("roed") || n.Contains("ham") || n.Contains("cob")) return "🐇";
        if (n.Contains("rep") || n.Contains("tort") || n.Contains("serp") || n.Contains("igua")) return "🐢";
        if (n.Contains("equ") || n.Contains("cab")) return "🐎";
        if (n.Contains("bov") || n.Contains("vac")) return "🐄";
        return "🐾";
    }

    // Filtros Histórico de Tratamientos
    private DateTime? filtroDesde;
    private DateTime? filtroHasta;
    private string filtroPaciente = string.Empty;
    private string filtroPropietario = string.Empty;
    private string filtroVeterinario = string.Empty;
    private bool isLoadingTratamientos = false;

    protected override async Task OnInitializedAsync()
    {
        // Determine user role
        if (AuthState != null)
        {
            var authState = await AuthState;
            var roleClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)
                ?? authState.User.FindFirst("role");
            userRole = roleClaim?.Value ?? "";
        }

        // Set default tab based on role
        if (userRole == "Veterinario")
            activeTab = "TURNOS";
        else
            activeTab = "FINANZAS"; // Admin default

        await LoadDataForTab(activeTab);
    }

    /// <summary>
    /// Determines if the current user role can see a specific report tab.
    /// Admin & Gerente: FINANZAS, STOCK, TURNOS, CLINICA
    /// Veterinario: TURNOS, CLINICA
    /// </summary>
    private bool CanSeeTab(string tabName)
    {
        return tabName switch
        {
            "FINANZAS" => userRole == "Admin" || userRole == "Gerente",
            "STOCK" => userRole == "Admin" || userRole == "Gerente",
            "TURNOS" => userRole == "Admin" || userRole == "Veterinario" || userRole == "Gerente",
            "CLINICA" => userRole == "Admin" || userRole == "Veterinario" || userRole == "Gerente",
            _ => false
        };
    }

    private async Task ChangeTab(string tabName)
    {
        activeTab = tabName;
        await LoadDataForTab(tabName);
    }

    private async Task LoadDataForTab(string tabName)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            if (tabName == "FINANZAS" && reporteVentas == null)
            {
                reporteVentas = await ReporteService.GetReporteVentasAsync();
            }
            else if (tabName == "STOCK" && reporteStock == null)
            {
                reporteStock = await ReporteService.GetReporteStockAsync();
            }
            else if (tabName == "TURNOS" && reporteTurnos == null)
            {
                reporteTurnos = await ReporteService.GetReporteTurnosAsync();
            }
            else if (tabName == "CLINICA" && reporteClinico == null)
            {
                reporteClinico = await ReporteService.GetReporteClinicoAsync();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Download(string endPoint)
    {
        await ReporteService.TriggerCsvDownloadAsync(endPoint);
    }

    private async Task ExportarIndividual()
    {
        if(!string.IsNullOrWhiteSpace(pacienteIdParaExportar))
        {
            await Download($"api/v1/Export/historial/{pacienteIdParaExportar}");
            pacienteIdParaExportar = string.Empty; // reset
        }
    }

    // ═══ Histórico de Tratamientos (R003) ═══

    private async Task BuscarTratamientos()
    {
        isLoadingTratamientos = true;
        StateHasChanged();
        try
        {
            historicoTratamientos = await ReporteService.GetHistoricoTratamientosAsync(
                filtroDesde, filtroHasta,
                string.IsNullOrWhiteSpace(filtroPaciente) ? null : filtroPaciente,
                string.IsNullOrWhiteSpace(filtroPropietario) ? null : filtroPropietario,
                string.IsNullOrWhiteSpace(filtroVeterinario) ? null : filtroVeterinario);
        }
        finally
        {
            isLoadingTratamientos = false;
        }
    }

    private void LimpiarFiltrosTratamientos()
    {
        filtroDesde = null;
        filtroHasta = null;
        filtroPaciente = string.Empty;
        filtroPropietario = string.Empty;
        filtroVeterinario = string.Empty;
        historicoTratamientos = null;
    }

    private bool HasActiveTratamientosFilter =>
        filtroDesde.HasValue ||
        filtroHasta.HasValue ||
        !string.IsNullOrWhiteSpace(filtroPaciente) ||
        !string.IsNullOrWhiteSpace(filtroPropietario) ||
        !string.IsNullOrWhiteSpace(filtroVeterinario);
}
