    public class DiaVentaItem
    {
        public int DiaNumero { get; set; }
        public DateTime Fecha { get; set; }
        public decimal Facturado { get; set; }
        public int Operaciones { get; set; }
    }

    private void ToggleAllSubreportes()
    {
        bool target = !(isResumenOpen && isMetodosOpen && isTopProductosOpen);
        isResumenOpen = target;
        isMetodosOpen = target;
        isTopProductosOpen = target;
