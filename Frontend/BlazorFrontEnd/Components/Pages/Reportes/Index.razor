@page "/reportes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Gerente,Veterinario")]
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@inject ReporteService ReporteService
@inject IJSRuntime JS

<PageTitle>Centro de Reportes</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 style="font-weight: 700; margin: 0; color: var(--text-primary);">Centro de Reportes</h2>
        <p class="text-secondary" style="margin: 0;">Análisis y Extracción de Datos (Formatos CSV)</p>
    </div>
</div>

<!-- Navegación de Pestañas (filtradas por rol) -->
<ul class="nav nav-pills mb-4 pb-2" style="border-bottom: 1px solid var(--border-glass);">
    @if (CanSeeTab("FINANZAS"))
    {
        <li class="nav-item">
            <button class="nav-link @(activeTab == "FINANZAS" ? "active bg-primary disabled" : "text-light")" style="@(activeTab == "FINANZAS" ? "border-radius: 8px; font-weight: 600;" : "border-radius: 8px;")" @onclick='() => ChangeTab("FINANZAS")'>Finanzas y Ventas</button>
        </li>
    }
    @if (CanSeeTab("STOCK"))
    {
        <li class="nav-item ms-2">
            <button class="nav-link @(activeTab == "STOCK" ? "active bg-primary disabled" : "text-light")" style="@(activeTab == "STOCK" ? "border-radius: 8px; font-weight: 600;" : "border-radius: 8px;")" @onclick='() => ChangeTab("STOCK")'>Control de Stock</button>
        </li>
    }
    @if (CanSeeTab("TURNOS"))
    {
        <li class="nav-item ms-2">
            <button class="nav-link @(activeTab == "TURNOS" ? "active bg-primary disabled" : "text-light")" style="@(activeTab == "TURNOS" ? "border-radius: 8px; font-weight: 600;" : "border-radius: 8px;")" @onclick='() => ChangeTab("TURNOS")'>Rendimiento de Turnos</button>
        </li>
    }
    @if (CanSeeTab("CLINICA"))
    {
        <li class="nav-item ms-2">
            <button class="nav-link @(activeTab == "CLINICA" ? "active bg-primary disabled" : "text-light")" style="@(activeTab == "CLINICA" ? "border-radius: 8px; font-weight: 600;" : "border-radius: 8px;")" @onclick='() => ChangeTab("CLINICA")'>Resumen Clínico</button>
        </li>
    }
</ul>

@if (isLoading)
{
    <div class="text-center p-5 text-secondary">
        <div class="spinner-border text-info mb-3" role="status"></div><br/>
        Procesando los módulos de reportes avanzados...
    </div>
}
else
{
    <!-- CONTENIDO: FINANZAS (3 SUBREPORTES COLAPSABLES) -->
    @if (activeTab == "FINANZAS" && reporteVentas != null)
    {
        <!-- Barra de Herramientas y Exportación -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <div>
                <h5 class="m-0 fw-bold" style="color: var(--text-primary);">Subreportes Financieros y Comerciales</h5>
                <small class="text-secondary">Período: @reporteVentas.Desde.ToString("dd/MM/yyyy") — @reporteVentas.Hasta.ToString("dd/MM/yyyy") (Últimos 30 días)</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleAllSubreportes" style="border-radius: 8px; font-weight: 500;">
                    @(isResumenOpen && isMetodosOpen && isTopProductosOpen ? "Contraer todos" : "Expandir todos")
                </button>
                <button class="btn btn-success btn-sm" @onclick='() => Download("api/v1/Export/ventas")' style="border-radius: 8px; font-weight: 600; background-color: var(--accent-primary); border-color: var(--accent-primary); color: white;">
                    Descargar Ventas (CSV)
                </button>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SUBREPORTE 1: Resumen Comercial (Últimos 30 días)             -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <div class="glass-card mb-4" style="background: #ffffff; border: 1px solid var(--border-light); border-radius: var(--radius-md); box-shadow: var(--shadow-card);">
            <!-- Encabezado colapsable -->
            <div class="d-flex justify-content-between align-items-center pb-2 @(isResumenOpen ? "border-bottom mb-3" : "")" style="cursor: pointer;" @onclick="() => isResumenOpen = !isResumenOpen">
                <div>
                    <h5 class="m-0 fw-bold" style="color: var(--text-primary);">1. Resumen Comercial (Últimos 30 días)</h5>
                    <small class="text-secondary">Evolución diaria de facturación y transacciones</small>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="d-none d-md-flex align-items-center gap-2">
                        <span class="badge bg-light text-dark border px-2 py-1">Facturado: <strong class="text-success">$@reporteVentas.TotalVentas.ToString("N0")</strong></span>
                        <span class="badge bg-light text-dark border px-2 py-1">Operaciones: <strong>@reporteVentas.CantidadVentas</strong></span>
                        <span class="badge bg-light text-dark border px-2 py-1">Promedio: <strong class="text-info">$@reporteVentas.PromedioVenta.ToString("N0")</strong></span>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" style="border-radius: 6px; padding: 2px 8px;" type="button" aria-label="Toggle Resumen">
                        @(isResumenOpen ? "▲" : "▼")
                    </button>
                </div>
            </div>

            @if (isResumenOpen)
            {
                var dias30 = ObtenerDias30();
                decimal maxDailyFact = dias30.Any() ? dias30.Max(d => d.Facturado) : 0;
                decimal scaleMaxFact = maxDailyFact > 100000m ? Math.Ceiling(maxDailyFact / 20000m) * 20000m : 100000m;
                int maxDailyOps = dias30.Any() ? dias30.Max(d => d.Operaciones) : 0;
                int scaleMaxOps = maxDailyOps < 5 ? 5 : (maxDailyOps % 2 == 0 ? maxDailyOps : maxDailyOps + 1);

                string linePath = GetSvgPath(dias30, lineChartMetric, scaleMaxFact, scaleMaxOps);
                string areaPath = GetSvgAreaPath(dias30, lineChartMetric, scaleMaxFact, scaleMaxOps);
                string strokeColor = lineChartMetric == "FACTURADO" ? "#00A36C" : "#0d6efd";
                string gradColorStart = lineChartMetric == "FACTURADO" ? "rgba(0, 163, 108, 0.28)" : "rgba(13, 110, 253, 0.28)";
                string gradColorEnd = lineChartMetric == "FACTURADO" ? "rgba(0, 163, 108, 0.0)" : "rgba(13, 110, 253, 0.0)";

                <!-- KPIs Destacados -->
                <div class="row text-center mb-4 g-3">
                    <div class="col-md-4">
                        <div class="p-3 rounded border" style="background: #f8faf9;">
                            <small class="text-uppercase text-secondary fw-bold d-block mb-1" style="font-size: 0.75rem;">Facturado Total (30 días)</small>
                            <h3 class="text-success m-0 fw-bold" style="font-size: 1.75rem;">$@reporteVentas.TotalVentas.ToString("N0")</h3>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded border" style="background: #f8faf9;">
                            <small class="text-uppercase text-secondary fw-bold d-block mb-1" style="font-size: 0.75rem;">Operaciones Totales</small>
                            <h3 class="m-0 fw-bold" style="color: var(--text-primary); font-size: 1.75rem;">@reporteVentas.CantidadVentas <span class="fs-6 text-secondary fw-normal">trx</span></h3>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded border" style="background: #f8faf9;">
                            <small class="text-uppercase text-secondary fw-bold d-block mb-1" style="font-size: 0.75rem;">Promedio por Venta</small>
                            <h3 class="text-info m-0 fw-bold" style="font-size: 1.75rem;">$@reporteVentas.PromedioVenta.ToString("N0")</h3>
                        </div>
                    </div>
                </div>

                <!-- Barra de selección de métrica del gráfico -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                    <div>
                        <span class="fw-bold" style="color: var(--text-primary);">Gráfico de Líneas Diario:</span>
                        <span class="text-secondary small ms-1">
                            @(lineChartMetric == "FACTURADO" 
                                ? "Muestra el total facturado diario (ordenada en pasos de $10.000 hasta $100.000+)" 
                                : "Muestra la cantidad de operaciones por día (del día 1 al 30)")
                        </span>
                    </div>
                    <div class="btn-group" role="group" aria-label="Métrica de Gráfico">
                        <button type="button" 
                                class="btn btn-sm @(lineChartMetric == "FACTURADO" ? "btn-success" : "btn-outline-secondary")"
                                style="font-weight: 600; padding: 5px 16px; @(lineChartMetric == "FACTURADO" ? "background-color: var(--accent-primary); border-color: var(--accent-primary); color: white;" : "")"
                                @onclick='() => lineChartMetric = "FACTURADO"'>
                            Facturado ($)
                        </button>
                        <button type="button" 
                                class="btn btn-sm @(lineChartMetric == "OPERACIONES" ? "btn-primary" : "btn-outline-secondary")"
                                style="font-weight: 600; padding: 5px 16px; @(lineChartMetric == "OPERACIONES" ? "background-color: #0d6efd; border-color: #0d6efd; color: white;" : "")"
                                @onclick='() => lineChartMetric = "OPERACIONES"'>
                            Operaciones (trx)
                        </button>
                    </div>
                </div>

                <!-- Gráfico de Líneas Vectorial SVG (Abscisas: Días 1 al 30, Ordenadas: Total / Operaciones) -->
                <div class="p-3 border rounded" style="background: #ffffff;">
                    <div style="width: 100%; overflow-x: auto;">
                        <svg viewBox="0 0 1000 360" style="width: 100%; min-width: 720px; height: auto; display: block;" font-family="Segoe UI, sans-serif">
                            <defs>
                                <linearGradient id="chartGradient" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="@gradColorStart" />
                                    <stop offset="100%" stop-color="@gradColorEnd" />
                                </linearGradient>
                            </defs>

                            <!-- Líneas de Grilla Horizontal y Etiquetas Eje Y (Ordenadas) -->
                            @if (lineChartMetric == "FACTURADO")
                            {
                                int steps = (int)(scaleMaxFact / 10000m);
                                if (steps > 12) steps = 10;
                                decimal stepVal = scaleMaxFact / steps;

                                for (int s = 0; s <= steps; s++)
                                {
                                    decimal val = s * stepVal;
                                    double yPos = 315.0 - (double)(val / scaleMaxFact) * 285.0;
                                    <line x1="85" y1="@yPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                          x2="970" y2="@yPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                          stroke="#e5e7eb" stroke-width="1" stroke-dasharray="@(s == 0 ? "none" : "3,3")" />
                                    @RenderSvgText(75, yPos + 4, $"${val:N0}", "end", 11, "#6b7280", "600")
                                }
                            }
                            else
                            {
                                int steps = scaleMaxOps <= 6 ? scaleMaxOps : 5;
                                int stepVal = Math.Max(1, scaleMaxOps / steps);
                                for (int s = 0; s <= steps; s++)
                                {
                                    int val = s * stepVal;
                                    if (val > scaleMaxOps) break;
                                    double yPos = 315.0 - (double)(val / (double)scaleMaxOps) * 285.0;
                                    <line x1="85" y1="@yPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                          x2="970" y2="@yPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                          stroke="#e5e7eb" stroke-width="1" stroke-dasharray="@(s == 0 ? "none" : "3,3")" />
                                    @RenderSvgText(75, yPos + 4, $"{val} trx", "end", 11, "#6b7280", "600")
                                }
                            }

                            <!-- Eje X (Línea base) -->
                            <line x1="85" y1="315" x2="970" y2="315" stroke="#9ca3af" stroke-width="1.5" />

                            <!-- Área sombreada con gradiente -->
                            @if (!string.IsNullOrEmpty(areaPath))
                            {
                                <path d="@areaPath" fill="url(#chartGradient)" />
                            }

                            <!-- Línea principal del gráfico -->
                            @if (!string.IsNullOrEmpty(linePath))
                            {
                                <path d="@linePath" fill="none" stroke="@strokeColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                            }

                            <!-- Puntos y Etiquetas Eje X (Días 1 al 30) -->
                            @for (int i = 0; i < dias30.Count; i++)
                            {
                                var day = dias30[i];
                                double xPos = 85.0 + i * (885.0 / 29.0);
                                double yPos;
                                if (lineChartMetric == "FACTURADO")
                                {
                                    yPos = 315.0 - (double)(day.Facturado / scaleMaxFact) * 285.0;
                                }
                                else
                                {
                                    yPos = 315.0 - (double)(day.Operaciones / (double)scaleMaxOps) * 285.0;
                                }

                                bool isSelected = diaSeleccionado?.DiaNumero == day.DiaNumero;

                                <!-- Marca vertical sutil en el eje X -->
                                <line x1="@xPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" y1="315" 
                                      x2="@xPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" y2="320" 
                                      stroke="#9ca3af" stroke-width="1" />

                                <!-- Etiqueta del Día (1 al 30) -->
                                @RenderSvgText(xPos, 335, day.DiaNumero.ToString(), "middle", 10, isSelected ? strokeColor : "#4b5563", isSelected ? "700" : "500")

                                <!-- Punto interactivo clickeable -->
                                <circle cx="@xPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                        cy="@yPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                        r="@(isSelected ? "7" : (day.Facturado > 0 || day.Operaciones > 0 ? "4.5" : "3"))" 
                                        fill="@(isSelected ? "#ffffff" : strokeColor)" 
                                        stroke="@(isSelected ? strokeColor : "#ffffff")" 
                                        stroke-width="@(isSelected ? "3.5" : "1.5")" 
                                        style="cursor: pointer; transition: r 0.2s, stroke-width 0.2s;"
                                        @onclick="() => diaSeleccionado = (diaSeleccionado?.DiaNumero == day.DiaNumero ? null : day)" />
                            }

                            <!-- Título del Eje X -->
                            @RenderSvgText(527, 354, "Días del período (1 al 30)", "middle", 11, "#6b7280", "600")
                        </svg>
                    </div>

                    <!-- Panel de Detalle del Día Seleccionado -->
                    @if (diaSeleccionado != null)
                    {
                        <div class="d-flex flex-wrap align-items-center justify-content-between p-2 px-3 mt-3 rounded border" 
                             style="background: @(lineChartMetric == "FACTURADO" ? "rgba(0, 163, 108, 0.08)" : "rgba(13, 110, 253, 0.08)"); border-color: @strokeColor !important;">
                            <div>
                                <strong style="color: var(--text-primary);">Día @diaSeleccionado.DiaNumero — @diaSeleccionado.Fecha.ToString("dd/MM/yyyy") (@diaSeleccionado.Fecha.ToString("dddd", new System.Globalization.CultureInfo("es-ES")))</strong>
                            </div>
                            <div class="d-flex flex-wrap gap-3 my-1">
                                <span>Facturado: <strong class="text-success">$@diaSeleccionado.Facturado.ToString("N0")</strong></span>
                                <span>Operaciones: <strong style="color: #0d6efd;">@diaSeleccionado.Operaciones trx</strong></span>
                                <span>Ticket Promedio: <strong>$@(diaSeleccionado.Operaciones > 0 ? (diaSeleccionado.Facturado / diaSeleccionado.Operaciones).ToString("N0") : "0")</strong></span>
                            </div>
                            <button class="btn btn-sm btn-link text-secondary p-0 text-decoration-none" @onclick="() => diaSeleccionado = null">✕ Deseleccionar</button>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-secondary small mt-2">
                            <span class="text-muted">Haz clic en cualquier punto del gráfico (Día 1 al 30) para inspeccionar el desglose de ese día.</span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SUBREPORTE 2: Distribución por Método de Pago                 -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <div class="glass-card mb-4" style="background: #ffffff; border: 1px solid var(--border-light); border-radius: var(--radius-md); box-shadow: var(--shadow-card);">
            <!-- Encabezado colapsable -->
            <div class="d-flex justify-content-between align-items-center pb-2 @(isMetodosOpen ? "border-bottom mb-3" : "")" style="cursor: pointer;" @onclick="() => isMetodosOpen = !isMetodosOpen">
                <div>
                    <h5 class="m-0 fw-bold" style="color: var(--text-primary);">2. Distribución por Método de Pago</h5>
                    <small class="text-secondary">Participación de medios de pago en ventas totales</small>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-light text-dark border px-2 py-1">@reporteVentas.VentasPorMetodoPago.Count métodos</span>
                    <button class="btn btn-sm btn-outline-secondary" style="border-radius: 6px; padding: 2px 8px;" type="button" aria-label="Toggle Metodos">
                        @(isMetodosOpen ? "▲" : "▼")
                    </button>
                </div>
            </div>

            @if (isMetodosOpen)
            {
                var listaMetodos = GetListaMetodosOrdenada();
                decimal maxMonto = listaMetodos.Any() ? listaMetodos.Max(m => m.Total) : 1;
                if (maxMonto <= 0) maxMonto = 1;
                int maxTrx = listaMetodos.Any() ? listaMetodos.Max(m => m.Cantidad) : 1;
                if (maxTrx <= 0) maxTrx = 1;
                decimal granTotal = reporteVentas.TotalVentas > 0 ? reporteVentas.TotalVentas : 1;
                int granTotalTrx = reporteVentas.CantidadVentas > 0 ? reporteVentas.CantidadVentas : 1;

                <!-- Controles de Ordenamiento -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                    <div>
                        <span class="fw-bold" style="color: var(--text-primary);">Ordenar por:</span>
                        <span class="text-secondary small ms-1">
                            @(metodoSortBy == "TOTAL" ? "Muestra primero los métodos con mayor facturación" : "Muestra primero los métodos con más operaciones")
                        </span>
                    </div>
                    <div class="btn-group" role="group" aria-label="Orden Método de Pago">
                        <button type="button" 
                                class="btn btn-sm @(metodoSortBy == "TOTAL" ? "btn-success" : "btn-outline-secondary")"
                                style="font-weight: 600; padding: 4px 14px; @(metodoSortBy == "TOTAL" ? "background-color: var(--accent-primary); border-color: var(--accent-primary); color: white;" : "")"
                                @onclick='() => metodoSortBy = "TOTAL"'>
                            Total Facturado ($)
                        </button>
                        <button type="button" 
                                class="btn btn-sm @(metodoSortBy == "CANTIDAD" ? "btn-primary" : "btn-outline-secondary")"
                                style="font-weight: 600; padding: 4px 14px; @(metodoSortBy == "CANTIDAD" ? "background-color: #0d6efd; border-color: #0d6efd; color: white;" : "")"
                                @onclick='() => metodoSortBy = "CANTIDAD"'>
                            Cantidad de Transacciones (trx)
                        </button>
                    </div>
                </div>

                @if (!listaMetodos.Any())
                {
                    <p class="text-secondary small my-3">Sin datos registrados de métodos de pago en el período.</p>
                }
                else
                {
                    <!-- Gráfico de Barras Proporcionales -->
                    <div class="p-3 border rounded mb-4" style="background: #fafafa;">
                        <h6 class="fw-bold mb-3" style="color: var(--text-primary);">Gráfico Comparativo de Métodos de Pago</h6>
                        <div class="d-flex flex-column gap-3">
                            @foreach (var pago in listaMetodos)
                            {
                                double barPercent = metodoSortBy == "TOTAL"
                                    ? (double)(pago.Total / maxMonto) * 100.0
                                    : (double)(pago.Cantidad / (double)maxTrx) * 100.0;
                                if (barPercent < 3 && (pago.Total > 0 || pago.Cantidad > 0)) barPercent = 3;

                                decimal shareMonto = (pago.Total / granTotal) * 100m;
                                decimal shareTrx = ((decimal)pago.Cantidad / granTotalTrx) * 100m;

                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold" style="color: var(--text-primary);">
                                            @pago.MetodoPago
                                        </span>
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="text-secondary small">@pago.Cantidad trx (@shareTrx.ToString("0.0")%)</span>
                                            <span class="text-success fw-bold">$@pago.Total.ToString("N0") <small class="text-muted">(@shareMonto.ToString("0.0")%)</small></span>
                                        </div>
                                    </div>
                                    <div class="progress" style="height: 22px; background: #e9ecef; border-radius: 6px; overflow: hidden;">
                                        <div class="progress-bar" role="progressbar" 
                                             style="width: @barPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; background: linear-gradient(90deg, var(--accent-primary) 0%, #20c997 100%); transition: width 0.5s ease; font-weight: 600; font-size: 0.75rem; text-align: right; padding-right: 8px;">
                                            @(metodoSortBy == "TOTAL" ? $"${pago.Total:N0}" : $"{pago.Cantidad} trx")
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Tabla de Detalle -->
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle" style="background: transparent;">
                            <thead class="table-light">
                                <tr>
                                    <th>Método de Pago</th>
                                    <th class="text-center">Transacciones (trx)</th>
                                    <th class="text-center">% Participación</th>
                                    <th class="text-end">Total Facturado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pago in listaMetodos)
                                {
                                    decimal share = (pago.Total / granTotal) * 100m;
                                    <tr>
                                        <td class="fw-bold" style="color: var(--text-primary);">
                                            @pago.MetodoPago
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary">@pago.Cantidad trx</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border">@share.ToString("0.0")%</span>
                                        </td>
                                        <td class="text-end fw-bold text-success">
                                            $@pago.Total.ToString("N0")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td>TOTAL GENERAL</td>
                                    <td class="text-center">@reporteVentas.CantidadVentas trx</td>
                                    <td class="text-center">100%</td>
                                    <td class="text-end text-success">$@reporteVentas.TotalVentas.ToString("N0")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            }
        </div>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SUBREPORTE 3: Top de Productos/Servicios Vendidos             -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <div class="glass-card mb-4" style="background: #ffffff; border: 1px solid var(--border-light); border-radius: var(--radius-md); box-shadow: var(--shadow-card);">
            <!-- Encabezado colapsable -->
            <div class="d-flex justify-content-between align-items-center pb-2 @(isTopProductosOpen ? "border-bottom mb-3" : "")" style="cursor: pointer;" @onclick="() => isTopProductosOpen = !isTopProductosOpen">
                <div>
                    <h5 class="m-0 fw-bold" style="color: var(--text-primary);">3. Top de Productos/Servicios Vendidos</h5>
                    <small class="text-secondary">Ranking de productos y servicios con mayor volumen y facturación</small>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-light text-dark border px-2 py-1">@reporteVentas.ProductosMasVendidos.Count ítems</span>
                    <button class="btn btn-sm btn-outline-secondary" style="border-radius: 6px; padding: 2px 8px;" type="button" aria-label="Toggle Productos">
                        @(isTopProductosOpen ? "▲" : "▼")
                    </button>
                </div>
            </div>

            @if (isTopProductosOpen)
            {
                var listaProds = GetListaProductosOrdenada();
                int maxCant = listaProds.Any() ? listaProds.Max(p => p.CantidadVendida) : 1;
                if (maxCant <= 0) maxCant = 1;
                decimal maxTotalProd = listaProds.Any() ? listaProds.Max(p => p.TotalVendido) : 1;
                if (maxTotalProd <= 0) maxTotalProd = 1;

                <!-- Controles de Ordenamiento -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                    <div>
                        <span class="fw-bold" style="color: var(--text-primary);">Ordenar por:</span>
                        <span class="text-secondary small ms-1">
                            @(productoSortBy == "CANTIDAD" ? "Muestra primero los productos/servicios con más unidades vendidas" : "Muestra primero los productos/servicios con mayor importe facturado")
                        </span>
                    </div>
                    <div class="btn-group" role="group" aria-label="Orden Top Productos/Servicios">
                        <button type="button" 
                                class="btn btn-sm @(productoSortBy == "CANTIDAD" ? "btn-primary" : "btn-outline-secondary")"
                                style="font-weight: 600; padding: 4px 14px; @(productoSortBy == "CANTIDAD" ? "background-color: #0d6efd; border-color: #0d6efd; color: white;" : "")"
                                @onclick='() => productoSortBy = "CANTIDAD"'>
                            Cantidades Vendidas (uds)
                        </button>
                        <button type="button" 
                                class="btn btn-sm @(productoSortBy == "TOTAL" ? "btn-success" : "btn-outline-secondary")"
                                style="font-weight: 600; padding: 4px 14px; @(productoSortBy == "TOTAL" ? "background-color: var(--accent-primary); border-color: var(--accent-primary); color: white;" : "")"
                                @onclick='() => productoSortBy = "TOTAL"'>
                            Total Facturado ($)
                        </button>
                    </div>
                </div>

                @if (!listaProds.Any())
                {
                    <p class="text-secondary small my-3">Sin ventas de productos/servicios registradas en el período.</p>
                }
                else
                {
                    <!-- Gráfico de Barras para Top Productos/Servicios -->
                    <div class="p-3 border rounded mb-4" style="background: #fafafa;">
                        <h6 class="fw-bold mb-3" style="color: var(--text-primary);">Gráfico de Barras — Top Productos/Servicios</h6>
                        <div class="d-flex flex-column gap-3">
                            @for (int i = 0; i < listaProds.Count; i++)
                            {
                                var prod = listaProds[i];
                                double barPercent = productoSortBy == "CANTIDAD"
                                    ? (double)(prod.CantidadVendida / (double)maxCant) * 100.0
                                    : (double)(prod.TotalVendido / maxTotalProd) * 100.0;
                                if (barPercent < 3) barPercent = 3;

                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge @(i == 0 ? "bg-warning text-dark" : (i == 1 ? "bg-secondary text-white" : (i == 2 ? "bg-dark text-white" : "bg-light text-dark border")))" style="font-size: 0.75rem;">
                                                #@(i + 1)
                                            </span>
                                            <span class="fw-bold" style="color: var(--text-primary);">@prod.ProductoNombre</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-primary text-white">@prod.CantidadVendida uds</span>
                                            <span class="text-success fw-bold">$@prod.TotalVendido.ToString("N0")</span>
                                        </div>
                                    </div>
                                    <div class="progress" style="height: 22px; background: #e9ecef; border-radius: 6px; overflow: hidden;">
                                        <div class="progress-bar" role="progressbar" 
                                             style="width: @barPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; background: @(productoSortBy == "CANTIDAD" ? "linear-gradient(90deg, #0d6efd 0%, #0dcaf0 100%)" : "linear-gradient(90deg, var(--accent-primary) 0%, #ffc107 100%)"); transition: width 0.5s ease; font-weight: 600; font-size: 0.75rem; text-align: right; padding-right: 8px;">
                                            @(productoSortBy == "CANTIDAD" ? $"{prod.CantidadVendida} uds (${prod.TotalVendido:N0})" : $"${prod.TotalVendido:N0} ({prod.CantidadVendida} uds)")
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Tabla de Detalle -->
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle" style="background: transparent;">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 60px;" class="text-center">#</th>
                                    <th>Producto / Servicio</th>
                                    <th class="text-center">Unidades Vendidas</th>
                                    <th class="text-end">Total Facturado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < listaProds.Count; i++)
                                {
                                    var prod = listaProds[i];
                                    <tr>
                                        <td class="text-center">
                                            <span class="badge @(i == 0 ? "bg-warning text-dark" : (i == 1 ? "bg-secondary text-white" : (i == 2 ? "bg-dark text-white" : "bg-light text-dark border")))">
                                                #@(i + 1)
                                            </span>
                                        </td>
                                        <td class="fw-bold" style="color: var(--text-primary);">
                                            @prod.ProductoNombre
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-primary">@prod.CantidadVendida uds</span>
                                        </td>
                                        <td class="text-end fw-bold text-success">
                                            $@prod.TotalVendido.ToString("N0")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    }

    <!-- CONTENIDO: STOCK (2 SUBREPORTES COLAPSABLES) -->
    @if (activeTab == "STOCK" && reporteStock != null)
    {
        <!-- Barra de Herramientas y Exportación -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <div>
                <h5 class="m-0 fw-bold" style="color: var(--text-primary);">Subreportes de Control de Stock</h5>
                <small class="text-secondary">Valuación monetaria, auditoría de existencias y alertas de reposición</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleAllStockSubreportes" style="border-radius: 8px; font-weight: 500;">
                    @(isValuacionStockOpen && isListadoStockOpen ? "Contraer todos" : "Expandir todos")
                </button>
                <button class="btn btn-success btn-sm" @onclick='() => Download("api/v1/Export/productos")' style="border-radius: 8px; font-weight: 600; background-color: var(--accent-primary); border-color: var(--accent-primary); color: white;">
                    Descargar Inventario (CSV)
                </button>
                <button class="btn btn-outline-warning btn-sm" @onclick='() => Download("api/v1/Export/stockBajo")' style="border-radius: 8px; font-weight: 600;">
                    Descargar Faltantes (CSV)
                </button>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SUBREPORTE 1: Valuación de Stock y Control de Existencias       -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <div class="glass-card mb-4" style="background: #ffffff; border: 1px solid var(--border-light); border-radius: var(--radius-md); box-shadow: var(--shadow-card);">
            <!-- Encabezado colapsable -->
            <div class="d-flex justify-content-between align-items-center pb-2 @(isValuacionStockOpen ? "border-bottom mb-3" : "")" style="cursor: pointer;" @onclick="() => isValuacionStockOpen = !isValuacionStockOpen">
                <div>
                    <h5 class="m-0 fw-bold" style="color: var(--text-primary);">Valuación de Stock y Control de Existencias</h5>
                    <small class="text-secondary">Métricas generales de capital y artículos con stock crítico</small>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="d-none d-md-flex align-items-center gap-2">
                        <span class="badge bg-light text-dark border px-2 py-1">Total Arts.: <strong>@reporteStock.ProductosActivos</strong></span>
                        <span class="badge bg-light text-dark border px-2 py-1">Capital: <strong class="text-success">$@reporteStock.ValorTotalStock.ToString("N0")</strong></span>
                        <span class="badge bg-light text-dark border px-2 py-1">Sin Stock: <strong class="text-danger">@reporteStock.ProductosSinStock</strong></span>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" style="border-radius: 6px; padding: 2px 8px;" type="button" aria-label="Toggle Valuacion Stock">
                        @(isValuacionStockOpen ? "▲" : "▼")
                    </button>
                </div>
            </div>

            @if (isValuacionStockOpen)
            {
                <!-- KPIs Destacados -->
                <div class="row text-center mb-4 g-3">
                    <div class="col-md-4">
                        <div class="p-3 rounded border" style="background: #f8faf9;">
                            <small class="text-uppercase text-secondary fw-bold d-block mb-1" style="font-size: 0.75rem;">Total Artículos Activos</small>
                            <h3 class="m-0 fw-bold" style="color: var(--text-primary); font-size: 1.75rem;">@reporteStock.ProductosActivos</h3>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded border" style="background: #f8faf9;">
                            <small class="text-uppercase text-secondary fw-bold d-block mb-1" style="font-size: 0.75rem;">Capital Inmovilizado (Valuación Total)</small>
                            <h3 class="text-success m-0 fw-bold" style="font-size: 1.75rem;">$@reporteStock.ValorTotalStock.ToString("N0")</h3>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded border" style="background: #f8faf9;">
                            <small class="text-uppercase text-danger fw-bold d-block mb-1" style="font-size: 0.75rem;">Sin Stock Absoluto (Faltantes)</small>
                            <h3 class="text-danger m-0 fw-bold" style="font-size: 1.75rem;">@reporteStock.ProductosSinStock</h3>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold m-0" style="color: var(--text-primary);">Artículos con Stock Bajo o Nulo (@reporteStock.ListaStockBajo.Count)</h6>
                    <small class="text-secondary">Productos que alcanzaron o están por debajo del umbral mínimo configurado</small>
                </div>

                <div class="table-responsive border rounded" style="max-height: 280px; overflow-y: auto;">
                    <table class="table table-sm table-hover align-middle mb-0" style="background: transparent;">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Cód / Nombre del Producto</th>
                                <th>Categoría</th>
                                <th class="text-center">Stock Actual / Mínimo</th>
                                <th class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!reporteStock.ListaStockBajo.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-secondary py-3">
                                        No hay artículos con stock bajo en este momento.
                                    </td>
                                </tr>
                            }
                            @foreach (var item in reporteStock.ListaStockBajo)
                            {
                                <tr>
                                    <td class="fw-bold" style="color: var(--text-primary);">@item.Nombre</td>
                                    <td><span class="badge bg-light text-dark border">@item.CategoriaNombre</span></td>
                                    <td class="text-center fw-bold">
                                        <span class="@(item.StockActual == 0 ? "text-danger" : "text-warning")">
                                            @item.StockActual
                                        </span>
                                        <span class="text-secondary fw-normal"> / @item.StockMinimo</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(item.StockActual == 0 ? "bg-danger" : "bg-warning text-dark")">
                                            @(item.StockActual == 0 ? "Sin Stock" : "Stock Bajo")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SUBREPORTE 2: Listado Detallado de Existencias y Valuación      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <div class="glass-card mb-4" style="background: #ffffff; border: 1px solid var(--border-light); border-radius: var(--radius-md); box-shadow: var(--shadow-card);">
            <!-- Encabezado colapsable -->
            <div class="d-flex justify-content-between align-items-center pb-2 @(isListadoStockOpen ? "border-bottom mb-3" : "")" style="cursor: pointer;" @onclick="() => isListadoStockOpen = !isListadoStockOpen">
                <div>
                    <h5 class="m-0 fw-bold" style="color: var(--text-primary);">Listado de Existencias y Valuación por Producto</h5>
                    <small class="text-secondary">Inventario detallado con existencia total, valor unitario y valor total acumulado</small>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-light text-dark border px-2 py-1">@reporteStock.ListaTodosProductos.Count artículos</span>
                    <button class="btn btn-sm btn-outline-secondary" style="border-radius: 6px; padding: 2px 8px;" type="button" aria-label="Toggle Listado Stock">
                        @(isListadoStockOpen ? "▲" : "▼")
                    </button>
                </div>
            </div>

            @if (isListadoStockOpen)
            {
                var listaStockFiltrada = GetListaStockFiltradaYOrdenada();
                int totalUnidadesListadas = listaStockFiltrada.Sum(p => p.StockActual);
                decimal totalValorListado = listaStockFiltrada.Sum(p => p.ValorTotal);

                <!-- Barra de Filtros, Búsqueda y Ordenamiento -->
                <div class="row g-3 align-items-center mb-3">
                    <!-- Buscador por texto -->
                    <div class="col-md-4">
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control" placeholder="Buscar por nombre o categoría..." 
                                   @bind="stockFiltroTexto" @bind:event="oninput" style="border-radius: 6px;" />
                            @if (!string.IsNullOrEmpty(stockFiltroTexto))
                            {
                                <button class="btn btn-outline-secondary" type="button" @onclick="() => stockFiltroTexto = string.Empty">✕</button>
                            }
                        </div>
                    </div>

                    <!-- Filtro por Estado de Semáforo (Bajo / Medio / Óptimo) -->
                    <div class="col-md-4">
                        <div class="btn-group btn-group-sm w-100" role="group" aria-label="Filtro Estado">
                            <button type="button" class="btn @(stockFiltroEstado == "TODOS" ? "btn-dark" : "btn-outline-secondary")" 
                                    @onclick='() => stockFiltroEstado = "TODOS"'>Todos</button>
                            <button type="button" class="btn @(stockFiltroEstado == "BAJO" ? "btn-danger text-white" : "btn-outline-danger")" 
                                    @onclick='() => stockFiltroEstado = "BAJO"'>Bajo</button>
                            <button type="button" class="btn @(stockFiltroEstado == "MEDIO" ? "btn-warning text-dark fw-bold" : "btn-outline-warning")" 
                                    @onclick='() => stockFiltroEstado = "MEDIO"'>Medio</button>
                            <button type="button" class="btn @(stockFiltroEstado == "OPTIMO" ? "btn-success text-white" : "btn-outline-success")" 
                                    @onclick='() => stockFiltroEstado = "OPTIMO"'>Óptimo</button>
                        </div>
                    </div>

                    <!-- Botones de Ordenamiento -->
                    <div class="col-md-4 text-md-end">
                        <div class="d-inline-flex align-items-center gap-1">
                            <span class="small text-secondary fw-bold me-1">Ordenar:</span>
                            <div class="btn-group btn-group-sm" role="group" aria-label="Ordenamiento Stock">
                                <button type="button" class="btn @(stockSortBy == "NOMBRE" ? "btn-primary" : "btn-outline-secondary")" 
                                        @onclick='() => ToggleStockSort("NOMBRE")'>
                                    Nombre @(stockSortBy == "NOMBRE" ? (isStockSortAsc ? "▲" : "▼") : "")
                                </button>
                                <button type="button" class="btn @(stockSortBy == "CANTIDAD" ? "btn-primary" : "btn-outline-secondary")" 
                                        @onclick='() => ToggleStockSort("CANTIDAD")'>
                                    Cantidad @(stockSortBy == "CANTIDAD" ? (isStockSortAsc ? "▲" : "▼") : "")
                                </button>
                                <button type="button" class="btn @(stockSortBy == "VALORTOTAL" ? "btn-primary" : "btn-outline-secondary")" 
                                        @onclick='() => ToggleStockSort("VALORTOTAL")'>
                                    Valor Total @(stockSortBy == "VALORTOTAL" ? (isStockSortAsc ? "▲" : "▼") : "")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabla de Lista Detallada con Colores Semáforo -->
                @if (!listaStockFiltrada.Any())
                {
                    <div class="text-center text-secondary p-4 border rounded" style="background: #fafafa;">
                        No se encontraron productos con los filtros aplicados.
                    </div>
                }
                else
                {
                    <div class="table-responsive border rounded" style="max-height: 480px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle mb-0" style="background: transparent;">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th style="cursor: pointer; width: 35%;" @onclick='() => ToggleStockSort("NOMBRE")'>
                                        Producto / Categoría @(stockSortBy == "NOMBRE" ? (isStockSortAsc ? "▲" : "▼") : "")
                                    </th>
                                    <th class="text-center" style="width: 15%;">Estado de Stock</th>
                                    <th class="text-center" style="cursor: pointer; width: 16%;" @onclick='() => ToggleStockSort("CANTIDAD")'>
                                        Existencia Total @(stockSortBy == "CANTIDAD" ? (isStockSortAsc ? "▲" : "▼") : "")
                                    </th>
                                    <th class="text-end" style="cursor: pointer; width: 16%;" @onclick='() => ToggleStockSort("PRECIOUNITARIO")'>
                                        Valor Unitario @(stockSortBy == "PRECIOUNITARIO" ? (isStockSortAsc ? "▲" : "▼") : "")
                                    </th>
                                    <th class="text-end" style="cursor: pointer; width: 18%;" @onclick='() => ToggleStockSort("VALORTOTAL")'>
                                        Valor Total Acumulado @(stockSortBy == "VALORTOTAL" ? (isStockSortAsc ? "▲" : "▼") : "")
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prod in listaStockFiltrada)
                                {
                                    var status = GetStockStatus(prod.StockActual, prod.StockMinimo);
                                    <tr>
                                        <td>
                                            <div class="fw-bold" style="color: var(--text-primary);">@prod.Nombre</div>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (!string.IsNullOrWhiteSpace(prod.CategoriaNombre))
                                                {
                                                    <small class="text-secondary">@prod.CategoriaNombre</small>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(prod.CodigoBarras))
                                                {
                                                    <small class="text-muted" style="font-family: monospace; font-size: 0.75rem;">(@prod.CodigoBarras)</small>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @status.BadgeClass px-2 py-1" style="font-weight: 600; font-size: 0.75rem;">
                                                @status.Label
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="fw-bold fs-6 @status.TextClass">@prod.StockActual</span>
                                            <span class="text-secondary small d-block" style="font-size: 0.75rem;">Mínimo: @prod.StockMinimo</span>
                                        </td>
                                        <td class="text-end">
                                            <span class="fw-semibold" style="color: var(--text-primary);">$@prod.PrecioUnitario.ToString("N0")</span>
                                            <small class="text-muted d-block" style="font-size: 0.75rem;">(Venta: $@prod.PrecioVenta.ToString("N0"))</small>
                                        </td>
                                        <td class="text-end">
                                            <span class="fw-bold text-success fs-6">$@prod.ValorTotal.ToString("N0")</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-bold sticky-bottom">
                                <tr>
                                    <td>TOTALES (@listaStockFiltrada.Count artículos)</td>
                                    <td></td>
                                    <td class="text-center text-primary fs-6">@totalUnidadesListadas uds</td>
                                    <td></td>
                                    <td class="text-end text-success fs-6">$@totalValorListado.ToString("N0")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            }
        </div>
    }

    <!-- CONTENIDO: TURNOS (3 SUBREPORTES COLAPSABLES) -->
    @if (activeTab == "TURNOS" && reporteTurnos != null)
    {
        <!-- Barra de Herramientas y Exportación -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <div>
                <h5 class="m-0 fw-bold" style="color: var(--text-primary);">Subreportes de Rendimiento de Turnos</h5>
                <small class="text-secondary">Gestión operativa, atención profesional y demanda por servicios</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleAllTurnosSubreportes" style="border-radius: 8px; font-weight: 500;">
                    @(isGestionTurnosOpen && isVetTurnosOpen && isServiciosTurnosOpen ? "Contraer todos" : "Expandir todos")
                </button>
                <button class="btn btn-primary btn-sm" @onclick='() => Download("api/v1/Export/turnos")' style="border-radius: 8px; font-weight: 600; background-color: var(--accent-primary); border-color: var(--accent-primary); color: white;">
                    Descargar Agenda (CSV)
                </button>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SUBREPORTE 1: Informe de Gestión y Atención de Turnos           -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <div class="glass-card mb-4" style="background: #ffffff; border: 1px solid var(--border-light); border-radius: var(--radius-md); box-shadow: var(--shadow-card);">
            <!-- Encabezado colapsable -->
            <div class="d-flex justify-content-between align-items-center pb-2 @(isGestionTurnosOpen ? "border-bottom mb-3" : "")" style="cursor: pointer;" @onclick="() => isGestionTurnosOpen = !isGestionTurnosOpen">
                <div>
                    <h5 class="m-0 fw-bold" style="color: var(--text-primary);">Informe de Gestión y Atención de Turnos</h5>
                    <small class="text-secondary">Evolución diaria de turnos programados, completados, ausencias y cancelaciones (Últimos 30 días)</small>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="d-none d-md-flex align-items-center gap-2">
                        <span class="badge bg-light text-dark border px-2 py-1">Total: <strong>@reporteTurnos.TotalTurnos</strong></span>
                        <span class="badge bg-light text-dark border px-2 py-1">Completados: <strong class="text-success">@reporteTurnos.Completados</strong></span>
                        <span class="badge bg-light text-dark border px-2 py-1">Cumplimiento: <strong class="text-info">@reporteTurnos.TasaCumplimiento.ToString("0.0")%</strong></span>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" style="border-radius: 6px; padding: 2px 8px;" type="button" aria-label="Toggle Gestion Turnos">
                        @(isGestionTurnosOpen ? "▲" : "▼")
                    </button>
                </div>
            </div>

            @if (isGestionTurnosOpen)
            {
                var diasTurnosVisualizados = ObtenerDiasTurnosFiltrados();
                double scaleMax = GetEffectiveScaleMax(diasTurnosVisualizados);
                var (stepMajor, stepMinor) = GetScaleSteps(scaleMax);

                string linePathTotal = GetTurnosSvgPath(diasTurnosVisualizados, d => d.Total, scaleMax);
                string linePathComp = GetTurnosSvgPath(diasTurnosVisualizados, d => d.Completados, scaleMax);
                string linePathAus = GetTurnosSvgPath(diasTurnosVisualizados, d => d.Ausentes, scaleMax);
                string linePathCanc = GetTurnosSvgPath(diasTurnosVisualizados, d => d.Cancelados, scaleMax);

                <!-- KPIs Destacados -->
                <div class="row text-center mb-4 g-3">
                    <div class="col-md-3 col-6">
                        <div class="p-3 rounded border" style="background: #f8faf9;">
                            <small class="text-uppercase text-secondary fw-bold d-block mb-1" style="font-size: 0.75rem;">Programados / Totales</small>
                            <h3 class="m-0 fw-bold" style="color: #111827; font-size: 1.65rem;">@reporteTurnos.TotalTurnos</h3>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="p-3 rounded border" style="background: #f8faf9;">
                            <small class="text-uppercase text-success fw-bold d-block mb-1" style="font-size: 0.75rem;">Completados / Atendidos</small>
                            <h3 class="text-success m-0 fw-bold" style="font-size: 1.65rem;">@reporteTurnos.Completados</h3>
                        </div>
                    </div>
                    <div class="col-md-2 col-4">
                        <div class="p-3 rounded border" style="background: #f8faf9;">
                            <small class="text-uppercase text-warning fw-bold d-block mb-1" style="font-size: 0.75rem;">Ausentes</small>
                            <h3 class="text-warning m-0 fw-bold" style="font-size: 1.65rem;">@reporteTurnos.Ausentes</h3>
                        </div>
                    </div>
                    <div class="col-md-2 col-4">
                        <div class="p-3 rounded border" style="background: #f8faf9;">
                            <small class="text-uppercase text-danger fw-bold d-block mb-1" style="font-size: 0.75rem;">Cancelados</small>
                            <h3 class="text-danger m-0 fw-bold" style="font-size: 1.65rem;">@reporteTurnos.Cancelados</h3>
                        </div>
                    </div>
                    <div class="col-md-2 col-4">
                        <div class="p-3 rounded border" style="background: #f8faf9;">
                            <small class="text-uppercase text-info fw-bold d-block mb-1" style="font-size: 0.75rem;">% Cumplimiento</small>
                            <h3 class="text-info m-0 fw-bold" style="font-size: 1.65rem;">@reporteTurnos.TasaCumplimiento.ToString("0.0")%</h3>
                        </div>
                    </div>
                </div>

                <!-- Barra de Configuración y Escala Interactiva Moderna (Sin Emojis) -->
                <div class="p-3 mb-4 rounded-3 border" style="background: #fcfcfc;">
                    <div class="row g-3 align-items-center">
                        <!-- Escala Horizontal (Rango de días) -->
                        <div class="col-lg-4 col-md-6">
                            <div class="d-flex flex-column gap-1">
                                <span class="text-uppercase text-secondary fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Rango Temporal (Eje X)</span>
                                <div class="btn-group p-1 rounded-2" style="background: #f1f3f5;" role="group">
                                    <button type="button" class="btn btn-sm @(turnosDiasRango == 30 ? "bg-white text-dark shadow-sm fw-bold" : "text-secondary border-0")" 
                                            style="border-radius: 6px; font-size: 0.75rem; padding: 4px 10px; transition: all 0.2s;"
                                            @onclick="() => { turnosDiasRango = 30; diaTurnoSeleccionado = null; }">30 días</button>
                                    <button type="button" class="btn btn-sm @(turnosDiasRango == 15 ? "bg-white text-dark shadow-sm fw-bold" : "text-secondary border-0")" 
                                            style="border-radius: 6px; font-size: 0.75rem; padding: 4px 10px; transition: all 0.2s;"
                                            @onclick="() => { turnosDiasRango = 15; diaTurnoSeleccionado = null; }">15 días</button>
                                    <button type="button" class="btn btn-sm @(turnosDiasRango == 7 ? "bg-white text-dark shadow-sm fw-bold" : "text-secondary border-0")" 
                                            style="border-radius: 6px; font-size: 0.75rem; padding: 4px 10px; transition: all 0.2s;"
                                            @onclick="() => { turnosDiasRango = 7; diaTurnoSeleccionado = null; }">7 días</button>
                                </div>
                            </div>
                        </div>

                        <!-- Escala Vertical (Eje Y) -->
                        <div class="col-lg-8 col-md-6">
                            <div class="d-flex flex-column gap-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-uppercase text-secondary fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Tope Vertical (Eje Y)</span>
                                    <span class="text-muted small" style="font-size: 0.7rem;">Escala activa: <strong>0 a @scaleMax.ToString("0")</strong></span>
                                </div>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <div class="btn-group p-1 rounded-2" style="background: #f1f3f5;" role="group">
                                        <button type="button" class="btn btn-sm @(isAutoVerticalScale ? "bg-white text-primary shadow-sm fw-bold" : "text-secondary border-0")" 
                                                style="border-radius: 6px; font-size: 0.75rem; padding: 4px 12px; transition: all 0.2s;"
                                                @onclick="() => isAutoVerticalScale = true">
                                            Automático
                                        </button>
                                        <button type="button" class="btn btn-sm @(!isAutoVerticalScale && scaleMaxTurnos == 10 ? "bg-white text-dark shadow-sm fw-bold" : "text-secondary border-0")" 
                                                style="border-radius: 6px; font-size: 0.75rem; padding: 4px 10px; transition: all 0.2s;"
                                                @onclick="() => { isAutoVerticalScale = false; scaleMaxTurnos = 10; }">10</button>
                                        <button type="button" class="btn btn-sm @(!isAutoVerticalScale && scaleMaxTurnos == 20 ? "bg-white text-dark shadow-sm fw-bold" : "text-secondary border-0")" 
                                                style="border-radius: 6px; font-size: 0.75rem; padding: 4px 10px; transition: all 0.2s;"
                                                @onclick="() => { isAutoVerticalScale = false; scaleMaxTurnos = 20; }">20</button>
                                        <button type="button" class="btn btn-sm @(!isAutoVerticalScale && scaleMaxTurnos == 30 ? "bg-white text-dark shadow-sm fw-bold" : "text-secondary border-0")" 
                                                style="border-radius: 6px; font-size: 0.75rem; padding: 4px 10px; transition: all 0.2s;"
                                                @onclick="() => { isAutoVerticalScale = false; scaleMaxTurnos = 30; }">30</button>
                                        <button type="button" class="btn btn-sm @(!isAutoVerticalScale && scaleMaxTurnos == 60 ? "bg-white text-dark shadow-sm fw-bold" : "text-secondary border-0")" 
                                                style="border-radius: 6px; font-size: 0.75rem; padding: 4px 10px; transition: all 0.2s;"
                                                @onclick="() => { isAutoVerticalScale = false; scaleMaxTurnos = 60; }">60</button>
                                    </div>

                                    <!-- Stepper sutil de Zoom -->
                                    <div class="d-inline-flex align-items-center border rounded-2 p-1 bg-white" style="height: 31px;">
                                        <button class="btn btn-sm btn-light border-0 px-2 py-0" type="button" title="Reducir escala" 
                                                @onclick="() => { isAutoVerticalScale = false; scaleMaxTurnos = Math.Max(4, scaleMaxTurnos - 2); }">
                                            −
                                        </button>
                                        <span class="px-2 small fw-bold text-secondary" style="font-size: 0.75rem; min-width: 48px; text-align: center;">
                                            Max @scaleMax.ToString("0")
                                        </span>
                                        <button class="btn btn-sm btn-light border-0 px-2 py-0" type="button" title="Aumentar escala" 
                                                @onclick="() => { isAutoVerticalScale = false; scaleMaxTurnos = Math.Min(120, scaleMaxTurnos + 2); }">
                                            +
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Filtros de Líneas (Curvas) Estilo Pill Moderno -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between pt-3 mt-3 border-top gap-2">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="text-uppercase text-secondary fw-bold me-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Curvas visibles:</span>
                            
                            <button type="button" class="btn btn-sm @(showLineTotal ? "btn-dark" : "btn-light text-muted") d-inline-flex align-items-center gap-1" 
                                    style="border-radius: 20px; font-size: 0.75rem; padding: 3px 12px; font-weight: 500; transition: all 0.2s;"
                                    @onclick="() => showLineTotal = !showLineTotal">
                                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: @(showLineTotal ? "#ffffff" : "#9ca3af");"></span>
                                Programados
                            </button>

                            <button type="button" class="btn btn-sm @(showLineComp ? "btn-success" : "btn-light text-muted") d-inline-flex align-items-center gap-1" 
                                    style="border-radius: 20px; font-size: 0.75rem; padding: 3px 12px; font-weight: 500; transition: all 0.2s;"
                                    @onclick="() => showLineComp = !showLineComp">
                                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: @(showLineComp ? "#ffffff" : "#10b981");"></span>
                                Completados
                            </button>

                            <button type="button" class="btn btn-sm @(showLineAus ? "btn-warning text-dark" : "btn-light text-muted") d-inline-flex align-items-center gap-1" 
                                    style="border-radius: 20px; font-size: 0.75rem; padding: 3px 12px; font-weight: 600; transition: all 0.2s;"
                                    @onclick="() => showLineAus = !showLineAus">
                                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: @(showLineAus ? "#78350f" : "#f59e0b");"></span>
                                Ausentes
                            </button>

                            <button type="button" class="btn btn-sm @(showLineCanc ? "btn-danger" : "btn-light text-muted") d-inline-flex align-items-center gap-1" 
                                    style="border-radius: 20px; font-size: 0.75rem; padding: 3px 12px; font-weight: 500; transition: all 0.2s;"
                                    @onclick="() => showLineCanc = !showLineCanc">
                                <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: @(showLineCanc ? "#ffffff" : "#ef4444");"></span>
                                Cancelados
                            </button>
                        </div>
                        <small class="text-secondary" style="font-size: 0.75rem;">
                            Total días en gráfica: <strong>@diasTurnosVisualizados.Count</strong>
                        </small>
                    </div>
                </div>

                <!-- Gráfico de Líneas Vectorial SVG Interactivo -->
                <div class="p-3 border rounded" style="background: #ffffff;">
                    <div style="width: 100%; overflow-x: auto;">
                        <svg viewBox="0 0 1000 370" style="width: 100%; min-width: 720px; height: auto; display: block;" font-family="Segoe UI, sans-serif">
                            <!-- Líneas de Grilla Horizontal -->
                            @for (int s = 0; s <= (int)scaleMax; s += stepMinor)
                            {
                                double yPos = 320.0 - (s / scaleMax) * 280.0;
                                bool isMajor = (s % stepMajor == 0);
                                if (isMajor)
                                {
                                    <line x1="75" y1="@yPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                          x2="970" y2="@yPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                          stroke="#e5e7eb" stroke-width="1" stroke-dasharray="@(s == 0 ? "none" : "3,3")" />
                                    @RenderSvgText(65, yPos + 4, $"{s}", "end", 11, "#6b7280", "600")
                                }
                                else
                                {
                                    <!-- Marca corta (tick mark) en el eje Y -->
                                    <line x1="70" y1="@yPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                          x2="75" y2="@yPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                          stroke="#9ca3af" stroke-width="1" />
                                }
                            }

                            <!-- Eje X (Línea base) y Eje Y -->
                            <line x1="75" y1="320" x2="970" y2="320" stroke="#9ca3af" stroke-width="1.5" />
                            <line x1="75" y1="40" x2="75" y2="320" stroke="#9ca3af" stroke-width="1.5" />

                            <!-- Línea 1: Programados / Totales (Negra / Gris Oscuro) -->
                            @if (showLineTotal && !string.IsNullOrEmpty(linePathTotal))
                            {
                                <path d="@linePathTotal" fill="none" stroke="#111827" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                            }

                            <!-- Línea 2: Completados (Verde) -->
                            @if (showLineComp && !string.IsNullOrEmpty(linePathComp))
                            {
                                <path d="@linePathComp" fill="none" stroke="#10b981" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                            }

                            <!-- Línea 3: Ausentes (Amarillo) -->
                            @if (showLineAus && !string.IsNullOrEmpty(linePathAus))
                            {
                                <path d="@linePathAus" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                            }

                            <!-- Línea 4: Cancelados (Rojo) -->
                            @if (showLineCanc && !string.IsNullOrEmpty(linePathCanc))
                            {
                                <path d="@linePathCanc" fill="none" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                            }

                            <!-- Puntos y Etiquetas Eje X -->
                            @for (int i = 0; i < diasTurnosVisualizados.Count; i++)
                            {
                                var day = diasTurnosVisualizados[i];
                                double xPos = (diasTurnosVisualizados.Count == 1) ? 522.0 : 75.0 + i * (895.0 / (diasTurnosVisualizados.Count - 1.0));
                                double yPosTotal = 320.0 - (day.Total / scaleMax) * 280.0;
                                double yPosComp = 320.0 - (day.Completados / scaleMax) * 280.0;
                                double yPosAus = 320.0 - (day.Ausentes / scaleMax) * 280.0;
                                double yPosCanc = 320.0 - (day.Cancelados / scaleMax) * 280.0;

                                bool isSelected = diaTurnoSeleccionado?.DiaNumero == day.DiaNumero;

                                <!-- Marca vertical sutil en el eje X -->
                                <line x1="@xPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" y1="320" 
                                      x2="@xPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" y2="325" 
                                      stroke="#9ca3af" stroke-width="1" />

                                <!-- Etiqueta del Día -->
                                string labelX = (turnosDiasRango <= 15) ? $"{day.Fecha.ToString("dd/MM")}" : day.DiaNumero.ToString();
                                @RenderSvgText(xPos, 340, labelX, "middle", (turnosDiasRango <= 15 ? 10 : 9), isSelected ? "#10b981" : "#4b5563", isSelected ? "700" : "500")

                                <!-- Punto interactivo sobre Total -->
                                @if (showLineTotal)
                                {
                                    <circle cx="@xPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                            cy="@yPosTotal.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                            r="@(isSelected ? "7" : (day.Total > 0 ? "4.5" : "3"))" 
                                            fill="@(isSelected ? "#ffffff" : "#111827")" 
                                            stroke="@(isSelected ? "#111827" : "#ffffff")" 
                                            stroke-width="@(isSelected ? "3.5" : "1.5")" 
                                            style="cursor: pointer; transition: r 0.2s, stroke-width 0.2s;"
                                            @onclick="() => diaTurnoSeleccionado = (diaTurnoSeleccionado?.DiaNumero == day.DiaNumero ? null : day)" />
                                }

                                @if (showLineComp && day.Completados > 0 && (!showLineTotal || day.Completados != day.Total))
                                {
                                    <circle cx="@xPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                            cy="@yPosComp.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                            r="3.5" fill="#10b981" stroke="#ffffff" stroke-width="1" 
                                            style="cursor: pointer;"
                                            @onclick="() => diaTurnoSeleccionado = (diaTurnoSeleccionado?.DiaNumero == day.DiaNumero ? null : day)" />
                                }

                                @if (showLineAus && day.Ausentes > 0)
                                {
                                    <circle cx="@xPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                            cy="@yPosAus.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                            r="3" fill="#f59e0b" stroke="#ffffff" stroke-width="1" 
                                            style="cursor: pointer;"
                                            @onclick="() => diaTurnoSeleccionado = (diaTurnoSeleccionado?.DiaNumero == day.DiaNumero ? null : day)" />
                                }

                                @if (showLineCanc && day.Cancelados > 0)
                                {
                                    <circle cx="@xPos.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                            cy="@yPosCanc.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                            r="3" fill="#ef4444" stroke="#ffffff" stroke-width="1" 
                                            style="cursor: pointer;"
                                            @onclick="() => diaTurnoSeleccionado = (diaTurnoSeleccionado?.DiaNumero == day.DiaNumero ? null : day)" />
                                }
                            }

                            <!-- Título del Eje X -->
                            @RenderSvgText(522, 360, (turnosDiasRango <= 15 ? "Días seleccionados (Fecha)" : "Días del período (1 al 30)"), "middle", 11, "#6b7280", "600")
                        </svg>
                    </div>

                    <!-- Panel de Detalle del Día Seleccionado -->
                    @if (diaTurnoSeleccionado != null)
                    {
                        decimal tasaDia = diaTurnoSeleccionado.Total > 0 ? (decimal)diaTurnoSeleccionado.Completados / diaTurnoSeleccionado.Total * 100m : 0;
                        <div class="d-flex flex-wrap align-items-center justify-content-between p-2 px-3 mt-3 rounded border" 
                             style="background: rgba(16, 185, 129, 0.08); border-color: #10b981 !important;">
                            <div>
                                <strong style="color: var(--text-primary);">Día @diaTurnoSeleccionado.DiaNumero — @diaTurnoSeleccionado.Fecha.ToString("dd/MM/yyyy") (@diaTurnoSeleccionado.Fecha.ToString("dddd", new System.Globalization.CultureInfo("es-ES")))</strong>
                            </div>
                            <div class="d-flex flex-wrap gap-3 my-1">
                                <span>Totales: <strong style="color: #111827;">@diaTurnoSeleccionado.Total turnos</strong></span>
                                <span>Completados: <strong class="text-success">@diaTurnoSeleccionado.Completados</strong></span>
                                <span>Ausentes: <strong class="text-warning">@diaTurnoSeleccionado.Ausentes</strong></span>
                                <span>Cancelados: <strong class="text-danger">@diaTurnoSeleccionado.Cancelados</strong></span>
                                <span>Efectividad: <strong class="text-info">@tasaDia.ToString("0.0")%</strong></span>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => diaTurnoSeleccionado = null" style="border-radius: 6px; padding: 2px 8px;">✕ Cerrar</button>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SUBREPORTE 2: Atención de Turnos por Profesional                -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <div class="glass-card mb-4" style="background: #ffffff; border: 1px solid var(--border-light); border-radius: var(--radius-md); box-shadow: var(--shadow-card);">
            <!-- Encabezado colapsable -->
            <div class="d-flex justify-content-between align-items-center pb-2 @(isVetTurnosOpen ? "border-bottom mb-3" : "")" style="cursor: pointer;" @onclick="() => isVetTurnosOpen = !isVetTurnosOpen">
                <div>
                    <h5 class="m-0 fw-bold" style="color: var(--text-primary);">Atención de Turnos por Profesional</h5>
                    <small class="text-secondary">Comparativa de turnos programados (amarillo) vs. completados (verde) por cada veterinario</small>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-light text-dark border px-2 py-1">@reporteTurnos.TurnosPorVeterinario.Count profesionales</span>
                    <button class="btn btn-sm btn-outline-secondary" style="border-radius: 6px; padding: 2px 8px;" type="button" aria-label="Toggle Vet Turnos">
                        @(isVetTurnosOpen ? "▲" : "▼")
                    </button>
                </div>
            </div>

            @if (isVetTurnosOpen)
            {
                var listaVets = reporteTurnos.TurnosPorVeterinario;
                int maxTurnosVet = listaVets.Any() ? listaVets.Max(v => v.TotalTurnos) : 1;
                if (maxTurnosVet <= 0) maxTurnosVet = 1;

                <!-- Leyenda de barras -->
                <div class="d-flex flex-wrap align-items-center gap-3 mb-3 p-2 px-3 border rounded" style="background: #fafafa;">
                    <span class="small fw-bold" style="color: var(--text-primary);">Código de Barras Superpuestas:</span>
                    <span class="badge bg-warning text-dark px-2 py-1"><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#b45309;margin-right:4px;"></span> Turnos Programados / Totales (Fondo)</span>
                    <span class="badge bg-success text-white px-2 py-1"><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:#ffffff;margin-right:4px;"></span> Turnos Completados (Frente)</span>
                </div>

                @if (!listaVets.Any())
                {
                    <div class="text-center text-secondary p-4 border rounded" style="background: #fafafa;">
                        No se registraron turnos asignados a profesionales en el período.
                    </div>
                }
                else
                {
                    <!-- Gráfico de Barras Superpuestas -->
                    <div class="p-3 border rounded mb-4" style="background: #ffffff;">
                        <div class="d-flex flex-column gap-3">
                            @foreach (var vet in listaVets)
                            {
                                double barTotalPercent = (double)vet.TotalTurnos / maxTurnosVet * 100.0;
                                if (barTotalPercent < 4 && vet.TotalTurnos > 0) barTotalPercent = 4;
                                double barCompPercent = (double)vet.Completados / maxTurnosVet * 100.0;
                                if (barCompPercent < 2 && vet.Completados > 0) barCompPercent = 2;

                                decimal pctCumplimiento = vet.TotalTurnos > 0 ? (decimal)vet.Completados / vet.TotalTurnos * 100m : 0;

                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold" style="color: var(--text-primary);">Dr. @vet.VeterinarioNombre</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-success text-white">@vet.Completados completados</span>
                                            <span class="badge bg-warning text-dark">@vet.TotalTurnos programados</span>
                                            <span class="badge bg-light text-dark border">@pctCumplimiento.ToString("0.0")% éxito</span>
                                        </div>
                                    </div>
                                    <div style="position: relative; height: 26px; background: #e5e7eb; border-radius: 6px; overflow: hidden;">
                                        <!-- Barra Amarilla (Programados / Totales) -->
                                        <div style="position: absolute; left: 0; top: 0; bottom: 0; width: @(barTotalPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%; background: #f59e0b; border-radius: 6px; transition: width 0.5s ease; opacity: 0.9;">
                                            <span style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); font-size: 0.75rem; font-weight: 700; color: #78350f;">
                                                @(vet.TotalTurnos > 0 ? $"{vet.TotalTurnos} tot" : "")
                                            </span>
                                        </div>
                                        <!-- Barra Verde (Completados Superpuesta) -->
                                        <div style="position: absolute; left: 0; top: 0; bottom: 0; width: @(barCompPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%; background: #10b981; border-radius: 6px; transition: width 0.5s ease; z-index: 2;">
                                            <span style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); font-size: 0.75rem; font-weight: 700; color: white;">
                                                @(vet.Completados > 0 ? $"{vet.Completados}" : "")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Tabla de Detalle por Profesional -->
                    <div class="table-responsive border rounded">
                        <table class="table table-sm table-hover align-middle mb-0" style="background: transparent;">
                            <thead class="table-light">
                                <tr>
                                    <th>Profesional Veterinario</th>
                                    <th class="text-center">Programados (Totales)</th>
                                    <th class="text-center">Completados</th>
                                    <th class="text-center">Ausentes</th>
                                    <th class="text-center">Cancelados</th>
                                    <th class="text-end">Tasa de Cumplimiento</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var vet in listaVets)
                                {
                                    decimal pct = vet.TotalTurnos > 0 ? (decimal)vet.Completados / vet.TotalTurnos * 100m : 0;
                                    <tr>
                                        <td class="fw-bold" style="color: var(--text-primary);">Dr. @vet.VeterinarioNombre</td>
                                        <td class="text-center"><span class="badge bg-warning text-dark">@vet.TotalTurnos</span></td>
                                        <td class="text-center"><span class="badge bg-success text-white">@vet.Completados</span></td>
                                        <td class="text-center"><span class="badge bg-light text-dark border">@vet.Ausentes</span></td>
                                        <td class="text-center"><span class="badge bg-light text-dark border">@vet.Cancelados</span></td>
                                        <td class="text-end fw-bold text-success">@pct.ToString("0.0")%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SUBREPORTE 3: Demanda y Top de Servicios Vendidos en Comercio    -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <div class="glass-card mb-4" style="background: #ffffff; border: 1px solid var(--border-light); border-radius: var(--radius-md); box-shadow: var(--shadow-card);">
            <!-- Encabezado colapsable -->
            <div class="d-flex justify-content-between align-items-center pb-2 @(isServiciosTurnosOpen ? "border-bottom mb-3" : "")" style="cursor: pointer;" @onclick="() => isServiciosTurnosOpen = !isServiciosTurnosOpen">
                <div>
                    <h5 class="m-0 fw-bold" style="color: var(--text-primary);">Demanda y Top de Servicios Vendidos en Comercio</h5>
                    <small class="text-secondary">Ranking y distribución de servicios cobrados y registrados en caja durante el período seleccionado</small>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-light text-dark border px-2 py-1">@reporteTurnos.TurnosPorServicio.Count servicios registrados</span>
                    <button class="btn btn-sm btn-outline-secondary" style="border-radius: 6px; padding: 2px 8px;" type="button" aria-label="Toggle Servicios Turnos">
                        @(isServiciosTurnosOpen ? "▲" : "▼")
                    </button>
                </div>
            </div>

            @if (isServiciosTurnosOpen)
            {
                var listaServicios = reporteTurnos.TurnosPorServicio.OrderByDescending(s => s.CantidadTurnos).ThenByDescending(s => s.TotalVendido).ToList();
                int maxServ = listaServicios.Any() ? listaServicios.Max(s => s.CantidadTurnos) : 1;
                if (maxServ <= 0) maxServ = 1;
                int granTotalServ = listaServicios.Sum(s => s.CantidadTurnos);
                if (granTotalServ <= 0) granTotalServ = 1;
                decimal granTotalMonto = listaServicios.Sum(s => s.TotalVendido);

                @if (!listaServicios.Any())
                {
                    <div class="text-center text-secondary p-4 border rounded" style="background: #fafafa;">
                        No se registraron servicios vendidos en el período.
                    </div>
                }
                else
                {
                    <!-- Gráfico de Barras Normal por Servicio -->
                    <div class="p-3 border rounded mb-4" style="background: #ffffff;">
                        <div class="d-flex flex-column gap-3">
                            @for (int i = 0; i < listaServicios.Count; i++)
                            {
                                var serv = listaServicios[i];
                                double barPercent = (double)serv.CantidadTurnos / maxServ * 100.0;
                                if (barPercent < 3 && serv.CantidadTurnos > 0) barPercent = 3;
                                decimal sharePercent = ((decimal)serv.CantidadTurnos / granTotalServ) * 100m;

                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge @(i == 0 ? "bg-primary" : "bg-secondary") text-white" style="font-size: 0.75rem;">
                                                #@(i + 1)
                                            </span>
                                            <span class="fw-bold" style="color: var(--text-primary);">@serv.ServicioNombre</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-light text-dark border">@sharePercent.ToString("0.0")%</span>
                                            <span class="fw-bold text-success">@serv.CantidadTurnos vendidos</span>
                                            @if (serv.TotalVendido > 0)
                                            {
                                                <span class="badge bg-light text-success border">($@serv.TotalVendido.ToString("N0"))</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="progress" style="height: 22px; background: #e5e7eb; border-radius: 6px; overflow: hidden;">
                                        <div class="progress-bar" role="progressbar" 
                                             style="width: @barPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; background: linear-gradient(90deg, #0284c7 0%, #38bdf8 100%); transition: width 0.5s ease; font-weight: 600; font-size: 0.75rem; text-align: right; padding-right: 8px;">
                                            @serv.CantidadTurnos
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Tabla de Detalle -->
                    <div class="table-responsive border rounded">
                        <table class="table table-sm table-hover align-middle mb-0" style="background: transparent;">
                            <thead class="table-light">
                                <tr>
                                    <th>Servicio</th>
                                    <th class="text-center">Cantidad Vendida</th>
                                    <th class="text-end">Total Facturado</th>
                                    <th class="text-end">% Participación</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var serv in listaServicios)
                                {
                                    decimal share = ((decimal)serv.CantidadTurnos / granTotalServ) * 100m;
                                    <tr>
                                        <td class="fw-bold" style="color: var(--text-primary);">@serv.ServicioNombre</td>
                                        <td class="text-center">
                                            <span class="badge bg-success text-white">@serv.CantidadTurnos vendidos</span>
                                        </td>
                                        <td class="text-end fw-bold text-success">
                                            $@serv.TotalVendido.ToString("N0")
                                        </td>
                                        <td class="text-end fw-bold text-info">@share.ToString("0.0")%</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td>TOTAL SERVICIOS VENDIDOS</td>
                                    <td class="text-center text-primary">@granTotalServ servicios</td>
                                    <td class="text-end text-success fs-6">$@granTotalMonto.ToString("N0")</td>
                                    <td class="text-end text-info">100%</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            }
        </div>
    }

    <!-- CONTENIDO: CLINICA (3 SUBREPORTES COLAPSABLES) -->
    @if (activeTab == "CLINICA" && reporteClinico != null)
    {
        <!-- Barra de Herramientas y Exportación -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <div>
                <h5 class="m-0 fw-bold" style="color: var(--text-primary);">Subreportes de Atención Clínica y Pacientes</h5>
                <small class="text-secondary">Padrón médico, distribución por especie e historial clínico</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleAllClinicaSubreportes" style="border-radius: 8px; font-weight: 500;">
                    @(isPanelClinicoOpen && isEspeciesOpen && isHistoricoTratamientosOpen ? "Contraer todos" : "Expandir todos")
                </button>
                <button class="btn btn-primary btn-sm" @onclick='() => Download("api/v1/Export/pacientes")' style="border-radius: 8px; font-weight: 600; background-color: var(--accent-primary); border-color: var(--accent-primary); color: white;">
                    Padrón Mascotas (CSV)
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick='() => Download("api/v1/Export/propietarios")' style="border-radius: 8px; font-weight: 600;">
                    Padrón Dueños (CSV)
                </button>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SUBREPORTE 1: Panel Clínico y Registro de Pacientes             -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <div class="glass-card mb-4" style="background: #ffffff; border: 1px solid var(--border-light); border-radius: var(--radius-md); box-shadow: var(--shadow-card);">
            <!-- Encabezado colapsable -->
            <div class="d-flex justify-content-between align-items-center pb-2 @(isPanelClinicoOpen ? "border-bottom mb-3" : "")" style="cursor: pointer;" @onclick="() => isPanelClinicoOpen = !isPanelClinicoOpen">
                <div>
                    <h5 class="m-0 fw-bold" style="color: var(--text-primary);">Panel Clínico y Registro de Pacientes</h5>
                    <small class="text-secondary">Indicadores clave de población atendida, vacunación activa y tratamientos médicos</small>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="d-none d-md-flex align-items-center gap-2">
                        <span class="badge bg-light text-dark border px-2 py-1">Pacientes: <strong>@reporteClinico.TotalPacientes</strong></span>
                        <span class="badge bg-light text-dark border px-2 py-1">Vacunas Mes: <strong class="text-info">@reporteClinico.VacunasAplicadasMes</strong></span>
                        <span class="badge bg-light text-dark border px-2 py-1">Tratamientos: <strong class="text-warning">@reporteClinico.TratamientosActivosCount</strong></span>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" style="border-radius: 6px; padding: 2px 8px;" type="button" aria-label="Toggle Panel Clinico">
                        @(isPanelClinicoOpen ? "▲" : "▼")
                    </button>
                </div>
            </div>

            @if (isPanelClinicoOpen)
            {
                <div class="row text-center mb-3 g-3">
                    <div class="col-md-4">
                        <div class="p-3 rounded border" style="background: #f8faf9;">
                            <small class="text-uppercase text-secondary fw-bold d-block mb-1" style="font-size: 0.75rem;">Pacientes Activos</small>
                            <h3 class="m-0 fw-bold" style="color: var(--text-primary); font-size: 1.75rem;">@reporteClinico.TotalPacientes</h3>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded border" style="background: #f8faf9;">
                            <small class="text-uppercase text-info fw-bold d-block mb-1" style="font-size: 0.75rem;">Vacunaciones del Mes</small>
                            <h3 class="text-info m-0 fw-bold" style="font-size: 1.75rem;">@reporteClinico.VacunasAplicadasMes</h3>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded border" style="background: #f8faf9;">
                            <small class="text-uppercase text-warning fw-bold d-block mb-1" style="font-size: 0.75rem;">Tratamientos en Curso</small>
                            <h3 class="text-warning m-0 fw-bold" style="font-size: 1.75rem;">@reporteClinico.TratamientosActivosCount</h3>
                        </div>
                    </div>
                </div>

                <!-- Exportación Individual de Historia Clínica -->
                <div class="p-3 rounded border mt-3" style="background: #fcfcfc;">
                    <div class="row align-items-center g-2">
                        <div class="col-md-7">
                            <h6 class="m-0 fw-bold" style="color: var(--text-primary); font-size: 0.9rem;">Exportar Historia Clínica Individual</h6>
                            <small class="text-secondary">Descargue la ficha médica completa de un paciente en formato CSV</small>
                        </div>
                        <div class="col-md-5">
                            <div class="input-group input-group-sm">
                                <input type="text" @bind="pacienteIdParaExportar" class="form-control" placeholder="ID o Código del Paciente..." />
                                <button class="btn btn-secondary" disabled="@string.IsNullOrWhiteSpace(pacienteIdParaExportar)" @onclick="ExportarIndividual">
                                    Descargar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SUBREPORTE 2: Distribución de Pacientes por Especie (Torta)      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <div class="glass-card mb-4" style="background: #ffffff; border: 1px solid var(--border-light); border-radius: var(--radius-md); box-shadow: var(--shadow-card);">
            <!-- Encabezado colapsable -->
            <div class="d-flex justify-content-between align-items-center pb-2 @(isEspeciesOpen ? "border-bottom mb-3" : "")" style="cursor: pointer;" @onclick="() => isEspeciesOpen = !isEspeciesOpen">
                <div>
                    <h5 class="m-0 fw-bold" style="color: var(--text-primary);">Distribución de Pacientes por Especie</h5>
                    <small class="text-secondary">Composición demográfica y proporción de mascotas censadas</small>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-light text-dark border px-2 py-1">@reporteClinico.PacientesPorEspecie.Count especies</span>
                    <button class="btn btn-sm btn-outline-secondary" style="border-radius: 6px; padding: 2px 8px;" type="button" aria-label="Toggle Especies">
                        @(isEspeciesOpen ? "▲" : "▼")
                    </button>
                </div>
            </div>

            @if (isEspeciesOpen)
            {
                var pieSlices = GetEspeciesPieSlices();

                @if (!pieSlices.Any())
                {
                    <div class="text-center text-secondary p-4 border rounded" style="background: #fafafa;">
                        No hay pacientes registrados para calcular la distribución demográfica.
                    </div>
                }
                else
                {
                    <div class="row align-items-center g-4">
                        <!-- Columna Izquierda: Gráfico de Tortas Vectorial SVG (con Emojis de Especies) -->
                        <div class="col-lg-5 col-md-6 text-center">
                            <div style="position: relative; width: 100%; max-width: 320px; margin: 0 auto;">
                                <svg viewBox="0 0 350 350" style="width: 100%; height: auto; display: block;" font-family="Segoe UI, sans-serif">
                                    <!-- Porciones de la Torta -->
                                    @foreach (var slice in pieSlices)
                                    {
                                        bool isSelected = especieSeleccionada?.EspecieId == slice.EspecieId;
                                        <path d="@slice.SvgPath" 
                                              fill="@slice.Color" 
                                              stroke="#ffffff" 
                                              stroke-width="@(isSelected ? "3" : "1.5")"
                                              style="cursor: pointer; transition: transform 0.2s, opacity 0.2s; opacity: @(especieSeleccionada == null || isSelected ? "1" : "0.55");"
                                              @onclick="() => especieSeleccionada = (especieSeleccionada?.EspecieId == slice.EspecieId ? null : slice)" />
                                    }

                                    <!-- Centro del Donut: Información y Totales -->
                                    <circle cx="175" cy="175" r="64" fill="#ffffff" stroke="#e5e7eb" stroke-width="1" />
                                    
                                    @if (especieSeleccionada != null)
                                    {
                                        @RenderSvgText(175, 155, GetEspecieIcon(especieSeleccionada.EspecieNombre), "middle", 22, "#111827", "normal")
                                        @RenderSvgText(175, 178, $"{especieSeleccionada.Cantidad} ({especieSeleccionada.Porcentaje:0.0}%)", "middle", 12, "#111827", "700")
                                        @RenderSvgText(175, 195, especieSeleccionada.EspecieNombre, "middle", 11, "#6b7280", "600")
                                    }
                                    else
                                    {
                                        @RenderSvgText(175, 155, "🐾", "middle", 22, "#111827", "normal")
                                        @RenderSvgText(175, 178, reporteClinico.TotalPacientes.ToString(), "middle", 17, "#111827", "700")
                                        @RenderSvgText(175, 196, "Total Pacientes", "middle", 10, "#6b7280", "600")
                                    }
                                </svg>
                            </div>
                            <small class="text-secondary d-block mt-2" style="font-size: 0.75rem;">
                                Haz clic en una porción de la torta para filtrar la especie
                            </small>
                        </div>

                        <!-- Columna Derecha: Leyenda y Desglose de Especies (con Emojis de Especies) -->
                        <div class="col-lg-7 col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold" style="color: var(--text-primary); font-size: 0.9rem;">Especies Registradas</span>
                                @if (especieSeleccionada != null)
                                {
                                    <button class="btn btn-sm btn-link text-decoration-none p-0" style="font-size: 0.8rem;" @onclick="() => especieSeleccionada = null">
                                        Mostrar todas
                                    </button>
                                }
                            </div>

                            <div class="d-flex flex-column gap-2" style="max-height: 320px; overflow-y: auto;">
                                @foreach (var slice in pieSlices)
                                {
                                    bool isSelected = especieSeleccionada?.EspecieId == slice.EspecieId;
                                    <div class="p-2 px-3 rounded border @(isSelected ? "border-primary bg-light" : "")" 
                                         style="cursor: pointer; transition: all 0.2s; background: @(isSelected ? "rgba(2, 132, 199, 0.06)" : "#ffffff");"
                                         @onclick="() => especieSeleccionada = (especieSeleccionada?.EspecieId == slice.EspecieId ? null : slice)">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <div class="d-flex align-items-center gap-2">
                                                <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: @slice.Color;"></span>
                                                <span style="font-size: 1.1rem;">@GetEspecieIcon(slice.EspecieNombre)</span>
                                                <span class="fw-bold" style="color: var(--text-primary); font-size: 0.9rem;">@slice.EspecieNombre</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-light text-dark border">@slice.Porcentaje.ToString("0.0")%</span>
                                                <strong style="color: var(--text-primary); font-size: 0.9rem;">@slice.Cantidad @(slice.Cantidad == 1 ? "mascota" : "mascotas")</strong>
                                            </div>
                                        </div>
                                        <div class="progress" style="height: 6px; background: #e5e7eb; border-radius: 4px;">
                                            <div class="progress-bar" role="progressbar" 
                                                 style="width: @slice.Porcentaje.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%; background-color: @slice.Color; border-radius: 4px;"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SUBREPORTE 3: Histórico de Tratamientos                         -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <div class="glass-card mb-4" style="background: #ffffff; border: 1px solid var(--border-light); border-radius: var(--radius-md); box-shadow: var(--shadow-card);">
            <!-- Encabezado colapsable -->
            <div class="d-flex justify-content-between align-items-center pb-2 @(isHistoricoTratamientosOpen ? "border-bottom mb-3" : "")" style="cursor: pointer;" @onclick="() => isHistoricoTratamientosOpen = !isHistoricoTratamientosOpen">
                <div>
                    <h5 class="m-0 fw-bold" style="color: var(--text-primary);">Histórico de Tratamientos</h5>
                    <small class="text-secondary">Registro auditable de intervenciones médicas, diagnósticos y estado evolutivo</small>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-light text-dark border px-2 py-1">@(historicoTratamientos?.Count ?? 0) registros</span>
                    <button class="btn btn-sm btn-outline-secondary" style="border-radius: 6px; padding: 2px 8px;" type="button" aria-label="Toggle Historico Tratamientos">
                        @(isHistoricoTratamientosOpen ? "▲" : "▼")
                    </button>
                </div>
            </div>

            @if (isHistoricoTratamientosOpen)
            {
                <p class="text-secondary small mb-3">Lista completa de tratamientos realizados. Utilice los filtros para refinar los resultados.</p>

                @* Filtros *@
                <div class="row g-2 mb-3">
                    <div class="col-md-2">
                        <label class="form-label text-secondary small mb-1">Desde</label>
                        <input type="date" @bind="filtroDesde" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-secondary small mb-1">Hasta</label>
                        <input type="date" @bind="filtroHasta" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-secondary small mb-1">Paciente</label>
                        <input type="text" @bind="filtroPaciente" class="form-control form-control-sm" placeholder="Buscar..." />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-secondary small mb-1">Dueño</label>
                        <input type="text" @bind="filtroPropietario" class="form-control form-control-sm" placeholder="Buscar..." />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-secondary small mb-1">Veterinario</label>
                        <input type="text" @bind="filtroVeterinario" class="form-control form-control-sm" placeholder="Buscar..." />
                    </div>
                    <div class="col-md-2 d-flex align-items-end gap-1">
                        <button class="btn btn-primary flex-fill" style="height: 31px; font-size: 0.875rem; padding: 0 0.75rem; background-color: var(--accent-primary); border-color: var(--accent-primary); color: white;" @onclick="BuscarTratamientos" disabled="@isLoadingTratamientos">
                            @if (isLoadingTratamientos) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Buscar
                        </button>
                        @if (HasActiveTratamientosFilter)
                        {
                            <button class="btn btn-outline-secondary" style="height: 31px; font-size: 0.875rem; padding: 0 0.5rem;" @onclick="LimpiarFiltrosTratamientos" title="Limpiar filtros">✕</button>
                        }
                    </div>
                </div>

                @* Tabla de resultados *@
                @if (historicoTratamientos != null)
                {
                    <div class="table-responsive border rounded" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle mb-0" style="background: transparent;">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Paciente</th>
                                    <th>Tratamiento</th>
                                    <th>Fecha</th>
                                    <th>Veterinario</th>
                                    <th>Dueño</th>
                                    <th class="text-center">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!historicoTratamientos.Any())
                                {
                                    <tr><td colspan="6" class="text-center text-secondary py-3">No se encontraron tratamientos con los filtros aplicados.</td></tr>
                                }
                                @foreach (var t in historicoTratamientos)
                                {
                                    <tr>
                                        <td class="fw-bold" style="color: var(--text-primary);">@t.PacienteNombre</td>
                                        <td>
                                            <span class="fw-semibold" style="color: var(--text-primary);">@t.Diagnostico</span>
                                            @if (!string.IsNullOrWhiteSpace(t.Descripcion))
                                            {
                                                <br/><small class="text-secondary">@t.Descripcion</small>
                                            }
                                        </td>
                                        <td class="text-secondary">@t.Fecha.ToString("yyyy-MM-dd")</td>
                                        <td class="text-secondary">@t.Veterinario</td>
                                        <td class="text-secondary">@t.PropietarioNombre</td>
                                        <td class="text-center">
                                            <span class="badge @(t.Finalizado ? "bg-success" : "bg-warning text-dark")">@(t.Finalizado ? "Finalizado" : "En curso")</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="text-secondary small mt-2 mb-0">Total: @historicoTratamientos.Count tratamiento(s)</p>
                }
            }
        </div>
    }
}

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

