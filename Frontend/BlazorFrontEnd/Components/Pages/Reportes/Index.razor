    private List<DiaVentaItem> ObtenerDias30()
    {
        var list = new List<DiaVentaItem>();
        if (reporteVentas == null) return list;

        var fechaFin = reporteVentas.Hasta.Date > DateTime.Today ? DateTime.Today : reporteVentas.Hasta.Date;
        if (fechaFin == DateTime.MinValue) fechaFin = DateTime.Today;
        var fechaInicio = fechaFin.AddDays(-29);

        var ventasDict = reporteVentas.VentasPorDia
            .GroupBy(v => v.Fecha.Date)
            .ToDictionary(g => g.Key, g => new { Total = g.Sum(x => x.Total), Cantidad = g.Sum(x => x.Cantidad) });

        for (int i = 1; i <= 30; i++)
        {
            var fecha = fechaInicio.AddDays(i - 1);
            decimal total = 0;
            int cant = 0;
            if (ventasDict.TryGetValue(fecha.Date, out var v))
            {
                total = v.Total;
                cant = v.Cantidad;
            }
            list.Add(new DiaVentaItem
            {
                DiaNumero = i,
                Fecha = fecha,
                Facturado = total,
                Operaciones = cant
            });
        }
        return list;
    }

    private string GetSvgPath(List<DiaVentaItem> dias, string metric, decimal scaleMaxFact, int scaleMaxOps)
    {
        if (dias == null || !dias.Any()) return "";
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < dias.Count; i++)
        {
            double x = 85.0 + i * (885.0 / 29.0);
            double y;
            if (metric == "FACTURADO")
            {
                y = 315.0 - (double)(dias[i].Facturado / (scaleMaxFact > 0 ? scaleMaxFact : 100000m)) * 285.0;
            }
            else
            {
                y = 315.0 - (double)(dias[i].Operaciones / (double)(scaleMaxOps > 0 ? scaleMaxOps : 5)) * 285.0;
            }
            if (y < 30) y = 30;
            if (y > 315) y = 315;

            if (i == 0)
                sb.Append(System.Globalization.CultureInfo.InvariantCulture, $"M {x:F2} {y:F2}");
            else
                sb.Append(System.Globalization.CultureInfo.InvariantCulture, $" L {x:F2} {y:F2}");
        }
        return sb.ToString();
    }

    private string GetSvgAreaPath(List<DiaVentaItem> dias, string metric, decimal scaleMaxFact, int scaleMaxOps)
    {
        var linePath = GetSvgPath(dias, metric, scaleMaxFact, scaleMaxOps);
        if (string.IsNullOrEmpty(linePath)) return "";
        double lastX = 85.0 + 29.0 * (885.0 / 29.0);
        double firstX = 85.0;
        return $"{linePath} L {lastX:F2} 315.00 L {firstX:F2} 315.00 Z";
    }

    private List<VentaPorMetodoPagoDto> GetListaMetodosOrdenada()
    {
        if (reporteVentas == null || reporteVentas.VentasPorMetodoPago == null) return new();
        return metodoSortBy == "TOTAL"
            ? reporteVentas.VentasPorMetodoPago.OrderByDescending(m => m.Total).ToList()
            : reporteVentas.VentasPorMetodoPago.OrderByDescending(m => m.Cantidad).ToList();
    }

    private List<ProductoMasVendidoDto> GetListaProductosOrdenada()
    {
        if (reporteVentas == null || reporteVentas.ProductosMasVendidos == null) return new();
        return productoSortBy == "CANTIDAD"
            ? reporteVentas.ProductosMasVendidos.OrderByDescending(p => p.CantidadVendida).ToList()
            : reporteVentas.ProductosMasVendidos.OrderByDescending(p => p.TotalVendido).ToList();
    }

    private MarkupString RenderSvgText(double x, double y, string content, string textAnchor = "start", int fontSize = 11, string fill = "#6b7280", string fontWeight = "normal")
    {
        var str = $"<text x=\"{x.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}\" y=\"{y.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}\" text-anchor=\"{textAnchor}\" font-size=\"{fontSize}\" fill=\"{fill}\" font-weight=\"{fontWeight}\">{System.Net.WebUtility.HtmlEncode(content)}</text>";
        return new MarkupString(str);
    }

    private string GetIconoMetodoPago(string metodo)
    {
        if (string.IsNullOrWhiteSpace(metodo)) return "🏷️";
        var m = metodo.ToLowerInvariant();
        if (m.Contains("efectivo")) return "💵";
        if (m.Contains("débito") || m.Contains("debito")) return "💳";
        if (m.Contains("crédito") || m.Contains("credito")) return "💳";
        if (m.Contains("transfer") || m.Contains("mp") || m.Contains("mercado") || m.Contains("qr")) return "📱";
        return "🏷️";
    }

