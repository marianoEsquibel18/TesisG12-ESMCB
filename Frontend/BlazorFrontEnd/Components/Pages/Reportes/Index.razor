    private List<DiaTurnoItem> ObtenerDiasTurnosFiltrados()
    {
        var todos = ObtenerDiasTurnos30();
        if (!todos.Any()) return todos;

        if (turnosDiasRango == 7)
            return todos.TakeLast(7).ToList();
        if (turnosDiasRango == 15)
            return todos.TakeLast(15).ToList();
        return todos;
    }

    private double GetEffectiveScaleMax(List<DiaTurnoItem> dias)
    {
        if (isAutoVerticalScale)
        {
            int maxVal = dias.Any() ? dias.Max(d => Math.Max(d.Total, Math.Max(d.Completados, Math.Max(d.Ausentes, d.Cancelados)))) : 10;
            if (maxVal <= 4) return 6.0;
            if (maxVal <= 8) return 10.0;
            if (maxVal <= 16) return 20.0;
            if (maxVal <= 26) return 30.0;
            if (maxVal <= 50) return 60.0;
            return Math.Ceiling(maxVal * 1.2 / 5.0) * 5.0;
        }
        return scaleMaxTurnos > 0 ? scaleMaxTurnos : 20.0;
    }

    private (int StepMajor, int StepMinor) GetScaleSteps(double scaleMax)
    {
        if (scaleMax <= 10) return (2, 1);
        if (scaleMax <= 24) return (5, 1);
        if (scaleMax <= 40) return (5, 2);
        if (scaleMax <= 70) return (10, 2);
        return (20, 5);
    }

    private List<DiaTurnoItem> ObtenerDiasTurnos30()
    {
        var list = new List<DiaTurnoItem>();
        if (reporteTurnos == null) return list;

        var fechaFin = reporteTurnos.Hasta.Date > DateTime.Today ? DateTime.Today : reporteTurnos.Hasta.Date;
        if (fechaFin == DateTime.MinValue) fechaFin = DateTime.Today;
        var fechaInicio = fechaFin.AddDays(-29);

        var dict = reporteTurnos.TurnosPorDia
            .GroupBy(t => t.Fecha.Date)
            .ToDictionary(g => g.Key, g => new
            {
                Total = g.Sum(x => x.Total),
                Programados = g.Sum(x => x.Programados),
                Completados = g.Sum(x => x.Completados),
                Ausentes = g.Sum(x => x.Ausentes),
                Cancelados = g.Sum(x => x.Cancelados)
            });

        for (int i = 1; i <= 30; i++)
        {
            var fecha = fechaInicio.AddDays(i - 1);
            int tot = 0, prog = 0, comp = 0, aus = 0, canc = 0;
            if (dict.TryGetValue(fecha.Date, out var d))
            {
                tot = d.Total;
                prog = d.Programados;
                comp = d.Completados;
                aus = d.Ausentes;
                canc = d.Cancelados;
            }

            list.Add(new DiaTurnoItem
            {
                DiaNumero = i,
                Fecha = fecha,
                Total = tot,
                Programados = prog,
                Completados = comp,
                Ausentes = aus,
                Cancelados = canc
            });
        }
        return list;
    }

    private string GetTurnosSvgPath(List<DiaTurnoItem> dias, Func<DiaTurnoItem, int> selector, double scaleMax = 60.0)
    {
        if (dias == null || !dias.Any()) return "";
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < dias.Count; i++)
        {
            double x = (dias.Count == 1) ? 522.0 : 75.0 + i * (895.0 / (dias.Count - 1.0));
            int val = selector(dias[i]);
            double y = 320.0 - (val / scaleMax) * 280.0;
            if (y < 40) y = 40;
            if (y > 320) y = 320;

            if (i == 0)
                sb.Append(System.Globalization.CultureInfo.InvariantCulture, $"M {x:F2} {y:F2}");
            else
                sb.Append(System.Globalization.CultureInfo.InvariantCulture, $" L {x:F2} {y:F2}");
        }
        return sb.ToString();
    }

