@page "/dashboard"
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@using BlazorFrontEnd.Auth
@implements IDisposable
@inject DashboardService DashboardService
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject TurnoService TurnoService
@inject TokenStorageService TokenStorage

<style>
    .alert-clickable {
        transition: background-color 0.2s ease, transform 0.15s ease;
    }
    .alert-clickable:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
        transform: translateX(4px);
    }
    .alert-clickable:active {
        background-color: rgba(255, 255, 255, 0.08) !important;
    }
</style>

<PageTitle>Dashboard | Panel Principal</PageTitle>

@if (isLoading)
{
    <div class="text-center p-5 text-secondary">
        <div class="spinner-border text-info mb-3" role="status"></div>
        <br/>
        Cargando indicadores y procesando alertas del sistema...
    </div>
}
else if (userProfile == null)
{
    <div class="alert alert-danger" style="background: rgba(255, 107, 107, 0.1); border: 1px solid var(--accent-danger); color: #c0392b;">
        Error al obtener los datos de usuario. Verifique que la API del Backend esté corriendo.
    </div>
}
else if (IsVeterinario)
{
    <!-- Banner y Título -->
    <div class="d-flex justify-content-between align-items-center" style="margin-bottom: var(--sp-lg);">
        <div>
            <h2 style="font-weight: 700; margin: 0; color: var(--text-primary);">Panel Profesional</h2>
            <p class="text-secondary" style="margin: 0;">Bienvenido, Dr/a. @userProfile.NombreCompleto (Hoy: @DateTime.Today.ToString("dd MMMM yyyy"))</p>
        </div>
    </div>

    <!-- KPIs Principales Veterinario -->
    <div class="row mb-4">
        <!-- Turnos de Hoy -->
        <div class="col-md-6 mb-3 mb-md-0">
            <div class="glass-card text-center" style="padding: var(--sp-md);">
                <p class="text-secondary small text-uppercase fw-bold m-0 mb-1">Mis Turnos de Hoy</p>
                <h3 style="color: var(--accent-primary); font-weight: 800; margin: 0;">@(misTurnosHoy?.Count ?? 0)</h3>
                <small class="text-secondary">Turnos asignados a tu agenda para hoy</small>
            </div>
        </div>
        <!-- Pacientes Activos -->
        <div class="col-md-6">
            <div class="glass-card text-center" style="padding: var(--sp-md);">
                <p class="text-secondary small text-uppercase fw-bold m-0 mb-1">Pacientes Activos</p>
                <h3 style="color: var(--text-primary); font-weight: 800; margin: 0;">@(kpis?.TotalPacientes ?? 0)</h3>
                <small class="text-secondary">Padrón activo en @(kpis?.TotalPropietarios ?? 0) familias</small>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <!-- Turnos de Hoy (Tabla) -->
        <div class="col-md-7 mb-4 mb-md-0">
            <div class="glass-card" style="height: 100%; min-height: 380px; display: flex; flex-direction: column;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="m-0" style="color: var(--text-primary); font-weight: 700;">Mis Turnos de Hoy</h5>
                    <span class="badge bg-primary rounded-pill">@(misTurnosHoy?.Count ?? 0)</span>
                </div>
                
                @if (misTurnosHoy == null || !misTurnosHoy.Any())
                {
                    <div class="text-center text-secondary my-auto p-4">
                        <p style="font-size: 1.1rem; margin: 0;">Sin turnos agendados</p>
                        <small>No tienes turnos programados para hoy.</small>
                    </div>
                }
                else
                {
                    <div style="flex-grow: 1; overflow-y: auto; max-height: 380px;">
                        <div class="table-responsive">
                            <table class="table table-dark table-hover table-borderless align-middle m-0" style="--bs-table-bg: transparent; --bs-table-hover-bg: rgba(255,255,255,0.03);">
                                <thead>
                                    <tr class="text-secondary border-bottom" style="border-color: var(--border-light) !important;">
                                        <th style="font-size: 0.85rem; font-weight: 600;">Hora</th>
                                        <th style="font-size: 0.85rem; font-weight: 600;">Paciente</th>
                                        <th style="font-size: 0.85rem; font-weight: 600;">Servicio</th>
                                        <th style="font-size: 0.85rem; font-weight: 600;">Motivo</th>
                                        <th style="font-size: 0.85rem; font-weight: 600;">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var turno in misTurnosHoy.OrderBy(t => t.FechaHora))
                                    {
                                        var badgeColor = turno.Estado == "Completado" ? "bg-success text-white" :
                                                         turno.Estado == "Ausente" ? "bg-danger text-white" :
                                                         turno.Estado == "Cancelado" ? "bg-purple text-white" :
                                                         turno.Estado == "Programado" ? "bg-primary text-white" : "bg-warning text-dark";
                                        
                                        <tr class="border-bottom" style="border-color: var(--border-light) !important; cursor: pointer;" @onclick='() => Navigation.NavigateTo($"/agenda?turnoId={turno.Id}")'>
                                            <td class="fw-bold" style="color: var(--accent-primary); font-size: 0.9rem;">@turno.FechaHora.ToString("HH:mm") hs</td>
                                            <td>
                                                <span style="font-weight: 600; color: #333333;">@turno.PacienteNombre</span>
                                                <br/>
                                                <small class="text-secondary" style="font-size: 0.75rem;">Dueño: @turno.PropietarioNombre</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary" style="font-size: 0.75rem; background-color: #3b82f6 !important;">@turno.ServicioNombre</span>
                                            </td>
                                            <td class="text-secondary" style="font-size: 0.85rem; max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                @turno.Motivo
                                            </td>
                                            <td>
                                                <span class="badge @badgeColor" style="font-size: 0.75rem;">@turno.Estado</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Centro de Resoluciones (Alertas) -->
        <div class="col-md-5">
            <div class="glass-card" style="height: 100%; min-height: 380px; display: flex; flex-direction: column;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="m-0" style="color: var(--text-primary); font-weight: 700;">Centro de Resoluciones</h5>
                        <small class="text-secondary" style="font-size: 0.75rem;">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 12px; height: 12px; vertical-align: -1px; margin-right: 2px;">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                            </svg>
                            @currentSucursalNombre
                        </small>
                    </div>
                    <span class="badge @(monitor != null && monitor.TotalAlertas > 0 ? "bg-danger" : "bg-success") rounded-pill">@(monitor?.TotalAlertas ?? 0)</span>
                </div>
                
                <div style="flex-grow: 1; overflow-y: auto; max-height: 380px;">
                    @if (monitor == null || !monitor.Alertas.Any())
                    {
                        <div class="text-center text-secondary my-auto p-4">
                            <p style="font-size: 1.1rem; margin: 0;">Todo bajo control</p>
                            <small>No hay alertas críticas en el sistema.</small>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush" style="background: transparent;">
                            @foreach (var alerta in monitor.Alertas)
                            {
                                var colorClass = alerta.Nivel == "CRITICA" ? "text-danger" :
                                                alerta.Nivel == "IMPORTANTE" ? "text-warning" : "text-info";
                                
                                <div class="list-group-item bg-transparent border-bottom px-1 py-2 alert-clickable" 
                                     style="color: var(--text-primary); border-color: var(--border-light) !important; cursor: pointer;"
                                     @onclick="() => OnAlertaClick(alerta)">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1 @colorClass" style="font-size: 0.9rem; font-weight: 700;">
                                            @alerta.Titulo
                                        </h6>
                                        <small class="text-secondary" style="font-size: 0.7rem;">@alerta.Nivel</small>
                                    </div>
                                    <p class="mb-1 text-secondary" style="font-size: 0.8rem;">@alerta.Detalle</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Fila: Gráfico de Atención de Pacientes por Especie (Veterinario) -->
    <div class="row">
        <div class="col-12">
            <div class="glass-card" style="padding: var(--sp-md);">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom gap-3" style="border-color: var(--border-light) !important;">
                    <div>
                        <h5 class="m-0 fw-bold" style="color: var(--text-primary);">Atención de Pacientes por Especie</h5>
                        <small class="text-secondary">Cantidad de pacientes que asistieron a la veterinaria según su especie en el período seleccionado</small>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <div class="d-flex align-items-center gap-1">
                            <label class="form-label text-secondary small m-0 fw-semibold">Desde:</label>
                            <input type="date" class="form-control form-control-sm bg-dark text-light border-secondary" style="max-width: 140px; font-size: 0.82rem;" @bind="fechaDesdeEspecie" />
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <label class="form-label text-secondary small m-0 fw-semibold">Hasta:</label>
                            <input type="date" class="form-control form-control-sm bg-dark text-light border-secondary" style="max-width: 140px; font-size: 0.82rem;" @bind="fechaHastaEspecie" />
                        </div>
                        <button class="btn btn-sm btn-primary d-flex align-items-center gap-1" style="background-color: var(--accent-primary); border-color: var(--accent-primary); color: #ffffff; font-weight: 600; padding: 4px 12px; border-radius: 6px;" @onclick="FiltrarPacientesPorEspecie" disabled="@isLoadingEspecies">
                            @if (isLoadingEspecies)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                <span>Cargando...</span>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 14px; height: 14px;">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                                </svg>
                                <span>Filtrar</span>
                            }
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" style="font-size: 0.82rem; padding: 4px 10px; border-radius: 6px;" @onclick="ResetFiltroEspecies" title="Ver todo el historial">
                            Todos
                        </button>
                    </div>
                </div>

                @if (isLoadingEspecies)
                {
                    <div class="text-center py-4 text-secondary">
                        <div class="spinner-border spinner-border-sm text-info mb-2"></div>
                        <p class="small m-0">Actualizando gráfico por especie...</p>
                    </div>
                }
                else if (pacientesPorEspecieData == null || !pacientesPorEspecieData.Distribucion.Any())
                {
                    <div class="text-center py-4 text-secondary">
                        <p class="mb-1" style="font-size: 0.95rem;">No se registraron turnos ni visitas en el rango de fechas seleccionado.</p>
                        <small>Pruebe seleccionando un rango de fechas más amplio o haga clic en "Todos".</small>
                    </div>
                }
                else
                {
                    <div class="mb-3 d-flex align-items-center justify-content-between">
                        <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.85rem;">
                            Total de visitas en el período: <strong style="color: var(--accent-primary);">@pacientesPorEspecieData.Total</strong>
                        </span>
                        <span class="text-secondary small">
                            @pacientesPorEspecieData.Distribucion.Count @(pacientesPorEspecieData.Distribucion.Count == 1 ? "especie atendida" : "especies atendidas")
                        </span>
                    </div>

                    <!-- Gráfico de barras horizontal -->
                    <div class="d-flex flex-column gap-3 p-3 border rounded" style="background: var(--bg-main); border-color: var(--border-color) !important;">
                        @{
                            var maxCant = pacientesPorEspecieData.Distribucion.Max(d => d.Cantidad);
                            if (maxCant == 0) maxCant = 1;

                            string[] barGradients = new[]
                            {
                                "linear-gradient(90deg, #00A36C 0%, #34d399 100%)", // Verde esmeralda
                                "linear-gradient(90deg, #2563eb 0%, #60a5fa 100%)", // Azul vibrante
                                "linear-gradient(90deg, #d97706 0%, #fbbf24 100%)", // Ámbar
                                "linear-gradient(90deg, #7c3aed 0%, #a78bfa 100%)", // Púrpura
                                "linear-gradient(90deg, #db2777 0%, #f472b6 100%)", // Rosa
                                "linear-gradient(90deg, #0891b2 0%, #22d3ee 100%)", // Cian
                                "linear-gradient(90deg, #4b5563 0%, #9ca3af 100%)"  // Gris
                            };
                        }

                        @for (int i = 0; i < pacientesPorEspecieData.Distribucion.Count; i++)
                        {
                            var item = pacientesPorEspecieData.Distribucion[i];
                            var widthPercent = Math.Max(8, (item.Cantidad * 100.0) / maxCant);
                            var gradient = barGradients[i % barGradients.Length];
                            var pctOfTotal = pacientesPorEspecieData.Total > 0 ? (item.Cantidad * 100.0) / pacientesPorEspecieData.Total : 0;

                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold" style="color: var(--text-primary); font-size: 0.9rem;">
                                        @item.Especie: @item.Cantidad
                                    </span>
                                    <small class="text-secondary fw-semibold">
                                        @pctOfTotal.ToString("0.#")% de las visitas
                                    </small>
                                </div>
                                <div class="progress" style="height: 28px; background-color: rgba(0,0,0,0.06); border-radius: 6px; overflow: hidden; border: 1px solid var(--border-light);">
                                    <div class="progress-bar d-flex flex-row align-items-center justify-content-between px-3 text-white fw-bold" 
                                         role="progressbar" 
                                         style="width: @(widthPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; background: @gradient; transition: width 0.6s ease; font-size: 0.85rem;" 
                                         aria-valuenow="@item.Cantidad" 
                                         aria-valuemin="0" 
                                         aria-valuemax="@maxCant">
                                        <span>@item.Especie: @item.Cantidad</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <!-- Admin & Gerente Dashboard -->
    <!-- Banner y Título -->
    <div class="d-flex justify-content-between align-items-center" style="margin-bottom: var(--sp-lg);">
        <div>
            <h2 style="font-weight: 700; margin: 0; color: var(--text-primary);">Centro de Comando</h2>
            <p class="text-secondary" style="margin: 0;">Resumen General del Sistema (Hoy: @DateTime.Today.ToString("dd MMMM yyyy"))</p>
        </div>
    </div>

    @if (kpis == null || monitor == null)
    {
        <div class="alert alert-danger" style="background: rgba(255, 107, 107, 0.1); border: 1px solid var(--accent-danger); color: #c0392b;">
            Error al obtener los datos del panel. Verifique que posee los privilegios correspondientes.
        </div>
    }
    else
    {
        <!-- KPIs Principales -->
        <div class="row mb-4">
            <!-- Ingresos del Mes -->
            <div class="col-md-3">
                <div class="glass-card text-center" style="padding: var(--sp-md);">
                    <p class="text-secondary small text-uppercase fw-bold m-0 mb-1">Caja del Mes</p>
                    <h3 style="color: var(--accent-primary); font-weight: 800; margin: 0;">$@kpis.IngresosMesActual.ToString("N0")</h3>
                    <small class="text-success">@kpis.VentasMesActual.ToString() tickets emitidos</small>
                </div>
            </div>
            <!-- Turnos del Día -->
            <div class="col-md-3">
                <div class="glass-card text-center" style="padding: var(--sp-md);">
                    <p class="text-secondary small text-uppercase fw-bold m-0 mb-1">Turnos de Hoy</p>
                    <h3 style="color: var(--text-primary); font-weight: 800; margin: 0;">@kpis.TurnosCompletadosHoy / @kpis.TurnosHoy</h3>
                    <small class="text-info">@kpis.TurnosPendientesHoy pendientes</small>
                </div>
            </div>
            <!-- Padrón de Pacientes -->
            <div class="col-md-3">
                <div class="glass-card text-center" style="padding: var(--sp-md);">
                    <p class="text-secondary small text-uppercase fw-bold m-0 mb-1">Pacientes Activos</p>
                    <h3 style="color: var(--text-primary); font-weight: 800; margin: 0;">@kpis.TotalPacientes</h3>
                    <small class="text-secondary">En @kpis.TotalPropietarios familias</small>
                </div>
            </div>
            <!-- Inventario Crítico -->
            <div class="col-md-3">
                <div class="glass-card text-center" style="padding: var(--sp-md); @(kpis.ProductosStockBajo > 0 ? "border: 1px solid var(--accent-danger);" : "")">
                    <p class="text-secondary small text-uppercase fw-bold m-0 mb-1">Stock en Alerta</p>
                    <h3 style="@(kpis.ProductosStockBajo > 0 ? "color: var(--accent-danger);" : "color: var(--text-primary);") font-weight: 800; margin: 0;">@kpis.ProductosStockBajo</h3>
                    <small class="text-secondary">De @kpis.TotalProductos Artículos Totales</small>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <!-- Gráfico / Ingresos -->
            <div class="col-md-8">
                <div class="glass-card" style="height: 100%;">
                    <h5 class="mb-4" style="color: var(--text-primary);">Historial de Caja (Últimos 7 días)</h5>
                    @if(ingresos == null || !ingresos.Any())
                    {
                        <p class="text-secondary">No hay data reciente para graficar.</p>
                    }
                    else
                    {
                        <div class="d-flex align-items-end justify-content-between p-3 border rounded" style="height: 250px; background: var(--bg-main); border-color: var(--border-color);">
                            @{ var max = ingresos.Max(i => i.Ingresos) > 0 ? ingresos.Max(i => i.Ingresos) : 1; }
                            @foreach(var day in ingresos)
                            {
                                var heightPercent = (day.Ingresos / max) * 100;
                                var minHeight = heightPercent < 5 ? 5 : heightPercent;
                                
                                <div class="d-flex flex-column align-items-center justify-content-end" style="width: 12%; height: 100%;">
                                    <small class="text-secondary mb-1" style="font-size: 0.7rem;">$@day.Ingresos.ToString("N0")</small>
                                    <div style="width: 100%; height: 150px; display: flex; align-items: flex-end;">
                                        <div style="width: 100%; height: @((int)minHeight)%; min-height: 5px; background: linear-gradient(180deg, var(--accent-primary) 0%, rgba(0, 163, 108, 0.2) 100%); border-radius: 4px 4px 0 0; transition: height 1s ease;">
                                        </div>
                                    </div>
                                    <small class="mt-2" style="font-size: 0.75rem; white-space: nowrap; color: var(--text-secondary);">@day.FechaCorta</small>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Panel de Alertas Inteligente -->
            <div class="col-md-4">
                <div class="glass-card" style="height: 100%; display: flex; flex-direction: column;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="m-0" style="color: var(--text-primary);">Centro de Resoluciones</h5>
                            <small class="text-secondary" style="font-size: 0.75rem;">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 12px; height: 12px; vertical-align: -1px; margin-right: 2px;">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                                </svg>
                                @currentSucursalNombre
                            </small>
                        </div>
                        <span class="badge @(monitor.TotalAlertas > 0 ? "bg-danger" : "bg-success") rounded-pill">@monitor.TotalAlertas</span>
                    </div>
                    
                    <div style="flex-grow: 1; overflow-y: auto; max-height: 250px;">
                        @if(!monitor.Alertas.Any())
                        {
                            <div class="text-center text-secondary mt-4">
                                <p>Todo bajo control.</p>
                                <small>No hay alertas críticas en el sistema.</small>
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush" style="background: transparent;">
                                @foreach(var alerta in monitor.Alertas)
                                {
                                    var colorClass = alerta.Nivel == "CRITICA" ? "text-danger" :
                                                    alerta.Nivel == "IMPORTANTE" ? "text-warning" : "text-info";
                                    
                                    <div class="list-group-item bg-transparent border-bottom px-1 py-2 alert-clickable" 
                                         style="color: var(--text-primary); border-color: var(--border-light) !important; cursor: pointer;"
                                         @onclick="() => OnAlertaClick(alerta)">
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1 @colorClass" style="font-size: 0.9rem; font-weight: 700;">
                                                @alerta.Titulo
                                            </h6>
                                            <small class="text-secondary" style="font-size: 0.7rem;">@alerta.Nivel</small>
                                        </div>
                                        <p class="mb-1 text-secondary" style="font-size: 0.8rem;">@alerta.Detalle</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Fila: Gráfico de Atención de Pacientes por Especie (Admin y Gerente) -->
        <div class="row">
            <div class="col-12">
                <div class="glass-card" style="padding: var(--sp-md);">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom gap-3" style="border-color: var(--border-light) !important;">
                        <div>
                            <h5 class="m-0 fw-bold" style="color: var(--text-primary);">Atención de Pacientes por Especie</h5>
                            <small class="text-secondary">Cantidad de pacientes que asistieron a la veterinaria según su especie en el período seleccionado</small>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <div class="d-flex align-items-center gap-1">
                                <label class="form-label text-secondary small m-0 fw-semibold">Desde:</label>
                                <input type="date" class="form-control form-control-sm bg-dark text-light border-secondary" style="max-width: 140px; font-size: 0.82rem;" @bind="fechaDesdeEspecie" />
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <label class="form-label text-secondary small m-0 fw-semibold">Hasta:</label>
                                <input type="date" class="form-control form-control-sm bg-dark text-light border-secondary" style="max-width: 140px; font-size: 0.82rem;" @bind="fechaHastaEspecie" />
                            </div>
                            <button class="btn btn-sm btn-primary d-flex align-items-center gap-1" style="background-color: var(--accent-primary); border-color: var(--accent-primary); color: #ffffff; font-weight: 600; padding: 4px 12px; border-radius: 6px;" @onclick="FiltrarPacientesPorEspecie" disabled="@isLoadingEspecies">
                                @if (isLoadingEspecies)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                    <span>Cargando...</span>
                                }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 14px; height: 14px;">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                                    </svg>
                                    <span>Filtrar</span>
                                }
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" style="font-size: 0.82rem; padding: 4px 10px; border-radius: 6px;" @onclick="ResetFiltroEspecies" title="Ver todo el historial">
                                Todos
                            </button>
                        </div>
                    </div>

                    @if (isLoadingEspecies)
                    {
                        <div class="text-center py-4 text-secondary">
                            <div class="spinner-border spinner-border-sm text-info mb-2"></div>
                            <p class="small m-0">Actualizando gráfico por especie...</p>
                        </div>
                    }
                    else if (pacientesPorEspecieData == null || !pacientesPorEspecieData.Distribucion.Any())
                    {
                        <div class="text-center py-4 text-secondary">
                            <p class="mb-1" style="font-size: 0.95rem;">No se registraron turnos ni visitas en el rango de fechas seleccionado.</p>
                            <small>Pruebe seleccionando un rango de fechas más amplio o haga clic en "Todos".</small>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3 d-flex align-items-center justify-content-between">
                            <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.85rem;">
                                Total de visitas en el período: <strong style="color: var(--accent-primary);">@pacientesPorEspecieData.Total</strong>
                            </span>
                            <span class="text-secondary small">
                                @pacientesPorEspecieData.Distribucion.Count @(pacientesPorEspecieData.Distribucion.Count == 1 ? "especie atendida" : "especies atendidas")
                            </span>
                        </div>

                        <!-- Gráfico de barras horizontal -->
                        <div class="d-flex flex-column gap-3 p-3 border rounded" style="background: var(--bg-main); border-color: var(--border-color) !important;">
                            @{
                                var maxCant = pacientesPorEspecieData.Distribucion.Max(d => d.Cantidad);
                                if (maxCant == 0) maxCant = 1;

                                string[] barGradients = new[]
                                {
                                    "linear-gradient(90deg, #00A36C 0%, #34d399 100%)", // Verde esmeralda
                                    "linear-gradient(90deg, #2563eb 0%, #60a5fa 100%)", // Azul vibrante
                                    "linear-gradient(90deg, #d97706 0%, #fbbf24 100%)", // Ámbar
                                    "linear-gradient(90deg, #7c3aed 0%, #a78bfa 100%)", // Púrpura
                                    "linear-gradient(90deg, #db2777 0%, #f472b6 100%)", // Rosa
                                    "linear-gradient(90deg, #0891b2 0%, #22d3ee 100%)", // Cian
                                    "linear-gradient(90deg, #4b5563 0%, #9ca3af 100%)"  // Gris
                                };
                            }

                            @for (int i = 0; i < pacientesPorEspecieData.Distribucion.Count; i++)
                            {
                                var item = pacientesPorEspecieData.Distribucion[i];
                                var widthPercent = Math.Max(8, (item.Cantidad * 100.0) / maxCant);
                                var gradient = barGradients[i % barGradients.Length];
                                var pctOfTotal = pacientesPorEspecieData.Total > 0 ? (item.Cantidad * 100.0) / pacientesPorEspecieData.Total : 0;

                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold" style="color: var(--text-primary); font-size: 0.9rem;">
                                            @item.Especie: @item.Cantidad
                                        </span>
                                        <small class="text-secondary fw-semibold">
                                            @pctOfTotal.ToString("0.#")% de las visitas
                                        </small>
                                    </div>
                                    <div class="progress" style="height: 28px; background-color: rgba(0,0,0,0.06); border-radius: 6px; overflow: hidden; border: 1px solid var(--border-light);">
                                        <div class="progress-bar d-flex flex-row align-items-center justify-content-between px-3 text-white fw-bold" 
                                             role="progressbar" 
                                             style="width: @(widthPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; background: @gradient; transition: width 0.6s ease; font-size: 0.85rem;" 
                                             aria-valuenow="@item.Cantidad" 
                                             aria-valuemin="0" 
                                             aria-valuemax="@maxCant">
                                            <span>@item.Especie: @item.Cantidad</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    private bool isLoading = true;
    private UsuarioDto? userProfile;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string currentUserRole = string.Empty;
    private bool IsVeterinario => 
        (userProfile?.RolNombre?.Equals("Veterinario", StringComparison.OrdinalIgnoreCase) == true) || 
        (currentUserRole.Equals("Veterinario", StringComparison.OrdinalIgnoreCase));
    private bool IsRecepcionista => 
        (userProfile?.RolNombre?.Equals("Recepcionista", StringComparison.OrdinalIgnoreCase) == true) || 
        (currentUserRole.Equals("Recepcionista", StringComparison.OrdinalIgnoreCase));

    // Admin & Gerente data
    private KpiDashboardDto? kpis;
    private DashboardAlertasResponse? monitor;
    private List<IngresoDiarioDto>? ingresos;

    // Especies por rango de fechas (Admin, Gerente & Veterinario)
    private DateTime? fechaDesdeEspecie = DateTime.Today.AddDays(-30);
    private DateTime? fechaHastaEspecie = DateTime.Today;
    private PacientesPorEspecieDashboardResponse? pacientesPorEspecieData;
    private bool isLoadingEspecies = false;

    // Veterinario data
    private List<TurnoDto>? misTurnosHoy;

    private string? _lastRole;
    private int? _lastSucursalId;

    private string currentSucursalNombre
    {
        get
        {
            if (TokenStorage.ActiveSucursalId.HasValue)
            {
                return TokenStorage.ActiveSucursalNombre ?? $"Sucursal #{TokenStorage.ActiveSucursalId.Value}";
            }
            if (userProfile?.SucursalId.HasValue == true)
            {
                return userProfile.SucursalNombre ?? $"Sucursal #{userProfile.SucursalId.Value}";
            }
            return "Todas las sucursales";
        }
    }

    private int? currentSucursalId => TokenStorage.ActiveSucursalId ?? _lastSucursalId ?? userProfile?.SucursalId;

    protected override void OnInitialized()
    {
        TokenStorage.OnContextChanged += HandleContextChanged;
    }

    private async void HandleContextChanged()
    {
        await InvokeAsync(async () =>
        {
            _lastSucursalId = currentSucursalId;
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TokenStorage.OnContextChanged -= HandleContextChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState != null)
        {
            var authState = await AuthState;
            var currentRole = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value 
                ?? authState.User.FindFirst("role")?.Value ?? "";
            
            var sucursalClaim = authState.User.FindFirst("sucursalId")?.Value;
            int? currentSucursal = int.TryParse(sucursalClaim, out var sId) ? sId : null;
            if (!currentSucursal.HasValue && TokenStorage.ActiveSucursalId.HasValue)
            {
                currentSucursal = TokenStorage.ActiveSucursalId;
            }

            if (_lastRole != currentRole || _lastSucursalId != currentSucursal || userProfile == null)
            {
                _lastRole = currentRole;
                _lastSucursalId = currentSucursal;
                await LoadDataAsync();
            }
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            if (AuthState != null)
            {
                var authState = await AuthState;
                currentUserRole = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value 
                    ?? authState.User.FindFirst("role")?.Value ?? "";
            }

            userProfile = await AuthService.GetProfileAsync();
            if (userProfile == null && string.IsNullOrEmpty(currentUserRole))
            {
                Navigation.NavigateTo("/");
                return;
            }

            if (IsRecepcionista)
            {
                Navigation.NavigateTo("/agenda");
                return;
            }

            int? effectiveSucursal = currentSucursalId;

            if (IsVeterinario)
            {
                var today = DateTime.Today;
                var start = new DateTime(today.Year, today.Month, today.Day, 0, 0, 0);
                var end = new DateTime(today.Year, today.Month, today.Day, 23, 59, 59);

                var taskTurnos = TurnoService.GetRangoAsync(start, end, null, userProfile?.VeterinarioId);
                var taskKpi = DashboardService.GetKpisAsync(effectiveSucursal);
                var taskMonitor = DashboardService.GetAlertasDashboardAsync(effectiveSucursal);
                var taskEspecies = DashboardService.GetPacientesPorEspecieAsync(fechaDesdeEspecie, fechaHastaEspecie, effectiveSucursal);

                await Task.WhenAll(taskTurnos, taskKpi, taskMonitor, taskEspecies);

                misTurnosHoy = taskTurnos.Result ?? new List<TurnoDto>();
                kpis = taskKpi.Result;
                monitor = taskMonitor.Result;
                pacientesPorEspecieData = taskEspecies.Result;
            }
            else // Admin, Gerente, etc.
            {
                var taskKpi = DashboardService.GetKpisAsync(effectiveSucursal);
                var taskMonitor = DashboardService.GetAlertasDashboardAsync(effectiveSucursal);
                var taskChart = DashboardService.GetIngresosDiariosAsync(7, effectiveSucursal);
                var taskEspecies = DashboardService.GetPacientesPorEspecieAsync(fechaDesdeEspecie, fechaHastaEspecie, effectiveSucursal);

                await Task.WhenAll(taskKpi, taskMonitor, taskChart, taskEspecies);

                kpis = taskKpi.Result;
                monitor = taskMonitor.Result;
                ingresos = taskChart.Result;
                pacientesPorEspecieData = taskEspecies.Result;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[HOME INITIALIZE ERROR] {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task FiltrarPacientesPorEspecie()
    {
        isLoadingEspecies = true;
        StateHasChanged();
        try
        {
            pacientesPorEspecieData = await DashboardService.GetPacientesPorEspecieAsync(fechaDesdeEspecie, fechaHastaEspecie, currentSucursalId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR FILTER ESPECIES] {ex.Message}");
        }
        finally
        {
            isLoadingEspecies = false;
            StateHasChanged();
        }
    }

    private async Task ResetFiltroEspecies()
    {
        fechaDesdeEspecie = null;
        fechaHastaEspecie = null;
        await FiltrarPacientesPorEspecie();
    }

    private void OnAlertaClick(AlertaDto alerta)
    {
        if (alerta.Tipo == "Stock")
        {
            Navigation.NavigateTo($"/inventario/productos?productoId={alerta.EntidadId}");
        }
        else if (alerta.Tipo == "Turno")
        {
            Navigation.NavigateTo($"/agenda?turnoId={alerta.EntidadId}");
        }
        else if (alerta.Tipo == "Vacunación")
        {
            Navigation.NavigateTo($"/historial-clinico/paciente/{alerta.EntidadId}?tab=vacunas");
        }
    }
}
