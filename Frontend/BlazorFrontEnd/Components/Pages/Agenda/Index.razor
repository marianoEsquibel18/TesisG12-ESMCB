@using System.Globalization

@code {
    [Inject] private Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    [Parameter]
    [SupplyParameterFromQuery(Name = "turnoId")]
    public string? QueryTurnoId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "nuevo")]
    public bool? QueryNuevo { get; set; }

    private bool isGerente = false;
    private string currentView = "Lista";
    private DateTime currentReferenceDate = DateTime.Today;
    private PaginatedList<TurnoDto>? turnosResponse;
    private List<TurnoDto> turnosRender = new();
    private List<VeterinarioDto> veterinariosList = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private int currentPage = 1;
    private int pageSize = 15;
    private string searchMascota = "";
    private string filterVeterinarioId = "";

    // ── Modal Turno ──
    private bool showTurnoModal;
    private bool isLoadingTurnoModal;
    private TurnoDto turnoModel = new();
    private DateTime? turnoModelOriginalFechaHora;
    private bool isSavingTurno;
    private string turnoErrorMessage = string.Empty;
    private string turnoFechaError = string.Empty;
    private List<PacienteDto> modalPacientes = new();
    private List<VeterinarioDto> modalVeterinarios = new();
    private List<ServicioDto> modalServicios = new();
    private List<Adjunto> turnoFilesList = new();

    // ── Modal Paciente (anidado) ──
    private bool showPacienteModal;
    private bool isLoadingPacienteModal;
    private PacienteDto pacienteModel = new();
    private bool isSavingPaciente;
    private string pacienteErrorMessage = string.Empty;
    private string pacienteFechaError = string.Empty;
    private string pacienteTipoIngresoFecha = "fecha";
    private int pacienteEdadAniosInput = 0;
    private int pacienteEdadMesesInput = 0;
    private int pacienteEdadDiasInput = 0;
    private List<PropietarioDto> modalPropietarios = new();
    private List<EspecieDto> modalEspecies = new();
    private List<RazaDto> modalRazas = new();

    // ── Modal Cliente (anidado x2) ──
    private bool showClienteModal;
    private PropietarioDto clienteModel = new();
    private bool isSavingCliente;
    private string clienteErrorMessage = string.Empty;

    // ── Modal Especie (anidado x2) ──
    private bool showEspecieModal;
    private EspecieDto especieModel = new();
    private bool isSavingEspecie;
    private string especieErrorMessage = string.Empty;

    // ── Modal Raza (anidado x2) ──
    private bool showRazaModal;
    private RazaDto razaModel = new();
    private bool isSavingRaza;
    private string razaErrorMessage = string.Empty;

    // ── Previsualización de Notificaciones Automáticas ──
    private bool showNotificationSuccessModal;
    private TurnoDto? notificationTurnoRef;
    private string notificationEmailTo = "";
    private string notificationEmailSubject = "";
    private string notificationEmailBody = "";
    private string notificationWhatsAppTo = "";
    private string notificationWhatsAppBody = "";
    private string notificationGoogleCalendarUrl = "";
    private string notificationMailtoUrl = "";
    private string notificationWhatsAppUrl = "";
    private bool isSurgeryTurn = false;

    // ── Modal Detalle Turno ──
    private bool showDetailModal;
    private TurnoDto? selectedDetailTurno;

    protected override async Task OnInitializedAsync()
    {
        TokenStorage.OnContextChanged += HandleContextChanged;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isGerente = user.IsInRole("Gerente");

        await LoadVeterinariosAsync();
        await LoadDataAsync();
    }

    private async void HandleContextChanged()
    {
        await InvokeAsync(async () =>
        {
            currentPage = 1;
            filterVeterinarioId = "";
            await LoadVeterinariosAsync();
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TokenStorage.OnContextChanged -= HandleContextChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(QueryTurnoId))
        {
            try
            {
                var t = await TurnoService.GetByIdAsync(QueryTurnoId);
                if (t != null)
                {
                    await OpenDetailModal(t);
                }
            }
            catch (Exception)
            {
            }
        }
        if (QueryNuevo == true)
        {
            await OpenTurnoModal();
        }
    }

    private async Task LoadVeterinariosAsync()
    {
        var paginateVets = await VeterinarioService.GetAllAsync(true);
        if (paginateVets?.Items != null)
        {
            veterinariosList = paginateVets.Items
                .Where(v => v.Activo && (!TokenStorage.ActiveSucursalId.HasValue || v.SucursalId == TokenStorage.ActiveSucursalId.Value))
                .ToList();
        }
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || searchMascota.Length >= 3 || searchMascota.Length == 0)
        { currentPage = 1; await LoadDataAsync(); }
    }

    private async Task OnVeterinarioChanged(ChangeEventArgs e)
    { filterVeterinarioId = e.Value?.ToString() ?? ""; currentPage = 1; await LoadDataAsync(); }

    private async Task ClearFilters()
    { searchMascota = ""; filterVeterinarioId = ""; currentPage = 1; await LoadDataAsync(); }

    private async Task ChangeView(string viewName)
    { currentView = viewName; currentReferenceDate = DateTime.Today; await LoadDataAsync(); }

    private async Task LoadDataAsync()
    {
        isLoading = true; errorMessage = string.Empty;
        try
        {
            if (currentView == "Lista")
            { turnosResponse = await TurnoService.GetAllAsync(currentPage, pageSize, searchMascota, filterVeterinarioId); turnosRender.Clear(); }
            else
            {
                DateTime inicio, fin;
                if (currentView == "Diaria") { inicio = currentReferenceDate.Date; fin = inicio.AddDays(1).AddSeconds(-1); }
                else if (currentView == "Semanal") { int diff = (7 + (currentReferenceDate.DayOfWeek - DayOfWeek.Monday)) % 7; inicio = currentReferenceDate.AddDays(-1 * diff).Date; fin = inicio.AddDays(7).AddSeconds(-1); }
                else { inicio = new DateTime(currentReferenceDate.Year, currentReferenceDate.Month, 1).AddDays(-7); fin = new DateTime(currentReferenceDate.Year, currentReferenceDate.Month, DateTime.DaysInMonth(currentReferenceDate.Year, currentReferenceDate.Month)).AddDays(7); }
                var RangoQuery = await TurnoService.GetRangoAsync(inicio, fin, searchMascota, filterVeterinarioId);
                turnosRender = RangoQuery ?? new List<TurnoDto>();
            }
        }
        catch (Exception) { errorMessage = "Error de conexión al cargar la agenda."; }
        finally { isLoading = false; }
    }

    private async Task NavigatePrevious()
    {
        if (currentView == "Diaria") currentReferenceDate = currentReferenceDate.AddDays(-1);
        else if (currentView == "Semanal") currentReferenceDate = currentReferenceDate.AddDays(-7);
        else if (currentView == "Mensual") currentReferenceDate = currentReferenceDate.AddMonths(-1);
        await LoadDataAsync();
    }

    private async Task NavigateNext()
    {
        if (currentView == "Diaria") currentReferenceDate = currentReferenceDate.AddDays(1);
        else if (currentView == "Semanal") currentReferenceDate = currentReferenceDate.AddDays(7);
        else if (currentView == "Mensual") currentReferenceDate = currentReferenceDate.AddMonths(1);
        await LoadDataAsync();
    }

    private string GetPeriodLabel()
    {
        var ci = new CultureInfo("es-ES");
        if (currentView == "Diaria") return currentReferenceDate.ToString("dd MMMM yyyy", ci);
        if (currentView == "Semanal") { int diff = (7 + (currentReferenceDate.DayOfWeek - DayOfWeek.Monday)) % 7; var inicio = currentReferenceDate.AddDays(-1 * diff); var fin = inicio.AddDays(6); return $"{inicio.ToString("dd MMM", ci)} - {fin.ToString("dd MMM yyyy", ci)}"; }
        if (currentView == "Mensual") return currentReferenceDate.ToString("MMMM yyyy", ci).ToUpper();
        return "";
    }

    private string GetBadgeColor(string estado) => estado switch
    {
        "Programado" => "bg-primary text-white",
        "Completado" => "bg-success text-white",
        "Ausente" => "bg-danger text-white",
        "Cancelado" => "bg-purple text-white",
        "Reprogramado" => "bg-warning text-dark",
        _ => "bg-secondary text-white"
    };

    private async Task PreviousPage() { if (turnosResponse?.HasPreviousPage == true) { currentPage--; await LoadDataAsync(); } }
    private async Task NextPage() { if (turnosResponse?.HasNextPage == true) { currentPage++; await LoadDataAsync(); } }
    private void NavigateToEdit(string id)
    {
        if (isGerente) return;
        Navigation.NavigateTo($"/agenda/editar/{id}");
    }

    private async Task ConfirmCancel(string id)
    {
        var result = await TurnoService.ChangeStatusAsync(id, "Cancelado");
        if (result) await LoadDataAsync();
        else errorMessage = "No se pudo cancelar el turno.";
    }

    // ══════ MODAL TURNO ══════
    private async Task OpenTurnoModal()
    {
        turnoModel = new TurnoDto(); turnoErrorMessage = string.Empty; isSavingTurno = false;
        turnoFilesList = new List<Adjunto>();
        isLoadingTurnoModal = true; showTurnoModal = true;
        try
        {
            var resP = await PacienteService.GetAllAsync(1, 1000, ""); if (resP != null) modalPacientes = resP.Items;
            var resV = await PersonalService.GetVeterinariosActivosAsync();
            if (resV != null)
            {
                modalVeterinarios = resV
                    .Where(v => !TokenStorage.ActiveSucursalId.HasValue || v.SucursalId == TokenStorage.ActiveSucursalId.Value)
                    .ToList();
            }
            var resS = await ServiciosService.GetServiciosActivosAsync(); if (resS != null) modalServicios = resS;
        }
        catch { turnoErrorMessage = "Error al cargar datos."; }
        finally { isLoadingTurnoModal = false; }
    }

    private void CloseTurnoModal() => showTurnoModal = false;

    private VeterinarioDto? selectedVetForModal =>
        modalVeterinarios?.FirstOrDefault(v => v.Id == turnoModel.VeterinarioId);

    private string GetDiaNombre(int dia) => dia switch
    {
        1 => "Lunes",
        2 => "Martes",
        3 => "Miércoles",
        4 => "Jueves",
        5 => "Viernes",
        6 => "Sábado",
        7 => "Domingo",
        _ => ""
    };

    private string FormatHorarioText(HorarioDto h)
    {
        string inicioStr = h.HoraInicio;
        string finStr = h.HoraFin;

        if (TimeSpan.TryParse(h.HoraInicio, out var tsStart))
        {
            var dtStart = DateTime.Today.Add(tsStart);
            inicioStr = dtStart.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture).ToLower();
        }

        if (TimeSpan.TryParse(h.HoraFin, out var tsEnd))
        {
            var dtEnd = DateTime.Today.Add(tsEnd);
            finStr = dtEnd.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture).ToLower();
        }

        bool isGuardia = h.TipoHorarioId == 2 || string.Equals(h.TipoHorarioNombre, "Guardia", StringComparison.OrdinalIgnoreCase);
        string tipoStr = isGuardia ? "Turno guardia" : "Turno normal";

        return $"{inicioStr} a {finStr} | {tipoStr}";
    }

    private async Task HandleSaveTurno()
    {
        isSavingTurno = true; turnoErrorMessage = string.Empty; turnoFechaError = string.Empty;

        // Validación custom: los turnos se deben agendar con al menos 30 minutos de anticipación
        if (string.IsNullOrEmpty(turnoModel.Id) && turnoModel.FechaHora < DateTime.Now.AddMinutes(30))
        {
            turnoFechaError = "Los turnos deben agendarse con al menos 30 minutos de anticipación.";
            isSavingTurno = false;
            return;
        }

        // Si se cambia la fecha de un turno existente y no se especificó un estado de cierre/ausente, se marca como Reprogramado
        if (!string.IsNullOrEmpty(turnoModel.Id) && turnoModelOriginalFechaHora.HasValue && turnoModelOriginalFechaHora.Value != turnoModel.FechaHora && turnoModel.Estado != "Completado" && turnoModel.Estado != "Cancelado" && turnoModel.Estado != "Ausente")
        {
            turnoModel.Estado = "Reprogramado";
        }

        try
        {
            turnoModel.ArchivosAdjuntos = System.Text.Json.JsonSerializer.Serialize(turnoFilesList);

            bool result;
            string serverMsg = string.Empty;
            TurnoDto? savedTurno = null;
            bool isNew = string.IsNullOrEmpty(turnoModel.Id);

            if (isNew)
            {
                var createRes = await TurnoService.CreateWithResultAsync(turnoModel);
                result = createRes.Success;
                serverMsg = createRes.ErrorMessage;
                if (result)
                {
                    savedTurno = new TurnoDto
                    {
                        Id = turnoModel.Id,
                        PacienteId = turnoModel.PacienteId,
                        PacienteNombre = modalPacientes.FirstOrDefault(p => p.Id == turnoModel.PacienteId)?.Nombre ?? "Paciente",
                        VeterinarioId = turnoModel.VeterinarioId,
                        VeterinarioNombre = modalVeterinarios.FirstOrDefault(v => v.Id == turnoModel.VeterinarioId)?.NombreCompleto ?? "Veterinario",
                        ServicioId = turnoModel.ServicioId,
                        ServicioNombre = modalServicios.FirstOrDefault(s => s.Id == turnoModel.ServicioId)?.Nombre ?? "Servicio",
                        FechaHora = turnoModel.FechaHora,
                        DuracionMinutos = turnoModel.DuracionMinutos > 0 ? turnoModel.DuracionMinutos : (modalServicios.FirstOrDefault(s => s.Id == turnoModel.ServicioId)?.DuracionMinutos ?? 30),
                        Motivo = turnoModel.Motivo,
                        Observaciones = turnoModel.Observaciones,
                        Estado = turnoModel.Estado,
                        ArchivosAdjuntos = turnoModel.ArchivosAdjuntos
                    };
                }
            }
            else
            {
                var resUpdate = await TurnoService.UpdateWithResultAsync(turnoModel.Id, turnoModel);
                result = resUpdate.Success;
                serverMsg = resUpdate.ErrorMessage;
                if (result)
                {
                    savedTurno = new TurnoDto
                    {
                        Id = turnoModel.Id,
                        PacienteId = turnoModel.PacienteId,
                        PacienteNombre = modalPacientes.FirstOrDefault(p => p.Id == turnoModel.PacienteId)?.Nombre ?? "Paciente",
                        VeterinarioId = turnoModel.VeterinarioId,
                        VeterinarioNombre = modalVeterinarios.FirstOrDefault(v => v.Id == turnoModel.VeterinarioId)?.NombreCompleto ?? "Veterinario",
                        ServicioId = turnoModel.ServicioId,
                        ServicioNombre = modalServicios.FirstOrDefault(s => s.Id == turnoModel.ServicioId)?.Nombre ?? "Servicio",
                        FechaHora = turnoModel.FechaHora,
                        DuracionMinutos = turnoModel.DuracionMinutos > 0 ? turnoModel.DuracionMinutos : (modalServicios.FirstOrDefault(s => s.Id == turnoModel.ServicioId)?.DuracionMinutos ?? 30),
                        Motivo = turnoModel.Motivo,
                        Observaciones = turnoModel.Observaciones,
                        Estado = turnoModel.Estado,
                        ArchivosAdjuntos = turnoModel.ArchivosAdjuntos
                    };
                }
            }
            
            if (result) 
            { 
                showTurnoModal = false; 
                await LoadDataAsync(); 
                if (savedTurno != null && isNew)
                {
                    await PrepareNotificationPreview(savedTurno);
                }
                else if (savedTurno != null && savedTurno.Estado == "Completado")
                {
                    Navigation.NavigateTo($"/ventas/pos?servicioId={savedTurno.ServicioId}&pacienteId={savedTurno.PacienteId}&turnoId={savedTurno.Id}");
                }
            }
            else turnoErrorMessage = !string.IsNullOrEmpty(serverMsg) ? serverMsg : "Ya hay un turno registrado en la fecha/hora ingresada para el mismo veterinario o error de guardado.";
        }
        catch (Exception) { turnoErrorMessage = "Excepción al enviar datos del turno."; }
        finally { isSavingTurno = false; }
    }

