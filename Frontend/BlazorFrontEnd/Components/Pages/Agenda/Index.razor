                            <p class="mb-1"><strong>Destinatario:</strong> @(string.IsNullOrEmpty(notificationEmailTo) ? "Sin registrar" : notificationEmailTo)</p>
                            <p class="mb-2"><strong>Asunto:</strong> @notificationEmailSubject</p>
                            <div class="p-2 rounded mb-3 bg-dark" style="max-height: 120px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.05); font-family: monospace; white-space: pre-wrap; font-size: 0.75rem;">
                                @notificationEmailBody
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-auto">
                            @if (!string.IsNullOrEmpty(notificationEmailTo))
                            {
                                <a href="@notificationMailtoUrl" target="_blank" onclick="window.open(this.href, '_blank'); return false;" class="btn btn-sm btn-primary-glass flex-grow-1 text-center" style="font-size: 0.8rem; display: flex; align-items: center; justify-content: center; gap: 4px;">
                                    Enviar Email
                                </a>
                            }
                            <a href="@notificationGoogleCalendarUrl" target="_blank" class="btn btn-sm btn-outline-info flex-grow-1 text-center" style="font-size: 0.8rem; display: flex; align-items: center; justify-content: center; gap: 4px; border-color: rgba(96,165,250,0.3); color: #60a5fa;">
                                Google Cal
                            </a>
                        </div>
                    </div>
                </div>

                @* CARD: WHATSAPP DE RECORDATORIO *@
                <div class="col-md-6">
                    <div class="p-3 h-100 rounded d-flex flex-column" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-glass);">
                        <div class="d-flex align-items-center gap-2 mb-3">
