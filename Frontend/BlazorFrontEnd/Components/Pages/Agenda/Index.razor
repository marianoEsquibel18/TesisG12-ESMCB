    private async Task HandleSavePaciente()
    {
        isSavingPaciente = true; pacienteErrorMessage = string.Empty; pacienteFechaError = string.Empty;

        // Validación custom: fecha de nacimiento no puede ser futura
        if (pacienteModel.FechaNacimiento.HasValue && pacienteModel.FechaNacimiento.Value.Date > DateTime.Today)
        {
            pacienteFechaError = "La fecha ingresada es inválida (Es una fecha futura)";
            isSavingPaciente = false;
            return;
        }

        try
        {
            var result = await PacienteService.CreateAsync(pacienteModel);
            if (result.Success)
            {
                var resP = await PacienteService.GetAllAsync(1, 1000, ""); if (resP != null) modalPacientes = resP.Items;
                var nuevo = modalPacientes.FirstOrDefault(p => p.Nombre == pacienteModel.Nombre && p.PropietarioId == pacienteModel.PropietarioId);
                if (nuevo != null) turnoModel.PacienteId = nuevo.Id;
                showPacienteModal = false;
            }
            else pacienteErrorMessage = $"Error al guardar: {result.ErrorMessage}";
        }
        catch (Exception) { pacienteErrorMessage = "Excepción al guardar."; }
        finally { isSavingPaciente = false; }
    }

