    // ── Previsualización de Notificaciones ──
    private async Task PrepareNotificationPreview(TurnoDto turno)
    {
        notificationTurnoRef = turno;
        showNotificationSuccessModal = false;
        
        try
        {
            var pac = await PacienteService.GetByIdAsync(turno.PacienteId);
            if (pac == null) return;

            var prop = await PropietarioService.GetByIdAsync(pac.PropietarioId);
            if (prop == null) return;

            bool isCirugia = false;
            if (!string.IsNullOrEmpty(turno.Motivo) && (turno.Motivo.Contains("cirugia", StringComparison.OrdinalIgnoreCase) || turno.Motivo.Contains("cirugía", StringComparison.OrdinalIgnoreCase) || turno.Motivo.Contains("operacion", StringComparison.OrdinalIgnoreCase) || turno.Motivo.Contains("operación", StringComparison.OrdinalIgnoreCase)))
            {
                isCirugia = true;
            }
            if (!string.IsNullOrEmpty(turno.ServicioNombre) && (turno.ServicioNombre.Contains("cirugia", StringComparison.OrdinalIgnoreCase) || turno.ServicioNombre.Contains("cirugía", StringComparison.OrdinalIgnoreCase)))
            {
                isCirugia = true;
            }
            isSurgeryTurn = isCirugia;

            notificationEmailTo = prop.Email;
            notificationEmailSubject = $"Confirmación de Turno - Veterinaria";
            
            int duracion = turno.DuracionMinutos > 0 ? turno.DuracionMinutos : 30;
            var startUtc = turno.FechaHora.ToUniversalTime();
            var endUtc = startUtc.AddMinutes(duracion);
            
            var gCalText = Uri.EscapeDataString($"Turno Veterinaria - Mascota: {pac.Nombre}");
            var gCalDates = $"{startUtc:yyyyMMddTHHmmssZ}/{endUtc:yyyyMMddTHHmmssZ}";
            var gCalDetails = Uri.EscapeDataString($"Turno agendado para {pac.Nombre} con el veterinario {turno.VeterinarioNombre}. Servicio: {turno.ServicioNombre}. Motivo: {turno.Motivo}");
            notificationGoogleCalendarUrl = $"https://calendar.google.com/calendar/render?action=TEMPLATE&text={gCalText}&dates={gCalDates}&details={gCalDetails}";

            notificationEmailBody = $"Hola {prop.NombreCompleto},\n\nTe confirmamos que se ha agendado un turno para tu mascota {pac.Nombre} el día {turno.FechaHora:dd/MM/yyyy} a las {turno.FechaHora:HH:mm} hs.\n\nVeterinario: {turno.VeterinarioNombre}\nServicio: {turno.ServicioNombre}\nMotivo: {turno.Motivo}\n\nPara añadir este turno a tu Google Calendar, haz clic en el siguiente enlace:\n{notificationGoogleCalendarUrl}\n\nSaludos,\nEl equipo de la Veterinaria.";

            notificationMailtoUrl = $"mailto:{prop.Email}?subject={Uri.EscapeDataString(notificationEmailSubject)}&body={Uri.EscapeDataString(notificationEmailBody)}";

            notificationWhatsAppTo = prop.Telefono;
            var wsText = $"Hola {prop.NombreCompleto}, te recordamos que mañana {turno.FechaHora:dd/MM/yyyy} a las {turno.FechaHora:HH:mm} hs tienes un turno programado para {pac.Nombre} con el veterinario {turno.VeterinarioNombre}.";
            
            if (isCirugia)
            {
                wsText += "\n\n⚠️ INDICACIONES IMPORTANTES DE CIRUGÍA: Por favor, recuerde que el animal debe realizar un ayuno total de sólidos y líquidos (sin comida ni agua) durante las 24 horas previas al turno.";
            }
            
            notificationWhatsAppBody = wsText;
            
            var cleanPhone = new string(prop.Telefono.Where(char.IsDigit).ToArray());
            notificationWhatsAppUrl = $"https://wa.me/{cleanPhone}?text={Uri.EscapeDataString(wsText)}";
            
            notificationTwilioResultMsg = null;
            showNotificationSuccessModal = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al preparar notificaciones: {ex.Message}");
        }
    }

