                else
                {
                    detailModalMessage = "¡Cambios guardados con éxito!";
                    await Task.Delay(600);
                    showDetailModal = false;
                }
            }
            else
            {
                detailModalMessage = $"Error al guardar: {res.ErrorMessage}";
            }
        }
        catch (Exception ex)
        {
            detailModalMessage = $"Excepción al guardar: {ex.Message}";
        }
        finally
        {
            isSavingDetailModal = false;
        }
    }

    private void CloseDetailModal()
    {
        showDetailModal = false;
        selectedDetailTurno = null;
        if (!string.IsNullOrEmpty(QueryTurnoId))
        {
            QueryTurnoId = null;
            Navigation.NavigateTo("/agenda");
        }
    }

    private async Task NavigateFromDetailToEdit(string id)
    {
        await OpenTurnoModalForEdit(id);
    }

    private async Task OpenTurnoModalForEdit(string id)
    {
        showDetailModal = false;
        turnoModel = new TurnoDto(); turnoErrorMessage = string.Empty; isSavingTurno = false;
        turnoModelOriginalFechaHora = null;
        isLoadingTurnoModal = true; showTurnoModal = true;
        try
        {
            var resP = await PacienteService.GetAllAsync(1, 1000, ""); if (resP != null) modalPacientes = resP.Items;
            var resV = await PersonalService.GetVeterinariosActivosAsync(); if (resV != null) modalVeterinarios = resV;
            var resS = await ServiciosService.GetServiciosActivosAsync(); if (resS != null) modalServicios = resS;

            var existing = await TurnoService.GetByIdAsync(id);
            if (existing != null)
            {
                turnoModel = existing;
                turnoModelOriginalFechaHora = existing.FechaHora;
                try
                {
                    turnoFilesList = string.IsNullOrEmpty(turnoModel.ArchivosAdjuntos)
                        ? new List<Adjunto>()
                        : System.Text.Json.JsonSerializer.Deserialize<List<Adjunto>>(turnoModel.ArchivosAdjuntos) ?? new List<Adjunto>();
                }
                catch
                {
                    turnoFilesList = new List<Adjunto>();
                }
            }
            else
            {
                turnoErrorMessage = "No se encontró el turno a editar.";
            }
        }
        catch { turnoErrorMessage = "Error al cargar datos del turno."; }
        finally { isLoadingTurnoModal = false; }
    }

