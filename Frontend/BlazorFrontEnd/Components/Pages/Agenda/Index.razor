    private void OnPacienteTipoIngresoFechaChanged(ChangeEventArgs e)
    {
        pacienteTipoIngresoFecha = e.Value?.ToString() ?? "fecha";
        if (pacienteTipoIngresoFecha == "edad")
        {
            if (pacienteModel.FechaNacimiento.HasValue)
            {
                CalcularPacienteEdadDesdeFecha();
            }
            else
            {
                CalcularPacienteFechaDesdeEdad();
            }
        }
        else
        {
            CalcularPacienteFechaDesdeEdad();
        }
    }

    private void OnPacienteFechaNacimientoChanged(DateTime? val)
    {
        pacienteModel.FechaNacimiento = val;
        pacienteFechaError = string.Empty;
        CalcularPacienteEdadDesdeFecha();
    }

    private void OnPacienteEdadAniosInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
            pacienteEdadAniosInput = Math.Max(0, val);
        else
            pacienteEdadAniosInput = 0;
        CalcularPacienteFechaDesdeEdad();
    }

    private void OnPacienteEdadMesesInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
            pacienteEdadMesesInput = Math.Max(0, val);
        else
            pacienteEdadMesesInput = 0;
        CalcularPacienteFechaDesdeEdad();
    }

    private void OnPacienteEdadDiasInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
            pacienteEdadDiasInput = Math.Max(0, val);
        else
            pacienteEdadDiasInput = 0;
        CalcularPacienteFechaDesdeEdad();
    }

    private void CalcularPacienteFechaDesdeEdad()
    {
        pacienteFechaError = string.Empty;
        pacienteModel.FechaNacimiento = DateTime.Today
            .AddYears(-pacienteEdadAniosInput)
            .AddMonths(-pacienteEdadMesesInput)
            .AddDays(-pacienteEdadDiasInput);
    }

    private void CalcularPacienteEdadDesdeFecha()
    {
        if (!pacienteModel.FechaNacimiento.HasValue)
        {
            pacienteEdadAniosInput = 0;
            pacienteEdadMesesInput = 0;
            pacienteEdadDiasInput = 0;
            return;
        }

        var hoy = DateTime.Today;
        var nac = pacienteModel.FechaNacimiento.Value.Date;

        if (nac > hoy)
        {
            pacienteEdadAniosInput = 0;
            pacienteEdadMesesInput = 0;
            pacienteEdadDiasInput = 0;
            return;
        }

        int a = hoy.Year - nac.Year;
        int m = hoy.Month - nac.Month;
        int d = hoy.Day - nac.Day;

        if (d < 0)
        {
            m--;
            var prevMonth = hoy.AddMonths(-1);
            d += DateTime.DaysInMonth(prevMonth.Year, prevMonth.Month);
        }
        if (m < 0)
        {
            a--;
            m += 12;
        }

        pacienteEdadAniosInput = Math.Max(0, a);
        pacienteEdadMesesInput = Math.Max(0, m);
        pacienteEdadDiasInput = Math.Max(0, d);
    }

