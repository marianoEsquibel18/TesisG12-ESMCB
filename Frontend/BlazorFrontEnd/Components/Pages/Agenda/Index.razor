    private string FormatWhatsApp(string telefono)
    {
        if (string.IsNullOrEmpty(telefono)) return string.Empty;
        var clean = new string(telefono.Where(char.IsDigit).ToArray());
        return clean;
    }

    private async Task IrAAgendaDiaria(DateTime fecha)
    {
        currentView = "Diaria";
        currentReferenceDate = fecha;
        await LoadDataAsync();
    }

    private async Task UploadTurnoFiles(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(10))
        {
            try
            {
                var maxAllowedSize = 5 * 1024 * 1024;
                using var stream = file.OpenReadStream(maxAllowedSize);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                
                turnoFilesList.Add(new Adjunto
                {
                    Nombre = file.Name,
                    Base64 = base64,
                    ContentType = file.ContentType
                });
            }
            catch (Exception ex)
            {
                turnoErrorMessage = $"Error al cargar archivo {file.Name}: {ex.Message}";
            }
        }
    }

    private void RemoveTurnoFile(Adjunto file)
    {
        turnoFilesList.Remove(file);
    }

    private async Task PreviewFile(Adjunto file)
    {
        try
        {
            await JS.InvokeVoidAsync("openBase64File", file.Base64, file.Nombre, file.ContentType);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al abrir archivo: {ex.Message}");
        }
    }
