                                @notificationWhatsAppBody
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(notificationTwilioResultMsg))
                        {
                            <div class="alert @(notificationTwilioSuccess ? "alert-success" : "alert-danger") p-2 small mb-2 text-center" style="font-size: 0.78rem;">
