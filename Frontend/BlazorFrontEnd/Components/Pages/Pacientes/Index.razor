                selectedAdminEspecie = adminEspeciesList.FirstOrDefault(e => e.Id == selectEspecieId.Value);
            }
            else if (selectedAdminEspecie != null)
            {
                selectedAdminEspecie = adminEspeciesList.FirstOrDefault(e => e.Id == selectedAdminEspecie.Id);
            }

            if (selectedAdminEspecie != null)
            {
                await LoadAdminRazasAsync(selectedAdminEspecie.Id);
            }
            else if (adminEspeciesList.Any())
            {
                await SelectAdminEspecie(adminEspeciesList.First());
            }
            else
            {
                adminRazasList.Clear();
            }
        }
        catch (Exception ex)
