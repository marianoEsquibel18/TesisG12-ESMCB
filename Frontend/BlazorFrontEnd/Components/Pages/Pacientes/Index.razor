@* ═══════ MODAL PRINCIPAL: Gestión de Especies y Razas ═══════ *@
@if (showEspeciesRazasModal)
{
    <div class="modal-overlay modal-overlay-z1" @onclick="CloseEspeciesRazasModal" @onclick:stopPropagation="false">
        <div class="modal-panel" style="max-width: 960px; max-height: 88vh; display: flex; flex-direction: column;" @onclick:stopPropagation="true">
            <div class="modal-header-row" style="margin-bottom: 0.85rem; padding-bottom: 0.75rem;">
                <div class="d-flex align-items-center gap-2">
                    <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(0, 163, 108, 0.15); display: flex; align-items: center; justify-content: center; color: var(--accent-primary);">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 20px; height: 20px;">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
                        </svg>
                    </div>
                    <div>
                        <h3 style="margin: 0; font-size: 1.25rem;">Gestión de Especies y Razas</h3>
                        <p class="text-secondary" style="margin: 0; font-size: 0.82rem;">Administra el catálogo de especies y sus razas asociadas</p>
                    </div>
                </div>
                <button class="modal-close-btn" @onclick="CloseEspeciesRazasModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(especiesRazasGeneralMessage))
            {
                <div class="alert alert-info py-2 px-3 mb-3 d-flex justify-content-between align-items-center" style="font-size: 0.875rem;">
                    <span>@especiesRazasGeneralMessage</span>
                    <button type="button" class="btn-close" style="font-size: 0.75rem;" @onclick='() => especiesRazasGeneralMessage = string.Empty'></button>
                </div>
            }

            <div class="row g-3" style="flex: 1; min-height: 0;">
                @* ──── COLUMNA 1: ESPECIES ──── *@
                <div class="col-md-5 d-flex flex-column" style="border-right: 1px solid var(--border-light); padding-right: 15px;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold" style="color: var(--text-primary); font-size: 0.95rem;">Especies</span>
                            <span class="badge bg-light text-dark border" style="font-size: 0.75rem;">@(adminEspeciesList?.Count ?? 0)</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-success d-flex align-items-center gap-1" style="font-size: 0.8rem; padding: 4px 10px;" @onclick="OpenCreateEspecieModal">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 14px; height: 14px;">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                            </svg>
                            Nueva Especie
                        </button>
                    </div>

                    <div style="margin-bottom: 8px;">
                        <input type="text" @bind-value="searchEspecieFilter" @bind-value:event="oninput" class="form-control form-control-sm" placeholder="Buscar especie..." style="font-size: 0.82rem;" />
                    </div>

                    <div class="d-flex flex-column gap-2" style="overflow-y: auto; max-height: 48vh; padding-right: 4px;">
                        @if (isLoadingAdminEspecies)
                        {
                            <div class="text-center py-4 text-secondary" style="font-size: 0.85rem;">Cargando especies...</div>
                        }
                        else if (FilteredAdminEspecies == null || !FilteredAdminEspecies.Any())
                        {
                            <div class="text-center py-4 text-secondary" style="font-size: 0.85rem;">
                                No se encontraron especies cargadas.
                            </div>
                        }
                        else
                        {
                            @foreach (var esp in FilteredAdminEspecies)
                            {
                                var isSel = selectedAdminEspecie?.Id == esp.Id;
                                <div class="p-2 rounded d-flex justify-content-between align-items-center"
                                     style="cursor: pointer; border: 1.5px solid @(isSel ? "var(--accent-primary)" : "var(--border-light)"); background: @(isSel ? "rgba(0, 163, 108, 0.08)" : "var(--bg-main)"); transition: all 0.15s ease;"
                                     @onclick="() => SelectAdminEspecie(esp)">
                                    <div class="d-flex align-items-center gap-2" style="min-width: 0;">
                                        <div style="font-size: 1.25rem;">@GetEspecieEmoji(esp.Nombre)</div>
                                        <div style="min-width: 0;">
                                            <div class="fw-bold text-truncate" style="font-size: 0.88rem; color: var(--text-primary);">
                                                @esp.Nombre
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(esp.Descripcion))
                                            {
                                                <div class="text-secondary text-truncate" style="font-size: 0.75rem; max-width: 170px;">
                                                    @esp.Descripcion
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-1" @onclick:stopPropagation="true">
                                        <button type="button" class="btn btn-sm btn-link p-1" title="Editar especie" @onclick="() => OpenEditEspecieModal(esp)">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" style="width: 15px; height: 15px; color: var(--accent-primary);">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
                                            </svg>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-link p-1" title="Eliminar especie" @onclick="() => ConfirmDeleteEspecie(esp)">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" style="width: 15px; height: 15px; color: var(--accent-danger);">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                @* ──── COLUMNA 2: RAZAS ──── *@
                <div class="col-md-7 d-flex flex-column" style="padding-left: 10px;">
                    @if (selectedAdminEspecie == null)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center py-5 text-secondary">
                            <div style="font-size: 2.5rem; margin-bottom: 10px; opacity: 0.5;">🐾</div>
