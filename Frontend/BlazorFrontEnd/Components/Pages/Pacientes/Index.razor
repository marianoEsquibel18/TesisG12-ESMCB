    private async Task OnModalFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file.Size > 1_000_000) // 1MB max
            {
                pacienteErrorMessage = "La imagen no puede superar 1MB";
                return;
            }

            var buffer = new byte[file.Size];
            using var stream = file.OpenReadStream(1_000_000);
            int bytesRead = 0;
            while (bytesRead < file.Size)
            {
                int read = await stream.ReadAsync(buffer, bytesRead, (int)file.Size - bytesRead);
                if (read == 0) break;
                bytesRead += read;
            }
            var base64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
            pacienteModel.FotoUrl = base64;
            pacienteErrorMessage = string.Empty;
        }
        catch (Exception ex)
        {
            pacienteErrorMessage = $"Error al cargar la imagen: {ex.Message}";
        }
    }

