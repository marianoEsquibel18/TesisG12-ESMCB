                if (selectedAdminEspecie != null)
                {
                    await LoadAdminRazasAsync(selectedAdminEspecie.Id);
                }
                especiesRazasGeneralMessage = "Raza eliminada correctamente.";
            }
            else
            {
                especiesRazasGeneralMessage = "No se pudo eliminar la raza. Podría estar en uso.";
                CloseAdminDeleteRazaConfirm();
            }
        }
        catch (Exception ex)
        {
            especiesRazasGeneralMessage = "Error al eliminar raza: " + ex.Message;
            CloseAdminDeleteRazaConfirm();
        }
        finally
        {
            isDeletingAdminRaza = false;
        }
    }

    private string GetEspecieEmoji(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "🐾";
        var n = nombre.ToLowerInvariant();
        if (n.Contains("canin") || n.Contains("perr") || n.Contains("dog")) return "🐶";
        if (n.Contains("felin") || n.Contains("gat") || n.Contains("cat")) return "🐱";
        if (n.Contains("ave") || n.Contains("pajar") || n.Contains("loro") || n.Contains("bird")) return "🦜";
        if (n.Contains("roedor") || n.Contains("hamster") || n.Contains("conejo") || n.Contains("cuy") || n.Contains("cobayo")) return "🐰";
        if (n.Contains("reptil") || n.Contains("tortuga") || n.Contains("iguana") || n.Contains("serpiente")) return "🐢";
        if (n.Contains("pez") || n.Contains("peces") || n.Contains("fish")) return "🐠";
        if (n.Contains("equin") || n.Contains("caball") || n.Contains("horse")) return "🐴";
        return "🐾";
    }
}
