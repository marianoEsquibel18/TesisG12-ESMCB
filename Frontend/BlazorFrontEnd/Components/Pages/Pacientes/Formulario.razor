@page "/pacientes/nuevo"
@page "/pacientes/editar/{Id}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Veterinario,Recepcionista")]
@using BlazorFrontEnd.Models
@using BlazorFrontEnd.Services
@inject PacienteService PacienteService
@inject PropietarioService PropietarioService
@inject CatalogoService CatalogoService
@inject NavigationManager Navigation

<PageTitle>@(isEdit ? "Editar Paciente" : "Nuevo Paciente")</PageTitle>

<div class="d-flex align-items-center" style="margin-bottom: var(--sp-lg);">
    <button class="btn btn-link" style="color: var(--text-secondary); padding: 0; margin-right: 15px;" @onclick="GoBack">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 24px; height: 24px;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
    </button>
    <h2 style="font-weight: 700; margin: 0;">@(isEdit ? "Editar Paciente" : "Nuevo Paciente")</h2>
</div>

<div class="glass-card" style="max-width: 800px;">
    @if (isLoading)
    {
        <p class="text-secondary">Cargando información y catálogos...</p>
    }
    else
    {
        <EditForm Model="model" OnValidSubmit="HandleSave" FormName="pacienteForm">
            <DataAnnotationsValidator />
            
            <div class="row">
                <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Nombre de mascota (*)</label>
                    <InputText @bind-Value="model.Nombre" class="form-control bg-dark text-light border-secondary" />
                    <ValidationMessage For="@(() => model.Nombre)" class="text-danger" />
                </div>
                
                <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Propietario / Dueño (*)</label>
                    <div class="d-flex gap-2">
                        <InputSelect @bind-Value="model.PropietarioId" class="form-select bg-dark text-light border-secondary">
                            <option value="">-- Seleccione un Dueño --</option>
                            @foreach (var p in propietarios)
                            {
                                <option value="@p.Id">@p.NombreCompleto - @p.DNI</option>
                            }
                        </InputSelect>
                        <a href="/propietarios/nuevo" class="btn btn-outline-info d-flex align-items-center" style="white-space: nowrap; border-color: var(--border-glass); color: var(--accent-primary);" title="Registrar nuevo cliente">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                            </svg>
                            Nuevo
                        </a>
                    </div>
                    <ValidationMessage For="@(() => model.PropietarioId)" class="text-danger" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Especie (*)</label>
                    <div class="d-flex gap-2">
                        <InputSelect Value="model.EspecieId" ValueExpression="()=>model.EspecieId" ValueChanged="((int v) => OnEspecieChanged(v))" class="form-select bg-dark text-light border-secondary">
                            <option value="0">-- Seleccione Especie --</option>
                            @foreach (var e in especies)
                            {
                                <option value="@e.Id">@e.Nombre</option>
                            }
                        </InputSelect>
                        <button type="button" @onclick="OpenEspecieModal" class="btn btn-outline-info d-flex align-items-center" style="white-space: nowrap; border-color: var(--border-glass); color: var(--accent-primary);" title="Registrar nueva especie">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                            </svg>
                            Nuevo
                        </button>
                    </div>
                    <ValidationMessage For="@(() => model.EspecieId)" class="text-danger" />
                </div>
                
                <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Raza (*)</label>
                    <div class="d-flex gap-2">
                        <InputSelect @bind-Value="model.RazaId" class="form-select bg-dark text-light border-secondary" disabled="@(model.EspecieId == 0)">
                            <option value="">-- Seleccione Raza --</option>
                            @foreach (var r in razas)
                            {
                                <option value="@r.Id">@r.Nombre</option>
                            }
                        </InputSelect>
                        <button type="button" @onclick="OpenRazaModal" class="btn btn-outline-info d-flex align-items-center" style="white-space: nowrap; border-color: var(--border-glass); color: var(--accent-primary);" title="Registrar nueva raza" disabled="@(model.EspecieId == 0)">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                            </svg>
                            Nuevo
                        </button>
                    </div>
                    <ValidationMessage For="@(() => model.RazaId)" class="text-danger" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Sexo (*)</label>
                    <InputSelect @bind-Value="model.Sexo" class="form-select bg-dark text-light border-secondary">
                        <option value="">-- Sexo --</option>
                        <option value="M">Macho</option>
                        <option value="H">Hembra</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => model.Sexo)" class="text-danger" />
                </div>
                <div class="col-md-6" style="margin-bottom: var(--sp-sm);">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Modalidad de Nacimiento / Edad (*)</label>
                    <select class="form-select bg-dark text-light border-secondary" value="@tipoIngresoFecha" @onchange="OnTipoIngresoFechaChanged">
                        <option value="fecha">Fecha exacta (Día/Mes/Año)</option>
                        <option value="edad">Por edad (Años, meses y días)</option>
                    </select>
                </div>
            </div>

            @if (tipoIngresoFecha == "fecha")
            {
                <div class="row">
                    <div class="col-12" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Fecha de Nacimiento (*)</label>
                        <InputDate Value="model.FechaNacimiento" ValueExpression="() => model.FechaNacimiento" ValueChanged="((DateTime? val) => OnFechaNacimientoChanged(val))" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => model.FechaNacimiento)" class="text-danger" />
                        @if (!string.IsNullOrEmpty(fechaNacimientoError))
                        { <div class="text-danger" style="font-size: 0.8rem; margin-top: 4px;">@fechaNacimientoError</div> }
                    </div>
                </div>
            }
            else
            {
                <div class="row" style="margin-bottom: var(--sp-sm);">
                    <div class="col-12">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Edad del Paciente (*)</label>
                        <div class="row g-2">
                            <div class="col-4">
                                <div class="input-group">
                                    <input type="number" min="0" max="100" class="form-control bg-dark text-light border-secondary" placeholder="0" value="@edadAniosInput" @oninput="OnEdadAniosInput" />
                                    <span class="input-group-text bg-dark text-secondary border-secondary" style="font-size: 0.8rem;">años</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="input-group">
                                    <input type="number" min="0" max="11" class="form-control bg-dark text-light border-secondary" placeholder="0" value="@edadMesesInput" @oninput="OnEdadMesesInput" />
                                    <span class="input-group-text bg-dark text-secondary border-secondary" style="font-size: 0.8rem;">meses</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="input-group">
                                    <input type="number" min="0" max="31" class="form-control bg-dark text-light border-secondary" placeholder="0" value="@edadDiasInput" @oninput="OnEdadDiasInput" />
                                    <span class="input-group-text bg-dark text-secondary border-secondary" style="font-size: 0.8rem;">días</span>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <small class="text-secondary" style="font-size: 0.8rem;">
                                Fecha calculada: <span style="color: var(--accent-primary); font-weight: 500;">@(model.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "No calculada")</span>
                            </small>
                        </div>
                        <ValidationMessage For="@(() => model.FechaNacimiento)" class="text-danger" />
                        @if (!string.IsNullOrEmpty(fechaNacimientoError))
                        { <div class="text-danger" style="font-size: 0.8rem; margin-top: 4px;">@fechaNacimientoError</div> }
                    </div>
                </div>
            }

            <div class="row" style="margin-bottom: var(--sp-sm);">
                <div class="col-12">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Observaciones (Alergias, Condiciones previas...)</label>
                    <InputTextArea @bind-Value="model.Observaciones" class="form-control bg-dark text-light border-secondary" rows="3" />
                </div>
            </div>

            <div class="row" style="margin-bottom: var(--sp-sm);">
                <div class="col-12">
                    <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Foto de la mascota (opcional)</label>
                    <InputFile OnChange="OnFileSelected" accept="image/*" class="form-control bg-dark text-light border-secondary" style="color: var(--text-secondary); font-size: 0.875rem;" />
                    @if (!string.IsNullOrEmpty(model.FotoUrl))
                    {
                        <div style="margin-top: 10px; display: flex; align-items: center; gap: 15px;">
                            <img src="@model.FotoUrl" style="width: 100px; height: 100px; border-radius: 8px; object-fit: cover; border: 2px solid var(--accent-primary);" />
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RemovePhoto">Quitar Foto</button>
                        </div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
                    @errorMessage
                </div>
            }

            <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                <button type="button" class="btn btn-outline-secondary text-light" @onclick="GoBack">Cancelar</button>
                <button type="submit" class="btn-primary-glass" disabled="@isSaving">
                    @if(isSaving) { <span>Guardando...</span> } else { <span>Guardar Paciente</span> }
                </button>
            </div>
        </EditForm>
    }
</div>

@* ═══════ MODAL: Nueva Especie ═══════ *@
@if (showEspecieModal)
{
    <div class="modal-overlay modal-overlay-z1" @onclick="CloseEspecieModal" @onclick:stopPropagation="false">
        <div class="modal-panel modal-panel-sm" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>Nueva Especie</h3>
                <button class="modal-close-btn" @onclick="CloseEspecieModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <EditForm Model="especieModel" OnValidSubmit="HandleSaveEspecie" FormName="modalEspecieForm">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-12" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Nombre (*)</label>
                        <InputText @bind-Value="especieModel.Nombre" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => especieModel.Nombre)" class="text-danger" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-12" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Descripción</label>
                        <InputText @bind-Value="especieModel.Descripcion" class="form-control bg-dark text-light border-secondary" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(especieErrorMessage))
                {
                    <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
                        @especieErrorMessage
                    </div>
                }

                <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                    <button type="button" class="btn btn-outline-secondary text-light" @onclick="CloseEspecieModal">Cancelar</button>
                    <button type="submit" class="btn-primary-glass" disabled="@isSavingEspecie">
                        @if(isSavingEspecie) { <span>Guardando...</span> } else { <span>Guardar Especie</span> }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* ═══════ MODAL: Nueva Raza ═══════ *@
@if (showRazaModal)
{
    <div class="modal-overlay modal-overlay-z1" @onclick="CloseRazaModal" @onclick:stopPropagation="false">
        <div class="modal-panel modal-panel-sm" @onclick:stopPropagation="true">
            <div class="modal-header-row">
                <h3>Nueva Raza</h3>
                <button class="modal-close-btn" @onclick="CloseRazaModal" title="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <EditForm Model="razaModel" OnValidSubmit="HandleSaveRaza" FormName="modalRazaForm">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-12" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Especie (*)</label>
                        <InputSelect @bind-Value="razaModel.EspecieId" class="form-select bg-dark text-light border-secondary" disabled="true">
                            @foreach (var e in especies)
                            {
                                <option value="@e.Id">@e.Nombre</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Nombre (*)</label>
                        <InputText @bind-Value="razaModel.Nombre" class="form-control bg-dark text-light border-secondary" />
                        <ValidationMessage For="@(() => razaModel.Nombre)" class="text-danger" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-12" style="margin-bottom: var(--sp-sm);">
                        <label class="form-label" style="color: var(--text-secondary); font-size: 0.875rem;">Descripción</label>
                        <InputText @bind-Value="razaModel.Descripcion" class="form-control bg-dark text-light border-secondary" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(razaErrorMessage))
                {
                    <div class="alert alert-danger mt-3" style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--accent-danger); color: white;">
                        @razaErrorMessage
                    </div>
                }

                <div class="d-flex justify-content-end mt-4" style="gap: 10px;">
                    <button type="button" class="btn btn-outline-secondary text-light" @onclick="CloseRazaModal">Cancelar</button>
                    <button type="submit" class="btn-primary-glass" disabled="@isSavingRaza">
                        @if(isSavingRaza) { <span>Guardando...</span> } else { <span>Guardar Raza</span> }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (showSimilarEspeciesConfirm)
{
    <div class="modal-overlay modal-overlay-z3" style="background: rgba(0,0,0,0.85);">
        <div class="modal-panel modal-panel-sm" style="border: 1px solid var(--accent-primary);">
            <div class="modal-header-row">
                <h3>¿Quisiste decir?</h3>
            </div>
            <div style="margin-top: 15px; margin-bottom: 25px;">
                <p class="text-light">Se encontraron las siguientes especies similares cargadas en el sistema:</p>
                <ul style="color: var(--accent-primary); font-size: 1.1rem; font-weight: bold; margin-bottom: 20px;">
                    @foreach (var s in similarEspeciesList)
                    {
                        <li>@s</li>
                    }
                </ul>
                <p class="text-secondary" style="font-size: 0.9rem;">¿Deseas continuar y guardar de todos modos?</p>
            </div>
            <div class="d-flex justify-content-end" style="gap: 10px;">
                <button type="button" class="btn btn-outline-secondary text-light" @onclick="CancelEspecieSimilarity">Cancelar</button>
                <button type="button" class="btn btn-primary" style="background: var(--accent-primary); border: none;" @onclick="BypassEspecieSimilarity">Continuar y guardar</button>
            </div>
        </div>
    </div>
}

@if (showSimilarRazasConfirm)
{
    <div class="modal-overlay modal-overlay-z3" style="background: rgba(0,0,0,0.85);">
        <div class="modal-panel modal-panel-sm" style="border: 1px solid var(--accent-primary);">
            <div class="modal-header-row">
                <h3>¿Quisiste decir?</h3>
            </div>
            <div style="margin-top: 15px; margin-bottom: 25px;">
                <p class="text-light">Se encontraron las siguientes razas similares cargadas en el sistema:</p>
                <ul style="color: var(--accent-primary); font-size: 1.1rem; font-weight: bold; margin-bottom: 20px;">
                    @foreach (var r in similarRazasList)
                    {
                        <li>@r</li>
                    }
                </ul>
                <p class="text-secondary" style="font-size: 0.9rem;">¿Deseas continuar y guardar de todos modos?</p>
            </div>
            <div class="d-flex justify-content-end" style="gap: 10px;">
                <button type="button" class="btn btn-outline-secondary text-light" @onclick="CancelRazaSimilarity">Cancelar</button>
                <button type="button" class="btn btn-primary" style="background: var(--accent-primary); border: none;" @onclick="BypassRazaSimilarity">Continuar y guardar</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string? Id { get; set; }

    private PacienteDto model = new();
    private bool isEdit => !string.IsNullOrEmpty(Id);
    private bool isLoading = true;
    private bool isSaving;
    private string errorMessage = string.Empty;
    private string fechaNacimientoError = string.Empty;
    private string tipoIngresoFecha = "fecha";
    private int edadAniosInput = 0;
    private int edadMesesInput = 0;
    private int edadDiasInput = 0;

    // Catálogos
    private List<PropietarioDto> propietarios = new();
    private List<EspecieDto> especies = new();
    private List<RazaDto> razas = new();

    // ── Modal Especie ──
    private bool showEspecieModal;
    private EspecieDto especieModel = new();
    private bool isSavingEspecie;
    private string especieErrorMessage = string.Empty;

    // ── Modal Raza ──
    private bool showRazaModal;
    private RazaDto razaModel = new();
    private bool isSavingRaza;
    private string razaErrorMessage = string.Empty;

    // ── Similarity Checks ──
    private bool showSimilarEspeciesConfirm;
    private List<string> similarEspeciesList = new();
    private bool bypassEspecieSimilarity;

    private bool showSimilarRazasConfirm;
    private List<string> similarRazasList = new();
    private bool bypassRazaSimilarity;


    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            // Cargar datos dependientes (Dropdowns)
            var props = await PropietarioService.GetAllActivosAsync();
            if(props != null) propietarios = props;

            var esp = await CatalogoService.GetEspeciesActivasAsync();
            if(esp != null) especies = esp;

            if (isEdit)
            {
                var response = await PacienteService.GetByIdAsync(Id!);
                if (response != null)
                {
                    model = response;
                    if (model.EspecieId > 0)
                    {
                        await CargarRazas(model.EspecieId);
                    }
                    CalcularEdadDesdeFecha();
                }
                else errorMessage = "No se encontró el paciente solicitado.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Error al cargar los catálogos/paciente desde la base de datos.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnTipoIngresoFechaChanged(ChangeEventArgs e)
    {
        tipoIngresoFecha = e.Value?.ToString() ?? "fecha";
        if (tipoIngresoFecha == "edad")
        {
            if (model.FechaNacimiento.HasValue)
            {
                CalcularEdadDesdeFecha();
            }
            else
            {
                CalcularFechaDesdeEdad();
            }
        }
        else
        {
            CalcularFechaDesdeEdad();
        }
    }

    private void OnFechaNacimientoChanged(DateTime? val)
    {
        model.FechaNacimiento = val;
        fechaNacimientoError = string.Empty;
        CalcularEdadDesdeFecha();
    }

    private void OnEdadAniosInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            edadAniosInput = Math.Max(0, val);
        }
        else
        {
            edadAniosInput = 0;
        }
        CalcularFechaDesdeEdad();
    }

    private void OnEdadMesesInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            edadMesesInput = Math.Max(0, val);
        }
        else
        {
            edadMesesInput = 0;
        }
        CalcularFechaDesdeEdad();
    }

    private void OnEdadDiasInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            edadDiasInput = Math.Max(0, val);
        }
        else
        {
            edadDiasInput = 0;
        }
        CalcularFechaDesdeEdad();
    }

    private void CalcularFechaDesdeEdad()
    {
        fechaNacimientoError = string.Empty;
        model.FechaNacimiento = DateTime.Today
            .AddYears(-edadAniosInput)
            .AddMonths(-edadMesesInput)
            .AddDays(-edadDiasInput);
    }

    private void CalcularEdadDesdeFecha()
    {
        if (!model.FechaNacimiento.HasValue)
        {
            edadAniosInput = 0;
            edadMesesInput = 0;
            edadDiasInput = 0;
            return;
        }

        var hoy = DateTime.Today;
        var nac = model.FechaNacimiento.Value.Date;

        if (nac > hoy)
        {
            edadAniosInput = 0;
            edadMesesInput = 0;
            edadDiasInput = 0;
            return;
        }

        int a = hoy.Year - nac.Year;
        int m = hoy.Month - nac.Month;
        int d = hoy.Day - nac.Day;

        if (d < 0)
        {
            m--;
            var prevMonth = hoy.AddMonths(-1);
            d += DateTime.DaysInMonth(prevMonth.Year, prevMonth.Month);
        }
        if (m < 0)
        {
            a--;
            m += 12;
        }

        edadAniosInput = Math.Max(0, a);
        edadMesesInput = Math.Max(0, m);
        edadDiasInput = Math.Max(0, d);
    }

    private async Task OnEspecieChanged(int newEspecieId)
    {
        model.EspecieId = newEspecieId;
        model.RazaId = null; // Reset raza al cambiar especie
        await CargarRazas(newEspecieId);
    }

    private async Task CargarRazas(int especieId)
    {
        try
        {
            var r = await CatalogoService.GetRazasPorEspecieAsync(especieId);
            razas = r ?? new List<RazaDto>();
        }
        catch
        {
            razas = new List<RazaDto>();
        }
    }

    private async Task HandleSave()
    {
        isSaving = true;
        errorMessage = string.Empty;
        fechaNacimientoError = string.Empty;

        // Validación custom: fecha de nacimiento no puede ser futura
        if (model.FechaNacimiento.HasValue && model.FechaNacimiento.Value.Date > DateTime.Today)
        {
            fechaNacimientoError = "La fecha ingresada es inválida (Es una fecha futura)";
            isSaving = false;
            return;
        }

        try
        {
            (bool Success, string ErrorMessage) result;
            if (isEdit) 
                result = await PacienteService.UpdateAsync(Id!, model);
            else 
                result = await PacienteService.CreateAsync(model);

            if (result.Success)
            {
                Navigation.NavigateTo("/pacientes");
            }
            else
            {
                errorMessage = $"Ocurrió un error al guardar: {result.ErrorMessage}";
            }
        }
        catch (Exception)
        {
            errorMessage = "Excepción al guardar los datos.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/pacientes");

    // ── Modal Especie Handlers ──
    private void OpenEspecieModal()
    {
        especieModel = new EspecieDto();
        especieErrorMessage = string.Empty;
        isSavingEspecie = false;
        showEspecieModal = true;
    }

    private void CloseEspecieModal()
    {
        showEspecieModal = false;
    }

    private async Task HandleSaveEspecie()
    {
        isSavingEspecie = true;
        especieErrorMessage = string.Empty;
        try
        {
            if (!bypassEspecieSimilarity && especies != null)
            {
                similarEspeciesList = especies
                    .Where(e => BlazorFrontEnd.Helpers.SimilarityHelper.AreSimilar(especieModel.Nombre, e.Nombre))
                    .Select(e => e.Nombre)
                    .ToList();

                if (similarEspeciesList.Any())
                {
                    showSimilarEspeciesConfirm = true;
                    isSavingEspecie = false;
                    return;
                }
            }

            bypassEspecieSimilarity = false;
            showSimilarEspeciesConfirm = false;

            var result = await CatalogoService.CreateEspecieAsync(especieModel);
            if (result)
            {
                var esp = await CatalogoService.GetEspeciesActivasAsync();
                if (esp != null) especies = esp;

                var nuevo = especies?.FirstOrDefault(e => e.Nombre.Equals(especieModel.Nombre, StringComparison.OrdinalIgnoreCase));
                if (nuevo != null)
                {
                    await OnEspecieChanged(nuevo.Id);
                }
                showEspecieModal = false;
            }
            else
            {
                especieErrorMessage = "Ocurrió un error al guardar. Vuelva a intentar.";
            }
        }
        catch (Exception)
        {
            especieErrorMessage = "Error de conexión al guardar los datos.";
        }
        finally
        {
            isSavingEspecie = false;
        }
    }

    private void CancelEspecieSimilarity()
    {
        showSimilarEspeciesConfirm = false;
        bypassEspecieSimilarity = false;
    }

    private async Task BypassEspecieSimilarity()
    {
        showSimilarEspeciesConfirm = false;
        bypassEspecieSimilarity = true;
        await HandleSaveEspecie();
    }

    // ── Modal Raza Handlers ──
    private void OpenRazaModal()
    {
        if (model.EspecieId == 0) return;
        razaModel = new RazaDto { EspecieId = model.EspecieId };
        razaErrorMessage = string.Empty;
        isSavingRaza = false;
        showRazaModal = true;
    }

    private void CloseRazaModal()
    {
        showRazaModal = false;
    }

    private async Task HandleSaveRaza()
    {
        isSavingRaza = true;
        razaErrorMessage = string.Empty;
        try
        {
            if (!bypassRazaSimilarity && razas != null)
            {
                similarRazasList = razas
                    .Where(r => BlazorFrontEnd.Helpers.SimilarityHelper.AreSimilar(razaModel.Nombre, r.Nombre))
                    .Select(r => r.Nombre)
                    .ToList();

                if (similarRazasList.Any())
                {
                    showSimilarRazasConfirm = true;
                    isSavingRaza = false;
                    return;
                }
            }

            bypassRazaSimilarity = false;
            showSimilarRazasConfirm = false;

            var result = await CatalogoService.CreateRazaAsync(razaModel);
            if (result)
            {
                await CargarRazas(model.EspecieId);

                var nuevo = razas?.FirstOrDefault(r => r.Nombre.Equals(razaModel.Nombre, StringComparison.OrdinalIgnoreCase));
                if (nuevo != null)
                {
                    model.RazaId = nuevo.Id;
                }
                showRazaModal = false;
            }
            else
            {
                razaErrorMessage = "Ocurrió un error al guardar. Vuelva a intentar.";
            }
        }
        catch (Exception)
        {
            razaErrorMessage = "Error de conexión al guardar los datos.";
        }
        finally
        {
            isSavingRaza = false;
        }
    }

    private void CancelRazaSimilarity()
    {
        showSimilarRazasConfirm = false;
        bypassRazaSimilarity = false;
    }

    private async Task BypassRazaSimilarity()
    {
        showSimilarRazasConfirm = false;
        bypassRazaSimilarity = true;
        await HandleSaveRaza();
    }


    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file.Size > 1_000_000) // 1MB max
            {
                errorMessage = "La imagen no puede superar 1MB";
                return;
            }

            var buffer = new byte[file.Size];
            using var stream = file.OpenReadStream(1_000_000);
            int bytesRead = 0;
            while (bytesRead < file.Size)
            {
                int read = await stream.ReadAsync(buffer, bytesRead, (int)file.Size - bytesRead);
                if (read == 0) break;
                bytesRead += read;
            }
            var base64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
            model.FotoUrl = base64;
            errorMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar la imagen: {ex.Message}";
        }
    }

    private void RemovePhoto()
    {
        model.FotoUrl = string.Empty;
    }
