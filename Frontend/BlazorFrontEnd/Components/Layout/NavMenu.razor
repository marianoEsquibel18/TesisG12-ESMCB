<div class="sidebar-toggle-container">
    <button class="sidebar-hamburger" @onclick="OnToggle" title="@(Collapsed ? "Expandir menú" : "Colapsar menú")">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:18px; height:18px;">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
    </button>
</div>

@code {
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback OnToggleRequested { get; set; }
    
    private bool inventarioMenuOpen = false;

    private void ToggleInventarioMenu()
    {
        inventarioMenuOpen = !inventarioMenuOpen;
    }

    private async Task OnToggle()
    {
        await OnToggleRequested.InvokeAsync();
    }
}
