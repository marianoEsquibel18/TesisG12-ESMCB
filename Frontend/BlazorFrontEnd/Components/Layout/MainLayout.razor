@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        <div class="app-container">
            <div class="sidebar @(sidebarCollapsed ? "sidebar-collapsed" : "")">
                <NavMenu Collapsed="sidebarCollapsed" OnToggleRequested="ToggleSidebar" />
            </div>

            <main class="main-content">
                <div class="topbar" style="gap: 15px;">
                    <div class="page-title" style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                        <span style="font-weight: 700; color: var(--text-primary);">Gestión Veterinaria</span>
                        
                        @* Branch badge for non-admin users or users with an assigned branch *@
                        @if (!IsAdminReal && !string.IsNullOrWhiteSpace(UserSucursalNombre))
                        {
                            <span class="badge" style="background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(74, 222, 128, 0.3); font-size: 0.8rem; font-weight: 500; padding: 4px 10px; border-radius: 20px; display: inline-flex; align-items: center; gap: 5px;">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 13px; height: 13px;">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                                </svg>
                                @UserSucursalNombre
                            </span>
                        }
                        else if (IsAdminReal && TokenStorage.ActiveSucursalId.HasValue)
                        {
                            <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(96, 165, 250, 0.3); font-size: 0.8rem; font-weight: 500; padding: 4px 10px; border-radius: 20px; display: inline-flex; align-items: center; gap: 5px;">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 13px; height: 13px;">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                                </svg>
                                @(TokenStorage.ActiveSucursalNombre ?? "Sucursal #" + TokenStorage.ActiveSucursalId.Value)
                            </span>
                        }
                    </div>

                    @* Admin testing controls *@
                    @if (IsAdminReal)
                    {
                        <div class="admin-topbar-controls" style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                            <!-- Selector de Sucursal -->
                            <div style="display: flex; align-items: center; gap: 5px; background: rgba(255,255,255,0.06); padding: 3px 8px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.12);">
                                <label style="color: var(--text-secondary); font-size: 0.78rem; font-weight: 600; margin: 0; white-space: nowrap; display: flex; align-items: center; gap: 4px;">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 14px; height: 14px;">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 21v-4.875c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125V21m0 0h4.5V3.545M12.75 21h7.5V10.75M2.25 21h1.5m18 0h-18M2.25 9l4.5-1.636M18.75 3l-1.5.545m0 6.205 3 1m1.5.5-1.5-.5M6.75 7.364V3h-3v18m3-13.636 10.5-3.819" />
                                    </svg>
                                    Sucursal:
                                </label>
                                <select class="form-select form-select-sm" style="background: rgba(0,0,0,0.4); color: var(--text-primary); border: 1px solid rgba(255,255,255,0.15); font-size: 0.8rem; padding: 2px 24px 2px 8px; width: auto; max-width: 170px; border-radius: 6px;" value="@(TokenStorage.ActiveSucursalId ?? 0)" @onchange="OnSucursalChanged">
                                    <option value="0">🌐 Todas (Global)</option>
                                    @foreach (var s in sucursales)
                                    {
                                        <option value="@s.Id">@s.Nombre</option>
                                    }
                                </select>
                            </div>

                            <!-- Selector de Rol para Testing -->
                            <div style="display: flex; align-items: center; gap: 5px; background: rgba(255,255,255,0.06); padding: 3px 8px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.12);">
                                <label style="color: var(--text-secondary); font-size: 0.78rem; font-weight: 600; margin: 0; white-space: nowrap; display: flex; align-items: center; gap: 4px;">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 14px; height: 14px;">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                    </svg>
                                    Ver como:
                                </label>
                                <select class="form-select form-select-sm" style="background: rgba(0,0,0,0.4); color: var(--text-primary); border: 1px solid rgba(255,255,255,0.15); font-size: 0.8rem; padding: 2px 24px 2px 8px; width: auto; max-width: 150px; border-radius: 6px;" value="@(TokenStorage.SimulatedRole ?? "Admin")" @onchange="OnRoleChanged">
                                    <option value="Admin">🛡️ Admin (Real)</option>
                                    <option value="Gerente">👔 Gerente</option>
                                    <option value="Veterinario">🩺 Veterinario</option>
                                    <option value="Recepcionista">📋 Recepcionista</option>
                                </select>
                            </div>

                            @if (CustomAuth != null && CustomAuth.IsSimulatingRole)
                            {
                                <button class="btn btn-sm btn-warning" style="font-size: 0.75rem; padding: 3px 8px; border-radius: 6px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;" @onclick="ResetSimulation" title="Volver a la vista completa de Administrador">
                                    ✕ Restablecer a Admin
                                </button>
                            }
                        </div>
                    }
                    
                    <div class="user-profile" style="display: flex; align-items: center; gap: 10px;">
                        <a href="/perfil" style="display: flex; align-items: center; gap: 10px; text-decoration: none; cursor: pointer; padding: 4px 8px; border-radius: 8px; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.08)'" onmouseout="this.style.background='transparent'">
                            <div style="text-align: right; line-height: 1.2;">
                                <span style="color: var(--text-primary); font-weight: 600; font-size: 0.9rem;">@context.User.Identity?.Name</span>
                                <br/>
                                <span style="color: var(--accent-primary); font-size: 0.75rem; font-weight: 500;">
                                    @GetUserRole(context)
                                    @if (IsAdminReal && CustomAuth != null && CustomAuth.IsSimulatingRole)
                                    {
                                        <small style="color: #f59e0b; font-weight: 600;"> (Simulado)</small>
                                    }
                                </span>
                            </div>
                            <div class="avatar" style="width: 36px; height: 36px; border-radius: 50%; background: var(--accent-primary); display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 0.9rem;">
                                @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                        </a>
                        <button class="btn btn-sm btn-outline-danger" style="font-size: 0.8rem; padding: 4px 12px;" @onclick="Logout">
                            Cerrar Sesión
                        </button>
                    </div>
                </div>

                <article class="content-area">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>
    <Authorizing>
        <div style="position: fixed; inset: 0; background-color: #2e7d32; z-index: 9999; display: flex; align-items: center; justify-content: center; color: white; font-family: 'Poppins', sans-serif;">
            <div style="text-align: center;">
                <div class="spinner-border text-light mb-3" role="status"></div>
                <h4>Verificando sesión...</h4>
            </div>
        </div>
    </Authorizing>
    <NotAuthorized>
        <div style="position: fixed; inset: 0; background-color: #2e7d32; z-index: 9999; display: flex; flex-direction: column; align-items: center; justify-content: center; color: white; font-family: 'Poppins', sans-serif; text-align: center; padding: 20px;">
            <div style="background: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.2); padding: 40px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); max-width: 450px; width: 90%;">
                <div style="font-size: 4rem; margin-bottom: 20px;">🔒</div>
                <h2 style="font-weight: 700; margin-bottom: 10px; font-size: 1.8rem;">Acceso Restringido</h2>
                <p style="font-size: 1.1rem; opacity: 0.9; margin-bottom: 20px;">Debes iniciar sesión para acceder al sistema.</p>
                <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.1); padding: 8px 16px; border-radius: 20px; font-size: 0.9rem;">
                    <div class="spinner-border spinner-border-sm text-light" role="status" style="width: 1rem; height: 1rem;"></div>
                    <span>Redirigiendo a pantalla de inicio...</span>
                </div>
            </div>
        </div>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error.
    <a href="/login" class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] private Blazored.LocalStorage.ILocalStorageService LocalStorage { get; set; } = default!;
    [Inject] private Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private BlazorFrontEnd.Auth.TokenStorageService TokenStorage { get; set; } = default!;
    [Inject] private BlazorFrontEnd.Services.SucursalService SucursalService { get; set; } = default!;

    private bool sidebarCollapsed = false;
    private List<BlazorFrontEnd.Models.SucursalDto> sucursales = new();

    private BlazorFrontEnd.Auth.CustomAuthenticationStateProvider? CustomAuth => AuthStateProvider as BlazorFrontEnd.Auth.CustomAuthenticationStateProvider;
    private bool IsAdminReal => CustomAuth?.IsRealAdmin ?? false;
    private string? UserSucursalNombre => CustomAuth?.UserSucursalNombre;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Sync token and simulation context from localStorage to in-memory TokenStorageService.
            try
            {
                var token = await LocalStorage.GetItemAsync<string>("authToken");
                if (!string.IsNullOrWhiteSpace(token))
                {
                    TokenStorage.SetToken(token);
                }

                if (IsAdminReal)
                {
                    var simRole = await LocalStorage.GetItemAsync<string>("simulatedRole");
                    if (!string.IsNullOrWhiteSpace(simRole))
                    {
                        TokenStorage.SetSimulatedRole(simRole);
                    }

                    var actSucId = await LocalStorage.GetItemAsync<string>("activeSucursalId");
                    var actSucNombre = await LocalStorage.GetItemAsync<string>("activeSucursalNombre");
                    if (int.TryParse(actSucId, out var sId) && sId > 0)
                    {
                        TokenStorage.SetActiveSucursal(sId, actSucNombre);
                    }

                    await LoadSucursales();
                    StateHasChanged();
                }
            }
            catch { /* localStorage not available yet */ }
        }
    }

    private async Task LoadSucursales()
    {
        try
        {
            var res = await SucursalService.GetAllAsync(soloActivos: true);
            if (res != null)
            {
                sucursales = res;
                StateHasChanged();
            }
        }
        catch { /* Ignore error on background load */ }
    }

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
    }

    private async Task OnSucursalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sId))
        {
            if (sId > 0)
            {
                var sucursal = sucursales.FirstOrDefault(s => s.Id == sId);
                if (CustomAuth != null)
                {
                    await CustomAuth.SetActiveSucursalAsync(sId, sucursal?.Nombre ?? $"Sucursal #{sId}");
                }
            }
            else
            {
                if (CustomAuth != null)
                {
                    await CustomAuth.SetActiveSucursalAsync(null, null);
                }
            }
            StateHasChanged();
        }
    }

    private async Task OnRoleChanged(ChangeEventArgs e)
    {
        var selectedRole = e.Value?.ToString();
        if (CustomAuth != null)
        {
            await CustomAuth.SetSimulatedRoleAsync(selectedRole);
        }
        StateHasChanged();
    }

    private async Task ResetSimulation()
    {
        if (CustomAuth != null)
        {
            await CustomAuth.ResetSimulationAsync();
        }
        StateHasChanged();
    }

    private async Task Logout()
    {
        if (CustomAuth != null)
        {
            await CustomAuth.LogoutAsync();
        }
        else
        {
            await LocalStorage.RemoveItemAsync("authToken");
            TokenStorage.ClearToken();
        }
        Navigation.NavigateTo("/", true);
    }

    private string GetUserRole(Microsoft.AspNetCore.Components.Authorization.AuthenticationState context)
    {
        var roleClaim = context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)
            ?? context.User.FindFirst("role");
        return roleClaim?.Value ?? "Usuario";
    }
}
