@code {
    private bool isOpen = false;
    private bool isLoading = false;
    private bool isConfirmingTurno = false;
    private bool isListening = false;
    private string mensajeInput = string.Empty;
    private List<ChatMensajeDto> mensajes = new();
    private List<string> opcionesActuales = new();
    private HashSet<string> turnoConfirmadoIds = new();
    private List<string> accesosRapidosFijos = new();
    private string textoBaseAntesDeVoz = string.Empty;

    private DotNetObjectReference<ChatbotFlotante>? dotNetRef;
    private string activeSucursalNombre = string.Empty;
    private int? activeSucursalId = null;
    private string userRol = "Admin";
    private string realRole = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        dotNetRef = DotNetObjectReference.Create(this);

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                realRole = user.Claims.FirstOrDefault(c => c.Type == "role" || c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;
            }
        }
        catch { }

        ActualizarRolYSucursal();
        TokenStorage.OnContextChanged += HandleContextChanged;
        AuthStateProvider.AuthenticationStateChanged += HandleAuthStateChanged;
        ConfigurarAccesosRapidos();

        if (!mensajes.Any())
        {
            var greetingSuc = !string.IsNullOrWhiteSpace(activeSucursalNombre) ? $" ({activeSucursalNombre})" : "";
            mensajes.Add(new ChatMensajeDto
            {
                Role = "model",
                Content = $"Hola, soy el copiloto inteligente de la clínica veterinaria{greetingSuc}. Puedo ayudarte a consultar la agenda, coordinar turnos médicos, ver horarios profesionales o consultar productos y servicios. Escribe o usa el micrófono, por ejemplo: 'turnos de hoy', 'todos los turnos' o 'Agendame un turno para Henry hoy 18:00 motivo Castracion'.",
                Timestamp = DateTime.Now
            });
        }
    }

    private void ActualizarRolYSucursal()
    {
        activeSucursalId = TokenStorage.ActiveSucursalId;
        activeSucursalNombre = TokenStorage.ActiveSucursalNombre ?? (activeSucursalId.HasValue ? $"Sucursal #{activeSucursalId.Value}" : "");
        userRol = !string.IsNullOrWhiteSpace(TokenStorage.SimulatedRole) 
            ? TokenStorage.SimulatedRole 
            : (!string.IsNullOrWhiteSpace(realRole) ? realRole : "Admin");
    }

    private async void HandleAuthStateChanged(Task<AuthenticationState> task)
    {
        try
        {
            var state = await task;
            realRole = state.User.Claims.FirstOrDefault(c => c.Type == "role" || c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;
            ActualizarRolYSucursal();
            ConfigurarAccesosRapidos();
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private void HandleContextChanged()
    {
        ActualizarRolYSucursal();
        ConfigurarAccesosRapidos();
        InvokeAsync(StateHasChanged);
    }

    private void ConfigurarAccesosRapidos()
    {
        accesosRapidosFijos.Clear();
        accesosRapidosFijos.Add("Turnos de hoy");
        accesosRapidosFijos.Add("Todos los turnos");
        accesosRapidosFijos.Add("Mis pacientes");
        accesosRapidosFijos.Add("Veterinarios y horarios");

        var esRecepcionista = userRol.Equals("Recepcionista", StringComparison.OrdinalIgnoreCase) || 
                              userRol.Equals("Secretaria", StringComparison.OrdinalIgnoreCase);

        if (!esRecepcionista)
        {
            accesosRapidosFijos.Add("Stock en alerta");
        }

        accesosRapidosFijos.Add("Precios de productos");
        accesosRapidosFijos.Add("Precios de servicios");

        var esGerente = userRol.Equals("Gerente", StringComparison.OrdinalIgnoreCase) ||
                        userRol.Equals("Manager", StringComparison.OrdinalIgnoreCase);

        if (!esGerente)
        {
            accesosRapidosFijos.Add("Agendar turno");
        }
    }

    private void ToggleChat()
    {
        isOpen = !isOpen;
        if (isOpen)
        {
            ScrollToBottom();
        }
    }

    private void ReiniciarConversacion()
    {
        mensajes.Clear();
        turnoConfirmadoIds.Clear();
        var greetingSuc = !string.IsNullOrWhiteSpace(activeSucursalNombre) ? $" ({activeSucursalNombre})" : "";
        mensajes.Add(new ChatMensajeDto
        {
            Role = "model",
            Content = $"Conversación reiniciada{greetingSuc}. ¿En qué puedo ayudarte hoy?",
            Timestamp = DateTime.Now
        });

        var esGerente = userRol.Equals("Gerente", StringComparison.OrdinalIgnoreCase) ||
                        userRol.Equals("Manager", StringComparison.OrdinalIgnoreCase);

        opcionesActuales = esGerente
            ? new List<string> { "Turnos de hoy", "Todos los turnos", "Stock en alerta", "Precios de servicios" }
            : new List<string> { "Turnos de hoy", "Todos los turnos", "Como agendar un turno?", "Agendar turno" };
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await EnviarMensaje();
        }
    }

    private async Task SeleccionarChip(string texto)
    {
        mensajeInput = texto;
        await EnviarMensaje();
    }

    #region Reconocimiento de Voz (Web Speech API)

    private async Task ToggleVoiceRecognition()
    {
        if (isListening)
        {
            try
            {
                await JS.InvokeVoidAsync("speechRecognitionHelper.stop");
            }
            catch { }
            isListening = false;
            textoBaseAntesDeVoz = string.Empty;
        }
        else
        {
            try
            {
                dotNetRef ??= DotNetObjectReference.Create(this);
                var isSupported = await JS.InvokeAsync<bool>("speechRecognitionHelper.isSupported");
                if (!isSupported)
                {
                    mensajes.Add(new ChatMensajeDto
                    {
                        Role = "model",
                        Content = "El dictado por voz no está disponible en este navegador o contexto. Te recomendamos utilizar Google Chrome o Microsoft Edge en un entorno seguro (HTTPS o localhost).",
                        Timestamp = DateTime.Now
                    });
                    StateHasChanged();
                    ScrollToBottom();
                    return;
                }

                textoBaseAntesDeVoz = mensajeInput?.Trim() ?? string.Empty;
                var started = await JS.InvokeAsync<bool>("speechRecognitionHelper.start", dotNetRef);
                isListening = started;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[SpeechRecognition Error] {ex.Message}");
                isListening = false;
                textoBaseAntesDeVoz = string.Empty;
            }
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void OnSpeechResult(string transcript)
    {
        if (!string.IsNullOrWhiteSpace(transcript))
        {
            mensajeInput = string.IsNullOrWhiteSpace(textoBaseAntesDeVoz)
                ? transcript
                : $"{textoBaseAntesDeVoz} {transcript}";
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnSpeechStart()
    {
        isListening = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnSpeechEnd()
    {
        isListening = false;
        textoBaseAntesDeVoz = string.Empty;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnSpeechError(string error)
    {
        Console.WriteLine($"[Speech Error JS] {error}");
        isListening = false;
        textoBaseAntesDeVoz = string.Empty;
        if (error == "not-allowed" || error == "service-not-allowed")
        {
            mensajes.Add(new ChatMensajeDto
            {
                Role = "model",
                Content = "No se pudo acceder al micrófono. Por favor permite los permisos de micrófono en tu navegador para usar el dictado por voz.",
                Timestamp = DateTime.Now
            });
            ScrollToBottom();
        }
        StateHasChanged();
    }

    #endregion

    private async Task EnviarMensaje()
    {
        var texto = mensajeInput?.Trim();
        if (string.IsNullOrWhiteSpace(texto) || isLoading) return;

        // Si estaba escuchando por voz, detener al enviar
        if (isListening)
        {
            try
            {
                await JS.InvokeVoidAsync("speechRecognitionHelper.stop");
            }
            catch { }
            isListening = false;
            textoBaseAntesDeVoz = string.Empty;
        }

        mensajeInput = string.Empty;
        textoBaseAntesDeVoz = string.Empty;

        // Agregar mensaje de usuario
        mensajes.Add(new ChatMensajeDto
        {
            Role = "user",
            Content = texto,
            Timestamp = DateTime.Now
        });

        isLoading = true;
        opcionesActuales.Clear();
        StateHasChanged();
        ScrollToBottom();

        try
        {
            var request = new ChatbotRequestDto
            {
                Mensaje = texto,
                SucursalId = activeSucursalId,
                UsuarioRol = userRol,
                Historial = mensajes.TakeLast(6).ToList()
            };

            var respuesta = await IaService.EnviarMensajeChatAsync(request);

            mensajes.Add(new ChatMensajeDto
            {
                Role = "model",
                Content = respuesta.Respuesta,
                TurnoPropuesto = respuesta.TurnoPropuesto,
                Timestamp = DateTime.Now
            });

            if (respuesta.OpcionesSugeridas != null && respuesta.OpcionesSugeridas.Any())
            {
                opcionesActuales = respuesta.OpcionesSugeridas;
            }
        }
        catch (Exception ex)
        {
            mensajes.Add(new ChatMensajeDto
            {
                Role = "model",
                Content = $"Error al procesar la solicitud: {ex.Message}",
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            ScrollToBottom();
        }
    }

    private async Task ConfirmarTurno(TurnoPropuestoDto turno)
    {
        if (turno == null || isConfirmingTurno) return;

        isConfirmingTurno = true;
        StateHasChanged();

        try
        {
            turno.SucursalId = (turno.SucursalId.HasValue && turno.SucursalId.Value > 0)
                ? turno.SucursalId
                : activeSucursalId;

            var resultado = await IaService.ConfirmarTurnoAsync(turno);
            if (resultado.Exito)
            {
                var key = turno.TurnoId ?? (turno.PacienteId + turno.FechaHora.Ticks);
                turnoConfirmadoIds.Add(key);

                mensajes.Add(new ChatMensajeDto
                {
                    Role = "model",
                    Content = resultado.Respuesta,
                    Timestamp = DateTime.Now
                });

                opcionesActuales = new List<string> { "Turnos de hoy", "Todos los turnos", "Agendar otro turno" };
            }
            else
            {
                mensajes.Add(new ChatMensajeDto
                {
                    Role = "model",
                    Content = $"No se pudo confirmar el turno: {resultado.ErrorMensaje}",
                    Timestamp = DateTime.Now
                });
            }
        }
        catch (Exception ex)
        {
            mensajes.Add(new ChatMensajeDto
            {
                Role = "model",
                Content = $"Error al confirmar el turno: {ex.Message}",
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            isConfirmingTurno = false;
            StateHasChanged();
            ScrollToBottom();
        }
    }

    private void ScrollToBottom()
    {
        _ = Task.Run(async () =>
        {
            await Task.Delay(50);
            try
            {
                await JS.InvokeVoidAsync("eval", "var el = document.getElementById('chatbot-messages-container'); if (el) el.scrollTop = el.scrollHeight;");
            }
            catch { }
        });
    }

    private string FormatearTextoMarkdown(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return string.Empty;

        // Limpiar cualquier emoji residual
        var textoLimpio = System.Text.RegularExpressions.Regex.Replace(
            texto,
            @"[\p{Cs}\p{So}\p{Sk}\u2600-\u27BF\uE000-\uF8FF]",
            string.Empty);

        var html = System.Net.WebUtility.HtmlEncode(textoLimpio);

        // Reemplazar negritas **texto** -> <strong>texto</strong>
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");

        // Reemplazar saltos de línea
        html = html.Replace("\n", "<br />");

        return html;
    }

    public async ValueTask DisposeAsync()
    {
        TokenStorage.OnContextChanged -= HandleContextChanged;
        AuthStateProvider.AuthenticationStateChanged -= HandleAuthStateChanged;
        if (isListening)
        {
            try
            {
                await JS.InvokeVoidAsync("speechRecognitionHelper.stop");
            }
            catch { }
        }
        dotNetRef?.Dispose();
    }
}
